{%- comment -%}
  XTU Help Software — Help Center 软件 / App。

  数据来源
  - 产品目录：metaobjects.xtu_help_product
  - 软件：metaobjects.xtu_help_software
    · image：APP 图标（卡片左侧）
    · qr_code：APP 二维码（说明下方，可选）

  相关：snippets/xtu-help-shell.liquid、assets/xtu-help.css、assets/xtu-help.js
{%- endcomment -%}

{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign content_background = section.settings.content_background | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#000000'
  assign muted_text_color = section.settings.muted_text_color | default: '#8E9297'
  assign text_color = section.settings.text_color | default: '#333333'
  assign accent_color = section.settings.accent_color | default: '#0070CA'
  assign sidebar_background = section.settings.sidebar_background | default: '#F5F5F7'
  assign card_background = section.settings.card_background | default: '#FFFFFF'
  assign border_color = section.settings.border_color | default: '#DFDFDF'
  assign content_width = section.settings.content_width | default: 1200 | at_least: 600 | at_most: 1600
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign empty_text = section.settings.empty_text | default: 'No software for this product yet.'
%}

{{ 'xtu-help.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xtu-help.js' | asset_url }}" defer="defer"></script>

{% capture catalog_json %}
{
  "type": "software",
  "emptyText": {{ empty_text | json }},
  "products": [{% render 'xtu-help-products-json' %}],
  "items": [
    {% paginate metaobjects.xtu_help_software.values by 250 %}
      {% assign first_item = true %}
      {% for entry in metaobjects.xtu_help_software.values %}
        {% liquid
          assign raw_code = entry.product_code.value | default: entry.product_code | strip | downcase
          if raw_code == '__default'
            assign product_code = '__default'
          else
            assign product_code = raw_code | handleize
          endif
          assign sw_title = entry.title.value | default: entry.title | strip
          assign desc_html = blank
          if entry.description.value != blank
            assign desc_html = entry.description | metafield_tag
          endif
          assign platform = entry.platform.value | default: entry.platform | strip | downcase
          assign store_url = entry.store_url.value | default: entry.store_url
          assign file_obj = entry.file.value | default: entry.file
          assign file_url = blank
          if file_obj != blank and file_obj.url != blank
            assign file_url = file_obj.url
          endif
          assign sw_image = entry.image.value | default: entry.image
          assign image_url = blank
          if sw_image != blank
            assign image_url = sw_image | image_url: width: 200
          endif
          assign qr_image = entry.qr_code.value | default: entry.qr_code
          assign qr_url = blank
          if qr_image != blank
            assign qr_url = qr_image | image_url: width: 400
          endif
          assign v_sort = entry.sort_order.value | default: entry.sort_order | default: 0
        %}
        {% if product_code != blank and sw_title != blank %}
          {% unless first_item %},{% endunless %}
          {% assign first_item = false %}
          {
            "productCode": {{ product_code | json }},
            "title": {{ sw_title | json }},
            "description": {{ desc_html | json }},
            "platform": {{ platform | json }},
            "storeUrl": {{ store_url | json }},
            "fileUrl": {{ file_url | json }},
            "image": {{ image_url | json }},
            "qrCode": {{ qr_url | json }},
            "sort": {{ v_sort | json }}
          }
        {% endif %}
      {% endfor %}
    {% endpaginate %}
  ]
}
{% endcapture %}

<section
  id="xtu-help-software-{{ section.id }}"
  class="xtu-help"
  data-xtu-help
  style="{% render 'xtu-help-color-vars', section: section %}"
>
  <div class="xtu-help__inner">
    {% render 'xtu-help-shell',
      heading: heading,
      subheading: subheading,
      catalog_json: catalog_json,
      empty_text: empty_text,
      sidebar_label: section.settings.sidebar_label
    %}
  </div>
</section>

{% schema %}
{
  "name": "XTU Help Software",
  "tag": "section",
  "class": "section-xtu-help-software",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "大标题", "default": "Software" },
    { "type": "textarea", "id": "subheading", "label": "副标题", "default": "Apps and tools for XTU cameras." },
    { "type": "text", "id": "sidebar_label", "label": "侧栏标题", "default": "Products" },
    { "type": "text", "id": "empty_text", "label": "空态文案", "default": "No software for this product yet." },
    { "type": "header", "content": "外观" },
    { "type": "color", "id": "background_color", "label": "版块背景色", "default": "#FFFFFF" },
    { "type": "color", "id": "content_background", "label": "内容区背景色", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "标题色", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "正文色", "default": "#333333" },
    { "type": "color", "id": "muted_text_color", "label": "次要文字色", "default": "#8E9297" },
    { "type": "color", "id": "accent_color", "label": "强调色", "default": "#0070CA" },
    { "type": "color", "id": "sidebar_background", "label": "侧栏背景色", "default": "#F5F5F7" },
    { "type": "color", "id": "card_background", "label": "卡片背景色", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "边框颜色", "default": "#DFDFDF" },
    { "type": "header", "content": "按钮" },
    { "type": "color", "id": "button_bg", "label": "按钮背景色", "default": "#1590F2", "info": "如 Download / Get app；默认跟随 Theme settings → XTU 通用颜色" },
    { "type": "color", "id": "button_color", "label": "按钮文字色", "default": "#FFFFFF" },
    { "type": "color", "id": "button_bg_hover", "label": "按钮 Hover 背景色", "default": "#0070CA" },
    { "type": "color", "id": "button_color_hover", "label": "按钮 Hover 文字色", "default": "#FFFFFF" },
    { "type": "header", "content": "细节色" },
    { "type": "color", "id": "badge_bg", "label": "徽章背景色", "default": "#0070CA", "info": "如 Latest 标记" },
    { "type": "color", "id": "badge_color", "label": "徽章文字色", "default": "#FFFFFF" },
    { "type": "color", "id": "card_hover_bg", "label": "卡片 Hover 背景色", "default": "#ECECF0" },
    { "type": "color", "id": "lang_tab_color_active", "label": "语言 Tab 激活文字色", "default": "#FFFFFF" },
    { "type": "color", "id": "chip_bg", "label": "移动端产品 Chip 背景色", "default": "#FFFFFF" },
    { "type": "color", "id": "chip_border", "label": "移动端产品 Chip 边框色", "default": "#E5E7EB" },
    { "type": "color", "id": "chip_color_active", "label": "移动端 Chip 激活文字色", "default": "#FFFFFF" },
    { "type": "color", "id": "surface_bg", "label": "图标/二维码底色", "default": "#FFFFFF" },
    { "type": "color", "id": "icon_muted", "label": "次要图标色", "default": "#667085" },
    { "type": "color", "id": "divider_color", "label": "分割线颜色", "default": "#E5E5E5" },

    { "type": "number", "id": "content_width", "label": "内容区最大宽度（px）", "default": 1200, "info": "范围 600–1600。" },
    { "type": "header", "content": "边距" },
    { "type": "range", "id": "padding_top", "label": "上边距（PC）", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "下边距（PC）", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "上边距（移动端）", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "下边距（移动端）", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "XTU Help Software" }]
}
{% endschema %}
