{%- comment -%}
  XTU Image Compare Slider — 双图左右拖动对比。

  数据来源：Theme Editor 本 section。
  - 对比前图（左/上层）、对比后图（右/底层）；可选 PC/移动分图。
  - 可选前后标签；初始分割位置、媒体比例、滑块样式色。

  运营配置
  1. Theme Editor 添加「XTU Image Compare Slider」。
  2. 上传对比前、对比后图片；建议两张同尺寸同比例。
  3. 可调初始滑块位置（默认居中 50%）。

  前台
  - 拖动/触摸中间竖向滑块左右对比；支持键盘方向键微调。
  - 媒体高度由 aspect-ratio 推导（含「按图片自身比例」：用图片 aspect_ratio，禁止 aspect-ratio:auto 导致塌高）；空图用 placeholder 占位。

  相关：assets/xtu-image-compare-slider.js、assets/xtu-image-compare-slider.css
{%- endcomment -%}

{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign content_background = section.settings.content_background | default: '#FFFFFF'
  assign content_width = section.settings.content_width | default: 1200 | at_least: 600 | at_most: 1600
  assign media_ratio = section.settings.media_ratio | default: '16 / 9'
  assign media_radius = section.settings.media_radius | default: 16
  assign initial_position = section.settings.initial_position | default: 50
  assign label_before = section.settings.label_before
  assign label_after = section.settings.label_after
  assign handle_color = section.settings.handle_color | default: '#FFFFFF'
  assign handle_accent = section.settings.handle_accent | default: '#333333'
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40

  assign image_before = section.settings.image_before
  assign image_before_mobile = section.settings.image_before_mobile
  assign image_after = section.settings.image_after
  assign image_after_mobile = section.settings.image_after_mobile

  assign has_before_mobile = false
  if image_before_mobile != blank
    assign has_before_mobile = true
  endif
  assign has_after_mobile = false
  if image_after_mobile != blank
    assign has_after_mobile = true
  endif

  assign alt_before = label_before | default: heading | default: 'Before'
  assign alt_after = label_after | default: heading | default: 'After'
  assign ratio_auto = false
  assign ratio_css = media_ratio
  assign ratio_css_mobile = blank
  if media_ratio == 'auto'
    assign ratio_auto = true
    # Absolute media layers cannot size an aspect-ratio:auto stage — derive ratio from image.
    if image_after != blank
      assign ratio_css = image_after.aspect_ratio
    elsif image_before != blank
      assign ratio_css = image_before.aspect_ratio
    else
      assign ratio_css = '16 / 9'
    endif
    if image_after_mobile != blank
      assign ratio_css_mobile = image_after_mobile.aspect_ratio
    elsif image_before_mobile != blank
      assign ratio_css_mobile = image_before_mobile.aspect_ratio
    endif
  endif
  assign img_sizes = '(max-width: 749px) calc(100vw - 30px), min(1200px, 100vw - 80px)'
%}

{{ 'xtu-image-compare-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xtu-image-compare-slider.js' | asset_url }}" defer="defer"></script>

<section
  id="xtu-image-compare-slider-{{ section.id }}"
  class="xtu-ics{% if ratio_auto %} xtu-ics--ratio-auto{% endif %}"
  data-xtu-image-compare-slider
  data-initial="{{ initial_position }}"
  style="
    --xtu-ics-bg: {{ background_color }};
    --xtu-ics-content-bg: {{ content_background }};
    --xtu-ics-content-width: {{ content_width }}px;
    --xtu-ics-ratio: {{ ratio_css }};
    {% if ratio_css_mobile != blank %}--xtu-ics-ratio-mobile: {{ ratio_css_mobile }};{% endif %}
    --xtu-ics-radius: {{ media_radius }}px;
    --xtu-ics-split: {{ initial_position }}%;
    --xtu-ics-handle: {{ handle_color }};
    --xtu-ics-handle-accent: {{ handle_accent }};
    --xtu-ics-pt: {{ padding_top }}px;
    --xtu-ics-pb: {{ padding_bottom }}px;
    --xtu-ics-pt-m: {{ padding_top_mobile }}px;
    --xtu-ics-pb-m: {{ padding_bottom_mobile }}px;
  "
>
  <div class="xtu-ics__inner">
    {% if heading != blank or subheading != blank %}
      <div class="xtu-ics__header" data-xtu-reveal="fade-up" data-xtu-stagger>
        {% if heading != blank %}
          <h2 class="xtu-ics__heading" data-xtu-reveal-child>{{ heading | escape }}</h2>
        {% endif %}
        {% if subheading != blank %}
          <p class="xtu-ics__subheading" data-xtu-reveal-child>{{ subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div
      class="xtu-ics__stage"
      data-xtu-ics-stage
      data-xtu-reveal="fade-up"
    >
      <div class="xtu-ics__media xtu-ics__media--after{% if has_after_mobile %} xtu-ics__media--split{% endif %}">
        {% if image_after != blank %}
          {{
            image_after
            | image_url: width: 2400
            | image_tag:
              class: 'xtu-ics__img xtu-ics__img--desktop',
              loading: 'lazy',
              widths: '400, 600, 800, 1200, 1600, 2000, 2400',
              sizes: img_sizes,
              alt: alt_after
          }}
        {% endif %}
        {% if image_after_mobile != blank %}
          {{
            image_after_mobile
            | image_url: width: 1200
            | image_tag:
              class: 'xtu-ics__img xtu-ics__img--mobile',
              loading: 'lazy',
              widths: '400, 600, 800, 1200',
              sizes: img_sizes,
              alt: alt_after
          }}
        {% endif %}
        {% if image_after == blank %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'xtu-ics__placeholder xtu-ics__img xtu-ics__img--desktop' }}
        {% endif %}
        {% if label_after != blank %}
          <span class="xtu-ics__label xtu-ics__label--after">{{ label_after | escape }}</span>
        {% endif %}
      </div>

      <div class="xtu-ics__media xtu-ics__media--before{% if has_before_mobile %} xtu-ics__media--split{% endif %}" data-xtu-ics-before>
        {% if image_before != blank %}
          {{
            image_before
            | image_url: width: 2400
            | image_tag:
              class: 'xtu-ics__img xtu-ics__img--desktop',
              loading: 'lazy',
              widths: '400, 600, 800, 1200, 1600, 2000, 2400',
              sizes: img_sizes,
              alt: alt_before
          }}
        {% endif %}
        {% if image_before_mobile != blank %}
          {{
            image_before_mobile
            | image_url: width: 1200
            | image_tag:
              class: 'xtu-ics__img xtu-ics__img--mobile',
              loading: 'lazy',
              widths: '400, 600, 800, 1200',
              sizes: img_sizes,
              alt: alt_before
          }}
        {% endif %}
        {% if image_before == blank %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'xtu-ics__placeholder xtu-ics__img xtu-ics__img--desktop' }}
        {% endif %}
        {% if label_before != blank %}
          <span class="xtu-ics__label xtu-ics__label--before">{{ label_before | escape }}</span>
        {% endif %}
      </div>

      <div
        class="xtu-ics__handle"
        data-xtu-ics-handle
        role="slider"
        tabindex="0"
        aria-label="{{ 'Compare images' | escape }}"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ initial_position }}"
        aria-orientation="horizontal"
      >
        <span class="xtu-ics__line" aria-hidden="true"></span>
        <span class="xtu-ics__knob" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "XTU Image Compare Slider",
  "tag": "section",
  "class": "section-xtu-image-compare-slider",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "上传两张同比例图片，拖动中间滑块左右对比。建议对比前为左侧可见区域，对比后为右侧底层。"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "大标题",
      "default": "See the difference"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "副标题"
    },
    {
      "type": "header",
      "content": "对比图片"
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "对比前（左/上层）"
    },
    {
      "type": "image_picker",
      "id": "image_before_mobile",
      "label": "对比前（移动端，可选）",
      "info": "未配置时移动端回退 PC 图。"
    },
    {
      "type": "text",
      "id": "label_before",
      "label": "对比前标签",
      "default": "Before"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "对比后（右/底层）"
    },
    {
      "type": "image_picker",
      "id": "image_after_mobile",
      "label": "对比后（移动端，可选）"
    },
    {
      "type": "text",
      "id": "label_after",
      "label": "对比后标签",
      "default": "After"
    },
    {
      "type": "header",
      "content": "滑块与布局"
    },
    {
      "type": "range",
      "id": "initial_position",
      "label": "初始滑块位置",
      "min": 5,
      "max": 95,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "从左边缘算起，表示对比前图可见宽度占比。"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "图片比例",
      "options": [
        { "value": "auto", "label": "按图片自身比例" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "16 / 10", "label": "16:10" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "1 / 1", "label": "1:1" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "图片圆角",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "handle_color",
      "label": "滑块按钮色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "handle_accent",
      "label": "滑块握把线条色",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "颜色与版心"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "版块背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "内容区背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "number",
      "id": "content_width",
      "label": "内容区最大宽度（px）",
      "default": 1200,
      "info": "范围 600–1600。"
    },
    {
      "type": "header",
      "content": "边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "XTU Image Compare Slider",
      "settings": {
        "heading": "See the difference",
        "label_before": "Before",
        "label_after": "After"
      }
    }
  ]
}
{% endschema %}
