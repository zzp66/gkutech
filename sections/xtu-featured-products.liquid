{% liquid
  assign height_mode = section.settings.height_mode | default: 'fixed'
  assign card_height = section.settings.card_height | default: 500
  assign card_ratio_desktop = section.settings.card_ratio_desktop | default: '4 / 5'
  assign card_ratio_mobile = section.settings.card_ratio_mobile | default: '4 / 5'
  assign ratio_desktop_auto = false
  if card_ratio_desktop == 'auto'
    assign ratio_desktop_auto = true
  endif
  assign ratio_mobile_auto = false
  if card_ratio_mobile == 'auto'
    assign ratio_mobile_auto = true
  endif
  assign mobile_layout = section.settings.mobile_layout | default: 'swiper'
  assign mobile_gap = section.settings.mobile_gap | default: 12
  assign desktop_gap = section.settings.desktop_gap | default: 12
  assign section_padding_top = section.settings.padding_top | default: 80
  assign section_padding_bottom = section.settings.padding_bottom | default: 80
  assign section_padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign section_padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
%}

<script src="{{ 'xtu-featured-products.js' | asset_url }}" defer="defer"></script>

<section
  id="xtu-featured-products-{{ section.id }}"
  class="xtu-featured-products xtu-featured-products--height-{{ height_mode }} xtu-featured-products--mobile-{{ mobile_layout }}{% if ratio_desktop_auto %} xtu-featured-products--ratio-desktop-auto{% endif %}{% if ratio_mobile_auto %} xtu-featured-products--ratio-mobile-auto{% endif %}"
  data-xtu-featured-products
  data-mobile-layout="{{ mobile_layout }}"
  data-mobile-gap="{{ mobile_gap }}"
  style="
    --xtu-featured-card-height: {{ card_height }}px;
    {% unless ratio_desktop_auto %}--xtu-featured-ratio-desktop: {{ card_ratio_desktop }};{% endunless %}
    {% unless ratio_mobile_auto %}--xtu-featured-ratio-mobile: {{ card_ratio_mobile }};{% endunless %}
    --xtu-featured-desktop-gap: {{ desktop_gap }}px;
    --xtu-featured-mobile-gap: {{ mobile_gap }}px;
    --xtu-featured-padding-top: {{ section_padding_top }}px;
    --xtu-featured-padding-bottom: {{ section_padding_bottom }}px;
    --xtu-featured-padding-top-mobile: {{ section_padding_top_mobile }}px;
    --xtu-featured-padding-bottom-mobile: {{ section_padding_bottom_mobile }}px;
  "
>
  <div class="xtu-featured-products__shell">
    <div class="swiper xtu-featured-products__swiper" data-xtu-featured-swiper>
      <div class="swiper-wrapper xtu-featured-products__grid">
        {% for block in section.blocks %}
          {% if block.type == 'product_card' %}
            {% liquid
              assign card_product = block.settings.product
              assign learn_more_url = block.settings.learn_more_link
              assign buy_url = block.settings.buy_link

              if learn_more_url == blank and card_product != blank
                assign learn_more_url = card_product.url
              endif

              if buy_url == blank and card_product != blank
                assign buy_url = card_product.url
              endif

              assign heading = block.settings.heading
              if heading == blank and card_product != blank
                assign heading = card_product.title
              endif

              assign image = block.settings.image
              if image == blank and card_product != blank
                assign image = card_product.featured_image
              endif

              assign image_mobile = block.settings.image_mobile
              assign has_mobile_image = false
              if image_mobile != blank
                assign has_mobile_image = true
              endif

              if image == blank and image_mobile != blank
                assign image = image_mobile
                assign has_mobile_image = false
              endif
            %}

            <article
              class="swiper-slide xtu-featured-products__card{% if has_mobile_image %} has-mobile-image{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="xtu-featured-products__media">
                {% if image != blank %}
                  {{
                    image
                    | image_url: width: 1600
                    | image_tag:
                      class: 'xtu-featured-products__image xtu-featured-products__image--desktop',
                      loading: 'lazy',
                      widths: '400, 600, 800, 1200, 1600',
                      sizes: '(min-width: 750px) 50vw, 90vw',
                      alt: heading
                  }}
                {% endif %}
                {% if has_mobile_image %}
                  {{
                    image_mobile
                    | image_url: width: 1200
                    | image_tag:
                      class: 'xtu-featured-products__image xtu-featured-products__image--mobile',
                      loading: 'lazy',
                      widths: '400, 600, 800, 1200',
                      sizes: '90vw',
                      alt: heading
                  }}
                {% elsif image == blank %}
                  {{ 'product-1' | placeholder_svg_tag: 'xtu-featured-products__placeholder' }}
                {% endif %}
                <div class="xtu-featured-products__wash" aria-hidden="true"></div>
              </div>

              <div
                class="xtu-featured-products__copy"
                data-xtu-reveal="fade-up"
                data-xtu-stagger
              >
                {% if block.settings.eyebrow != blank %}
                  <p class="xtu-featured-products__eyebrow" data-xtu-reveal-child>
                    {{ block.settings.eyebrow | escape }}
                  </p>
                {% endif %}

                {% if heading != blank %}
                  <h3 class="xtu-featured-products__heading" data-xtu-reveal-child>
                    {{ heading | escape }}
                  </h3>
                {% endif %}

                {% if block.settings.description != blank %}
                  <p class="xtu-featured-products__description" data-xtu-reveal-child>
                    {{ block.settings.description | escape }}
                  </p>
                {% endif %}

                {% if block.settings.learn_more_label != blank or block.settings.buy_label != blank %}
                  <div class="xtu-featured-products__actions" data-xtu-reveal-child>
                    {% if block.settings.learn_more_label != blank %}
                      {% liquid
                        assign lm_bg = block.settings.learn_more_bg | default: '#FFFFFF'
                        assign lm_color = block.settings.learn_more_text_color | default: '#111827'
                        assign lm_bg_hover = block.settings.learn_more_bg_hover | default: '#F3F4F6'
                        assign lm_color_hover = block.settings.learn_more_text_color_hover | default: '#111827'
                      %}
                      {% render 'xtu-btn',
                        label: block.settings.learn_more_label,
                        href: learn_more_url,
                        size: 'sm',
                        show_arrow: section.settings.show_button_arrow,
                        bg: lm_bg,
                        color: lm_color,
                        bg_hover: lm_bg_hover,
                        color_hover: lm_color_hover,
                        class: 'xtu-featured-products__btn'
                      %}
                    {% endif %}
                    {% if block.settings.buy_label != blank %}
                      {% liquid
                        assign buy_bg = block.settings.buy_bg | default: '#1590F2'
                        assign buy_color = block.settings.buy_text_color | default: '#FFFFFF'
                        assign buy_bg_hover = block.settings.buy_bg_hover | default: '#0070CA'
                        assign buy_color_hover = block.settings.buy_text_color_hover | default: '#FFFFFF'
                      %}
                      {% render 'xtu-btn',
                        label: block.settings.buy_label,
                        href: buy_url,
                        size: 'sm',
                        show_arrow: section.settings.show_button_arrow,
                        bg: buy_bg,
                        color: buy_color,
                        bg_hover: buy_bg_hover,
                        color_hover: buy_color_hover,
                        class: 'xtu-featured-products__btn'
                      %}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .xtu-featured-products {
    padding: var(--xtu-featured-padding-top, 80px) 0 var(--xtu-featured-padding-bottom, 80px);
    background: #fff;
  }

  .xtu-featured-products__shell {
    width: 100%;
  }

  .xtu-featured-products__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--xtu-featured-desktop-gap, 12px);
    align-items: stretch;
    padding-inline: 12px;
    box-sizing: border-box;
  }

  .xtu-featured-products__card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 0;
    box-shadow: none;
    background: #f5f5f7;
    min-height: 0;
    height: 100%;
  }

  .xtu-featured-products--height-fixed .xtu-featured-products__card {
    height: var(--xtu-featured-card-height, 500px);
  }

  .xtu-featured-products--height-auto .xtu-featured-products__card {
    height: auto;
    min-height: 0;
    aspect-ratio: var(--xtu-featured-ratio-desktop, 4 / 5);
  }

  .xtu-featured-products__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .xtu-featured-products__image,
  .xtu-featured-products__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s var(--xtu-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .xtu-featured-products__image--mobile {
    display: none;
  }

  .xtu-featured-products__placeholder {
    background: #e8eaed;
  }

  .xtu-featured-products__wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.92) 0%,
      rgb(255 255 255 / 0.2) 38%,
      rgb(255 255 255 / 0) 66%
    );
    pointer-events: none;
  }

  .xtu-featured-products__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 40px 20px 24px;
    color: #111827;
  }

  .xtu-featured-products__eyebrow,
  .xtu-featured-products__description {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 400;
    line-height: 1.2;
  }

  .xtu-featured-products__eyebrow {
    margin-bottom: 10px;
    font-size: var(--xtu-type-body, 0.875rem);
    color: #667085;
  }

  .xtu-featured-products__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 600;
    line-height: 1.2;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    letter-spacing: -0.02em;
    color: #111827;
  }

  .xtu-featured-products__description {
    margin-top: 12px;
    font-size: var(--xtu-type-body, 0.875rem);
    color: #667085;
    max-width: 28rem;
  }

  .xtu-featured-products__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 18px;
  }

  .xtu-featured-products__card:hover .xtu-featured-products__image {
    transform: scale(1.03);
  }

  /* Desktop: treat as grid, neutralize swiper wrapper behavior */
  @media screen and (min-width: 750px) {
    .xtu-featured-products__swiper {
      overflow: visible;
    }

    .xtu-featured-products__swiper .swiper-wrapper {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--xtu-featured-desktop-gap, 12px);
      transform: none !important;
    }

    .xtu-featured-products__card.swiper-slide {
      width: auto !important;
      margin: 0 !important;
    }
  }

  @media screen and (max-width: 749px) {
    .xtu-featured-products {
      padding: var(--xtu-featured-padding-top-mobile, 40px) 0 var(--xtu-featured-padding-bottom-mobile, 40px);
    }

    .xtu-featured-products--mobile-stack .xtu-featured-products__grid,
    .xtu-featured-products--mobile-stack .xtu-featured-products__swiper .swiper-wrapper {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--xtu-featured-mobile-gap, 12px);
      padding-inline: 12px;
      transform: none !important;
    }

    .xtu-featured-products--mobile-stack .xtu-featured-products__card.swiper-slide {
      width: auto !important;
      margin: 0 !important;
    }

    .xtu-featured-products--mobile-swiper .xtu-featured-products__shell {
      overflow: hidden;
    }

    .xtu-featured-products--mobile-swiper .xtu-featured-products__grid,
    .xtu-featured-products--mobile-swiper .xtu-featured-products__swiper .swiper-wrapper {
      display: flex;
      gap: 0;
      padding-inline: 0;
    }

    /* Mobile: aspect-ratio drives height (no fixed px) */
    .xtu-featured-products--mobile-swiper .xtu-featured-products__card,
    .xtu-featured-products--mobile-stack .xtu-featured-products__card,
    .xtu-featured-products--height-fixed.xtu-featured-products--mobile-swiper .xtu-featured-products__card,
    .xtu-featured-products--height-auto.xtu-featured-products--mobile-swiper .xtu-featured-products__card {
      height: auto;
      min-height: 0;
      aspect-ratio: var(--xtu-featured-ratio-mobile, 4 / 5);
    }

    .xtu-featured-products--mobile-swiper .xtu-featured-products__media,
    .xtu-featured-products--mobile-stack .xtu-featured-products__media {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }

    .xtu-featured-products--mobile-swiper .xtu-featured-products__copy,
    .xtu-featured-products--mobile-stack .xtu-featured-products__copy {
      position: relative;
    }

    .xtu-featured-products__card.has-mobile-image .xtu-featured-products__image--desktop {
      display: none;
    }

    .xtu-featured-products__card.has-mobile-image .xtu-featured-products__image--mobile {
      display: block;
    }

    .xtu-featured-products__copy {
      padding-top: 32px;
    }

    .xtu-featured-products__card {
      border-radius: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xtu-featured-products__image {
      transition: none;
    }

    .xtu-featured-products__card:hover .xtu-featured-products__image {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU Featured Products",
  "tag": "section",
  "class": "xtu-featured-products-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "height_mode",
      "label": "卡片高度模式",
      "options": [
        { "value": "fixed", "label": "固定高度" },
        { "value": "auto", "label": "跟随图片比例" }
      ],
      "default": "fixed"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "固定卡片高度（PC）",
      "min": 360,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 500,
      "visible_if": "{{ section.settings.height_mode == 'fixed' }}"
    },
    {
      "type": "select",
      "id": "card_ratio_desktop",
      "label": "卡片图片比例（PC）",
      "info": "仅「跟随图片比例」模式生效",
      "options": [
        { "value": "auto", "label": "自适应（按图片比例）" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "4 / 3", "label": "4:3" }
      ],
      "default": "4 / 5",
      "visible_if": "{{ section.settings.height_mode == 'auto' }}"
    },
    {
      "type": "select",
      "id": "card_ratio_mobile",
      "label": "卡片图片比例（移动端）",
      "info": "移动端滑动/平铺按此比例或自适应高度",
      "options": [
        { "value": "auto", "label": "自适应（按图片比例）" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "4 / 3", "label": "4:3" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "移动端布局",
      "options": [
        { "value": "swiper", "label": "左右滑动（1.1 卡）" },
        { "value": "stack", "label": "平铺（一行 1 卡）" }
      ],
      "default": "swiper"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "桌面间距",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "移动端间距",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "show_button_arrow",
      "label": "按钮显示箭头图标",
      "info": "启用后，本区块内所有主副按钮同步显示箭头",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "产品卡片",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "关联产品"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "卡片图片（PC）"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "卡片图片（移动端）",
          "info": "不设置时沿用 PC 图片"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "眉题",
          "default": "Capture every frame in focus"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "标题",
          "default": "S7 Pro Max"
        },
        {
          "type": "text",
          "id": "description",
          "label": "描述",
          "default": "HiSilicon AI True Color Imaging"
        },
        {
          "type": "header",
          "content": "主按钮（了解更多）"
        },
        {
          "type": "text",
          "id": "learn_more_label",
          "label": "文案",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "learn_more_link",
          "label": "链接"
        },
        {
          "type": "color",
          "id": "learn_more_bg",
          "label": "背景色",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "learn_more_text_color",
          "label": "文字颜色",
          "default": "#111827"
        },
        {
          "type": "color",
          "id": "learn_more_bg_hover",
          "label": "Hover 背景色",
          "default": "#F3F4F6"
        },
        {
          "type": "color",
          "id": "learn_more_text_color_hover",
          "label": "Hover 文字颜色",
          "default": "#111827"
        },
        {
          "type": "header",
          "content": "副按钮（购买）"
        },
        {
          "type": "text",
          "id": "buy_label",
          "label": "文案",
          "default": "Buy now"
        },
        {
          "type": "url",
          "id": "buy_link",
          "label": "链接"
        },
        {
          "type": "color",
          "id": "buy_bg",
          "label": "背景色",
          "default": "#1590F2"
        },
        {
          "type": "color",
          "id": "buy_text_color",
          "label": "文字颜色",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "buy_bg_hover",
          "label": "Hover 背景色",
          "default": "#0070CA"
        },
        {
          "type": "color",
          "id": "buy_text_color_hover",
          "label": "Hover 文字颜色",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "XTU Featured Products",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "eyebrow": "Capture every frame in focus",
            "heading": "S7 Pro Max",
            "description": "HiSilicon AI True Color Imaging",
            "learn_more_label": "Learn more",
            "buy_label": "Buy now"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "eyebrow": "4K flagship action camera",
            "heading": "S7 Pro",
            "description": "Capture every frame in focus",
            "learn_more_label": "Learn more",
            "buy_label": "Buy now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
