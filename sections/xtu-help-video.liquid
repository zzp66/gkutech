{%- comment -%}
  XTU Help Video — Help Center 教程视频（与 Guide Video 页数据隔离）。

  数据来源
  - 产品目录：metaobjects.xtu_help_product（无内容的产品不出现在侧栏）
  - 共用语言：metaobjects.xtu_help_language（label / icon）；未配时用内置旗帜
  - 视频：metaobjects.xtu_help_video（cover / youtube_url / video / language）
    YouTube 优先于上传视频；二者皆空则跳过。language 与 FAQ 一样做语言 Tab。
  运营：后台「内容 → Metaobjects → XTU Help Video」维护。勿写入 xtu_guide_video。
  前台：语言 Tab → 封面 lazy；点击才插入 iframe / video；超出每页数量分页。

  相关：snippets/xtu-help-shell.liquid、xtu-help-languages-json、assets/xtu-help.css/js
{%- endcomment -%}

{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign content_background = section.settings.content_background | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#000000'
  assign muted_text_color = section.settings.muted_text_color | default: '#8E9297'
  assign text_color = section.settings.text_color | default: '#333333'
  assign accent_color = section.settings.accent_color | default: '#0070CA'
  assign sidebar_background = section.settings.sidebar_background | default: '#F5F5F7'
  assign card_background = section.settings.card_background | default: '#FFFFFF'
  assign border_color = section.settings.border_color | default: '#DFDFDF'
  assign content_width = section.settings.content_width | default: 1200 | at_least: 600 | at_most: 1600
  assign columns_desktop = section.settings.columns_desktop | default: 2
  assign per_page = section.settings.per_page | default: 8
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign empty_text = section.settings.empty_text | default: 'No videos for this product yet.'
%}

{{ 'xtu-help.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xtu-help.js' | asset_url }}" defer="defer"></script>

{% capture catalog_json %}
{
  "type": "video",
  "emptyText": {{ empty_text | json }},
  "columns": {{ columns_desktop | json }},
  "perPage": {{ per_page | json }},
  "products": [{% render 'xtu-help-products-json' %}],
  "languages": [{% render 'xtu-help-languages-json' %}],
  "items": [
    {% paginate metaobjects.xtu_help_video.values by 250 %}
      {% assign first_item = true %}
      {% for entry in metaobjects.xtu_help_video.values %}
        {% liquid
          assign product_code = entry.product_code.value | default: entry.product_code | strip | downcase | handleize
          assign v_title = entry.title.value | default: entry.title | strip
          assign v_cover = entry.cover.value | default: entry.cover
          assign v_youtube = entry.youtube_url.value | default: entry.youtube_url | strip
          assign v_video = entry.video.value | default: entry.video
          assign v_language = entry.language.value | default: entry.language | strip | downcase
          assign v_language_label = entry.language_label.value | default: entry.language_label | strip
          assign v_sort = entry.sort_order.value | default: entry.sort_order | default: 0

          assign cover_url = blank
          if v_cover != blank
            assign cover_url = v_cover | image_url: width: 1200
          elsif v_video != blank and v_video.preview_image != blank
            assign cover_url = v_video.preview_image | image_url: width: 1200
          endif

          assign video_url = blank
          if v_video != blank
            if v_video.sources != blank
              for source in v_video.sources
                assign source_format = source.format | default: '' | downcase
                assign source_mime = source.mime_type | default: '' | downcase
                assign source_href = source.url | default: ''
                if source_href != blank
                  if source_format == 'mp4' or source_mime == 'video/mp4' or source_href contains '.mp4'
                    unless source_href contains '.m3u8'
                      assign video_url = source_href
                      break
                    endunless
                  endif
                endif
              endfor
              if video_url == blank
                for source in v_video.sources
                  assign source_href = source.url | default: ''
                  if source_href != blank
                    unless source_href contains '.m3u8'
                      assign video_url = source_href
                      break
                    endunless
                  endif
                endfor
              endif
            endif
            if video_url == blank and v_video.url != blank
              unless v_video.url contains '.m3u8'
                assign video_url = v_video.url
              endunless
            endif
          endif
        %}
        {% if product_code != blank and v_title != blank %}
          {% if v_youtube != blank or video_url != blank %}
            {% unless first_item %},{% endunless %}
            {% assign first_item = false %}
            {
              "productCode": {{ product_code | json }},
              "title": {{ v_title | json }},
              "language": {{ v_language | json }},
              "languageLabel": {{ v_language_label | json }},
              "cover": {{ cover_url | json }},
              "youtubeUrl": {{ v_youtube | json }},
              "videoUrl": {{ video_url | json }},
              "sort": {{ v_sort | json }}
            }
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endpaginate %}
  ]
}
{% endcapture %}

<section
  id="xtu-help-video-{{ section.id }}"
  class="xtu-help"
  data-xtu-help
  style="{% render 'xtu-help-color-vars', section: section %}"
>
  <div class="xtu-help__inner">
    {% render 'xtu-help-shell',
      heading: heading,
      subheading: subheading,
      catalog_json: catalog_json,
      empty_text: empty_text,
      sidebar_label: section.settings.sidebar_label
    %}
  </div>
</section>

{% schema %}
{
  "name": "XTU Help Video",
  "tag": "section",
  "class": "section-xtu-help-video",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "paragraph", "content": "视频数据在「内容 → Metaobjects → XTU Help Video」。请填写 language（与 XTU Help Language / FAQ 的语言代码一致）；语言名称与旗帜优先读共用语言字典，条目上的 language_label 可覆盖名称。无内容的产品不会出现在侧栏。" },
    { "type": "text", "id": "heading", "label": "大标题", "default": "Video Guide" },
    { "type": "textarea", "id": "subheading", "label": "副标题", "default": "Watch setup and how-to videos." },
    { "type": "text", "id": "sidebar_label", "label": "侧栏标题", "default": "Products" },
    { "type": "text", "id": "empty_text", "label": "空态文案", "default": "No videos for this product yet." },
    { "type": "range", "id": "columns_desktop", "label": "每行数量（PC）", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "per_page", "label": "每页数量", "min": 4, "max": 24, "step": 2, "default": 8 },
    { "type": "header", "content": "外观" },
    { "type": "color", "id": "background_color", "label": "版块背景色", "default": "#FFFFFF" },
    { "type": "color", "id": "content_background", "label": "内容区背景色", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "标题色", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "正文色", "default": "#333333" },
    { "type": "color", "id": "muted_text_color", "label": "次要文字色", "default": "#8E9297" },
    { "type": "color", "id": "accent_color", "label": "强调色", "default": "#0070CA" },
    { "type": "color", "id": "sidebar_background", "label": "侧栏背景色", "default": "#F5F5F7" },
