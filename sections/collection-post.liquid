{%- assign faq_items = collection.metafields.custom.faq_structured_data_items.value -%}
{%- if faq_items != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for faq_item in faq_items -%}
          {
            "@type": "Question",
            "name": {{ faq_item.question.value | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ faq_item.answer.value | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{%- assign seo_post = collection.metafields.custom.seo_post -%}
{%- assign seo_post_html = collection.metafields.custom.seo_post_html.value -%}
{%- assign seo_post_size = seo_post | metafield_tag | strip_html | size -%}
{% if section.settings.copy_preview != blank or seo_post_html != blank or seo_post_size > 0 %}
  <style>
    #shopify-section-{{ section.id }} {
      padding-top: 0;
      padding-bottom: 0;
      background-color: {{ section.settings.section_background_color }};
      color: {{ section.settings.section_text_color }};
    }

    #shopify-section-{{ section.id }} .rich-text__text.rich-text__wrapper--left {
      text-align: left;
    }

    #shopify-section-{{ section.id }} .rich-text__text.rich-text__wrapper--center {
      text-align: center;
    }

    #shopify-section-{{ section.id }} .rich-text__text.rich-text__wrapper--right {
      text-align: right;
    }

    #shopify-section-{{ section.id }} .rich-text__text :where(h1, h2, h3, h4, h5, h6) {
      text-align: inherit;
    }

    {% comment %} 移动端 {% endcomment %}
    #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      padding-left: {{ section.settings.padding_left | times: 0.75 | round: 0 }}px;
      padding-right: {{ section.settings.padding_right | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        padding-left: {{ section.settings.padding_left }}px;
        padding-right: {{ section.settings.padding_right }}px;
      }
    }

    /* H 标签默认字体大小、字重与间距 */
    #shopify-section-{{ section.id }} .custom-post h1,
    #shopify-section-{{ section.id }} .custom-post h2,
    #shopify-section-{{ section.id }} .custom-post h3,
    #shopify-section-{{ section.id }} .custom-post h4,
    #shopify-section-{{ section.id }} .custom-post h5,
    #shopify-section-{{ section.id }} .custom-post h6 {
      color: {{ section.settings.section_text_color }};
    }

    #shopify-section-{{ section.id }} .custom-post h1 {
      font-size: 2.5em;
      font-weight: bold;
      margin-top: 1.5em;
      margin-bottom: 0.75em;
    }

    #shopify-section-{{ section.id }} .custom-post h2 {
      font-size: 2em;
      font-weight: bold;
      margin-top: 1.3em;
      margin-bottom: 0.65em;
    }

    #shopify-section-{{ section.id }} .custom-post h3 {
      font-size: 1.5em;
      font-weight: bold;
      margin-top: 1.1em;
      margin-bottom: 0.55em;
    }

    #shopify-section-{{ section.id }} .custom-post p {
      margin-top: 0.6em;
      margin-bottom: 1em;
      line-height: 1.6;
    }

    #shopify-section-{{ section.id }} .custom-post ul {
      margin-top: 0.6em;
      margin-bottom: 1em;
      padding-left: 2em;
      list-style-type: disc;
    }

    #shopify-section-{{ section.id }} .custom-post ul li {
      margin-bottom: 0.5em;
    }

    #shopify-section-{{ section.id }} .custom-post a {
      color: inherit;
      text-decoration: underline;
    }

    /* Read More 按钮 */
    #shopify-section-{{ section.id }} .rich-text__text {
      position: relative;
    }

    #shopify-section-{{ section.id }} .rich-text__text.content-collapsed {
      max-height: {{ section.settings.content_height }}px;
      overflow: hidden;
      mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
    }

    #shopify-section-{{ section.id }} .read-full-story-btn {
      display: none;
      margin-top: 1.5rem;
      margin-left: auto;
      margin-right: auto;
      padding: 1rem 2rem;
      font-size: 14px;
      font-weight: 700;
      color: #000;
      background-color: #fff;
      border: 2px solid #000;
      border-radius: 30px;
      cursor: pointer;
      transition: background-color 0.3s ease, color 0.3s ease;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .read-full-story-btn:hover {
      background-color: {{ section.settings.button_color }};
      color: #fff;
    }

    #shopify-section-{{ section.id }} .read-full-story-btn:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 3px;
    }

    #shopify-section-{{ section.id }} .read-full-story-btn.show {
      display: block;
    }

    #shopify-section-{{ section.id }} .read-full-story-btn--center {
      margin-left: auto;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} .read-full-story-btn--left {
      margin-left: 0;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} .read-full-story-btn--right {
      margin-left: auto;
      margin-right: 0;
    }

    {% comment %} FAQ 样式 {% endcomment %}
    #shopify-section-{{ section.id }} .accordion-container {
      margin: 0 auto;
      padding: 2rem 0;
      {% if section.settings.full_width == false %}
        max-width: 48rem;
      {% endif %}
      --color: {{ section.settings.section_text_color }};
    }

    #shopify-section-{{ section.id }} .accordion-container h2 {
      text-align: {{ section.settings.faq_title_position }};
    }

    #shopify-section-{{ section.id }} .accordion .accordion-item {
      border-bottom: 1px solid #e5e5e5;
    }

    #shopify-section-{{ section.id }} .accordion .accordion-item button[aria-expanded='true'] {
      border-bottom: 1px solid var(--color);
      border-radius: unset;
    }

    #shopify-section-{{ section.id }} .accordion button {
      position: relative;
      display: block;
      width: 100%;
      padding: 1em 0;
      color: var(--color);
      font-size: 1.15em;
      font-weight: 400;
      text-align: left;
      border: none;
      background: none;
      cursor: pointer;
    }

    #shopify-section-{{ section.id }} .accordion button:hover {
      color: var(--color);
    }

    #shopify-section-{{ section.id }} .accordion button:focus-visible {
      outline: 2px solid var(--color);
      outline-offset: 3px;
    }

    #shopify-section-{{ section.id }} .accordion button .accordion-title {
      display: inline-block;
      padding: 1em 1.5em 1em 0;
    }

    #shopify-section-{{ section.id }} .accordion button .icon {
      position: absolute;
      top: 18px;
      right: 0;
      display: inline-block;
      width: 22px;
      height: 22px;
    }

    #shopify-section-{{ section.id }} .accordion button .icon::before {
      position: absolute;
      top: 9px;
      left: 5px;
      display: block;
      width: 10px;
      height: 2px;
      background: currentColor;
      content: '';
    }

    #shopify-section-{{ section.id }} .accordion button .icon::after {
      position: absolute;
      top: 5px;
      left: 9px;
      display: block;
      width: 2px;
      height: 10px;
      background: currentColor;
      content: '';
    }

    #shopify-section-{{ section.id }} .accordion button[aria-expanded='true'] {
      color: var(--color);
    }

    #shopify-section-{{ section.id }} .accordion button[aria-expanded='true'] .icon::after {
      width: 0;
    }

    #shopify-section-{{ section.id }} .accordion button[aria-expanded='true'] + .accordion-content {
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .accordion .accordion-content {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: opacity 200ms linear, max-height 200ms linear;
    }

    #shopify-section-{{ section.id }} .accordion .accordion-content p {
      margin: 2em 0;
      font-size: 16px;
      font-weight: 300;
    }
    {% comment %} FAQ 样式 end {% endcomment %}
  </style>


  <div class="custom-post page-width container">
    <article class="section-{{ section.id }}-padding">
      <div
        id="rich-text-{{ section.id }}"
        class="rich-text__text rich-text__wrapper--{{ section.settings.content_position }} rte"
      >
        {% if section.settings.copy_preview != blank %}
          {{ section.settings.copy_preview }}
        {% elsif seo_post_html != blank %}
          {{ seo_post_html }}
        {% else %}
          {{ seo_post | metafield_tag }}
        {% endif %}
      </div>
      <button
        type="button"
        id="read-full-story-btn-{{ section.id }}"
        class="read-full-story-btn read-full-story-btn--{{ section.settings.read_more_button_position | default: 'center' }}"
        aria-expanded="false"
        aria-controls="rich-text-{{ section.id }}"
      >
        {{ section.settings.read_more_button_text }}
      </button>
    </article>
  </div>

<script>
  (function() {
    const sectionRoot = document.getElementById('shopify-section-{{ section.id }}');

    if (!sectionRoot) {
      return;
    }

    const article = sectionRoot.querySelector('.custom-post article');
    const accordionContainers = sectionRoot.querySelectorAll('.accordion-container');

    // FAQ 不参与 Read More 的高度计算，并始终显示在文章内容之后。
    if (article) {
      accordionContainers.forEach((container) => article.appendChild(container));
    }

    {% if section.settings.use_read_more %}
      const richTextContent = sectionRoot.querySelector('#rich-text-{{ section.id }}');
      const readMoreBtn = sectionRoot.querySelector('#read-full-story-btn-{{ section.id }}');
      const contentHeightThreshold = {{ section.settings.content_height }};

      if (richTextContent && readMoreBtn) {
        if (richTextContent.scrollHeight > contentHeightThreshold) {
          richTextContent.classList.add('content-collapsed');
          readMoreBtn.classList.add('show');
        }

        readMoreBtn.addEventListener('click', function() {
          const isExpanded = this.getAttribute('aria-expanded') === 'true';

          richTextContent.classList.toggle('content-collapsed', isExpanded);
          this.setAttribute('aria-expanded', String(!isExpanded));
          this.textContent = isExpanded
            ? {{ section.settings.read_more_button_text | json }}
            : {{ section.settings.read_less_button_text | json }};
        });
      }
    {% endif %}

    const accordionButtons = sectionRoot.querySelectorAll('.accordion button');

    function getAccordionContent(button) {
      const content = button.nextElementSibling;

      if (content && content.classList.contains('accordion-content')) {
        return content;
      }

      return null;
    }

    function setAccordionState(button, isExpanded) {
      const content = getAccordionContent(button);

      button.setAttribute('aria-expanded', String(isExpanded));

      if (content) {
        content.style.maxHeight = isExpanded ? `${content.scrollHeight}px` : '0px';
      }
    }

    function toggleAccordion() {
      const shouldExpand = this.getAttribute('aria-expanded') !== 'true';

      accordionButtons.forEach((button) => setAccordionState(button, false));

      if (shouldExpand) {
        setAccordionState(this, true);
      }
    }

    accordionButtons.forEach((button) => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';

      setAccordionState(button, isExpanded);
      button.addEventListener('click', toggleAccordion);
    });
  })();
</script>
{% endif %}
{% schema %}
{
  "name": "集合页文章",
  "settings": [
    {
      "type": "liquid",
      "id": "copy_preview",
      "label": "文案预览",
      "info": "可直接粘贴 HTML 或 Liquid 代码；填写后优先显示预览内容，留空时显示集合页 SEO 文案"
    },
    {
      "type": "text_alignment",
      "id": "content_position",
      "default": "left",
      "label": "内容对齐"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "区块背景色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "section_text_color",
      "label": "区块字体颜色",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "阅读更多设置"
    },
   {
      "type":"checkbox",
      "id":"use_read_more",
      "default":true,
      "label":"Read More 开关"
    },
    {
      "type": "text_alignment",
      "id": "read_more_button_position",
      "default": "center",
      "label": "按钮对齐"
    },
    {
      "type": "range",
      "id": "content_height",
      "min": 200,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "label": "内容高度阈值",
      "default": 600,
      "info": "当内容高度超过此值时显示阅读更多按钮"
    },
    {
      "type": "text",
      "id": "read_more_button_text",
      "label": "展开按钮文案",
      "default": "Read More"
    },
    {
      "type": "text",
      "id": "read_less_button_text",
      "label": "收起按钮文案",
      "default": "Show Less"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "按钮颜色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "顶部填充",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "底部填充",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "左侧填充",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "右侧填充",
      "default": 0
    },
      {
      "type": "header",
      "content": "FAQ设置"
    },
    {
      "type":"checkbox",
      "id":"full_width",
      "label": "全宽展示",
      "default":true
    },
    {
      "type": "text_alignment",
      "id": "faq_title_position",
      "default": "left",
      "label": "标题对齐"
    }
  ],
  "presets": [
    {
      "name": "集合页文章"
    }
  ]
}
{% endschema %}