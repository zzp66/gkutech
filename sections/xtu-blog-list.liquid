      "default": "#EEF0F3"
    },
    {
      "type": "color",
      "id": "tab_color",
      "label": "Tab 文字色",
      "default": "#4B5563"
    },
    {
      "type": "color",
      "id": "tab_bg_active",
      "label": "Tab 选中背景色",
      "default": "#0070CA"
    },
    {
      "type": "color",
      "id": "tab_color_active",
      "label": "Tab 选中文字色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
