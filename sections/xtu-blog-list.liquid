{% liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = blog.title
  endif

  assign button_label = section.settings.button_label | default: 'Read More'
  assign show_button_arrow = section.settings.show_button_arrow
  assign show_author = section.settings.show_author
  assign date_format = section.settings.date_format | default: '%B %d, %Y'
  assign card_ratio = section.settings.card_ratio | default: '4 / 3'
  assign ratio_auto = false
  if card_ratio == 'auto'
    assign ratio_auto = true
  endif
  assign per_page_desktop = section.settings.articles_per_page_desktop | default: 9
  assign per_page_mobile = section.settings.articles_per_page_mobile | default: 8
  assign content_width = section.settings.content_width | default: 1200
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign background_color = section.settings.background_color | default: settings.color_palette.background
  assign content_background = section.settings.content_background | default: background_color
  assign heading_color = section.settings.heading_color | default: '#111111'
  assign text_color = section.settings.text_color | default: '#4B5563'
  assign muted_text_color = section.settings.muted_text_color | default: '#6B7280'
  assign accent_color = section.settings.accent_color | default: '#0070CA'
  assign tab_bg = section.settings.tab_bg | default: '#EEF0F3'
  assign tab_color = section.settings.tab_color | default: '#4B5563'
  assign tab_bg_active = section.settings.tab_bg_active | default: '#0070CA'
  assign tab_color_active = section.settings.tab_color_active | default: '#FFFFFF'
  assign button_bg = section.settings.button_bg | default: settings.xtu_btn_bg | default: '#1590F2'
  assign button_color = section.settings.button_color | default: settings.xtu_btn_color | default: '#FFFFFF'
  assign button_bg_hover = section.settings.button_bg_hover | default: settings.xtu_btn_bg_hover | default: '#0070CA'
  assign button_color_hover = section.settings.button_color_hover | default: settings.xtu_btn_color_hover | default: '#FFFFFF'
  assign card_background = section.settings.card_background | default: '#FFFFFF'
  assign border_color = section.settings.border_color | default: '#E5E7EB'
  assign placeholder_bg = section.settings.placeholder_bg | default: '#F5F5F7'
  assign gap = section.settings.card_gap | default: 24
  assign gap_mobile = section.settings.card_gap_mobile | default: 12
  assign show_blog_tabs = section.settings.show_blog_tabs
  assign show_tag_filter = section.settings.show_tag_filter
  assign tag_filter_label = section.settings.tag_filter_label | default: 'All tags'

  assign active_tag = current_tags.first
  assign blog_tab_count = 0
  for block in section.blocks
    if block.type == 'blog_category' and block.settings.blog != blank
      assign blog_tab_count = blog_tab_count | plus: 1
    endif
  endfor
  assign articles_per_page = per_page_desktop
  if per_page_mobile > per_page_desktop
    assign articles_per_page = per_page_mobile
  endif
%}

<section
  id="xtu-blog-list-{{ section.id }}"
  class="xtu-blog-list{% if ratio_auto %} xtu-blog-list--ratio-auto{% endif %}"
  data-xtu-blog-list
  style="
    --xtu-bl-bg: {{ background_color }};
    --xtu-bl-content-bg: {{ content_background }};
    --xtu-bl-heading: {{ heading_color }};
    --xtu-bl-text: {{ text_color }};
    --xtu-bl-muted: {{ muted_text_color }};
    --xtu-bl-accent: {{ accent_color }};
    --xtu-bl-tab-bg: {{ tab_bg }};
    --xtu-bl-tab-color: {{ tab_color }};
    --xtu-bl-tab-bg-active: {{ tab_bg_active }};
    --xtu-bl-tab-color-active: {{ tab_color_active }};
    --xtu-bl-card-bg: {{ card_background }};
    --xtu-bl-border: {{ border_color }};
    --xtu-bl-placeholder: {{ placeholder_bg }};
    --xtu-bl-content-width: {{ content_width }}px;
    --xtu-bl-padding-top: {{ padding_top }}px;
    --xtu-bl-padding-bottom: {{ padding_bottom }}px;
    --xtu-bl-padding-top-mobile: {{ padding_top_mobile }}px;
    --xtu-bl-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --xtu-bl-gap: {{ gap }}px;
    --xtu-bl-gap-mobile: {{ gap_mobile }}px;
    {% unless ratio_auto %}--xtu-bl-ratio: {{ card_ratio }};{% endunless %}
  "
>
  <div class="xtu-blog-list__inner xtu-blog-list__inner--head">
    {% if heading != blank %}
      <h1 class="xtu-blog-list__heading" data-xtu-blog-heading>
        {{ heading | escape }}
      </h1>
    {% endif %}
  </div>

  {% if show_blog_tabs and blog_tab_count > 0 %}
    <div class="xtu-blog-list__tabs-bar" data-xtu-blog-tabs>
      <div class="xtu-blog-list__tabs-inner">
        <ul class="xtu-blog-list__tabs" role="list">
          {% for block in section.blocks %}
            {% if block.type == 'blog_category' and block.settings.blog != blank %}
              {% liquid
                assign tab_blog = block.settings.blog
                assign tab_label = block.settings.label
                if tab_label == blank
                  assign tab_label = tab_blog.title
                endif
                assign tab_is_active = false
                if tab_blog.handle == blog.handle
                  assign tab_is_active = true
                endif
              %}
              <li {{ block.shopify_attributes }}>
                <a
                  class="xtu-blog-list__tab{% if tab_is_active %} is-active{% endif %}"
                  href="{{ tab_blog.url }}"
                  data-xtu-blog-tab
                  {% if tab_is_active %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ tab_label | escape }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  {% endif %}

  <div class="xtu-blog-list__inner">
    <div class="xtu-blog-list__content">
      {% if show_tag_filter and blog.all_tags.size > 0 %}
        <div class="xtu-blog-list__filter" data-xtu-blog-filter>
          <label class="xtu-blog-list__filter-label" for="xtu-blog-tag-select-{{ section.id }}">
            {{ section.settings.tag_filter_heading | default: 'Filter by tag' | escape }}
          </label>
          <div class="xtu-blog-list__select-wrap">
            <select
              id="xtu-blog-tag-select-{{ section.id }}"
              class="xtu-blog-list__tag-select"
              data-xtu-blog-tag-select
              aria-label="{{ section.settings.tag_filter_heading | default: 'Filter by tag' | escape }}"
            >
              <option value="{{ blog.url }}"{% if active_tag == blank %} selected{% endif %}>
                {{ tag_filter_label | escape }}
              </option>
              {% for tag in blog.all_tags %}
                <option
                  value="{{ blog.url }}/tagged/{{ tag | handle }}"
                  {% if active_tag == tag %}
                    selected
                  {% endif %}
                >
                  {{ tag | escape }}
                </option>
              {% endfor %}
            </select>
            <span class="xtu-blog-list__select-icon" aria-hidden="true">
              <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </div>
      {% endif %}

      <div class="xtu-blog-list__panel" data-xtu-blog-panel>
      {% paginate blog.articles by articles_per_page %}
        {% if blog.articles.size > 0 %}
          <div class="xtu-blog-list__grid" data-xtu-blog-grid>
            {% for article in blog.articles %}
              <div class="xtu-blog-list__item">
                {% render 'xtu-blog-card',
                  article: article,
                  button_label: button_label,
                  show_button_arrow: show_button_arrow,
                  show_author: show_author,
                  date_format: date_format,
                  button_bg: button_bg,
                  button_color: button_color,
                  button_bg_hover: button_bg_hover,
                  button_color_hover: button_color_hover
                %}
              </div>
            {% endfor %}
          </div>
        {% else %}
          <p class="xtu-blog-list__empty">{{ section.settings.empty_text | default: 'No articles found.' | escape }}</p>
        {% endif %}

        {% if paginate.pages > 1 %}
          <div class="xtu-blog-list__pagination" data-xtu-blog-pagination>
            {% render 'pagination-controls', paginate: paginate %}
          </div>
        {% endif %}
      {% endpaginate %}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'xtu-blog-list.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "XTU Blog List",
  "tag": "section",
  "class": "xtu-blog-list-section",
  "enabled_on": {
    "templates": ["blog"]
  },
  "blocks": [
    {
      "type": "blog_category",
      "name": "Blog 分类",
      "settings": [
        {
          "type": "blog",
          "id": "blog",
          "label": "Blog"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tab 文案",
          "info": "留空则使用 Blog 名称"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "标题"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "大标题",
      "info": "留空则使用当前 Blog 名称"
    },
    {
      "type": "header",
      "content": "Blog 分类 Tab"
    },
    {
      "type": "checkbox",
      "id": "show_blog_tabs",
      "label": "显示 Blog 分类 Tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Tag 筛选"
    },
    {
      "type": "checkbox",
      "id": "show_tag_filter",
      "label": "显示 Tag 下拉筛选",
      "default": true
    },
    {
      "type": "text",
      "id": "tag_filter_heading",
      "label": "筛选标题",
      "default": "Filter by tag"
    },
    {
      "type": "text",
      "id": "tag_filter_label",
      "label": "「全部 Tag」选项文案",
      "default": "All tags"
    },
    {
      "type": "header",
      "content": "文章列表"
    },
    {
      "type": "range",
      "id": "articles_per_page_desktop",
      "label": "PC 每页文章数",
      "info": "Shopify 分页仅支持单一每页数量，取 PC 与移动端较大值。建议两端设为相同值（如 PC 9 / 移动 8 时按 9 分页，移动端为 2 列布局）",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "range",
      "id": "articles_per_page_mobile",
      "label": "移动端每页文章数",
      "info": "默认 2 列 × 4 行 = 8",
      "min": 2,
      "max": 16,
      "step": 2,
      "default": 8
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "卡片图片比例",
      "options": [
        { "value": "auto", "label": "自适应（按图片/视频比例）" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "16 / 9", "label": "16:9" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "卡片间距（PC）",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "卡片间距（移动端）",
      "min": 4,
      "max": 24,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "text",
      "id": "date_format",
      "label": "日期格式",
      "default": "%B %d, %Y",
      "info": "Liquid 日期格式，如 %B %d, %Y"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "显示作者",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "无文章提示",
      "default": "No articles found."
    },
    {
      "type": "header",
      "content": "Read More 按钮"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文案",
      "default": "Read More"
    },
    {
      "type": "checkbox",
      "id": "show_button_arrow",
      "label": "显示箭头",
      "default": false
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "按钮背景色",
      "default": "#1590F2"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "按钮文字色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_bg_hover",
      "label": "按钮 Hover 背景色",
      "default": "#0070CA"
    },
    {
      "type": "color",
      "id": "button_color_hover",
      "label": "按钮 Hover 文字色",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "版块样式"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "版块背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "内容区背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题颜色",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "正文颜色",
      "default": "#4B5563"
    },
    {
      "type": "color",
      "id": "muted_text_color",
