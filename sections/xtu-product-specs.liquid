            "label": "Channels",
            "value": "3-Channel (Front + Cabin + Rear)"
          }
        },
        {
          "type": "spec",
          "settings": {
            "label": "Sensor",
            "value": "Sony STARVIS 2 IMX678 (Front)"
          }
        },
        {
          "type": "spec",
          "settings": {
            "label": "Video Resolution",
            "value": "4K Front + 1080P Cabin + 1080P Rear"
          }
        },
        {
          "type": "spec",
          "settings": {
            "label": "Field of View",
            "value": "170° Front / 160° Cabin / 140° Rear"
          }
        },
        {
          "type": "spec",
          "settings": {
            "label": "GPS Tracking",
            "value": "Built-in GPS"
          }
        },
        {
          "type": "spec",
          "settings": {
            "label": "Storage",
            "value": "MicroSD up to 512GB"
          }
        },
        {
          "type": "spec",
          "settings": {
            "label": "Connectivity",
            "value": "Wi-Fi / App Control"
          }
        }
      ]
    }
  ]
}
{% endschema %}
