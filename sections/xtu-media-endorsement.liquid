{% liquid
  assign mode = section.settings.mode | default: 'quote'
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
%}

<script src="{{ 'xtu-media-endorsement.js' | asset_url }}" defer="defer"></script>

<section
  id="xtu-media-endorsement-{{ section.id }}"
  class="xtu-media-endorsement xtu-media-endorsement--{{ mode }}"
  data-xtu-media-endorsement
  data-mode="{{ mode }}"
  style="
    --xtu-me-pt: {{ padding_top }}px;
    --xtu-me-pb: {{ padding_bottom }}px;
    --xtu-me-pt-m: {{ padding_top_mobile }}px;
    --xtu-me-pb-m: {{ padding_bottom_mobile }}px;
  "
>
  <div class="xtu-media-endorsement__container">
    {% if heading != blank or subheading != blank or section.blocks.size > 1 %}
      <div class="xtu-media-endorsement__header" data-xtu-reveal="fade-up">
        <div class="xtu-media-endorsement__titles">
          {% if heading != blank %}
            <h2 class="xtu-media-endorsement__heading">{{ heading | escape }}</h2>
          {% endif %}
          {% if subheading != blank %}
            <p class="xtu-media-endorsement__subheading">{{ subheading | escape }}</p>
          {% endif %}
        </div>

        {% if section.blocks.size > 1 %}
          <div class="xtu-swiper-nav-group xtu-swiper-nav-group--hide-mobile">
            {% render 'xtu-swiper-nav',
              variant: 'on-light',
              prev_attributes: 'data-xtu-me-prev',
              next_attributes: 'data-xtu-me-next'
            %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% comment %} Logo Tab bar (article mode) {% endcomment %}
    {% if mode == 'article' and section.blocks.size > 0 %}
      <div class="xtu-media-endorsement__tabs" role="tablist">
        {% for block in section.blocks %}
          {% if block.settings.logo != blank %}
            <button
              type="button"
              class="xtu-media-endorsement__tab{% if forloop.first %} is-active{% endif %}"
              data-xtu-me-tab
              role="tab"
              aria-selected="{{ forloop.first }}"
            >
              {{
                block.settings.logo
                | image_url: height: 40
                | image_tag:
                  class: 'xtu-media-endorsement__tab-logo',
                  loading: 'lazy',
                  alt: block.settings.title
              }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="xtu-media-endorsement__viewport">
      <div class="swiper xtu-media-endorsement__swiper" data-xtu-me-swiper>
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide xtu-media-endorsement__slide" {{ block.shopify_attributes }}>
              {% if mode == 'quote' %}
                {% comment %} ===== Quote card ===== {% endcomment %}
                {% if block.settings.link != blank %}
                  <a
                    href="{{ block.settings.link }}"
                    class="xtu-media-endorsement__quote-card xtu-media-endorsement__quote-card--linked"
                  >
                {% else %}
                  <div class="xtu-media-endorsement__quote-card">
                {% endif %}
                  {% if block.settings.logo != blank %}
                    <div class="xtu-media-endorsement__card-logo">
                      {{
                        block.settings.logo
                        | image_url: height: 48
                        | image_tag:
                          class: 'xtu-media-endorsement__logo-img',
                          loading: 'lazy',
                          alt: block.settings.title
                      }}
                    </div>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="xtu-media-endorsement__card-text">
                      {{ block.settings.description }}
                    </p>
                  {% endif %}
                {% if block.settings.link != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}

              {% else %}
                {% comment %} ===== Article card ===== {% endcomment %}
                {% if block.settings.link != blank %}
                  <a
                    href="{{ block.settings.link }}"
                    class="xtu-media-endorsement__article-card xtu-media-endorsement__article-card--linked"
                  >
                {% else %}
                  <div class="xtu-media-endorsement__article-card">
                {% endif %}
                  <div class="xtu-media-endorsement__article-text">
                    {% if block.settings.logo != blank %}
                      <div class="xtu-media-endorsement__card-logo xtu-media-endorsement__card-logo--article">
                        {{
                          block.settings.logo
                          | image_url: height: 32
                          | image_tag:
                            class: 'xtu-media-endorsement__logo-img',
                            loading: 'lazy',
                            alt: block.settings.title
                        }}
                      </div>
                    {% endif %}
                    {% if block.settings.title != blank %}
                      <h3 class="xtu-media-endorsement__article-title">
                        {{ block.settings.title | escape }}
                      </h3>
                    {% endif %}
                    {% if block.settings.description != blank %}
                      <p class="xtu-media-endorsement__article-desc">
                        {{ block.settings.description }}
                      </p>
                    {% endif %}
                    {% if block.settings.link != blank %}
                      <span class="xtu-media-endorsement__article-link">Read more →</span>
                    {% endif %}
                  </div>
                  {% if block.settings.image != blank %}
                    <div class="xtu-media-endorsement__article-image">
                      {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                          class: 'xtu-media-endorsement__article-img',
                          loading: 'lazy',
                          widths: '400, 600, 800',
                          sizes: '(max-width: 749px) 100vw, 50vw',
                          alt: block.settings.title
                      }}
                    </div>
                  {% endif %}
                {% if block.settings.link != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .xtu-media-endorsement {
    padding: var(--xtu-me-pt) 0 var(--xtu-me-pb);
  }

  .xtu-media-endorsement__container {
    width: min(var(--page-content-width), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
  }

  .xtu-media-endorsement__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: var(--xtu-space-40, 40px);
  }

  .xtu-media-endorsement__titles {
    flex: 1;
    min-width: 0;
    text-align: left;
  }

  .xtu-media-endorsement__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground);
  }

  .xtu-media-endorsement__subheading {
    margin: 12px 0 0;
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-body, 0.875rem);
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-1);
    max-width: 48rem;
  }

  .xtu-media-endorsement__header .xtu-swiper-nav-group {
    flex-shrink: 0;
    align-self: center;
  }

  /* ---- Tabs (article mode) ---- */
  .xtu-media-endorsement__tabs {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    margin-bottom: 32px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-2);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .xtu-media-endorsement__tabs::-webkit-scrollbar {
    display: none;
  }

  .xtu-media-endorsement__tab {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 8px 4px;
    border: 0;
    background: none;
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 0.25s ease;
    appearance: none;
  }

  .xtu-media-endorsement__tab.is-active,
  .xtu-media-endorsement__tab:hover {
    opacity: 1;
  }

  .xtu-media-endorsement__tab.is-active::after {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-foreground);
    border-radius: 1px;
  }

  .xtu-media-endorsement__tab-logo {
    display: block;
    height: 28px;
    width: auto;
    object-fit: contain;
  }

  /* ---- Viewport ---- */
  .xtu-media-endorsement__viewport {
    position: relative;
    overflow: hidden;
  }

  /* ---- Quote card ---- */
  .xtu-media-endorsement__quote-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 24px 16px;
    height: 100%;
  }

  .xtu-media-endorsement__card-logo {
    margin-bottom: 20px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .xtu-media-endorsement__logo-img {
    display: block;
    height: 100%;
    width: auto;
    object-fit: contain;
  }

  .xtu-media-endorsement__card-text {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-body, 0.875rem);
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-1);
  }

  /* ---- Article card ---- */
  .xtu-media-endorsement__article-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
    background: var(--color-4);
    border-radius: 16px;
    overflow: hidden;
    min-height: 320px;
  }

  .xtu-media-endorsement__article-text {
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .xtu-media-endorsement__card-logo--article {
    height: 24px;
    margin-bottom: 0;
  }

  .xtu-media-endorsement__article-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground);
  }

  .xtu-media-endorsement__article-desc {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-body, 0.875rem);
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-1);
  }

  .xtu-media-endorsement__quote-card--linked,
  .xtu-media-endorsement__article-card--linked {
    display: flex;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  .xtu-media-endorsement__article-card--linked {
    display: grid;
  }

  .xtu-media-endorsement__quote-card--linked:hover,
  .xtu-media-endorsement__article-card--linked:hover {
    opacity: 0.88;
  }

  .xtu-media-endorsement__article-link {
    display: inline-block;
    font-size: var(--xtu-type-body, 0.875rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-5);
    text-decoration: none;
  }

  .xtu-media-endorsement__article-image {
    position: relative;
    height: 100%;
    min-height: 280px;
  }

  .xtu-media-endorsement__article-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---- Mobile ---- */
  @media screen and (max-width: 749px) {
    .xtu-media-endorsement {
      padding: var(--xtu-me-pt-m) 0 var(--xtu-me-pb-m);
      overflow: hidden;
    }

    .xtu-media-endorsement__header {
      margin-bottom: var(--xtu-space-20, 20px);
    }

    .xtu-media-endorsement__viewport {
      margin-inline: calc(var(--page-margin) * -1);
      padding-inline: var(--page-margin);
    }

    .xtu-media-endorsement__swiper {
      overflow: visible;
    }

    .xtu-media-endorsement__tabs {
      justify-content: flex-start;
      gap: 24px;
      margin-bottom: 24px;
    }

    .xtu-media-endorsement__article-card {
      grid-template-columns: 1fr;
      min-height: auto;
      border-radius: 12px;
    }

    .xtu-media-endorsement__article-text {
      padding: 24px;
      order: 2;
    }

    .xtu-media-endorsement__article-image {
      min-height: 200px;
      order: 1;
    }

    .xtu-media-endorsement__quote-card {
      padding: 16px 12px;
    }

    .xtu-media-endorsement__card-logo {
      height: 36px;
      margin-bottom: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU Media Endorsement",
  "tag": "section",
  "class": "xtu-media-endorsement-section",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "布局模式",
      "options": [
        { "value": "quote", "label": "纯引用（Logo + 文案）" },
        { "value": "article", "label": "图文（Logo Tab + 图文卡）" }
      ],
      "default": "quote"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "As Seen On"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "副标题",
      "default": "Trusted by leading tech and automotive media worldwide."
    },
    {
      "type": "header",
      "content": "上下边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "media_card",
      "name": "媒体卡片",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "媒体 Logo"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题 / 媒体名称",
          "info": "图文模式下显示为文章标题"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "引用文案 / 描述"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "配图",
          "info": "仅图文模式下显示"
        },
        {
          "type": "url",
          "id": "link",
          "label": "卡片链接",
          "info": "填写后整卡可点击跳转（引用 / 图文模式均生效）"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "XTU Media Endorsement",
      "settings": {
        "mode": "quote",
        "heading": "As Seen On",
        "subheading": "Trusted by leading tech and automotive media worldwide."
      },
      "blocks": [
        {
          "type": "media_card",
          "settings": {
            "title": "Tom's Guide",
            "description": "Impressively, it does what it promises to, eliminating blind spots in its coverage."
          }
        },
        {
          "type": "media_card",
          "settings": {
            "title": "Forbes",
            "description": "A really clever way of enhancing the image to ensure you can read number plates."
          }
        },
        {
          "type": "media_card",
          "settings": {
            "title": "CNET",
            "description": "Sits in the Goldilocks zone with all of the core features I need in a dash cam."
          }
        },
        {
          "type": "media_card",
          "settings": {
            "title": "TechRadar",
            "description": "Captures clear, comprehensive video constantly and consistently."
          }
        }
      ]
    }
  ]
}
{% endschema %}
