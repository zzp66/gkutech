{%- comment -%}
  XTU Help Firmware — Help Center 固件下载。

  数据来源
  - 产品目录：metaobjects.xtu_help_product（code = URL ?s=）
  - 固件：metaobjects.xtu_help_firmware（一条 = 某产品一个版本）
  运营：内容 → Metaobjects 维护；本 section 只调标题、宽度、边距。
  前台：左产品列表，右版本卡（Latest 标记 + 更新说明 + Download）；JS 用 ?s= 切换。

  相关：snippets/xtu-help-shell.liquid、assets/xtu-help.css、assets/xtu-help.js
{%- endcomment -%}

{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign content_background = section.settings.content_background | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#000000'
  assign muted_text_color = section.settings.muted_text_color | default: '#8E9297'
  assign text_color = section.settings.text_color | default: '#333333'
  assign content_width = section.settings.content_width | default: 1200 | at_least: 600 | at_most: 1600
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign empty_text = section.settings.empty_text | default: 'No firmware for this product yet.'
%}

{{ 'xtu-help.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xtu-help.js' | asset_url }}" defer="defer"></script>

{% capture catalog_json %}
{
  "type": "firmware",
  "emptyText": {{ empty_text | json }},
  "products": [{% render 'xtu-help-products-json' %}],
  "items": [
    {% paginate metaobjects.xtu_help_firmware.values by 250 %}
      {% assign first_item = true %}
      {% for entry in metaobjects.xtu_help_firmware.values %}
        {% liquid
          assign product_code = entry.product_code.value | default: entry.product_code | strip | downcase | handleize
          assign version = entry.version.value | default: entry.version | strip
          assign released_at = entry.released_at.value | default: entry.released_at | strip
          assign notes_html = blank
          if entry.notes.value != blank
            assign notes_html = entry.notes | metafield_tag
          endif
          assign file_obj = entry.file.value | default: entry.file
          assign file_url = blank
          if file_obj != blank and file_obj.url != blank
            assign file_url = file_obj.url
          endif
          assign link_url = file_url | default: entry.url.value | default: entry.url
          assign latest = false
          if entry.is_latest.value == true
            assign latest = true
          endif
          assign v_sort = entry.sort_order.value | default: entry.sort_order | default: 0
        %}
        {% if product_code != blank and version != blank %}
          {% unless first_item %},{% endunless %}
          {% assign first_item = false %}
          {
            "productCode": {{ product_code | json }},
            "version": {{ version | json }},
            "releasedAt": {{ released_at | json }},
            "notes": {{ notes_html | json }},
            "url": {{ link_url | json }},
            "latest": {{ latest | json }},
            "sort": {{ v_sort | json }}
          }
        {% endif %}
      {% endfor %}
    {% endpaginate %}
  ]
}
{% endcapture %}

<section
  id="xtu-help-firmware-{{ section.id }}"
  class="xtu-help"
  data-xtu-help
  style="
    --xtu-help-bg: {{ background_color }};
    --xtu-help-content-bg: {{ content_background }};
    --xtu-help-content-width: {{ content_width }}px;
    --xtu-help-pt: {{ padding_top }}px;
    --xtu-help-pb: {{ padding_bottom }}px;
    --xtu-help-pt-m: {{ padding_top_mobile }}px;
    --xtu-help-pb-m: {{ padding_bottom_mobile }}px;
    --xtu-help-heading: {{ heading_color }};
    --xtu-help-muted: {{ muted_text_color }};
    --xtu-help-text: {{ text_color }};
  "
>
  <div class="xtu-help__inner">
    {% render 'xtu-help-shell',
      heading: heading,
      subheading: subheading,
      catalog_json: catalog_json,
      empty_text: empty_text,
      sidebar_label: section.settings.sidebar_label
    %}
  </div>
</section>

{% schema %}
{
  "name": "XTU Help Firmware",
  "tag": "section",
  "class": "section-xtu-help-firmware",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "大标题", "default": "Firmware" },
    { "type": "textarea", "id": "subheading", "label": "副标题", "default": "Download the latest firmware for your camera." },
    { "type": "text", "id": "sidebar_label", "label": "侧栏标题", "default": "Products" },
    { "type": "text", "id": "empty_text", "label": "空态文案", "default": "No firmware for this product yet." },
    { "type": "header", "content": "外观" },
    { "type": "color", "id": "background_color", "label": "版块背景色", "default": "#FFFFFF" },
    { "type": "color", "id": "content_background", "label": "内容区背景色", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "标题色", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "正文色", "default": "#333333" },
    { "type": "color", "id": "muted_text_color", "label": "次要文字色", "default": "#8E9297" },
    { "type": "number", "id": "content_width", "label": "内容区最大宽度（px）", "default": 1200, "info": "范围 600–1600。" },
    { "type": "header", "content": "边距" },
    { "type": "range", "id": "padding_top", "label": "上边距（PC）", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "下边距（PC）", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "上边距（移动端）", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "下边距（移动端）", "min": 0, "max": 140, "step": 2, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "XTU Help Firmware" }]
}
{% endschema %}
