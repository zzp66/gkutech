{%- comment -%}
  XTU Feature Slider — 大标题 + 副标题 + 图文滑动卡片。

  数据来源
  - 标题/副标题、版心、边距、卡片圆角、图片宽度：section 设置。
  - 每一屏：block「幻灯」——PC 布局（左图右文 / 左文右图）、块标题、说明、媒体类型（图片 / 上传视频 / YouTube）。
  - 图片空资源用 placeholder_svg_tag；YouTube 无封面时用官方缩略图。

  运营配置
  1. Theme Editor 添加「XTU Feature Slider」。
  2. 填写大标题、副标题；按需增删幻灯 block。
  3. 每个 block 可单独选「左图右文」或「左文右图」。
  4. 「显示左右箭头」控制 PC；「移动端显示左右箭头」单独开关。
  5. 「图片宽度（PC）」控制媒体占比；高度跟图片本身走。
  6. 媒体：图片直接展示；上传视频仅当前屏静音循环；YouTube 点封面后加载播放器。

  前台
  - 标题居左、箭头居右，同一行水平对齐（xtu-swiper-nav on-light）。
  - PC / 移动端箭头分开配置；移动端关闭时隐藏整组，可滑动或点底部分页。
  - PC：按 block 布局左图右文或左文右图；媒体宽度可配，高度随图片自适应，文案垂直居中。
  - Swiper 单卡左右滑；移动端上图下文，各屏卡片高度对齐为最高那张，避免参差。
  - 底部分页为短横线。

  相关：assets/xtu-feature-slider.js、snippets/xtu-swiper-nav.liquid
{%- endcomment -%}

{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign content_background = section.settings.content_background | default: '#FFFFFF'
  assign card_background = section.settings.card_background | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#333333'
  assign muted_text_color = section.settings.muted_text_color | default: '#8E9297'
  assign content_width = section.settings.content_width | default: 1200 | at_least: 600 | at_most: 1600
  assign card_radius = section.settings.card_radius | default: 16
  assign media_width = section.settings.media_width | default: 60 | at_least: 40 | at_most: 70
  assign media_ratio = section.settings.media_ratio | default: 'auto'
  assign ratio_auto = true
  if media_ratio != 'auto'
    assign ratio_auto = false
  endif
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign show_arrows = section.settings.show_arrows
  assign show_arrows_mobile = section.settings.show_arrows_mobile
  assign slide_count = 0
  for block in section.blocks
    if block.type == 'slide'
      assign slide_count = slide_count | plus: 1
    endif
  endfor
  assign show_header_nav = false
  assign hide_arrows_mobile = true
  if show_arrows and slide_count > 1
    assign show_header_nav = true
  endif
  if show_arrows_mobile
    assign hide_arrows_mobile = false
  endif
%}

<script src="{{ 'xtu-feature-slider.js' | asset_url }}" defer="defer"></script>

<section
  id="xtu-feature-slider-{{ section.id }}"
  class="xtu-fsl{% if show_header_nav %} xtu-fsl--has-nav{% endif %}{% if ratio_auto %} xtu-fsl--ratio-auto{% endif %}"
  data-xtu-feature-slider
  style="
    --xtu-fsl-bg: {{ background_color }};
    --xtu-fsl-content-bg: {{ content_background }};
    --xtu-fsl-card-bg: {{ card_background }};
    --xtu-fsl-heading: {{ heading_color }};
    --xtu-fsl-text: {{ text_color }};
    --xtu-fsl-muted: {{ muted_text_color }};
    --xtu-fsl-content-width: {{ content_width }}px;
    --xtu-fsl-radius: {{ card_radius }}px;
    --xtu-fsl-media-width: {{ media_width }}%;
    {% unless ratio_auto %}--xtu-fsl-ratio: {{ media_ratio }};{% endunless %}
    --xtu-fsl-pt: {{ padding_top }}px;
    --xtu-fsl-pb: {{ padding_bottom }}px;
    --xtu-fsl-pt-m: {{ padding_top_mobile }}px;
    --xtu-fsl-pb-m: {{ padding_bottom_mobile }}px;
  "
>
  <div class="xtu-fsl__inner">
    {% if heading != blank or subheading != blank or show_header_nav %}
      <div class="xtu-fsl__header" data-xtu-reveal="fade-up" data-xtu-stagger>
        <div class="xtu-fsl__header-row">
          {% if heading != blank %}
            <h2 class="xtu-fsl__heading" data-xtu-reveal-child>{{ heading | escape }}</h2>
          {% endif %}
          {% if show_header_nav %}
            <div class="xtu-swiper-nav-group{% unless show_arrows_mobile %} xtu-swiper-nav-group--hide-mobile{% endunless %}">
              {% render 'xtu-swiper-nav',
                variant: 'on-light',
                hide_mobile: hide_arrows_mobile,
                prev_attributes: 'data-xtu-fsl-prev',
                next_attributes: 'data-xtu-fsl-next'
              %}
            </div>
          {% endif %}
        </div>
        {% if subheading != blank %}
          <p class="xtu-fsl__subheading" data-xtu-reveal-child>{{ subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if slide_count > 0 %}
      <div class="xtu-fsl__stage" data-xtu-reveal="fade-up">
        <div class="swiper xtu-fsl__swiper" data-xtu-fsl-swiper>
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% if block.type == 'slide' %}
                {% liquid
                  assign desktop_layout = block.settings.desktop_layout | default: 'image-left'
                  assign slide_title = block.settings.title
                  assign slide_body = block.settings.body
                  assign media_type = block.settings.media_type | default: 'image'
                  assign image = block.settings.image
                  assign image_mobile = block.settings.image_mobile
                  assign video = block.settings.video
                  assign video_mobile = block.settings.video_mobile
                  assign youtube_url = block.settings.youtube_url | strip
                  assign cover = block.settings.cover
                  assign has_mobile_image = false
                  if image_mobile != blank
                    assign has_mobile_image = true
                  endif
                  assign has_mobile_video = false
                  if video_mobile != blank
                    assign has_mobile_video = true
                  endif
                  assign alt_text = slide_title | default: heading | default: 'Feature'
                  assign ph_mod = forloop.index0 | modulo: 3
                  assign placeholder_name = 'lifestyle-1'
                  if ph_mod == 1
                    assign placeholder_name = 'lifestyle-2'
                  elsif ph_mod == 2
                    assign placeholder_name = 'image'
                  endif
                  assign youtube_thumb = blank
                  if youtube_url != blank
                    if youtube_url contains 'youtu.be/'
                      assign youtube_id = youtube_url | split: 'youtu.be/' | last | split: '?' | first | split: '/' | first
                    elsif youtube_url contains 'youtube.com/shorts/'
                      assign youtube_id = youtube_url | split: 'shorts/' | last | split: '?' | first | split: '/' | first
                    elsif youtube_url contains 'youtube.com/embed/'
                      assign youtube_id = youtube_url | split: 'embed/' | last | split: '?' | first | split: '/' | first
                    elsif youtube_url contains 'v='
                      assign youtube_id = youtube_url | split: 'v=' | last | split: '&' | first
                    else
                      assign youtube_id = blank
                    endif
                    if youtube_id != blank
                      assign youtube_thumb = 'https://i.ytimg.com/vi/' | append: youtube_id | append: '/hqdefault.jpg'
                    endif
                  endif
                %}
                <article
                  class="swiper-slide xtu-fsl__slide"
                  data-media-type="{{ media_type | escape }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="xtu-fsl__card xtu-fsl__card--{{ desktop_layout }}">
                    <div class="xtu-fsl__copy">
                      {% if slide_title != blank %}
                        <h3 class="xtu-fsl__title">{{ slide_title | escape }}</h3>
                      {% endif %}
                      {% if slide_body != blank %}
                        <div class="xtu-fsl__body rte">{{ slide_body }}</div>
                      {% endif %}
                    </div>

                    <div
                      class="xtu-fsl__media{% if media_type == 'image' and has_mobile_image %} xtu-fsl__media--split{% endif %}{% if media_type == 'video' and has_mobile_video %} xtu-fsl__media--split{% endif %}"
                      data-xtu-fsl-stage
                    >
                      {% if media_type == 'youtube' and youtube_url != blank %}
                        <button
                          type="button"
                          class="xtu-fsl__yt-cover"
                          data-xtu-fsl-yt-cover
                          data-youtube-url="{{ youtube_url | escape }}"
                          aria-label="Play {{ alt_text | escape }}"
                        >
                          {% if cover != blank %}
                            {{
                              cover
                              | image_url: width: 1600
                              | image_tag:
                                class: 'xtu-fsl__image',
                                widths: '600, 800, 1000, 1200, 1600',
                                sizes: '(max-width: 749px) calc(100vw - 30px), min(720px, 55vw)',
                                loading: 'lazy',
                                alt: alt_text
                            }}
                          {% elsif youtube_thumb != blank %}
                            <img
                              class="xtu-fsl__image"
                              src="{{ youtube_thumb | escape }}"
                              alt="{{ alt_text | escape }}"
                              loading="lazy"
                              decoding="async"
                              width="1280"
                              height="720"
                            >
                          {% else %}
                            {{ placeholder_name | placeholder_svg_tag: 'xtu-fsl__image xtu-fsl__placeholder' }}
                          {% endif %}
                          <span class="xtu-fsl__play" aria-hidden="true">
                            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <circle cx="24" cy="24" r="24" fill="rgb(0 0 0 / 0.55)"/>
                              <path d="M20 16.5v15l12-7.5-12-7.5Z" fill="#fff"/>
                            </svg>
                          </span>
                        </button>
                      {% elsif media_type == 'video' %}
                        {% if video != blank %}
                          {{
                            video
                            | video_tag:
                              class: 'xtu-fsl__video xtu-fsl__video--desktop',
                              image_size: '1600x',
                              autoplay: false,
                              loop: true,
                              muted: true,
                              controls: false,
                              playsinline: true,
                              preload: 'metadata'
                          }}
                        {% endif %}
                        {% if has_mobile_video %}
                          {{
                            video_mobile
                            | video_tag:
                              class: 'xtu-fsl__video xtu-fsl__video--mobile',
                              image_size: '1200x',
                              autoplay: false,
                              loop: true,
                              muted: true,
                              controls: false,
                              playsinline: true,
                              preload: 'metadata'
                          }}
                        {% endif %}
                        {% if video == blank and has_mobile_video == false %}
                          {{ placeholder_name | placeholder_svg_tag: 'xtu-fsl__image xtu-fsl__placeholder' }}
                        {% elsif video == blank and has_mobile_video %}
                          {{ placeholder_name | placeholder_svg_tag: 'xtu-fsl__image xtu-fsl__image--desktop xtu-fsl__placeholder' }}
                        {% endif %}
                      {% else %}
                        {% if image != blank %}
                          {{
                            image
                            | image_url: width: 1600
                            | image_tag:
                              class: 'xtu-fsl__image xtu-fsl__image--desktop',
                              widths: '600, 800, 1000, 1200, 1600',
                              sizes: '(max-width: 749px) calc(100vw - 30px), min(720px, 55vw)',
                              loading: 'lazy',
                              alt: alt_text
                          }}
                        {% else %}
                          {{ placeholder_name | placeholder_svg_tag: 'xtu-fsl__image xtu-fsl__image--desktop xtu-fsl__placeholder' }}
                        {% endif %}
                        {% if has_mobile_image %}
                          {{
                            image_mobile
                            | image_url: width: 1200
                            | image_tag:
                              class: 'xtu-fsl__image xtu-fsl__image--mobile',
                              widths: '400, 600, 800, 1000, 1200',
                              sizes: 'calc(100vw - 30px)',
                              loading: 'lazy',
                              alt: alt_text
                          }}
                        {% endif %}
                      {% endif %}
                    </div>
                  </div>
                </article>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>

      {% if slide_count > 1 %}
        <div class="xtu-fsl__pager" data-xtu-fsl-pager></div>
      {% endif %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .xtu-fsl {
    padding: var(--xtu-fsl-pt, 80px) 0 var(--xtu-fsl-pb, 80px);
    background: var(--xtu-fsl-bg, #fff);
    box-sizing: border-box;
  }

  .xtu-fsl__inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: min(var(--xtu-fsl-content-width, 1200px), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
    background: var(--xtu-fsl-content-bg, #fff);
    box-sizing: border-box;
  }

  .xtu-fsl__header {
    width: 100%;
    margin-bottom: var(--xtu-space-40, 40px);
  }

  .xtu-fsl__header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--xtu-space-16, 16px);
    min-height: 45px;
  }

  .xtu-fsl__header-row .xtu-swiper-nav-group {
    margin-left: auto;
  }

  .xtu-fsl__heading {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-section-title);
    font-weight: 600;
    line-height: 1.2;
    text-align: left;
    color: var(--xtu-fsl-heading, #000);
  }

  .xtu-fsl__subheading {
    margin: var(--xtu-space-16, 16px) 0 0;
    max-width: 42rem;
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-section-subtitle);
    font-weight: 400;
    line-height: 1.2;
    text-align: left;
    color: var(--xtu-fsl-muted, #8e9297);
  }

  .xtu-fsl__stage {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .xtu-fsl .xtu-fsl__swiper.swiper {
    width: 100%;
    height: auto;
    overflow: hidden;
    border-radius: var(--xtu-fsl-radius, 16px);
  }

  .xtu-fsl .xtu-fsl__swiper .swiper-wrapper {
    display: flex;
    align-items: stretch;
    height: auto;
  }

  .xtu-fsl .xtu-fsl__swiper .swiper-slide {
    width: 100%;
    height: auto !important;
    box-sizing: border-box;
  }

  .xtu-fsl__card {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    background: var(--xtu-fsl-card-bg, #fff);
    overflow: hidden;
    border-radius: var(--xtu-fsl-radius, 16px);
  }

  .xtu-fsl__card--image-left {
    flex-direction: row-reverse;
  }

  .xtu-fsl__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    flex: 1 1 0;
    min-width: 0;
    padding: var(--xtu-space-48, 48px) var(--xtu-space-32, 32px) var(--xtu-space-48, 48px) var(--xtu-space-48, 48px);
  }

  .xtu-fsl__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-block-title);
    font-weight: 600;
    line-height: 1.2;
    color: var(--xtu-fsl-heading, #000);
  }

  .xtu-fsl__body {
    margin: var(--xtu-space-16, 16px) 0 0;
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-body);
    font-weight: 400;
    line-height: 1.2;
    color: var(--xtu-fsl-text, #333);
  }

  .xtu-fsl__body > *:first-child {
    margin-top: 0;
  }

  .xtu-fsl__body > *:last-child {
    margin-bottom: 0;
  }

  .xtu-fsl__body p {
    margin: 0 0 var(--xtu-space-12, 12px);
  }

  .xtu-fsl__media {
    position: relative;
    flex: 0 0 var(--xtu-fsl-media-width, 60%);
    width: var(--xtu-fsl-media-width, 60%);
    max-width: var(--xtu-fsl-media-width, 60%);
    min-width: 0;
    overflow: hidden;
    background: #e8eaed;
  }

  .xtu-fsl__image,
  .xtu-fsl__video,
  .xtu-fsl__placeholder,
  .xtu-fsl__media > video {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
  }

  .xtu-fsl__iframe {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }

  .xtu-fsl__placeholder {
    background: #e8eaed;
    aspect-ratio: 16 / 9;
  }

  .xtu-fsl:not(.xtu-fsl--ratio-auto) .xtu-fsl__media {
    aspect-ratio: var(--xtu-fsl-ratio, 16 / 9);
  }

  .xtu-fsl:not(.xtu-fsl--ratio-auto) .xtu-fsl__image,
  .xtu-fsl:not(.xtu-fsl--ratio-auto) .xtu-fsl__video,
  .xtu-fsl:not(.xtu-fsl--ratio-auto) .xtu-fsl__placeholder,
  .xtu-fsl:not(.xtu-fsl--ratio-auto) .xtu-fsl__media > video {
    height: 100%;
    object-fit: cover;
  }

  .xtu-fsl__image--mobile,
  .xtu-fsl__video--mobile {
    display: none;
  }

  .xtu-fsl__yt-cover {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: #111;
    cursor: pointer;
    appearance: none;
  }

  .xtu-fsl__yt-cover .xtu-fsl__image,
  .xtu-fsl__yt-cover .xtu-fsl__placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .xtu-fsl__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: 48px;
    height: 48px;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .xtu-fsl__play svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .xtu-fsl__media.is-playing .xtu-fsl__play {
    display: none;
  }

  .xtu-fsl__media.is-playing .xtu-fsl__yt-cover {
    pointer-events: none;
  }

  .xtu-fsl__pager {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--xtu-space-8, 8px);
    margin-top: var(--xtu-space-24, 24px);
  }

  .xtu-fsl__pager .xtu-fsl__bullet {
    display: block;
    width: 24px;
    height: 2px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: #d1d5db;
    opacity: 1;
    cursor: pointer;
    appearance: none;
    transition: background 0.2s ease;
  }

  .xtu-fsl__pager .xtu-fsl__bullet.is-active {
    background: #000;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .xtu-fsl__copy {
      padding: var(--xtu-space-32, 32px) var(--xtu-space-24, 24px);
    }

    .xtu-fsl__title {
      font-size: var(--xtu-type-group-title);
    }
  }

  @media screen and (max-width: 749px) {
    .xtu-fsl {
      padding: var(--xtu-fsl-pt-m, 40px) 0 var(--xtu-fsl-pb-m, 40px);
    }

    .xtu-fsl__header {
      margin-bottom: var(--xtu-space-20, 20px);
    }

    .xtu-fsl__heading {
      font-size: var(--xtu-type-section-title-m);
    }

    .xtu-fsl__subheading {
      margin-top: var(--xtu-space-12, 12px);
      font-size: var(--xtu-type-section-subtitle-m);
    }

    .xtu-fsl .xtu-fsl__swiper .swiper-slide {
      display: flex;
      height: auto !important;
      align-self: stretch;
    }

    .xtu-fsl__card,
    .xtu-fsl__card--image-left,
    .xtu-fsl__card--text-left {
      flex-direction: column;
      flex: 1 1 auto;
      width: 100%;
      height: 100%;
      min-height: 100%;
    }

    .xtu-fsl__media {
      order: -1;
      width: 100%;
      max-width: 100%;
      flex: 0 0 auto;
    }

    .xtu-fsl__copy {
      width: 100%;
      flex: 1 1 auto;
      padding: var(--xtu-space-24, 24px) var(--xtu-space-20, 20px) var(--xtu-space-28, 28px);
    }

    .xtu-fsl__title {
      font-size: var(--xtu-type-block-title-m);
    }

    .xtu-fsl__media--split .xtu-fsl__image--desktop,
    .xtu-fsl__media--split .xtu-fsl__video--desktop {
      display: none;
    }

    .xtu-fsl__media--split .xtu-fsl__image--mobile,
    .xtu-fsl__media--split .xtu-fsl__video--mobile {
      display: block;
    }

    .xtu-fsl__pager {
      margin-top: var(--xtu-space-20, 20px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU Feature Slider",
  "tag": "section",
  "class": "section-xtu-feature-slider",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "标题"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "大标题",
      "default": "Advanced Parking Mode"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "副标题"
    },
    {
      "type": "header",
      "content": "卡片"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "显示左右箭头",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "移动端显示左右箭头",
      "info": "关闭后移动端可滑动或点底部分页切换。",
      "default": false,
      "visible_if": "{{ section.settings.show_arrows == true }}"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "图片宽度（PC）",
