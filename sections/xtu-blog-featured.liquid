{% liquid
  assign heading = section.settings.heading
  assign latest_label = section.settings.latest_label
  assign button_label = section.settings.button_label | default: 'Read More'
  assign show_button_arrow = section.settings.show_button_arrow
  assign card_radius = section.settings.card_radius | default: 16
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign accent_color = section.settings.accent_color | default: '#0070CA'

  assign selected_count = 0
  for block in section.blocks
    if block.type == 'post' and block.settings.article != blank
      assign selected_count = selected_count | plus: 1
    endif
  endfor
%}

<script src="{{ 'xtu-blog-featured.js' | asset_url }}" defer="defer"></script>

<section
  id="xtu-blog-featured-{{ section.id }}"
  class="xtu-blog-featured"
  data-xtu-blog-featured
  style="
    --xtu-bf-radius: {{ card_radius }}px;
    --xtu-bf-accent: {{ accent_color }};
    --xtu-bf-padding-top: {{ padding_top }}px;
    --xtu-bf-padding-bottom: {{ padding_bottom }}px;
    --xtu-bf-padding-top-mobile: {{ padding_top_mobile }}px;
    --xtu-bf-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  "
>
  <div class="xtu-blog-featured__inner">
    {% if heading != blank %}
      <h2 class="xtu-blog-featured__heading" data-xtu-reveal="fade-up">
        {{ heading | escape }}
      </h2>
    {% endif %}

    {% comment %} Desktop: featured row (image + text) + 4 cards below {% endcomment %}
    <div class="xtu-blog-featured__desktop" data-xtu-reveal="fade-up" data-xtu-stagger>
      {% if selected_count > 0 %}
        {% assign featured_article = blank %}
        {% assign featured_block = blank %}
        {% for block in section.blocks %}
          {% if featured_article == blank and block.type == 'post' and block.settings.article != blank %}
            {% assign featured_article = block.settings.article %}
            {% assign featured_block = block %}
          {% endif %}
        {% endfor %}

        {% if featured_article != blank %}
          <article class="xtu-blog-featured__featured" data-xtu-reveal-child {{ featured_block.shopify_attributes }}>
            <a href="{{ featured_article.url }}" class="xtu-blog-featured__featured-media xtu-img-zoom">
              {% if featured_article.image != blank %}
                {{
                  featured_article.image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'xtu-blog-featured__featured-img xtu-img-zoom__media',
                    loading: 'lazy',
                    widths: '600, 800, 1000, 1200',
                    sizes: '(max-width: 989px) 100vw, 50vw',
                    alt: featured_article.title
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'xtu-blog-featured__featured-img xtu-img-zoom__media xtu-blog-featured__placeholder' }}
              {% endif %}
            </a>

            <div class="xtu-blog-featured__featured-body">
              <div class="xtu-blog-featured__featured-meta">
                {% if latest_label != blank %}
                  <span class="xtu-blog-featured__latest">{{ latest_label | escape }}</span>
                {% endif %}
                <time class="xtu-blog-featured__date" datetime="{{ featured_article.published_at | date: '%Y-%m-%d' }}">
                  {{ featured_article.published_at | date: '%d %b %Y' }}
                </time>
              </div>

              <h3 class="xtu-blog-featured__featured-title">
                <a href="{{ featured_article.url }}">{{ featured_article.title | escape }}</a>
              </h3>

              {% if featured_article.excerpt != blank or featured_article.content != blank %}
                <p class="xtu-blog-featured__excerpt">
                  {% if featured_article.excerpt != blank %}
                    {{ featured_article.excerpt | strip_html | truncate: 180 }}
                  {% else %}
                    {{ featured_article.content | strip_html | truncate: 180 }}
                  {% endif %}
                </p>
              {% endif %}

              {% if button_label != blank %}
                {% render 'xtu-btn',
                  label: button_label,
                  href: featured_article.url,
                  show_arrow: show_button_arrow,
                  bg: '#1590F2',
                  color: '#FFFFFF',
                  bg_hover: '#0070CA',
                  color_hover: '#FFFFFF',
                  class: 'xtu-blog-featured__btn'
                %}
              {% endif %}
            </div>
          </article>
        {% endif %}

        <div class="xtu-blog-featured__cards" data-xtu-reveal-child>
          {% assign list_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'post' and block.settings.article != blank %}
              {% assign list_index = list_index | plus: 1 %}
              {% if list_index > 1 and list_index <= 5 %}
                {% assign article = block.settings.article %}
                <article class="xtu-blog-featured__card" {{ block.shopify_attributes }}>
                  <a href="{{ article.url }}" class="xtu-blog-featured__card-media xtu-img-zoom">
                    {% if article.image != blank %}
                      {{
                        article.image
                        | image_url: width: 800
                        | image_tag:
                          class: 'xtu-blog-featured__card-img xtu-img-zoom__media',
                          loading: 'lazy',
                          widths: '300, 400, 600, 800',
                          sizes: '(max-width: 989px) 45vw, 22vw',
                          alt: article.title
                      }}
                    {% else %}
                      {{ 'image' | placeholder_svg_tag: 'xtu-blog-featured__card-img xtu-img-zoom__media xtu-blog-featured__placeholder' }}
                    {% endif %}
                  </a>

                  <div class="xtu-blog-featured__card-body">
                    <time class="xtu-blog-featured__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                      {{ article.published_at | date: '%d %b %Y' }}
                    </time>
                    <h3 class="xtu-blog-featured__card-title">
                      <a href="{{ article.url }}">{{ article.title | escape }}</a>
                    </h3>
                    {% if article.excerpt != blank or article.content != blank %}
                      <p class="xtu-blog-featured__card-excerpt">
                        {% if article.excerpt != blank %}
                          {{ article.excerpt | strip_html | truncate: 90 }}
                        {% else %}
                          {{ article.content | strip_html | truncate: 90 }}
                        {% endif %}
                      </p>
                    {% endif %}
                    {% if button_label != blank %}
                      {% render 'xtu-btn',
                        label: button_label,
                        href: article.url,
                        size: 'sm',
                        show_arrow: show_button_arrow,
                        bg: '#1590F2',
                        color: '#FFFFFF',
                        bg_hover: '#0070CA',
                        color_hover: '#FFFFFF',
                        class: 'xtu-blog-featured__btn'
                      %}
                    {% endif %}
                  </div>
                </article>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        <article class="xtu-blog-featured__featured" data-xtu-reveal-child>
          <div class="xtu-blog-featured__featured-media xtu-img-zoom">
            {{ 'image' | placeholder_svg_tag: 'xtu-blog-featured__featured-img xtu-img-zoom__media xtu-blog-featured__placeholder' }}
          </div>
          <div class="xtu-blog-featured__featured-body">
            <div class="xtu-blog-featured__featured-meta">
              {% if latest_label != blank %}
                <span class="xtu-blog-featured__latest">{{ latest_label | escape }}</span>
              {% endif %}
              <time class="xtu-blog-featured__date">08 May 2026</time>
            </div>
            <h3 class="xtu-blog-featured__featured-title">A329S 60fps Guide: When It Works</h3>
            <p class="xtu-blog-featured__excerpt">
              Learn when 60fps filming makes sense for action cameras and how to dial in the right settings…
            </p>
            {% if button_label != blank %}
              {% render 'xtu-btn',
                label: button_label,
                href: '#',
                show_arrow: show_button_arrow,
                bg: '#1590F2',
                color: '#FFFFFF',
                bg_hover: '#0070CA',
                color_hover: '#FFFFFF',
                class: 'xtu-blog-featured__btn'
              %}
            {% endif %}
          </div>
        </article>
        <div class="xtu-blog-featured__cards" data-xtu-reveal-child>
          {% for i in (1..4) %}
            <article class="xtu-blog-featured__card">
              <div class="xtu-blog-featured__card-media xtu-img-zoom">
                {{ 'image' | placeholder_svg_tag: 'xtu-blog-featured__card-img xtu-img-zoom__media xtu-blog-featured__placeholder' }}
              </div>
              <div class="xtu-blog-featured__card-body">
                <time class="xtu-blog-featured__date">08 May 2026</time>
                <h3 class="xtu-blog-featured__card-title">Sample blog post title {{ i }}</h3>
                <p class="xtu-blog-featured__card-excerpt">Short excerpt placeholder for card layout preview…</p>
                {% if button_label != blank %}
                  {% render 'xtu-btn',
                    label: button_label,
                    href: '#',
                    size: 'sm',
                    show_arrow: show_button_arrow,
                    bg: '#1590F2',
                    color: '#FFFFFF',
                    bg_hover: '#0070CA',
                    color_hover: '#FFFFFF',
                    class: 'xtu-blog-featured__btn'
                  %}
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% comment %} Mobile: Swiper 1.1 peek {% endcomment %}
    <div class="xtu-blog-featured__mobile">
      <div class="swiper xtu-blog-featured__swiper" data-xtu-bf-swiper>
        <div class="swiper-wrapper">
          {% if selected_count > 0 %}
            {% assign mobile_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'post' and block.settings.article != blank %}
                {% assign article = block.settings.article %}
                {% assign mobile_index = mobile_index | plus: 1 %}
                {% if mobile_index <= 5 %}
                  <div class="swiper-slide" {{ block.shopify_attributes }}>
                    <article class="xtu-blog-featured__mobile-card">
                      <a href="{{ article.url }}" class="xtu-blog-featured__featured-media xtu-img-zoom">
                        {% if article.image != blank %}
                          {{
                            article.image
                            | image_url: width: 800
                            | image_tag:
                              class: 'xtu-blog-featured__featured-img xtu-img-zoom__media',
                              loading: 'lazy',
                              widths: '400, 600, 800',
                              sizes: '90vw',
                              alt: article.title
                          }}
                        {% else %}
                          {{ 'image' | placeholder_svg_tag: 'xtu-blog-featured__featured-img xtu-img-zoom__media xtu-blog-featured__placeholder' }}
                        {% endif %}
                      </a>
                      <div class="xtu-blog-featured__mobile-body">
                        <div class="xtu-blog-featured__featured-meta">
                          {% if mobile_index == 1 and latest_label != blank %}
                            <span class="xtu-blog-featured__latest">{{ latest_label | escape }}</span>
                          {% else %}
                            <span></span>
                          {% endif %}
                          <time class="xtu-blog-featured__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                            {{ article.published_at | date: '%d %b %Y' }}
                          </time>
                        </div>
                        <h3 class="xtu-blog-featured__featured-title">
                          <a href="{{ article.url }}">{{ article.title | escape }}</a>
                        </h3>
                        {% if article.excerpt != blank or article.content != blank %}
                          <p class="xtu-blog-featured__excerpt">
                            {% if article.excerpt != blank %}
                              {{ article.excerpt | strip_html | truncate: 120 }}
                            {% else %}
                              {{ article.content | strip_html | truncate: 120 }}
                            {% endif %}
                          </p>
                        {% endif %}
                        {% if button_label != blank %}
                          {% render 'xtu-btn',
                            label: button_label,
                            href: article.url,
                            show_arrow: show_button_arrow,
                            bg: '#1590F2',
                            color: '#FFFFFF',
                            bg_hover: '#0070CA',
                            color_hover: '#FFFFFF',
                            class: 'xtu-blog-featured__mobile-btn'
                          %}
                        {% endif %}
                      </div>
                    </article>
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% else %}
            {% for i in (1..5) %}
              <div class="swiper-slide">
                <article class="xtu-blog-featured__mobile-card">
                  <div class="xtu-blog-featured__featured-media xtu-img-zoom">
                    {{ 'image' | placeholder_svg_tag: 'xtu-blog-featured__featured-img xtu-img-zoom__media xtu-blog-featured__placeholder' }}
                  </div>
                  <div class="xtu-blog-featured__mobile-body">
                    <div class="xtu-blog-featured__featured-meta">
                      {% if forloop.first and latest_label != blank %}
                        <span class="xtu-blog-featured__latest">{{ latest_label | escape }}</span>
                      {% else %}
                        <span></span>
                      {% endif %}
                      <time class="xtu-blog-featured__date">08 May 2026</time>
                    </div>
                    <h3 class="xtu-blog-featured__featured-title">Sample blog post {{ i }}</h3>
                    <p class="xtu-blog-featured__excerpt">Short excerpt placeholder for the blog featured section…</p>
                    {% if button_label != blank %}
                      {% render 'xtu-btn',
                        label: button_label,
                        href: '#',
                        show_arrow: show_button_arrow,
                        bg: '#1590F2',
                        color: '#FFFFFF',
                        bg_hover: '#0070CA',
                        color_hover: '#FFFFFF',
                        class: 'xtu-blog-featured__mobile-btn'
                      %}
                    {% endif %}
                  </div>
                </article>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .xtu-blog-featured {
    padding: var(--xtu-bf-padding-top) 0 var(--xtu-bf-padding-bottom);
    overflow: hidden;
  }

  .xtu-blog-featured__inner {
    width: min(var(--page-content-width), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
  }

  .xtu-blog-featured__heading {
    margin: 0 0 var(--xtu-space-40, 40px);
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-section-title, clamp(1.5rem, 2.8vw, 2rem));
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground);
    text-align: left;
  }

  .xtu-blog-featured__desktop {
    display: flex;
    flex-direction: column;
    gap: var(--xtu-space-32, 32px);
  }

  .xtu-blog-featured__mobile {
    display: none;
  }

  /* Featured — left image / right copy */
  .xtu-blog-featured__featured {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--xtu-space-32, 32px);
    align-items: center;
    min-width: 0;
  }

  .xtu-blog-featured__featured-media {
    display: block;
    border-radius: var(--xtu-bf-radius, 16px);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-4);
  }

  .xtu-blog-featured__featured-img,
  .xtu-blog-featured__card-img,
  .xtu-blog-featured__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .xtu-blog-featured__placeholder {
    background: #e8e8ea;
  }

  .xtu-blog-featured__featured-body {
    display: flex;
    flex-direction: column;
    gap: var(--xtu-space-14, 14px);
    min-width: 0;
  }

  .xtu-blog-featured__featured-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--xtu-space-12, 12px);
  }

  .xtu-blog-featured__latest {
    position: relative;
    padding-left: var(--xtu-space-12, 12px);
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-eyebrow, 0.75rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-1);
  }

  .xtu-blog-featured__latest::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.15em;
    bottom: 0.15em;
    width: 2px;
    border-radius: 2px;
    background: var(--xtu-bf-accent, #0070CA);
  }

  .xtu-blog-featured__date {
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-eyebrow, 0.75rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-1);
    white-space: nowrap;
  }

  .xtu-blog-featured__featured-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-block-title, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground);
  }

  .xtu-blog-featured__featured-title a,
  .xtu-blog-featured__card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .xtu-blog-featured__featured-title a:hover,
  .xtu-blog-featured__card-title a:hover {
    color: var(--xtu-bf-accent, #0070CA);
  }

  .xtu-blog-featured__excerpt {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-body, 0.875rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-1);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .xtu-blog-featured__btn {
    align-self: flex-start;
    margin-top: var(--xtu-space-4, 4px);
  }

  /* Bottom row — 4 equal cards */
  .xtu-blog-featured__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--xtu-space-16, 16px);
    align-items: stretch;
  }

  .xtu-blog-featured__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    background: #fff;
    border-radius: var(--xtu-bf-radius, 16px);
    overflow: hidden;
  }

  .xtu-blog-featured__card-media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-4);
  }

  .xtu-blog-featured__card-body {
    display: flex;
    flex-direction: column;
    gap: var(--xtu-space-8, 8px);
    flex: 1 1 auto;
    min-width: 0;
    padding: var(--xtu-space-20, 20px);
    box-sizing: border-box;
  }

  .xtu-blog-featured__card-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-body, 0.875rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(1.2em * 2);
  }

  .xtu-blog-featured__card-excerpt {
    margin: var(--xtu-space-8, 8px) 0 0;
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-body, 0.875rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-1);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: calc(1.2em * 2);
  }

  .xtu-blog-featured__card .xtu-blog-featured__btn {
    margin-top: var(--xtu-space-16, 16px);
  }

  /* Mobile swiper cards — equal height + clamped text rows */
  .xtu-blog-featured__mobile-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    background: #fff;
    border-radius: var(--xtu-bf-radius, 16px);
    overflow: hidden;
  }

  .xtu-blog-featured__mobile-card .xtu-blog-featured__featured-media {
    flex: 0 0 auto;
    aspect-ratio: 16 / 10;
    min-height: 0;
    border-radius: 0;
  }

  .xtu-blog-featured__mobile-body {
    display: flex;
    flex-direction: column;
    gap: var(--xtu-space-8, 8px);
    flex: 1 1 auto;
    min-width: 0;
    padding: var(--xtu-space-20, 20px);
    box-sizing: border-box;
    background: #fff;
  }

  .xtu-blog-featured__mobile-card .xtu-blog-featured__featured-title {
    font-size: var(--xtu-type-group-title-m);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: calc(1.2em * 2);
  }

  .xtu-blog-featured__mobile-card .xtu-blog-featured__excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: calc(1.2em * 2);
  }

  .xtu-blog-featured__mobile-card .xtu-blog-featured__mobile-btn {
    margin-top: var(--xtu-space-16, 16px);
    align-self: flex-start;
    min-height: 44px;
  }

  .xtu-blog-featured__swiper .swiper-wrapper {
    align-items: stretch;
  }

  .xtu-blog-featured__swiper .swiper-slide {
    height: auto;
    display: flex;
    box-sizing: border-box;
  }

  @media screen and (max-width: 989px) {
    .xtu-blog-featured__desktop {
      gap: var(--xtu-space-24, 24px);
    }

    .xtu-blog-featured__featured {
      grid-template-columns: 1fr;
      gap: var(--xtu-space-16, 16px);
    }

    .xtu-blog-featured__featured-title {
      font-size: var(--xtu-type-group-title, 1.25rem);
    }

    .xtu-blog-featured__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--xtu-space-12, 12px);
    }
  }

  @media screen and (max-width: 749px) {
    .xtu-blog-featured {
      padding: var(--xtu-bf-padding-top-mobile) 0 var(--xtu-bf-padding-bottom-mobile);
    }

    .xtu-blog-featured__heading {
      margin-bottom: var(--xtu-space-20, 20px);
      font-size: var(--xtu-type-section-title-m, 1.375rem);
    }

    .xtu-blog-featured__featured-title {
      font-size: var(--xtu-type-group-title-m);
    }

    .xtu-blog-featured__desktop {
      display: none;
    }

    .xtu-blog-featured__mobile {
      display: block;
      margin-inline: calc(var(--page-margin) * -1);
      padding-inline: var(--page-margin);
      overflow: hidden;
    }

    .xtu-blog-featured__swiper {
      overflow: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU Blog Featured",
  "tag": "section",
  "class": "xtu-blog-featured-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Blogs"
    },
    {
      "type": "text",
      "id": "latest_label",
      "label": "精选标签",
      "default": "Latest Blogs",
      "info": "显示在第一篇文章日期左侧"
    },
    {
      "type": "text",
