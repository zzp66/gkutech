{%- comment -%}
  XTU Affiliate Banner — 联盟营销申请条：左侧徽标+标题，右侧申请按钮与协议链接。

  数据来源
  - 徽标图、标题/副标题、主按钮、协议链接、颜色与边距：section 设置。
  - 空徽标用 placeholder_svg_tag，保证 Theme Editor 可预览。

  运营配置
  1. Theme Editor 添加「XTU Affiliate Banner」。
  2. 上传联盟徽标；填写标题、副标题。
  3. 配置「申请」按钮文案/链接/四色；配置「用户协议」文案/链接。

  前台
  - PC：左右两端对齐，徽标与标题垂直居中；按钮为胶囊（xtu-btn），协议链接居中叠在按钮下方。
  - 移动端：上到下居中堆叠（徽标 → 标题 → 按钮 → 协议）。

  相关：snippets/xtu-btn.liquid、assets/xtu-btn.css
{%- endcomment -%}

{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign badge = section.settings.badge
  assign badge_size = section.settings.badge_size | default: 80
  assign badge_sizes = badge_size | append: 'px'
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign button_new_tab = section.settings.button_new_tab
  assign show_button_arrow = section.settings.show_button_arrow
  assign btn_bg = section.settings.button_bg | default: '#FFD400'
  assign btn_color = section.settings.button_color | default: '#000000'
  assign btn_bg_hover = section.settings.button_bg_hover | default: '#F5B400'
  assign btn_color_hover = section.settings.button_color_hover | default: '#000000'
  assign agreement_label = section.settings.agreement_label
  assign agreement_link = section.settings.agreement_link
  assign agreement_new_tab = section.settings.agreement_new_tab
  assign agreement_color = section.settings.agreement_color | default: '#0070CA'
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign content_background = section.settings.content_background | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#000000'
  assign content_width = section.settings.content_width | default: 1200 | at_least: 600 | at_most: 1600
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign btn_attrs = ''
  if button_new_tab
    assign btn_attrs = 'target="_blank" rel="noopener noreferrer"'
  endif
%}

<section
  id="xtu-affiliate-banner-{{ section.id }}"
  class="xtu-ab"
  style="
    --xtu-ab-bg: {{ background_color }};
    --xtu-ab-content-bg: {{ content_background }};
    --xtu-ab-heading: {{ heading_color }};
    --xtu-ab-text: {{ text_color }};
    --xtu-ab-link: {{ agreement_color }};
    --xtu-ab-content-width: {{ content_width }}px;
    --xtu-ab-badge: {{ badge_size }}px;
    --xtu-ab-pt: {{ padding_top }}px;
    --xtu-ab-pb: {{ padding_bottom }}px;
    --xtu-ab-pt-m: {{ padding_top_mobile }}px;
    --xtu-ab-pb-m: {{ padding_bottom_mobile }}px;
  "
>
  <div class="xtu-ab__inner" data-xtu-reveal="fade-up" data-xtu-stagger>
    <div class="xtu-ab__brand" data-xtu-reveal-child>
      <div class="xtu-ab__badge">
        {% if badge != blank %}
          {{
            badge
            | image_url: width: 240
            | image_tag:
              class: 'xtu-ab__badge-img',
              widths: '80, 120, 160, 240',
              sizes: badge_sizes,
              loading: 'lazy',
              alt: heading
          }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'xtu-ab__badge-img xtu-ab__placeholder' }}
        {% endif %}
      </div>

      {% if heading != blank or subheading != blank %}
        <div class="xtu-ab__copy">
          {% if heading != blank %}
            <h2 class="xtu-ab__heading">{{ heading | escape }}</h2>
          {% endif %}
          {% if subheading != blank %}
            <p class="xtu-ab__subheading">{{ subheading | escape }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if button_label != blank or agreement_label != blank %}
      <div class="xtu-ab__actions" data-xtu-reveal-child>
        {% if button_label != blank %}
          {% render 'xtu-btn',
            label: button_label,
            href: button_link,
            show_arrow: show_button_arrow,
            bg: btn_bg,
            color: btn_color,
            bg_hover: btn_bg_hover,
            color_hover: btn_color_hover,
            class: 'xtu-ab__btn',
            attributes: btn_attrs
          %}
        {% endif %}
        {% if agreement_label != blank %}
          <a
            class="xtu-ab__agreement"
            href="{{ agreement_link | default: '#' }}"
            {% if agreement_new_tab %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            {{ agreement_label | escape }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .xtu-ab {
    padding: var(--xtu-ab-pt, 80px) 0 var(--xtu-ab-pb, 80px);
    background: var(--xtu-ab-bg, #fff);
    box-sizing: border-box;
  }

  .xtu-ab__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--xtu-space-32, 32px);
    width: min(var(--xtu-ab-content-width, 1200px), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
    background: var(--xtu-ab-content-bg, #fff);
    box-sizing: border-box;
  }

  .xtu-ab__brand {
    display: flex;
    align-items: center;
    gap: var(--xtu-space-20, 20px);
    min-width: 0;
  }

  .xtu-ab__badge {
    flex: 0 0 auto;
    width: var(--xtu-ab-badge, 80px);
    height: var(--xtu-ab-badge, 80px);
  }

  .xtu-ab__badge-img,
  .xtu-ab__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .xtu-ab__placeholder {
    border-radius: 999px;
    background: #e8eaed;
  }

  .xtu-ab__copy {
    min-width: 0;
  }

  .xtu-ab__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-section-title);
    font-weight: 600;
    line-height: 1.2;
    color: var(--xtu-ab-heading, #000);
  }

  .xtu-ab__subheading {
    margin: var(--xtu-space-8, 8px) 0 0;
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-section-subtitle);
    font-weight: 400;
    line-height: 1.2;
    color: var(--xtu-ab-text, #000);
  }

  .xtu-ab__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 0 0 auto;
    gap: var(--xtu-space-12, 12px);
  }

  .xtu-ab__btn {
    min-width: 160px;
    min-height: 48px;
    padding: 0 var(--xtu-space-40, 40px);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .xtu-ab__agreement {
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-body);
    font-weight: 400;
    line-height: 1.2;
    color: var(--xtu-ab-link, #0070ca);
    text-decoration: none;
  }

  .xtu-ab__agreement:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .xtu-ab {
      padding: var(--xtu-ab-pt-m, 40px) 0 var(--xtu-ab-pb-m, 40px);
    }

    .xtu-ab__inner {
      flex-direction: column;
      align-items: center;
      gap: var(--xtu-space-24, 24px);
      text-align: center;
    }

    .xtu-ab__brand {
      flex-direction: column;
      align-items: center;
      gap: var(--xtu-space-16, 16px);
    }

    .xtu-ab__heading {
      font-size: var(--xtu-type-section-title-m);
    }

    .xtu-ab__subheading {
      margin-top: var(--xtu-space-8, 8px);
    }

    .xtu-ab__btn {
      min-width: 180px;
      width: min(280px, 100%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU Affiliate Banner",
  "tag": "section",
  "class": "section-xtu-affiliate-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "品牌"
    },
    {
      "type": "image_picker",
      "id": "badge",
      "label": "联盟徽标"
    },
    {
      "type": "range",
      "id": "badge_size",
      "label": "徽标尺寸",
      "min": 48,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "XTU Affiliate Program"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "副标题",
      "default": "Share to Earn"
    },
    {
      "type": "header",
      "content": "申请按钮"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文案",
      "default": "APPLY NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "新窗口打开按钮链接",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button_arrow",
      "label": "按钮显示箭头",
      "default": false
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "按钮背景色",
      "default": "#FFD400"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "按钮文字色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_hover",
      "label": "按钮 Hover 背景色",
      "default": "#F5B400"
    },
    {
      "type": "color",
      "id": "button_color_hover",
      "label": "按钮 Hover 文字色",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "用户协议"
    },
    {
      "type": "text",
      "id": "agreement_label",
      "label": "协议文案",
      "default": "User Agreement"
    },
    {
      "type": "url",
      "id": "agreement_link",
      "label": "协议链接"
    },
    {
      "type": "checkbox",
      "id": "agreement_new_tab",
      "label": "新窗口打开协议链接",
      "default": true
    },
    {
      "type": "color",
      "id": "agreement_color",
      "label": "协议链接色",
      "default": "#0070CA"
    },
    {
      "type": "header",
      "content": "颜色与布局"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "版块背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "内容区背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "副标题颜色",
      "default": "#000000"
    },
    {
      "type": "number",
      "id": "content_width",
      "label": "内容区最大宽度（px）",
