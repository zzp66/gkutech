{% liquid
  assign heading = section.settings.heading
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign content_background = section.settings.content_background | default: '#FFFFFF'
  assign content_width = section.settings.content_width | default: 1200
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign columns_mobile = section.settings.columns_mobile | default: 2
  assign row_height_desktop = section.settings.row_height_desktop | default: 200
  assign row_height_mobile = section.settings.row_height_mobile | default: 180
  assign gap_desktop = section.settings.gap_desktop | default: 16
  assign gap_mobile = section.settings.gap_mobile | default: 8
  assign card_radius = section.settings.card_radius | default: 16
  assign show_image_overlay = section.settings.show_image_overlay
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign heading_color = section.settings.heading_color | default: '#000000'
  assign placeholder_bg = section.settings.placeholder_bg | default: '#E8EAED'
%}

<section
  id="xtu-bento-grid-{{ section.id }}"
  class="xtu-bento-grid"
  style="
    --xtu-bento-bg: {{ background_color }};
    --xtu-bento-content-bg: {{ content_background }};
    --xtu-bento-content-width: {{ content_width }}px;
    --xtu-bento-cols: {{ columns_desktop }};
    --xtu-bento-cols-m: {{ columns_mobile }};
    --xtu-bento-row-h: {{ row_height_desktop }}px;
    --xtu-bento-row-h-m: {{ row_height_mobile }}px;
    --xtu-bento-gap: {{ gap_desktop }}px;
    --xtu-bento-gap-m: {{ gap_mobile }}px;
    --xtu-bento-radius: {{ card_radius }}px;
    --xtu-bento-pt: {{ padding_top }}px;
    --xtu-bento-pb: {{ padding_bottom }}px;
    --xtu-bento-pt-m: {{ padding_top_mobile }}px;
    --xtu-bento-pb-m: {{ padding_bottom_mobile }}px;
    --xtu-bento-heading-color: {{ heading_color }};
    --xtu-bento-placeholder-bg: {{ placeholder_bg }};
  "
>
  <div class="xtu-bento-grid__inner">
    {% if heading != blank %}
      <h2 class="xtu-bento-grid__heading" data-xtu-reveal="fade-up">{{ heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        class="xtu-bento-grid__grid"
        data-xtu-reveal="fade-up"
        data-xtu-stagger
      >
        {% for block in section.blocks %}
          {% liquid
            assign title = block.settings.title
            assign link = block.settings.link
            assign text_color = block.settings.text_color | default: '#FFFFFF'
            assign text_align = block.settings.text_align | default: 'center'
            assign text_position = block.settings.text_position | default: 'top'
            assign image_desktop = block.settings.image
            assign image_mobile = block.settings.image_mobile
            assign media_type = block.settings.media_type | default: 'image'
            assign video = block.settings.video
            assign video_mobile = block.settings.video_mobile
            assign video_url = block.settings.video_url
            assign has_mobile_image = false
            if image_mobile != blank
              assign has_mobile_image = true
            endif
            assign has_mobile_video = false
            if video_mobile != blank
              assign has_mobile_video = true
            endif

            assign col_span_d = block.settings.col_span_desktop | default: 1
            assign row_span_d = block.settings.row_span_desktop | default: 1
            assign col_start_d = block.settings.col_start_desktop | default: 'auto'
            assign row_start_d = block.settings.row_start_desktop | default: 'auto'
            assign col_span_m = block.settings.col_span_mobile | default: 1
            assign row_span_m = block.settings.row_span_mobile | default: 1
            assign col_start_m = block.settings.col_start_mobile | default: 'auto'
            assign row_start_m = block.settings.row_start_mobile | default: 'auto'

            if col_start_d == 'auto'
              assign grid_col_d = 'span ' | append: col_span_d
            else
              assign grid_col_d = col_start_d | append: ' / span ' | append: col_span_d
            endif
            if row_start_d == 'auto'
              assign grid_row_d = 'span ' | append: row_span_d
            else
              assign grid_row_d = row_start_d | append: ' / span ' | append: row_span_d
            endif
            if col_start_m == 'auto'
              assign grid_col_m = 'span ' | append: col_span_m
            else
              assign grid_col_m = col_start_m | append: ' / span ' | append: col_span_m
            endif
            if row_start_m == 'auto'
              assign grid_row_m = 'span ' | append: row_span_m
            else
              assign grid_row_m = row_start_m | append: ' / span ' | append: row_span_m
            endif

            assign placeholder_name = 'lifestyle-1'
            assign ph_mod = forloop.index0 | modulo: 3
            if ph_mod == 1
              assign placeholder_name = 'lifestyle-2'
            elsif ph_mod == 2
              assign placeholder_name = 'image'
            endif
          %}

          <div
            class="xtu-bento-grid__cell xtu-img-zoom{% if link != blank %} xtu-bento-grid__cell--link{% endif %}"
            style="
              --xtu-bento-gc: {{ grid_col_d }};
              --xtu-bento-gr: {{ grid_row_d }};
              --xtu-bento-gc-m: {{ grid_col_m }};
              --xtu-bento-gr-m: {{ grid_row_m }};
              --xtu-bento-text: {{ text_color }};
            "
            data-xtu-reveal-child
            {{ block.shopify_attributes }}
          >
            <div class="xtu-bento-grid__media{% if media_type == 'image' and has_mobile_image %} xtu-bento-grid__media--split{% endif %}{% if media_type == 'video' and has_mobile_video %} xtu-bento-grid__media--split{% endif %}">
              {% if media_type == 'video' %}
                {% if video != blank %}
                  {{
                    video
                    | video_tag:
                      class: 'xtu-bento-grid__video xtu-bento-grid__image--desktop',
                      image_size: '1600x',
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true
                  }}
                {% endif %}
                {% if has_mobile_video %}
                  {{
                    video_mobile
                    | video_tag:
                      class: 'xtu-bento-grid__video xtu-bento-grid__image--mobile',
                      image_size: '1200x',
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true
                  }}
                {% endif %}
                {% if video == blank and has_mobile_video == false %}
                  {{ placeholder_name | placeholder_svg_tag: 'xtu-bento-grid__image xtu-bento-grid__image--desktop xtu-img-zoom__media xtu-bento-grid__placeholder' }}
                {% endif %}
              {% elsif media_type == 'youtube' %}
                {% render 'xtu-video-embed',
                  video_url: video_url,
                  mode: 'ambient',
                  class: 'xtu-bento-grid__youtube',
                  title: title,
                  placeholder: placeholder_name,
                  placeholder_class: 'xtu-bento-grid__image xtu-img-zoom__media xtu-bento-grid__placeholder'
                %}
              {% elsif image_desktop != blank %}
                {{
                  image_desktop
                  | image_url: width: 1600
                  | image_tag:
                    class: 'xtu-bento-grid__image xtu-bento-grid__image--desktop xtu-img-zoom__media',
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200, 1600',
                    sizes: '(max-width: 749px) 100vw, 40vw',
                    alt: title
                }}
              {% else %}
                {{ placeholder_name | placeholder_svg_tag: 'xtu-bento-grid__image xtu-bento-grid__image--desktop xtu-img-zoom__media xtu-bento-grid__placeholder' }}
              {% endif %}

              {% if media_type == 'image' and has_mobile_image %}
                {{
                  image_mobile
                  | image_url: width: 1200
                  | image_tag:
                    class: 'xtu-bento-grid__image xtu-bento-grid__image--mobile xtu-img-zoom__media',
                    loading: 'lazy',
                    widths: '360, 480, 640, 800, 1000, 1200',
                    sizes: '100vw',
                    alt: title
                }}
              {% endif %}

              {% if show_image_overlay %}
                <div class="xtu-bento-grid__wash" aria-hidden="true"></div>
              {% endif %}
            </div>

            {% if title != blank %}
              <div class="xtu-bento-grid__copy xtu-bento-grid__copy--pos-{{ text_position }} xtu-bento-grid__copy--align-{{ text_align }}">
                <p class="xtu-bento-grid__title">{{ title | escape }}</p>
              </div>
            {% endif %}

            {% if link != blank %}
              <a
                class="xtu-bento-grid__hit"
                href="{{ link }}"
                {% if title != blank %}
                  aria-label="{{ title | escape }}"
                {% endif %}
              ></a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .xtu-bento-grid {
    padding: var(--xtu-bento-pt) 0 var(--xtu-bento-pb);
    background: var(--xtu-bento-bg, #fff);
  }

  .xtu-bento-grid__inner {
    width: min(var(--xtu-bento-content-width, 1200px), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
    padding: 0;
    border-radius: 0;
    background: var(--xtu-bento-content-bg, #fff);
    box-sizing: border-box;
  }

  .xtu-bento-grid__heading {
    margin: 0 0 var(--xtu-space-40, 40px);
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-section-title);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    color: var(--xtu-bento-heading-color, #000);
  }

  .xtu-bento-grid__grid {
    display: grid;
    grid-template-columns: repeat(var(--xtu-bento-cols, 3), minmax(0, 1fr));
    grid-auto-rows: var(--xtu-bento-row-h, 200px);
    grid-auto-flow: dense;
    gap: var(--xtu-bento-gap, 16px);
  }

  .xtu-bento-grid__cell {
    position: relative;
    display: block;
    grid-column: var(--xtu-bento-gc);
    grid-row: var(--xtu-bento-gr);
    overflow: hidden;
    border-radius: var(--xtu-bento-radius, 16px);
    background: var(--xtu-bento-placeholder-bg, #e8eaed);
    text-decoration: none;
    color: inherit;
    isolation: isolate;
  }

  .xtu-bento-grid__cell--link {
    cursor: pointer;
  }

  .xtu-bento-grid__hit {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .xtu-bento-grid__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .xtu-bento-grid__image,
  .xtu-bento-grid__video,
  .xtu-bento-grid__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .xtu-bento-grid__youtube {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }

  .xtu-bento-grid__image--mobile {
    display: none;
  }

  .xtu-bento-grid__placeholder {
    background: var(--xtu-bento-placeholder-bg, #e8eaed);
  }

  .xtu-bento-grid__wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.35) 0%,
      rgb(0 0 0 / 0.08) 42%,
      rgb(0 0 0 / 0) 70%
    );
    pointer-events: none;
  }

  .xtu-bento-grid__copy {
    position: relative;
    z-index: 2;
    display: flex;
    width: 100%;
    height: 100%;
    padding: var(--xtu-space-20, 20px) var(--xtu-space-20, 20px);
    box-sizing: border-box;
    pointer-events: none;
  }

  .xtu-bento-grid__copy--pos-top {
    align-items: flex-start;
  }

  .xtu-bento-grid__copy--pos-center {
    align-items: center;
  }

  .xtu-bento-grid__copy--pos-bottom {
    align-items: flex-end;
  }

  .xtu-bento-grid__copy--align-left {
    justify-content: flex-start;
    text-align: left;
  }

  .xtu-bento-grid__copy--align-center {
    justify-content: center;
    text-align: center;
  }

  .xtu-bento-grid__copy--align-right {
    justify-content: flex-end;
    text-align: right;
  }

  .xtu-bento-grid__title {
    margin: 0;
    max-width: 18em;
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-group-title);
    font-weight: 600;
    line-height: 1.2;
    color: var(--xtu-bento-text, #fff);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.25);
  }

  @media (max-width: 749px) {
    .xtu-bento-grid {
      padding: var(--xtu-bento-pt-m) 0 var(--xtu-bento-pb-m);
    }

    .xtu-bento-grid__heading {
      margin-bottom: var(--xtu-space-20, 20px);
      font-size: var(--xtu-type-section-title-m);
    }

    .xtu-bento-grid__grid {
      grid-template-columns: repeat(var(--xtu-bento-cols-m, 2), minmax(0, 1fr));
      grid-auto-rows: var(--xtu-bento-row-h-m, 180px);
      gap: var(--xtu-bento-gap-m, 8px);
    }

    .xtu-bento-grid__cell {
      grid-column: var(--xtu-bento-gc-m);
      grid-row: var(--xtu-bento-gr-m);
    }

    .xtu-bento-grid__media--split .xtu-bento-grid__image--desktop {
      display: none;
    }

    .xtu-bento-grid__media--split .xtu-bento-grid__image--mobile {
      display: block;
    }

    .xtu-bento-grid__copy {
      padding: var(--xtu-space-12, 12px) var(--xtu-space-16, 16px);
    }

    .xtu-bento-grid__title {
      font-size: var(--xtu-type-group-title-m);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU Bento Grid",
  "tag": "section",
  "class": "section-xtu-bento-grid",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "大标题",
      "info": "留空则不显示"
    },
    {
      "type": "header",
      "content": "外观"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "版块背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "内容区背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "版块标题色",
      "default": "#000000",
      "info": "大标题；卡片内文案仍由块级设置控制"
    },
    {
      "type": "color",
      "id": "placeholder_bg",
      "label": "占位背景色",
      "default": "#E8EAED"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "内容区最大宽度",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1200,
      "info": "图片拼贴建议偏宽；产品页可酌情收窄"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "卡片圆角",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_image_overlay",
      "label": "启用图片遮罩",
      "default": false,
      "info": "默认关闭；开启后在图片顶部加浅遮罩以增强文字可读性"
    },
    {
      "type": "header",
      "content": "网格（PC）"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "列数",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "row_height_desktop",
      "label": "单行基准高度",
      "min": 120,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 200,
      "info": "块的行高 = 基准高度 × 占据行数"
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "间距",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "网格（移动端）"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "列数",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "row_height_mobile",
      "label": "单行基准高度",
      "min": 100,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "间距",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "拼贴块",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "文案",
          "default": "Feature title"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "文案颜色",
          "default": "#FFFFFF"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "文案水平对齐",
          "options": [
            { "value": "left", "label": "左" },
            { "value": "center", "label": "中" },
            { "value": "right", "label": "右" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "文案垂直位置",
          "options": [
            { "value": "top", "label": "上" },
            { "value": "center", "label": "中" },
            { "value": "bottom", "label": "下" }
          ],
          "default": "top"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "媒体类型",
          "options": [
            { "value": "image", "label": "图片" },
            { "value": "video", "label": "上传视频" },
            { "value": "youtube", "label": "视频链接" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片（PC）",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "图片（移动端）",
          "info": "留空则回退使用 PC 图",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "上传视频（PC）",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "上传视频（移动端）",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "视频链接",
          "accept": ["youtube", "vimeo"],
          "info": "格子为跳转链接时视频静音循环，不响应点击。",
          "visible_if": "{{ block.settings.media_type == 'youtube' }}"
        },
        {
          "type": "url",
          "id": "link",
          "label": "跳转链接"
        },
        {
          "type": "header",
          "content": "布局（PC）"
        },
        {
          "type": "select",
          "id": "col_start_desktop",
          "label": "起始列",
          "options": [
            { "value": "auto", "label": "自动" },
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" },
            { "value": "4", "label": "4" },
            { "value": "5", "label": "5" },
            { "value": "6", "label": "6" }
          ],
          "default": "auto"
        },
        {
          "type": "range",
          "id": "col_span_desktop",
          "label": "占据列数",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 1
        },
        {
          "type": "select",
          "id": "row_start_desktop",
          "label": "起始行",
          "options": [
            { "value": "auto", "label": "自动" },
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" },
            { "value": "4", "label": "4" },
            { "value": "5", "label": "5" },
            { "value": "6", "label": "6" }
          ],
          "default": "auto"
        },
        {
          "type": "range",
          "id": "row_span_desktop",
          "label": "占据行数",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 2
        },
        {
          "type": "header",
          "content": "布局（移动端）"
        },
        {
          "type": "select",
          "id": "col_start_mobile",
