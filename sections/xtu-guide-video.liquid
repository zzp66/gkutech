{%- comment -%}
  XTU Guide Video — 品类 Tab + 分页视频网格。

  数据来源
  - Tab：本 section 的「品类」block（id + label）。id 经 handleize，须与 Metaobject.category 一致。
  - 视频：shop.metaobjects.xtu_guide_video（最多 paginate 250）。不使用视频 block，避免 25 条上限。
  - 字段：title、category、cover（图）、youtube_url、video（上传文件）、sort_order。
    youtube_url 优先于 video；二者皆空则跳过该条目。
    上传视频须取 mp4 源，不能用 sources 的第一条（店面前台常把 m3u8/HLS 放在最前，Chrome 无法原生播放）。

  运营配置
  1. 页面模板选 templates/page.guide-video.json。
  2. Theme Editor：配标题 / 每行数量（PC）/ 每页数量 / 品类 Tab。
  3. 后台「内容 → Metaobjects → XTU Guide Video」维护视频。
     无封面时：YouTube 用官方缩略图；上传视频用 Shopify 自动生成的首帧 preview_image，
     仍缺则前台从视频截取首帧静帧。

  前台
  - Liquid 只输出 JSON catalog；Tab、网格、分页由 assets/xtu-guide-video.js 渲染。
  - 封面图 lazy-load；点击播放才插入 iframe / video。切 Tab 或翻页会停掉当前播放。
  - PC：grid-template-columns = columns_desktop；移动端强制 1 列。
  - 移动端 Tab 溢出时，向右选贴左、向左选贴右（同 xtu-tab-images）。

  相关：assets/xtu-guide-video.js、assets/xtu-guide-video.css、
        scripts/setup-xtu-guide-video-metaobject.graphql
{%- endcomment -%}

{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign content_background = section.settings.content_background | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#000000'
  assign muted_text_color = section.settings.muted_text_color | default: '#8E9297'
  assign accent_color = section.settings.accent_color | default: '#0070CA'
  assign tab_bg_active = section.settings.tab_bg_active | default: '#0070CA'
  assign tab_color_active = section.settings.tab_color_active | default: '#FFFFFF'
  assign pagination_border = section.settings.pagination_border | default: '#DFDFDF'
  assign pagination_bg_active = section.settings.pagination_bg_active | default: '#0070CA'
  assign media_bg = section.settings.media_bg | default: '#111111'
  assign content_width = section.settings.content_width | default: 1200 | at_least: 600 | at_most: 1600
  assign columns_desktop = section.settings.columns_desktop | default: 2
  assign per_page = section.settings.per_page | default: 6
  assign card_radius = section.settings.card_radius | default: 16
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign empty_text = section.settings.empty_text | default: 'No videos in this category.'
%}

{{ 'xtu-guide-video.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xtu-guide-video.js' | asset_url }}" defer="defer"></script>

{% capture catalog_json %}
{
  "columns": {{ columns_desktop | json }},
  "perPage": {{ per_page | json }},
  "emptyText": {{ empty_text | json }},
  "categories": [
    {% assign cat_first = true %}
    {% for block in section.blocks %}
      {% if block.type == 'category' %}
        {% assign cat_id = block.settings.id | strip | handleize %}
        {% if cat_id != blank %}
          {% unless cat_first %},{% endunless %}
          {% assign cat_first = false %}
          {
            "id": {{ cat_id | json }},
            "label": {{ block.settings.label | default: block.settings.id | json }}
          }
        {% endif %}
      {% endif %}
    {% endfor %}
  ],
  "videos": [
    {% assign video_first = true %}
    {% paginate metaobjects.xtu_guide_video.values by 250 %}
      {% for entry in metaobjects.xtu_guide_video.values %}
        {% liquid
          assign v_title = entry.title.value | default: entry.title
          assign v_category = entry.category.value | default: entry.category | strip | handleize
          assign v_cover = entry.cover.value | default: entry.cover
          assign v_youtube = entry.youtube_url.value | default: entry.youtube_url | strip
          assign v_video = entry.video.value | default: entry.video
          assign v_sort = entry.sort_order.value | default: entry.sort_order | default: 0

          assign cover_url = blank
          if v_cover != blank
            assign cover_url = v_cover | image_url: width: 1200
          elsif v_video != blank and v_video.preview_image != blank
            assign cover_url = v_video.preview_image | image_url: width: 1200
          endif

          assign video_url = blank
          if v_video != blank
            if v_video.sources != blank
              for source in v_video.sources
                assign source_format = source.format | default: '' | downcase
                assign source_mime = source.mime_type | default: '' | downcase
                assign source_href = source.url | default: ''
                if source_href != blank
                  if source_format == 'mp4' or source_mime == 'video/mp4' or source_href contains '.mp4'
                    unless source_href contains '.m3u8'
                      assign video_url = source_href
                      break
                    endunless
                  endif
                endif
              endfor
              if video_url == blank
                for source in v_video.sources
                  assign source_href = source.url | default: ''
                  if source_href != blank
                    unless source_href contains '.m3u8'
                      assign video_url = source_href
                      break
                    endunless
                  endif
                endfor
              endif
            endif
            if video_url == blank and v_video.url != blank
              unless v_video.url contains '.m3u8'
                assign video_url = v_video.url
              endunless
            endif
          endif

          assign media_type = blank
          if v_youtube != blank
            assign media_type = 'youtube'
          elsif video_url != blank
            assign media_type = 'video'
          endif
        %}
        {% if media_type != blank and v_category != blank %}
          {% unless video_first %},{% endunless %}
          {% assign video_first = false %}
          {
            "id": {{ entry.system.handle | default: entry.id | json }},
            "title": {{ v_title | json }},
            "category": {{ v_category | json }},
            "type": {{ media_type | json }},
            "cover": {{ cover_url | json }},
            "youtubeUrl": {{ v_youtube | json }},
            "videoUrl": {{ video_url | json }},
            "sort": {{ v_sort | json }}
          }
        {% endif %}
      {% endfor %}
    {% endpaginate %}
  ]
}
{% endcapture %}

<section
  id="xtu-guide-video-{{ section.id }}"
  class="xtu-gv"
  data-xtu-guide-video
  style="
    --xtu-gv-bg: {{ background_color }};
    --xtu-gv-content-bg: {{ content_background }};
    --xtu-gv-heading: {{ heading_color }};
    --xtu-gv-muted: {{ muted_text_color }};
    --xtu-gv-accent: {{ accent_color }};
    --xtu-gv-tab-bg-active: {{ tab_bg_active }};
    --xtu-gv-tab-color-active: {{ tab_color_active }};
    --xtu-gv-page-border: {{ pagination_border }};
    --xtu-gv-page-bg-active: {{ pagination_bg_active }};
    --xtu-gv-media-bg: {{ media_bg }};
    --xtu-gv-content-width: {{ content_width }}px;
    --xtu-gv-columns: {{ columns_desktop }};
    --xtu-gv-radius: {{ card_radius }}px;
    --xtu-gv-pt: {{ padding_top }}px;
    --xtu-gv-pb: {{ padding_bottom }}px;
    --xtu-gv-pt-m: {{ padding_top_mobile }}px;
    --xtu-gv-pb-m: {{ padding_bottom_mobile }}px;
  "
>
  <script type="application/json" data-xtu-gv-catalog>
    {{ catalog_json | strip }}
  </script>

  <div class="xtu-gv__inner">
    {% if heading != blank or subheading != blank %}
      <div class="xtu-gv__header" data-xtu-reveal="fade-up" data-xtu-stagger>
        {% if heading != blank %}
          <h2 class="xtu-gv__heading" data-xtu-reveal-child>{{ heading | escape }}</h2>
        {% endif %}
        {% if subheading != blank %}
          <p class="xtu-gv__subheading" data-xtu-reveal-child>{{ subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="xtu-gv__tabs" data-xtu-gv-tabs role="tablist" aria-label="{{ heading | default: 'Guide videos' | escape }}" hidden></div>

    <div class="xtu-gv__grid" data-xtu-gv-grid data-xtu-reveal="fade-up"></div>

    <p class="xtu-gv__empty" data-xtu-gv-empty hidden>{{ empty_text | escape }}</p>

    <div class="xtu-gv__pager" data-xtu-gv-pager hidden>
      <button type="button" class="xtu-gv__page-btn" data-xtu-gv-prev aria-label="Previous page">Prev</button>
      <span class="xtu-gv__page-label" data-xtu-gv-page-label>1 / 1</span>
      <button type="button" class="xtu-gv__page-btn" data-xtu-gv-next aria-label="Next page">Next</button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "XTU Guide Video",
  "tag": "section",
  "class": "section-xtu-guide-video",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 30,
  "settings": [
    {
      "type": "paragraph",
      "content": "视频数据请在「内容 → Metaobjects → XTU Guide Video」中维护（支持超过 25 条）。本 section 仅配置品类 Tab 与展示参数。品类 ID 须与 Metaobject 的 category 字段一致。"
    },
    {
      "type": "header",
      "content": "标题"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "大标题",
      "default": "Guide Video"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "副标题"
    },
    {
      "type": "header",
      "content": "列表"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "每行数量（PC）",
