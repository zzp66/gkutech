{%- comment -%}
  XTU Process Steps — 流程步骤（图标 + 标题 + 说明）。

  数据来源
  - 标题/副标题、版心、边距、图标尺寸、连线与颜色：section 设置。
  - 每一步：block「步骤」——预设线框图标或上传图、标题、说明。

  运营配置
  1. Theme Editor 添加「XTU Process Steps」。
  2. 填写大标题、副标题；按需增删步骤（建议 3–4 步，最多 6）。
  3. 图标可选内置线框，或上传自定义图片。

  前台
  - PC：等分横排；图标之间浅灰连线，不穿过文案。
  - 平板 / 移动端：一行 2 个；同行图标间保留横向连线。
  - 空图标回退到对应预设线框，保证后台可预览。

  相关：无独立 JS；入场动效走 data-xtu-reveal。
{%- endcomment -%}

{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign content_background = section.settings.content_background | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#333333'
  assign muted_text_color = section.settings.muted_text_color | default: '#8E9297'
  assign icon_color = section.settings.icon_color | default: '#000000'
  assign line_color = section.settings.line_color | default: '#DFDFDF'
  assign content_width = section.settings.content_width | default: 1200 | at_least: 600 | at_most: 1600
  assign icon_size = section.settings.icon_size | default: 48
  assign icon_sizes = icon_size | append: 'px'
  assign column_gap = section.settings.column_gap | default: 32
  assign show_line = section.settings.show_line
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign step_count = 0
  for block in section.blocks
    if block.type == 'step'
      assign step_count = step_count | plus: 1
    endif
  endfor
%}

<section
  id="xtu-process-steps-{{ section.id }}"
  class="xtu-ps"
  style="
    --xtu-ps-bg: {{ background_color }};
    --xtu-ps-content-bg: {{ content_background }};
    --xtu-ps-heading: {{ heading_color }};
    --xtu-ps-text: {{ text_color }};
    --xtu-ps-muted: {{ muted_text_color }};
    --xtu-ps-icon: {{ icon_color }};
    --xtu-ps-line: {{ line_color }};
    --xtu-ps-content-width: {{ content_width }}px;
    --xtu-ps-icon-size: {{ icon_size }}px;
    --xtu-ps-gap: {{ column_gap }}px;
    --xtu-ps-cols: {{ step_count }};
    --xtu-ps-pt: {{ padding_top }}px;
    --xtu-ps-pb: {{ padding_bottom }}px;
    --xtu-ps-pt-m: {{ padding_top_mobile }}px;
    --xtu-ps-pb-m: {{ padding_bottom_mobile }}px;
  "
>
  <div class="xtu-ps__inner">
    {% if heading != blank or subheading != blank %}
      <div class="xtu-ps__header" data-xtu-reveal="fade-up" data-xtu-stagger>
        {% if heading != blank %}
          <h2 class="xtu-ps__heading" data-xtu-reveal-child>{{ heading | escape }}</h2>
        {% endif %}
        {% if subheading != blank %}
          <p class="xtu-ps__subheading" data-xtu-reveal-child>{{ subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if step_count > 0 %}
      <ol
        class="xtu-ps__list{% if show_line %} xtu-ps__list--line{% endif %}"
        data-xtu-reveal="fade-up"
        data-xtu-stagger
      >
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            {% liquid
              assign step_title = block.settings.title
              assign step_body = block.settings.body
              assign icon_style = block.settings.icon_style | default: 'user'
              assign icon_image = block.settings.icon_image
              assign use_custom_icon = false
              if icon_style == 'custom' and icon_image != blank
                assign use_custom_icon = true
              endif
              if icon_style == 'custom' and icon_image == blank
                assign icon_style = 'user'
              endif
            %}
            <li
              class="xtu-ps__step"
              data-xtu-reveal-child
              {{ block.shopify_attributes }}
            >
              <div class="xtu-ps__icon-wrap">
                {% if use_custom_icon %}
                  {{
                    icon_image
                    | image_url: width: 192
                    | image_tag:
                      class: 'xtu-ps__icon-img',
                      widths: '48, 64, 96, 128, 192',
                      sizes: icon_sizes,
                      loading: 'lazy',
                      alt: step_title
                  }}
                {% else %}
                  <span class="xtu-ps__icon" aria-hidden="true">
                    {% case icon_style %}
                      {% when 'check' %}
                        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <rect x="10" y="10" width="28" height="28" rx="6" stroke="currentColor" stroke-width="2"/>
                          <path d="M18 24.5 22.5 29 31 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      {% when 'plane' %}
                        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M10 24 40 12 26 38 24 26 10 24Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                          <path d="M40 12 24 26" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                      {% when 'dollar' %}
                        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="24" cy="24" r="14" stroke="currentColor" stroke-width="2"/>
                          <path d="M24 16v16M20 20h5a3 3 0 0 1 0 6h-2a3 3 0 0 0 0 6h6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      {% else %}
                        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="18" cy="16" r="6" stroke="currentColor" stroke-width="2"/>
                          <path d="M8 34c0-5.5 4.5-10 10-10h0c5.5 0 10 4.5 10 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                          <path d="M32 18v12M26 24h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    {% endcase %}
                  </span>
                {% endif %}
              </div>

              {% if step_title != blank %}
                <h3 class="xtu-ps__title">{{ step_title | escape }}</h3>
              {% endif %}
              {% if step_body != blank %}
                <div class="xtu-ps__body rte">{{ step_body }}</div>
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .xtu-ps {
    padding: var(--xtu-ps-pt, 80px) 0 var(--xtu-ps-pb, 80px);
    background: var(--xtu-ps-bg, #fff);
    box-sizing: border-box;
  }

  .xtu-ps__inner {
    width: min(var(--xtu-ps-content-width, 1200px), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
    background: var(--xtu-ps-content-bg, #fff);
    box-sizing: border-box;
  }

  .xtu-ps__header {
    margin-bottom: var(--xtu-space-40, 40px);
    text-align: center;
  }

  .xtu-ps__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-section-title);
    font-weight: 600;
    line-height: 1.2;
    color: var(--xtu-ps-heading, #000);
  }

  .xtu-ps__subheading {
    margin: var(--xtu-space-16, 16px) auto 0;
    max-width: 42rem;
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-section-subtitle);
    font-weight: 400;
    line-height: 1.2;
    color: var(--xtu-ps-muted, #8e9297);
  }

  .xtu-ps__list {
    display: grid;
    grid-template-columns: repeat(var(--xtu-ps-cols, 4), minmax(0, 1fr));
    gap: var(--xtu-ps-gap, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xtu-ps__step {
    position: relative;
    min-width: 0;
    margin: 0;
  }

  .xtu-ps__icon-wrap {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    height: var(--xtu-ps-icon-size, 48px);
    margin-bottom: var(--xtu-space-16, 16px);
  }

  .xtu-ps__icon,
  .xtu-ps__icon-img {
    position: relative;
    z-index: 1;
    display: block;
    width: var(--xtu-ps-icon-size, 48px);
    height: var(--xtu-ps-icon-size, 48px);
    flex: 0 0 auto;
    background: var(--xtu-ps-content-bg, #fff);
    color: var(--xtu-ps-icon, #000);
    object-fit: contain;
  }

  .xtu-ps__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .xtu-ps__list--line .xtu-ps__step:not(:last-child) .xtu-ps__icon-wrap::after {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(var(--xtu-ps-icon-size, 48px) + 8px);
    width: calc(100% - var(--xtu-ps-icon-size, 48px) - 16px + var(--xtu-ps-gap, 32px));
    height: 1px;
    background: var(--xtu-ps-line, #dfdfdf);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .xtu-ps__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-group-title);
    font-weight: 600;
    line-height: 1.2;
    color: var(--xtu-ps-heading, #000);
  }

  .xtu-ps__body {
    margin: var(--xtu-space-12, 12px) 0 0;
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-body);
    font-weight: 400;
    line-height: 1.2;
    color: var(--xtu-ps-text, #333);
  }

  .xtu-ps__body > *:first-child {
    margin-top: 0;
  }

  .xtu-ps__body > *:last-child {
    margin-bottom: 0;
  }

  .xtu-ps__body p {
    margin: 0 0 var(--xtu-space-12, 12px);
  }

  .xtu-ps__body a {
    color: var(--color-5, #0070ca);
  }

  @media screen and (max-width: 989px) {
    .xtu-ps__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--xtu-space-32, 32px) var(--xtu-space-16, 16px);
    }

    .xtu-ps__list--line .xtu-ps__step:not(:last-child) .xtu-ps__icon-wrap::after {
      display: none;
    }

    .xtu-ps__list--line .xtu-ps__step:not(:nth-child(2n)):not(:last-child) .xtu-ps__icon-wrap::after {
      display: block;
      left: calc(var(--xtu-ps-icon-size, 48px) + 8px);
      width: calc(100% - var(--xtu-ps-icon-size, 48px) - 16px + var(--xtu-space-16, 16px));
    }

    .xtu-ps__title {
      font-size: var(--xtu-type-group-title-m);
    }
  }

  @media screen and (max-width: 749px) {
    .xtu-ps {
      padding: var(--xtu-ps-pt-m, 40px) 0 var(--xtu-ps-pb-m, 40px);
    }

    .xtu-ps__header {
      margin-bottom: var(--xtu-space-20, 20px);
    }

    .xtu-ps__heading {
      font-size: var(--xtu-type-section-title-m);
    }

    .xtu-ps__subheading {
      margin-top: var(--xtu-space-12, 12px);
      font-size: var(--xtu-type-section-subtitle-m);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU Process Steps",
  "tag": "section",
  "class": "section-xtu-process-steps",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "标题"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "大标题",
      "default": "Ready to Kick Off?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "副标题"
    },
    {
      "type": "header",
      "content": "布局"
    },
    {
      "type": "checkbox",
      "id": "show_line",
      "label": "显示步骤连线",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "图标尺寸",
      "min": 32,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "步骤间距（PC）",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "颜色与布局"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "版块背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "内容区背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "正文颜色",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "副标题颜色",
      "default": "#8E9297"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "图标颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "连线颜色",
      "default": "#DFDFDF"
    },
    {
      "type": "number",
      "id": "content_width",
      "label": "内容区最大宽度（px）",
      "default": 1200,
      "info": "范围 600–1600。"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "步骤",
      "settings": [
        {
          "type": "select",
          "id": "icon_style",
          "label": "图标",
          "options": [
            { "value": "user", "label": "用户 +" },
            { "value": "check", "label": "勾选" },
            { "value": "plane", "label": "纸飞机" },
            { "value": "dollar", "label": "美元" },
            { "value": "custom", "label": "自定义上传" }
          ],
          "default": "user"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "自定义图标",
          "info": "图标选「自定义上传」时生效。建议正方形线框图。"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Sign Up"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "说明",
          "default": "<p>Join the program by applying through our partner platforms.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "XTU Process Steps",
      "settings": {
        "heading": "Ready to Kick Off?",
        "subheading": ""
      },
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon_style": "user",
            "title": "Sign Up",
            "body": "<p>Join the Vantrue Affiliate Program by applying through Impact or Awin.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_style": "check",
            "title": "Get Approved",
            "body": "<p>Receive your tracking links, promo codes, and campaign assets.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_style": "plane",
            "title": "Start Promoting",
            "body": "<p>Share Vantrue products across social media, YouTube, blogs, or newsletters.</p>"
          }
        },
        {
          "type": "step",
          "settings": {
            "icon_style": "dollar",
            "title": "Track & Earn",
            "body": "<p>Monitor performance in real time and get paid through our transparent commission system.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
