{% liquid
  assign heading = section.settings.heading
  assign gap = section.settings.card_gap | default: 16
  assign gap_mobile = section.settings.card_gap_mobile | default: 8
  assign card_radius = section.settings.card_radius | default: 16
  assign card_ratio = section.settings.card_ratio | default: '3 / 4'
  assign ratio_auto = false
  if card_ratio == 'auto'
    assign ratio_auto = true
  endif
  assign show_arrows = section.settings.show_arrows
  assign show_arrows_mobile = section.settings.show_arrows_mobile
  assign show_button_arrow = section.settings.show_button_arrow
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
%}

<script src="{{ 'xtu-story-slider.js' | asset_url }}" defer="defer"></script>

<section
  id="xtu-story-slider-{{ section.id }}"
  class="xtu-story-slider{% if ratio_auto %} xtu-story-slider--ratio-auto{% endif %}"
  data-xtu-story-slider
  data-gap="{{ gap }}"
  data-gap-mobile="{{ gap_mobile }}"
  style="
    --xtu-ss-gap: {{ gap }}px;
    --xtu-ss-gap-mobile: {{ gap_mobile }}px;
    --xtu-ss-radius: {{ card_radius }}px;
    {% unless ratio_auto %}--xtu-ss-ratio: {{ card_ratio }};{% endunless %}
    --xtu-ss-padding-top: {{ padding_top }}px;
    --xtu-ss-padding-bottom: {{ padding_bottom }}px;
    --xtu-ss-padding-top-mobile: {{ padding_top_mobile }}px;
    --xtu-ss-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  "
>
  <div class="xtu-story-slider__intro" data-xtu-reveal="fade-up">
    {% if heading != blank %}
      <h2 class="xtu-story-slider__heading">
        {{ heading | escape }}
      </h2>
    {% endif %}

    {% if show_arrows and section.blocks.size > 1 %}
      <div class="xtu-swiper-nav-group{% unless show_arrows_mobile %} xtu-swiper-nav-group--hide-mobile{% endunless %}">
        {% render 'xtu-swiper-nav',
          variant: 'on-light',
          prev_attributes: 'data-xtu-story-prev',
          next_attributes: 'data-xtu-story-next'
        %}
      </div>
    {% endif %}
  </div>

  <div class="xtu-story-slider__viewport" data-xtu-reveal="fade-up">
    <div class="swiper xtu-story-slider__swiper" data-xtu-story-swiper>
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% if block.type == 'card' %}
            {% liquid
              assign media_type = block.settings.media_type | default: 'image'
              assign card_image = block.settings.image
              assign card_image_mobile = block.settings.image_mobile
              assign card_video = block.settings.video
              assign card_video_mobile = block.settings.video_mobile
              assign video_url = block.settings.video_url
              assign has_mobile_image = false
              if card_image_mobile != blank
                assign has_mobile_image = true
              endif
              assign has_mobile_video = false
              if card_video_mobile != blank
                assign has_mobile_video = true
              endif
              assign is_video = false
              if media_type == 'video'
                if card_video != blank or card_video_mobile != blank
                  assign is_video = true
                endif
              endif
              assign is_youtube = false
              if media_type == 'youtube'
                assign is_youtube = true
              endif
              assign corner_icon = block.settings.corner_icon
              assign corner_link = block.settings.corner_link
              assign recommend_product = block.settings.product
              assign recommend_image = block.settings.product_image
              if recommend_image == blank and recommend_product != blank
                assign recommend_image = recommend_product.featured_image
              endif
              assign btn_label = block.settings.button_label
              assign btn_link = block.settings.button_link
              assign product_link = ''
              if recommend_product != blank
                assign product_link = recommend_product.url
              endif
              assign btn_bg = block.settings.button_bg
              assign btn_color = block.settings.button_color
              assign btn_bg_hover = block.settings.button_bg_hover
              assign btn_color_hover = block.settings.button_color_hover
              assign product_alt = btn_label
              if recommend_product != blank and recommend_product.title != blank
                assign product_alt = recommend_product.title
              endif
            %}
            <article
              class="swiper-slide xtu-story-slider__card"
              data-xtu-story-card
              data-media-type="{% if is_youtube %}youtube{% elsif is_video %}video{% else %}image{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div class="xtu-story-slider__media{% if media_type == 'image' and has_mobile_image %} xtu-story-slider__media--split{% endif %}{% if media_type == 'video' and has_mobile_video %} xtu-story-slider__media--split{% endif %}">
                {% if is_youtube %}
                  {% render 'xtu-video-embed',
                    video_url: video_url,
                    mode: 'embed',
                    class: 'xtu-story-slider__youtube',
                    title: heading,
                    placeholder: 'lifestyle-1',
                    placeholder_class: 'xtu-story-slider__image xtu-story-slider__placeholder'
                  %}
                {% elsif is_video %}
                  {% if card_video != blank %}
                    {{
                      card_video
                      | video_tag:
                        class: 'xtu-story-slider__video xtu-story-slider__video--desktop',
                        image_size: '1200x',
                        controls: false,
                        autoplay: false,
                        loop: false,
                        muted: false,
                        playsinline: true,
                        preload: 'metadata'
                    }}
                  {% endif %}
                  {% if has_mobile_video %}
                    {{
                      card_video_mobile
                      | video_tag:
                        class: 'xtu-story-slider__video xtu-story-slider__video--mobile',
                        image_size: '1000x',
                        controls: false,
                        autoplay: false,
                        loop: false,
                        muted: false,
                        playsinline: true,
                        preload: 'metadata'
                    }}
                  {% endif %}
                  {% if card_video == blank and has_mobile_video == false %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'xtu-story-slider__image xtu-story-slider__placeholder' }}
                  {% endif %}
                  <button
                    type="button"
                    class="xtu-story-slider__play"
                    data-xtu-story-play
                    aria-label="Play video"
                  >
                    <span class="xtu-story-slider__play-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M8.5 6.8v10.4L18 12 8.5 6.8Z" fill="currentColor"/>
                      </svg>
                    </span>
                  </button>
                {% elsif card_image != blank %}
                  {{
                    card_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'xtu-story-slider__image xtu-story-slider__image--desktop',
                      loading: 'lazy',
                      widths: '360, 480, 720, 960, 1200',
                      sizes: '(min-width: 750px) 22vw, 85vw',
                      alt: heading
                  }}
                  {% if has_mobile_image %}
                    {{
                      card_image_mobile
                      | image_url: width: 1000
                      | image_tag:
                        class: 'xtu-story-slider__image xtu-story-slider__image--mobile',
                        loading: 'lazy',
                        widths: '360, 480, 720, 960, 1000',
                        sizes: '85vw',
                        alt: heading
                    }}
                  {% endif %}
                {% else %}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'xtu-story-slider__image xtu-story-slider__placeholder' }}
                {% endif %}
              </div>

              {% if corner_icon != blank %}
                {% if corner_link != blank %}
                  <a
                    class="xtu-story-slider__corner"
                    href="{{ corner_link }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Open link"
                  >
                    {{
                      corner_icon
                      | image_url: width: 96
                      | image_tag:
                        class: 'xtu-story-slider__corner-icon',
                        loading: 'lazy',
                        widths: '48, 72, 96',
                        sizes: '28px',
                        alt: ''
                    }}
                  </a>
                {% else %}
                  <span class="xtu-story-slider__corner" aria-hidden="true">
                    {{
                      corner_icon
                      | image_url: width: 96
                      | image_tag:
                        class: 'xtu-story-slider__corner-icon',
                        loading: 'lazy',
                        widths: '48, 72, 96',
                        sizes: '28px',
                        alt: ''
                    }}
                  </span>
                {% endif %}
              {% endif %}

              {% liquid
                assign show_product_thumb = false
                if recommend_image != blank and product_link != blank
                  assign show_product_thumb = true
                endif
                assign show_card_button = false
                if btn_label != blank and btn_link != blank
                  assign show_card_button = true
                endif
              %}
              {% if show_product_thumb or show_card_button %}
                <div class="xtu-story-slider__footer">
                  {% if show_product_thumb %}
                    <a
                      class="xtu-story-slider__product"
                      href="{{ product_link }}"
                      aria-label="{{ product_alt | escape }}"
                    >
                      {{
                        recommend_image
                        | image_url: width: 160
                        | image_tag:
                          class: 'xtu-story-slider__product-image',
                          loading: 'lazy',
                          widths: '80, 120, 160',
                          sizes: '56px',
                          alt: product_alt
                      }}
                    </a>
                  {% elsif recommend_image != blank %}
                    <div class="xtu-story-slider__product" aria-hidden="true">
                      {{
                        recommend_image
                        | image_url: width: 160
                        | image_tag:
                          class: 'xtu-story-slider__product-image',
                          loading: 'lazy',
                          widths: '80, 120, 160',
                          sizes: '56px',
                          alt: product_alt
                      }}
                    </div>
                  {% endif %}

                  {% if show_card_button %}
                    {% render 'xtu-btn',
                      label: btn_label,
                      href: btn_link,
                      size: 'sm',
                      show_arrow: show_button_arrow,
                      bg: btn_bg,
                      color: btn_color,
                      bg_hover: btn_bg_hover,
                      color_hover: btn_color_hover,
                      class: 'xtu-story-slider__btn'
                    %}
                  {% endif %}
                </div>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .xtu-story-slider {
    --xtu-ss-inset: var(--util-page-margin-offset, var(--page-margin));
    padding: var(--xtu-ss-padding-top, 80px) 0 var(--xtu-ss-padding-bottom, 80px);
    background: #fff;
    overflow: hidden;
  }

  .xtu-story-slider__intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: min(var(--page-width), 100%);
    margin: 0 auto var(--xtu-space-40, 40px);
    padding-inline: var(--page-margin);
    box-sizing: border-box;
    min-height: 45px;
  }

  .xtu-story-slider__heading {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-align: left;
    color: #111827;
  }

  .xtu-story-slider__viewport {
    width: 100%;
    overflow: hidden;
  }

  .xtu-story-slider__swiper {
    overflow: visible;
  }

  .xtu-story-slider__card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: calc(
      (min(var(--page-content-width), calc(100% - var(--page-margin) * 2)) - (var(--xtu-ss-gap, 16px) * 3)) / 4
    );
    height: auto;
    border-radius: var(--xtu-ss-radius, 16px);
    overflow: hidden;
    background: #e8eaed;
    isolation: isolate;
    box-sizing: border-box;
  }

  .xtu-story-slider__media {
    position: relative;
    width: 100%;
    aspect-ratio: var(--xtu-ss-ratio, 3 / 4);
    overflow: hidden;
    background: #e8eaed;
  }

  .xtu-story-slider__image,
  .xtu-story-slider__video,
  .xtu-story-slider__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .xtu-story-slider__placeholder {
    background: #d0d5dd;
  }

  .xtu-story-slider__youtube {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .xtu-story-slider__image--mobile,
  .xtu-story-slider__video--mobile {
    display: none;
  }

  .xtu-story-slider__video {
    cursor: pointer;
  }

  .xtu-story-slider__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #111827;
    cursor: pointer;
    appearance: none;
    transform: translate(-50%, -50%);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
    transition:
      opacity 0.25s ease,
      transform 0.25s var(--xtu-ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      background 0.25s ease;
  }

  .xtu-story-slider__play:hover {
    background: #f5f5f7;
    transform: translate(-50%, -50%) scale(1.04);
  }

  .xtu-story-slider__play:focus-visible {
    outline: 2px solid #0070ca;
    outline-offset: 3px;
  }

  .xtu-story-slider__card.is-playing .xtu-story-slider__play {
    opacity: 0;
    pointer-events: none;
  }

  .xtu-story-slider__play-icon {
    display: block;
    width: 28px;
    height: 28px;
    margin-left: 2px;
  }

  .xtu-story-slider__play-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .xtu-story-slider__corner {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    text-decoration: none;
  }

  .xtu-story-slider__corner-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .xtu-story-slider__footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 20px 16px 18px;
    box-sizing: border-box;
    pointer-events: none;
  }

  .xtu-story-slider__product {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.16);
    text-decoration: none;
    pointer-events: auto;
    transition: transform 0.25s var(--xtu-ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  a.xtu-story-slider__product:hover {
    transform: scale(1.04);
  }

  a.xtu-story-slider__product:focus-visible {
    outline: 2px solid #0070ca;
    outline-offset: 2px;
  }

  .xtu-story-slider__product-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .xtu-story-slider__btn {
    pointer-events: auto;
    min-width: 132px;
  }

  .xtu-story-slider__corner {
    pointer-events: auto;
  }

  @media screen and (max-width: 749px) {
    .xtu-story-slider__media--split .xtu-story-slider__image--desktop,
    .xtu-story-slider__media--split .xtu-story-slider__video--desktop {
      display: none;
    }

    .xtu-story-slider__media--split .xtu-story-slider__image--mobile,
    .xtu-story-slider__media--split .xtu-story-slider__video--mobile {
      display: block;
    }

    .xtu-story-slider {
      --xtu-ss-inset: var(--page-margin);
      --xtu-ss-gap: var(--xtu-ss-gap-mobile, 8px);
      padding: var(--xtu-ss-padding-top-mobile, 40px) 0 var(--xtu-ss-padding-bottom-mobile, 40px);
      overflow-x: hidden;
    }

    .xtu-story-slider__intro {
      width: 100%;
      margin-bottom: var(--xtu-space-20, 20px);
      padding-inline: var(--page-margin);
      box-sizing: border-box;
      min-height: 40px;
      gap: 12px;
    }

    .xtu-story-slider__heading {
      font-size: 1.5rem;
    }

    .xtu-story-slider__card {
      width: auto;
    }

    .xtu-story-slider__play {
      width: 56px;
      height: 56px;
    }

    .xtu-story-slider__play-icon {
      width: 24px;
      height: 24px;
    }

    .xtu-story-slider__product {
      width: 48px;
      height: 48px;
    }

    .xtu-story-slider__footer {
      gap: 10px;
      padding: 16px 12px 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU Story Slider",
  "tag": "section",
  "class": "xtu-story-slider-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Real-Life Stories in Action"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "显示左右切换按钮",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "移动端显示左右切换按钮",
      "info": "Peek 露出邻卡时默认关闭，可滑动浏览",
      "default": false,
      "visible_if": "{{ section.settings.show_arrows == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_button_arrow",
      "label": "按钮显示箭头图标",
      "info": "启用后，本区块内所有卡片按钮同步显示箭头",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "桌面端：版心内等分 4 卡，右侧可溢出 peek；滑动后左侧也可露出。移动端：1.1 卡。"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "桌面卡片间距",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "移动端卡片间距",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "卡片圆角",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "卡片比例",
      "options": [
            { "value": "auto", "label": "自适应（按媒体比例）" },
            { "value": "1 / 1", "label": "1:1" },
            { "value": "4 / 5", "label": "4:5" },
            { "value": "3 / 4", "label": "3:4" },
            { "value": "2 / 3", "label": "2:3" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "header",
      "content": "边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "故事卡片",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "媒体类型",
          "options": [
            { "value": "image", "label": "图片" },
            { "value": "video", "label": "上传视频" },
            { "value": "youtube", "label": "视频链接" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片（PC）",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "图片（移动端）",
          "info": "可选。未配置时移动端使用 PC 图。",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "上传视频（PC）",
          "info": "卡片中央显示播放按钮",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "上传视频（移动端）",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "视频链接",
          "accept": ["youtube", "vimeo"],
          "info": "支持 YouTube / Vimeo。",
          "visible_if": "{{ block.settings.media_type == 'youtube' }}"
        },
        {
          "type": "header",
          "content": "右上角图标"
        },
        {
          "type": "image_picker",
          "id": "corner_icon",
          "label": "图标",
          "info": "建议透明底 PNG，如社交平台标识"
        },
        {
          "type": "url",
          "id": "corner_link",
          "label": "图标链接"
        },
        {
          "type": "header",
          "content": "推荐产品与按钮"
        },
        {
          "type": "product",
          "id": "product",
          "label": "推荐产品",
          "info": "默认使用产品主图与产品链接"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "自定义推荐图",
          "info": "填写后覆盖产品主图"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "按钮文案",
          "default": "Learn More"
        },
