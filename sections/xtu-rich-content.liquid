{%- comment -%}
  XTU Rich Content — 产品/内容页图文混排。

  数据来源：Theme Editor 本 section 的 blocks。
  - 段落 / 富文本：文案与字号、对齐、间距。
  - 图片：仅 PC/移动分图 + 比例/宽度/圆角；不再选择视频。
  - 视频：独立 block。可选手动上传（PC/移动）或 YouTube/Vimeo 链接；
    可配封面图；未配封面时上传视频用 Shopify preview_image 首帧，
    仍缺则前台截取第一帧；YouTube 用官方缩略图。点击封面才播放。

  运营：在 Theme Editor 按顺序添加段落、富文本、图片、视频 block。

  相关：assets/xtu-rich-content.js、snippets/xtu-media.liquid
{%- endcomment -%}

{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_align = section.settings.heading_align | default: 'left'
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign content_background = section.settings.content_background | default: '#FFFFFF'
  assign content_width = section.settings.content_width | default: 1200 | at_least: 600 | at_most: 1600
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign link_color = section.settings.link_color | default: '#0070CA'
%}

<script src="{{ 'xtu-rich-content.js' | asset_url }}" defer="defer"></script>

<section
  id="xtu-rich-content-{{ section.id }}"
  class="xtu-rc"
  style="
    --xtu-rc-bg: {{ background_color }};
    --xtu-rc-content-bg: {{ content_background }};
    --xtu-rc-content-width: {{ content_width }}px;
    --xtu-rc-pt: {{ padding_top }}px;
    --xtu-rc-pb: {{ padding_bottom }}px;
    --xtu-rc-pt-m: {{ padding_top_mobile }}px;
    --xtu-rc-pb-m: {{ padding_bottom_mobile }}px;
    --xtu-rc-link-color: {{ link_color }};
  "
>
  <div class="xtu-rc__inner" data-xtu-reveal="fade-up" data-xtu-stagger>
    {% if heading != blank or subheading != blank %}
      <div class="xtu-rc__header xtu-rc__header--{{ heading_align }}" data-xtu-reveal-child>
        {% if heading != blank %}
          <h2 class="xtu-rc__heading">{{ heading | escape }}</h2>
        {% endif %}
        {% if subheading != blank %}
          <p class="xtu-rc__subheading">{{ subheading | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="xtu-rc__blocks">
        {% for block in section.blocks %}
          {% liquid
            assign spacing = block.settings.spacing | default: 24
            assign spacing_mobile = block.settings.spacing_mobile | default: 16
          %}
          {% case block.type %}
            {% when 'paragraph' %}
              {% liquid
                assign text = block.settings.text
                assign align = block.settings.align | default: 'left'
                assign font_size = block.settings.font_size | default: 14
                assign font_size_mobile = block.settings.font_size_mobile | default: 14
                assign text_color = block.settings.text_color | default: '#333333'
              %}
              {% if text != blank %}
                <div
                  class="xtu-rc__block xtu-rc__block--paragraph xtu-rc__block--{{ align }}"
                  style="
                    --xtu-rc-block-space: {{ spacing }}px;
                    --xtu-rc-block-space-m: {{ spacing_mobile }}px;
                    --xtu-rc-block-size: {{ font_size }}px;
                    --xtu-rc-block-size-m: {{ font_size_mobile }}px;
                    --xtu-rc-block-color: {{ text_color }};
                  "
                  data-xtu-reveal-child
                  {{ block.shopify_attributes }}
                >
                  <p class="xtu-rc__paragraph">{{ text | escape | newline_to_br }}</p>
                </div>
              {% endif %}

            {% when 'richtext' %}
              {% liquid
                assign body = block.settings.body
                assign align = block.settings.align | default: 'left'
                assign font_size = block.settings.font_size | default: 14
                assign font_size_mobile = block.settings.font_size_mobile | default: 14
                assign text_color = block.settings.text_color | default: '#333333'
              %}
              {% if body != blank %}
                <div
                  class="xtu-rc__block xtu-rc__block--richtext xtu-rc__block--{{ align }}"
                  style="
                    --xtu-rc-block-space: {{ spacing }}px;
                    --xtu-rc-block-space-m: {{ spacing_mobile }}px;
                    --xtu-rc-block-size: {{ font_size }}px;
                    --xtu-rc-block-size-m: {{ font_size_mobile }}px;
                    --xtu-rc-block-color: {{ text_color }};
                  "
                  data-xtu-reveal-child
                  {{ block.shopify_attributes }}
                >
                  <div class="xtu-rc__richtext rte">{{ body }}</div>
                </div>
              {% endif %}

            {% when 'image' %}
              {% liquid
                assign image = block.settings.image
                assign image_mobile = block.settings.image_mobile
                assign media_ratio = block.settings.media_ratio | default: 'auto'
                assign align = block.settings.align | default: 'center'
                assign image_width = block.settings.image_width | default: 100
                assign image_radius = block.settings.image_radius | default: 16
                assign alt_text = block.settings.alt | default: heading | default: 'Content image'
                assign ratio_auto = true
                if media_ratio != 'auto'
                  assign ratio_auto = false
                endif
                assign ph_mod = forloop.index0 | modulo: 3
                assign placeholder_name = 'lifestyle-1'
                if ph_mod == 1
                  assign placeholder_name = 'lifestyle-2'
                elsif ph_mod == 2
                  assign placeholder_name = 'image'
                endif
              %}
              <div
                class="xtu-rc__block xtu-rc__block--image xtu-rc__block--{{ align }}"
                style="
                  --xtu-rc-block-space: {{ spacing }}px;
                  --xtu-rc-block-space-m: {{ spacing_mobile }}px;
                  --xtu-rc-img-width: {{ image_width }}%;
                  --xtu-rc-img-radius: {{ image_radius }}px;
                  {% unless ratio_auto %}--xtu-rc-ratio: {{ media_ratio }};{% endunless %}
                "
                data-xtu-reveal-child
                {{ block.shopify_attributes }}
              >
                <div class="xtu-rc__media{% unless ratio_auto %} xtu-rc__media--ratio{% endunless %} xtu-img-zoom">
                  {% render 'xtu-media',
                    media_type: 'image',
                    image: image,
                    image_mobile: image_mobile,
                    alt: alt_text,
                    placeholder: placeholder_name,
                    fill: true,
                    zoom: true,
                    sizes_desktop: '(max-width: 749px) calc(100vw - 30px), min(var(--xtu-rc-content-width), calc(100vw - 80px))',
                    sizes_mobile: 'calc(100vw - 30px)'
                  %}
                </div>
              </div>

            {% when 'video' %}
              {% liquid
                assign video_source = block.settings.video_source | default: 'upload'
                assign video = block.settings.video
                assign video_mobile = block.settings.video_mobile
                assign video_url = block.settings.video_url
                assign cover = block.settings.cover
                assign media_ratio = block.settings.media_ratio | default: '16 / 9'
                assign align = block.settings.align | default: 'center'
                assign image_width = block.settings.image_width | default: 100
                assign image_radius = block.settings.image_radius | default: 16
                assign alt_text = block.settings.alt | default: heading | default: 'Video'

                assign video_src = blank
                assign video_src_m = blank
                assign embed_id = blank
                assign embed_type = 'youtube'
                assign cover_url = blank
                assign ratio_value = media_ratio
                if media_ratio == 'auto'
                  assign ratio_value = '16 / 9'
                endif

                if video_source == 'youtube' and video_url != blank
                  if video_url.id != blank
                    assign embed_id = video_url.id
                    if video_url.type != blank
                      assign embed_type = video_url.type
                    endif
                  endif
                endif

                if video_source == 'upload' and video != blank
                  if video.sources != blank
                    for source in video.sources
                      assign source_format = source.format | default: '' | downcase
                      assign source_mime = source.mime_type | default: '' | downcase
                      assign source_href = source.url | default: ''
                      if source_href != blank
                        if source_format == 'mp4' or source_mime == 'video/mp4' or source_href contains '.mp4'
                          unless source_href contains '.m3u8'
                            assign video_src = source_href
                            break
                          endunless
                        endif
                      endif
                    endfor
                    if video_src == blank
                      for source in video.sources
                        assign source_href = source.url | default: ''
                        if source_href != blank
                          unless source_href contains '.m3u8'
                            assign video_src = source_href
                            break
                          endunless
                        endif
                      endfor
                    endif
                  endif
                  if video_src == blank and video.url != blank
                    unless video.url contains '.m3u8'
                      assign video_src = video.url
                    endunless
                  endif
                  if media_ratio == 'auto' and video.aspect_ratio != blank
                    assign ratio_value = video.aspect_ratio | append: ' / 1'
                  endif
                endif

                if video_source == 'upload' and video_mobile != blank
                  if video_mobile.sources != blank
                    for source in video_mobile.sources
                      assign source_format = source.format | default: '' | downcase
                      assign source_mime = source.mime_type | default: '' | downcase
                      assign source_href = source.url | default: ''
                      if source_href != blank
                        if source_format == 'mp4' or source_mime == 'video/mp4' or source_href contains '.mp4'
                          unless source_href contains '.m3u8'
                            assign video_src_m = source_href
                            break
                          endunless
                        endif
                      endif
                    endfor
                    if video_src_m == blank
                      for source in video_mobile.sources
                        assign source_href = source.url | default: ''
                        if source_href != blank
                          unless source_href contains '.m3u8'
                            assign video_src_m = source_href
                            break
                          endunless
                        endif
                      endfor
                    endif
                  endif
                  if video_src_m == blank and video_mobile.url != blank
                    unless video_mobile.url contains '.m3u8'
                      assign video_src_m = video_mobile.url
                    endunless
                  endif
                endif

                if cover != blank
                  assign cover_url = cover | image_url: width: 1600
                elsif video_source == 'upload' and video != blank and video.preview_image != blank
                  assign cover_url = video.preview_image | image_url: width: 1600
                elsif embed_id != blank and embed_type == 'youtube'
                  assign cover_url = 'https://i.ytimg.com/vi/' | append: embed_id | append: '/hqdefault.jpg'
                endif

                assign has_video = false
                if embed_id != blank or video_src != blank or video_src_m != blank
                  assign has_video = true
                endif
              %}
              <div
                class="xtu-rc__block xtu-rc__block--video xtu-rc__block--{{ align }}"
                style="
                  --xtu-rc-block-space: {{ spacing }}px;
                  --xtu-rc-block-space-m: {{ spacing_mobile }}px;
                  --xtu-rc-img-width: {{ image_width }}%;
                  --xtu-rc-img-radius: {{ image_radius }}px;
                  --xtu-rc-ratio: {{ ratio_value }};
                "
                data-xtu-reveal-child
                {{ block.shopify_attributes }}
              >
                <div
                  class="xtu-rc__media xtu-rc__media--ratio xtu-rc__player"
                  data-xtu-rc-video
                  data-embed-id="{{ embed_id | escape }}"
                  data-embed-type="{{ embed_type | escape }}"
                  data-video-url="{{ video_src | escape }}"
                  data-video-url-mobile="{{ video_src_m | escape }}"
                  data-cover="{{ cover_url | escape }}"
                  data-title="{{ alt_text | escape }}"
                >
                  <div class="xtu-rc__stage" data-xtu-rc-stage>
                    {% if has_video %}
                      <button
                        type="button"
                        class="xtu-rc__cover"
                        data-xtu-rc-cover
                        aria-label="Play {{ alt_text | escape }}"
                      >
                        {% if cover_url != blank %}
                          <img
                            class="xtu-rc__cover-media"
                            src="{{ cover_url | escape }}"
                            alt="{{ alt_text | escape }}"
                            loading="lazy"
                            decoding="async"
                            width="1600"
                            height="900"
                          >
                        {% elsif video_src != blank or video_src_m != blank %}
                          <video class="xtu-rc__cover-media" muted playsinline preload="metadata" aria-hidden="true"></video>
                        {% else %}
                          {{ 'lifestyle-1' | placeholder_svg_tag: 'xtu-rc__cover-media xtu-rc__placeholder' }}
                        {% endif %}
                        <span class="xtu-rc__play" aria-hidden="true">
                          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="24" cy="24" r="24" fill="rgb(0 0 0 / 0.55)"/>
                            <path d="M20 16.5v15l12-7.5-12-7.5Z" fill="#fff"/>
                          </svg>
                        </span>
                      </button>
                    {% else %}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'xtu-rc__cover-media xtu-rc__placeholder' }}
                    {% endif %}
                  </div>
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .xtu-rc {
    padding: var(--xtu-rc-pt, 80px) 0 var(--xtu-rc-pb, 80px);
    background: var(--xtu-rc-bg, #fff);
    box-sizing: border-box;
  }

  .xtu-rc__inner {
    width: min(var(--xtu-rc-content-width, 1200px), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
    background: var(--xtu-rc-content-bg, #fff);
    box-sizing: border-box;
  }

  .xtu-rc__header {
    margin-bottom: var(--xtu-space-40, 40px);
  }

  .xtu-rc__header--left {
    text-align: left;
  }

  .xtu-rc__header--center {
    text-align: center;
  }

  .xtu-rc__header--right {
    text-align: right;
  }

  .xtu-rc__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-section-title);
    font-weight: 600;
    line-height: 1.2;
    color: #000;
  }

  .xtu-rc__subheading {
    margin: var(--xtu-space-16, 16px) 0 0;
    max-width: 42rem;
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-section-subtitle);
    font-weight: 400;
    line-height: 1.2;
    color: #8e9297;
  }

  .xtu-rc__header--center .xtu-rc__subheading {
    margin-inline: auto;
  }

  .xtu-rc__header--right .xtu-rc__subheading {
    margin-left: auto;
  }

  .xtu-rc__blocks {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .xtu-rc__block {
    margin: 0 0 var(--xtu-rc-block-space, 24px);
  }

  .xtu-rc__block:last-child {
    margin-bottom: 0;
  }

  .xtu-rc__block--left {
    text-align: left;
  }

  .xtu-rc__block--center {
    text-align: center;
  }

  .xtu-rc__block--right {
    text-align: right;
  }

  .xtu-rc__paragraph {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: var(--xtu-rc-block-size, 14px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--xtu-rc-block-color, #333);
  }

  .xtu-rc__richtext {
    font-family: var(--font-body--family);
    font-size: var(--xtu-rc-block-size, 14px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--xtu-rc-block-color, #333);
  }

  .xtu-rc__richtext > *:first-child {
    margin-top: 0;
  }

  .xtu-rc__richtext > *:last-child {
    margin-bottom: 0;
  }

  .xtu-rc__richtext p,
  .xtu-rc__richtext ul,
  .xtu-rc__richtext ol {
    margin: 0 0 var(--xtu-space-12, 12px);
  }

  .xtu-rc__richtext a {
    color: var(--xtu-rc-link-color, #0070ca);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  .xtu-rc__richtext a:hover {
    opacity: 0.85;
  }

  .xtu-rc__block--image .xtu-rc__media,
  .xtu-rc__block--video .xtu-rc__media {
    width: min(100%, var(--xtu-rc-img-width, 100%));
    margin-inline: 0;
    overflow: hidden;
    border-radius: var(--xtu-rc-img-radius, 16px);
    background: #e8eaed;
  }

  .xtu-rc__block--image.xtu-rc__block--center .xtu-rc__media,
  .xtu-rc__block--video.xtu-rc__block--center .xtu-rc__media {
    margin-inline: auto;
  }

  .xtu-rc__block--image.xtu-rc__block--right .xtu-rc__media,
  .xtu-rc__block--video.xtu-rc__block--right .xtu-rc__media {
    margin-left: auto;
    margin-right: 0;
  }

  .xtu-rc__media--ratio {
    aspect-ratio: var(--xtu-rc-ratio, 16 / 9);
  }

  .xtu-rc__block--image .xtu-rc__media .xtu-media {
    height: 100%;
  }

  .xtu-rc__block--image .xtu-rc__media--ratio .xtu-media__item {
    height: 100%;
    object-fit: cover;
  }

  .xtu-rc__player {
    position: relative;
    background: #111111;
  }

  .xtu-rc__stage {
    position: absolute;
    inset: 0;
  }

  .xtu-rc__cover {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: #111111;
    cursor: pointer;
    appearance: none;
  }

  .xtu-rc__cover[hidden] {
    display: none !important;
  }

  .xtu-rc__cover-media,
  .xtu-rc__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    background: #111111;
  }

  .xtu-rc__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    width: 48px;
    height: 48px;
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: transform 0.2s ease;
  }

  .xtu-rc__play svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .xtu-rc__cover:hover .xtu-rc__play {
    transform: translate(-50%, -50%) scale(1.06);
  }

  .xtu-rc__player-iframe,
  .xtu-rc__player-video {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000000;
  }

  .xtu-rc__player-video {
    object-fit: contain;
  }

  .xtu-rc__image--mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .xtu-rc {
      padding: var(--xtu-rc-pt-m, 40px) 0 var(--xtu-rc-pb-m, 40px);
    }

    .xtu-rc__header {
      margin-bottom: var(--xtu-space-20, 20px);
    }

    .xtu-rc__heading {
      font-size: var(--xtu-type-section-title-m);
    }

    .xtu-rc__subheading {
      margin-top: var(--xtu-space-12, 12px);
      font-size: var(--xtu-type-section-subtitle-m);
      max-width: none;
    }

    .xtu-rc__block {
      margin-bottom: var(--xtu-rc-block-space-m, 16px);
    }

    .xtu-rc__block:last-child {
      margin-bottom: 0;
    }

    .xtu-rc__paragraph,
    .xtu-rc__richtext {
      font-size: var(--xtu-rc-block-size-m, 14px);
    }

    .xtu-rc__media--split .xtu-rc__image--desktop {
      display: none;
    }

    .xtu-rc__media--split .xtu-rc__image--mobile {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU Rich Content",
  "tag": "section",
  "class": "section-xtu-rich-content",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "标题"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "大标题",
      "default": "Section title"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "副标题",
      "default": "Supporting subtitle"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "标题对齐",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "版块背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "内容区背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "链接文字色",
      "default": "#0070CA",
      "info": "富文本 block 中带链接的文字颜色，并带下划线。"
    },
    {
      "type": "header",
      "content": "布局"
    },
    {
      "type": "number",
      "id": "content_width",
      "label": "内容区最大宽度（px）",
      "default": 1200,
      "info": "范围 600–1600，超出将自动限制。"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "段落文案",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "段落内容",
          "default": "Add a paragraph of supporting copy."
        },
        {
          "type": "select",
          "id": "align",
          "label": "对齐",
          "options": [
            { "value": "left", "label": "左对齐" },
            { "value": "center", "label": "居中" },
