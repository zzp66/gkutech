{%- comment -%}
  XTU Buying Guide — 通栏选购指南：背景图/视频 + 文案与双 CTA。
  数据：Theme Editor（PC/移动分图或视频、占位模式、按钮与边距、颜色）。
  前台：PC/移动可分别选择「素材比例」或「固定高度」占位；文案叠在媒体上。
  相关：xtu-img-zoom、xtu-reveal。
{%- endcomment -%}
{% liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign image_desktop = section.settings.image
  assign image_mobile = section.settings.image_mobile
  assign media_type = section.settings.media_type | default: 'image'
  assign video = section.settings.video
  assign video_mobile = section.settings.video_mobile
  assign video_url = section.settings.video_url
  assign has_mobile_image = false
  if image_mobile != blank
    assign has_mobile_image = true
  endif
  assign primary_label = section.settings.primary_label
  assign primary_link = section.settings.primary_link
  assign secondary_label = section.settings.secondary_label
  assign secondary_link = section.settings.secondary_link
  assign show_image_overlay = section.settings.show_image_overlay
  assign has_mobile_video = false
  if video_mobile != blank
    assign has_mobile_video = true
  endif
  assign media_sizing = section.settings.media_sizing | default: 'natural'
  assign media_sizing_mobile = section.settings.media_sizing_mobile | default: 'natural'
  assign media_height = section.settings.media_height | default: 400
  assign media_height_mobile = section.settings.media_height_mobile | default: 350
  if media_height < 120
    assign media_height = 120
  elsif media_height > 900
    assign media_height = 900
  endif
  if media_height_mobile < 120
    assign media_height_mobile = 120
  elsif media_height_mobile > 900
    assign media_height_mobile = 900
  endif
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign card_background = section.settings.card_background | default: '#F5F5F7'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#7A8599'
  assign heading_color = section.settings.heading_color | default: '#111827'
  assign button_bg = section.settings.button_bg | default: '#22242A'
  assign button_bg_hover = section.settings.button_bg_hover | default: '#1A1C21'
  assign button_color = section.settings.button_color | default: '#FFFFFF'
  assign link_color = section.settings.link_color | default: '#667085'
  assign link_color_hover = section.settings.link_color_hover | default: '#111827'
  assign placeholder_bg = section.settings.placeholder_bg | default: '#E8EAED'
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
%}

<section
  id="xtu-buying-guide-{{ section.id }}"
  class="xtu-buying-guide xtu-buying-guide--pc-{{ media_sizing }} xtu-buying-guide--m-{{ media_sizing_mobile }}"
  style="
    --xtu-bg-bg: {{ background_color }};
    --xtu-bg-card-bg: {{ card_background }};
    --xtu-bg-eyebrow: {{ eyebrow_color }};
    --xtu-bg-heading: {{ heading_color }};
    --xtu-bg-btn-bg: {{ button_bg }};
    --xtu-bg-btn-bg-hover: {{ button_bg_hover }};
    --xtu-bg-btn-color: {{ button_color }};
    --xtu-bg-link: {{ link_color }};
    --xtu-bg-link-hover: {{ link_color_hover }};
    --xtu-bg-placeholder-bg: {{ placeholder_bg }};
    --xtu-bg-media-height: {{ media_height }}px;
    --xtu-bg-media-height-mobile: {{ media_height_mobile }}px;
    --xtu-bg-padding-top: {{ padding_top }}px;
    --xtu-bg-padding-bottom: {{ padding_bottom }}px;
    --xtu-bg-padding-top-mobile: {{ padding_top_mobile }}px;
    --xtu-bg-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  "
>
  <article class="xtu-buying-guide__card xtu-img-zoom">
    <div class="xtu-buying-guide__media{% if media_type == 'image' and has_mobile_image %} xtu-buying-guide__media--split{% endif %}{% if media_type == 'video' and has_mobile_video %} xtu-buying-guide__media--split{% endif %}">
      {% if media_type == 'video' %}
        {% if video != blank %}
          {{
            video
            | video_tag:
              class: 'xtu-buying-guide__video xtu-buying-guide__image--desktop',
              image_size: '2400x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true
          }}
        {% endif %}
        {% if has_mobile_video %}
          {{
            video_mobile
            | video_tag:
              class: 'xtu-buying-guide__video xtu-buying-guide__image--mobile',
              image_size: '1200x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true
          }}
        {% endif %}
        {% if video == blank and has_mobile_video == false %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'xtu-buying-guide__image xtu-img-zoom__media xtu-buying-guide__placeholder' }}
        {% endif %}
      {% elsif media_type == 'youtube' %}
        {% render 'xtu-video-embed',
          video_url: video_url,
          mode: 'ambient',
          class: 'xtu-buying-guide__youtube',
          title: heading,
          placeholder: 'lifestyle-1',
          placeholder_class: 'xtu-buying-guide__image xtu-img-zoom__media xtu-buying-guide__placeholder'
        %}
      {% else %}
      {% if image_desktop != blank %}
        {{
          image_desktop
          | image_url: width: 2400
          | image_tag:
            class: 'xtu-buying-guide__image xtu-buying-guide__image--desktop xtu-img-zoom__media',
            loading: 'lazy',
            widths: '800, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            alt: heading
        }}
      {% endif %}
      {% if has_mobile_image %}
        {{
          image_mobile
          | image_url: width: 1200
          | image_tag:
            class: 'xtu-buying-guide__image xtu-buying-guide__image--mobile xtu-img-zoom__media',
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1200',
            sizes: '100vw',
            alt: heading
        }}
      {% endif %}
      {% if image_desktop == blank and has_mobile_image == false %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'xtu-buying-guide__image xtu-img-zoom__media xtu-buying-guide__placeholder' }}
      {% endif %}
      {% endif %}
      {% if show_image_overlay %}
        <div class="xtu-buying-guide__wash" aria-hidden="true"></div>
      {% endif %}
    </div>

    <div class="xtu-buying-guide__inner">
      <div
        class="xtu-buying-guide__copy"
        data-xtu-reveal="fade-up"
        data-xtu-stagger
      >
        {% if eyebrow != blank %}
          <p class="xtu-buying-guide__eyebrow" data-xtu-reveal-child>
            {{ eyebrow | escape }}
          </p>
        {% endif %}

        {% if heading != blank %}
          <h2 class="xtu-buying-guide__heading" data-xtu-reveal-child>
            {{ heading | escape }}
          </h2>
        {% endif %}

        {% if primary_label != blank or secondary_label != blank %}
          <div class="xtu-buying-guide__actions" data-xtu-reveal-child>
            {% if primary_label != blank %}
              <a
                class="xtu-buying-guide__btn"
                href="{{ primary_link | default: '#' }}"
              >
                {{ primary_label | escape }}
              </a>
            {% endif %}
            {% if secondary_label != blank %}
              <a
                class="xtu-buying-guide__link"
                href="{{ secondary_link | default: '#' }}"
              >
                {{ secondary_label | escape }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </article>
</section>

{% stylesheet %}
  .xtu-buying-guide {
    padding: var(--xtu-bg-padding-top, 80px) 0 var(--xtu-bg-padding-bottom, 80px);
    background: var(--xtu-bg-bg, #FFFFFF);
  }

  .xtu-buying-guide__card {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 0;
    background: var(--xtu-bg-card-bg, #F5F5F7);
  }

  .xtu-buying-guide__media {
    position: relative;
    z-index: 0;
    width: 100%;
    overflow: hidden;
  }

  .xtu-buying-guide__image,
  .xtu-buying-guide__video,
  .xtu-buying-guide__placeholder {
    display: block;
    width: 100%;
  }

  .xtu-buying-guide__youtube {
    display: block;
    width: 100%;
    border: 0;
    pointer-events: none;
  }

  .xtu-buying-guide__image--mobile {
    display: none;
  }

  .xtu-buying-guide__placeholder {
    background: var(--xtu-bg-placeholder-bg, #E8EAED);
  }

  .xtu-buying-guide__wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.86) 0%,
      rgb(255 255 255 / 0.3) 42%,
      rgb(255 255 255 / 0.06) 68%
    );
    pointer-events: none;
  }

  .xtu-buying-guide__inner {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    width: min(var(--page-width), 100%);
    margin-inline: auto;
    padding: 40px var(--page-margin);
    box-sizing: border-box;
  }

  .xtu-buying-guide__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 36rem;
  }

  .xtu-buying-guide__eyebrow {
    margin: 0 0 8px;
    font-family: var(--font-body--family);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--xtu-bg-eyebrow, #7A8599);
  }

  .xtu-buying-guide__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.625rem, 2.4vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--xtu-bg-heading, #111827);
  }

  .xtu-buying-guide__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 16px;
  }

  .xtu-buying-guide__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 132px;
    height: 38px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--xtu-bg-btn-bg, #22242A);
    color: var(--xtu-bg-btn-color, #FFFFFF);
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-body, 0.875rem);
    font-weight: 400;
    line-height: 1.2;
    text-decoration: none;
    transition: background 0.22s ease, transform 0.22s ease;
  }

  .xtu-buying-guide__btn:hover {
    background: var(--xtu-bg-btn-bg-hover, #1A1C21);
    transform: translateY(-1px);
  }

  .xtu-buying-guide__link {
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-body, 0.875rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--xtu-bg-link, #667085);
    text-decoration: none;
    transition: color 0.22s ease;
  }

  .xtu-buying-guide__link:hover {
    color: var(--xtu-bg-link-hover, #111827);
  }

  /* PC：素材比例 — 宽 100%，高度随媒体自适应 */
  .xtu-buying-guide--pc-natural .xtu-buying-guide__card {
    height: auto;
  }

  .xtu-buying-guide--pc-natural .xtu-buying-guide__media {
    position: relative;
  }

  .xtu-buying-guide--pc-natural .xtu-buying-guide__image,
  .xtu-buying-guide--pc-natural .xtu-buying-guide__video,
  .xtu-buying-guide--pc-natural .xtu-buying-guide__placeholder {
    height: auto;
    object-fit: contain;
  }

  .xtu-buying-guide--pc-natural .xtu-buying-guide__youtube {
    height: auto;
    aspect-ratio: 16 / 9;
  }

  .xtu-buying-guide--pc-natural .xtu-buying-guide__placeholder {
    aspect-ratio: 21 / 9;
  }

  /* PC：固定高度 — 高度铺满容器（纵向完整显示），宽度按比例超出则左右裁切 */
  .xtu-buying-guide--pc-fixed .xtu-buying-guide__card {
    height: var(--xtu-bg-media-height, 400px);
  }

  .xtu-buying-guide--pc-fixed .xtu-buying-guide__media {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .xtu-buying-guide--pc-fixed .xtu-buying-guide__image,
  .xtu-buying-guide--pc-fixed .xtu-buying-guide__video,
  .xtu-buying-guide--pc-fixed .xtu-buying-guide__placeholder {
    width: auto;
    max-width: none;
    height: 100%;
    object-fit: cover;
  }

  .xtu-buying-guide--pc-fixed .xtu-buying-guide__youtube {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .xtu-buying-guide {
      padding: var(--xtu-bg-padding-top-mobile, 40px) 0 var(--xtu-bg-padding-bottom-mobile, 40px);
    }

    .xtu-buying-guide__media--split .xtu-buying-guide__image--desktop {
      display: none;
    }

    .xtu-buying-guide__media--split .xtu-buying-guide__image--mobile {
      display: block;
    }

    .xtu-buying-guide__inner {
      padding-block: 28px;
    }

    .xtu-buying-guide__copy {
      align-items: center;
      text-align: center;
      max-width: none;
      margin-inline: auto;
    }

    .xtu-buying-guide__actions {
      justify-content: center;
    }

    .xtu-buying-guide__eyebrow {
      font-size: 1rem;
    }

    .xtu-buying-guide__heading {
      font-size: 1.5rem;
    }

    /* 移动端：素材比例 */
    .xtu-buying-guide--m-natural .xtu-buying-guide__card {
      height: auto;
    }

    .xtu-buying-guide--m-natural .xtu-buying-guide__media {
      position: relative;
      inset: auto;
    }

    .xtu-buying-guide--m-natural .xtu-buying-guide__image,
    .xtu-buying-guide--m-natural .xtu-buying-guide__video,
    .xtu-buying-guide--m-natural .xtu-buying-guide__placeholder {
      height: auto;
      object-fit: contain;
    }

    .xtu-buying-guide--m-natural .xtu-buying-guide__youtube {
      position: relative;
      inset: auto;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    .xtu-buying-guide--m-natural .xtu-buying-guide__placeholder {
      aspect-ratio: 21 / 9;
    }

    /* 移动端：固定高度 */
    .xtu-buying-guide--m-fixed .xtu-buying-guide__card {
      height: var(--xtu-bg-media-height-mobile, 350px);
    }

    .xtu-buying-guide--m-fixed .xtu-buying-guide__media {
      position: absolute;
      inset: 0;
    }

    .xtu-buying-guide--m-fixed .xtu-buying-guide__image,
    .xtu-buying-guide--m-fixed .xtu-buying-guide__video,
    .xtu-buying-guide--m-fixed .xtu-buying-guide__placeholder,
    .xtu-buying-guide--m-fixed .xtu-buying-guide__youtube {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .xtu-buying-guide--m-fixed .xtu-buying-guide__youtube {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU Buying Guide",
  "tag": "section",
  "class": "xtu-buying-guide-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "副标题",
      "default": "Buying guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Compare and recommend"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "媒体类型",
      "options": [
        { "value": "image", "label": "图片" },
        { "value": "video", "label": "上传视频" },
        { "value": "youtube", "label": "视频链接" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "桌面端背景图片",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "移动端背景图片",
      "info": "留空则移动端沿用桌面端图片",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "上传视频（PC）",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "上传视频（移动端）",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "视频链接",
      "accept": ["youtube", "vimeo"],
      "visible_if": "{{ section.settings.media_type == 'youtube' }}"
    },
    {
      "type": "checkbox",
      "id": "show_image_overlay",
      "label": "显示图片遮罩层",
      "info": "默认关闭；开启后在图片上叠加浅白渐变，便于文案对比",
      "default": false
    },
    {
      "type": "header",
      "content": "主按钮"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "主按钮文案",
      "default": "Compare products"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "主按钮链接"
    },
    {
      "type": "header",
      "content": "次按钮"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "次按钮文案",
      "default": "Help me choose"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "次按钮链接"
    },
    {
      "type": "header",
      "content": "媒体占位"
    },
    {
      "type": "select",
      "id": "media_sizing",
      "label": "占位方式（PC）",
      "options": [
        { "value": "natural", "label": "素材比例（宽 100%，高度自适应）" },
        { "value": "fixed", "label": "固定高度" }
      ],
      "default": "natural"
    },
    {
      "type": "range",
      "id": "media_height",
      "label": "固定高度（PC）",
      "info": "按高度完整显示素材，屏幕变宽时裁切左右两侧",
      "min": 120,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 400,
      "visible_if": "{{ section.settings.media_sizing == 'fixed' }}"
    },
    {
      "type": "select",
      "id": "media_sizing_mobile",
      "label": "占位方式（移动端）",
      "options": [
        { "value": "natural", "label": "素材比例（宽 100%，高度自适应）" },
        { "value": "fixed", "label": "固定高度" }
      ],
      "default": "natural"
    },
    {
      "type": "range",
      "id": "media_height_mobile",
      "label": "固定高度（移动端）",
      "min": 120,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 350,
      "visible_if": "{{ section.settings.media_sizing_mobile == 'fixed' }}"
    },
    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "版块背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "卡片背景色",
      "default": "#F5F5F7"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "副标题颜色",
      "default": "#7A8599"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题颜色",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "主按钮背景色",
      "default": "#22242A"
    },
    {
      "type": "color",
      "id": "button_bg_hover",
      "label": "主按钮 Hover 背景色",
      "default": "#1A1C21"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "主按钮文字色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "次按钮文字色",
      "default": "#667085"
    },
    {
      "type": "color",
      "id": "link_color_hover",
      "label": "次按钮 Hover 文字色",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "placeholder_bg",
      "label": "占位背景色",
      "default": "#E8EAED"
    },
    {
      "type": "header",
      "content": "边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
