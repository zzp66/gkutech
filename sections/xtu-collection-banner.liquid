{% liquid
  assign heading = section.settings.heading | default: collection.title
  assign enable_collection_description = section.settings.enable_collection_description
  assign description = blank

  if enable_collection_description
    assign description = section.settings.description | default: collection.description
  endif

  assign enable_collection_image = section.settings.enable_collection_image
  assign image = section.settings.image

  if enable_collection_image
    if image == blank
      assign image = collection.image
    endif
  else
    assign image = blank
  endif

  assign image_mobile = section.settings.image_mobile
  assign banner_ratio = section.settings.media_ratio | default: '21 / 9'
  assign ratio_auto = false
  if banner_ratio == 'auto'
    assign ratio_auto = true
  endif
  assign content_position = section.settings.content_position | default: 'left'
  assign show_overlay = section.settings.show_overlay
  assign padding_top = section.settings.padding_top | default: 60
  assign padding_bottom = section.settings.padding_bottom | default: 60
  assign page_background = section.settings.page_background | default: '#f8f9fd'
  assign has_media = false
  if image != blank
    assign has_media = true
  endif

  if has_media
    assign image_url_desktop = image | image_url: width: 2880
    if image_mobile != blank
      assign image_url_mobile = image_mobile | image_url: width: 1200
    else
      assign image_url_mobile = image_url_desktop
    endif
  endif
%}

{% style %}
  body:has(#xtu-collection-banner-{{ section.id }}) {
    --xtu-collection-page-bg: {{ page_background }};
    background-color: var(--xtu-collection-page-bg);
  }

  body:has(#xtu-collection-banner-{{ section.id }}) .xtu-collection-banner,
  body:has(#xtu-collection-banner-{{ section.id }}) .shopify-section:has(.xtu-collection-banner),
  body:has(#xtu-collection-banner-{{ section.id }}) .shopify-section:has(.product-grid-container),
  body:has(#xtu-collection-banner-{{ section.id }}) .product-grid-container,
  body:has(#xtu-collection-banner-{{ section.id }}) .product-grid-container .section-background,
  body:has(#xtu-collection-banner-{{ section.id }}) .facets-block-wrapper--vertical:not(#filters-drawer),
  body:has(#xtu-collection-banner-{{ section.id }}) .main-collection-grid,
  body:has(#xtu-collection-banner-{{ section.id }}) .facets.facets-controls-wrapper {
    background-color: var(--xtu-collection-page-bg) !important;
  }

  /* Full-bleed scoped to this section — avoid 100vw (broken inside .page-wrapper scroll). */
  #shopify-section-{{ section.id }} {
    display: block;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  {% if has_media %}
    #shopify-section-{{ section.id }} {
      /* Stretch to the scrollport edges of .page-wrapper */
      width: 100%;
      max-width: none;
      margin-inline: 0;
      padding-inline: 0;
    }

    #shopify-section-{{ section.id }} .xtu-collection-banner--has-media {
      --xtu-cb-banner-ratio: {{ banner_ratio }};
      --xtu-cb-banner-image: url('{{ image_url_desktop }}');
      --xtu-cb-banner-image-mobile: url('{{ image_url_mobile }}');
    }
  {% endif %}
{% endstyle %}

<div
  id="xtu-collection-banner-{{ section.id }}"
  class="xtu-collection-banner xtu-collection-banner--{{ content_position }}{% if has_media %} xtu-collection-banner--has-media{% endif %}{% if ratio_auto %} xtu-collection-banner--ratio-auto{% endif %}"
  style="
    --xtu-cb-padding-top: {{ padding_top }}px;
    --xtu-cb-padding-bottom: {{ padding_bottom }}px;
    {% unless ratio_auto %}--xtu-cb-banner-ratio: {{ banner_ratio }};{% endunless %}
  "
>
  {% if has_media %}
    <div class="xtu-collection-banner__media" aria-hidden="true">
      {%- comment -%}
        Prefer CSS background for reliable cover fill.
        Keep a visually-hidden img for crawlers / accessibility fallback.
      {%- endcomment -%}
      {{
        image
        | image_url: width: 2880
        | image_tag:
          class: 'xtu-collection-banner__image',
          loading: 'eager',
          widths: '800, 1200, 1600, 2000, 2400, 2880',
          sizes: '100vw',
          alt: heading
      }}
      {% if show_overlay %}
        <div class="xtu-collection-banner__overlay"></div>
      {% endif %}
    </div>
  {% endif %}

  <div class="xtu-collection-banner__inner" data-xtu-reveal>
    <div class="xtu-collection-banner__content">
      {% if heading != blank %}
        <h1 class="xtu-collection-banner__title">{{ heading }}</h1>
      {% endif %}
      {% if description != blank %}
        <div class="xtu-collection-banner__desc rte">{{ description }}</div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "XTU Collection Banner",
  "tag": "section",
  "class": "xtu-collection-banner-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "info": "留空则使用集合名称"
    },
    {
      "type": "checkbox",
      "id": "enable_collection_description",
      "label": "启用集合页描述",
      "info": "关闭后标题区域仅显示标题",
      "default": true
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述",
      "info": "留空则使用集合描述",
      "visible_if": "{{ section.settings.enable_collection_description }}"
    },
    {
      "type": "header",
      "content": "主图"
    },
    {
      "type": "checkbox",
      "id": "enable_collection_image",
      "label": "启用集合页主图",
      "info": "开启后显示集合主图或下方上传的背景图，通栏全宽",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "背景图（桌面）",
      "info": "留空且启用主图时，使用集合主图",
      "visible_if": "{{ section.settings.enable_collection_image }}"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "背景图（移动端）",
      "visible_if": "{{ section.settings.enable_collection_image }}"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Banner 比例",
      "options": [
        { "value": "auto", "label": "自适应（按图片比例）" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "21 / 9", "label": "21:9" },
        { "value": "3 / 1", "label": "3:1" },
        { "value": "4 / 1", "label": "4:1" }
      ],
      "default": "21 / 9",
      "visible_if": "{{ section.settings.enable_collection_image }}"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "文案位置",
      "options": [
        { "value": "left", "label": "左" },
        { "value": "center", "label": "居中" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "启用图片遮罩",
      "default": false,
      "visible_if": "{{ section.settings.enable_collection_image }}"
    },
    {
      "type": "color",
      "id": "page_background",
      "label": "集合页背景色",
      "info": "可从调色板选择，或自定义颜色",
      "default": "#F8F9FD"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60,
      "info": "仅在未显示主图时生效"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60,
      "info": "仅在未显示主图时生效"
    }
  ],
  "presets": [
    {
      "name": "XTU Collection Banner",
      "category": "XTU"
    }
  ]
}
{% endschema %}
