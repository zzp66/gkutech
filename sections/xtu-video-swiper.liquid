{%- comment -%}
  XTU Video Swiper — DJI 风格全宽居中视频轮播。

  数据来源：Theme Editor 本 section 的「视频」block。
  - 每个 block：上传视频（PC/移动）或 YouTube/Vimeo 链接、可选封面、标题/副标题、双 CTA。
  - 上传视频取 mp4 源（跳过 m3u8）；无封面时用 Shopify preview_image 首帧，再缺则 JS 截第一帧。
  - YouTube 无封面用官方缩略图；仅激活 slide 才注入静音循环 iframe。

  运营配置
  1. Theme Editor 添加「XTU Video Swiper」。
  2. 按需增加视频 block；PC 激活卡默认约占 70% 且最大 1200px（DJI 式左右 peek），移动端约 88%。
  3. 左右箭头叠在激活画面上；分页在视频框内距底 30px。末张下一张无缝接到第一张。遮罩默认关闭。

  前台
  - 全宽；激活 slide 居中限宽；首尾各复制一张做无缝循环。
  - 滚到版块前预加载当前与左右邻张，切卡时直接播已缓冲视频。
  - 触控板横向滑动；尊重 prefers-reduced-motion（不自动播）。

  相关：assets/xtu-video-swiper.js、assets/xtu-video-swiper.css、
        snippets/xtu-video-mp4-url.liquid、snippets/xtu-swiper-nav.liquid、snippets/xtu-btn.liquid
{%- endcomment -%}

{% liquid
  assign background_color = section.settings.background_color | default: '#000000'
  assign media_ratio = section.settings.media_ratio | default: '16 / 9'
  assign desktop_view = section.settings.desktop_view | default: '70'
  assign mobile_view = section.settings.mobile_view | default: '88'
  assign slide_max_width = section.settings.slide_max_width | default: 1200 | at_least: 600 | at_most: 1600
  assign desktop_pct = 70
  assign mobile_pct = 88
  if desktop_view contains '.'
    assign desktop_pct = 70
  else
    assign desktop_pct = desktop_view | plus: 0
    if desktop_pct < 60 or desktop_pct > 90
      assign desktop_pct = 70
    endif
  endif
  if mobile_view contains '.'
    assign mobile_pct = 88
  else
    assign mobile_pct = mobile_view | plus: 0
    if mobile_pct < 70 or mobile_pct > 96
      assign mobile_pct = 88
    endif
  endif
  assign gap = section.settings.card_gap | default: 16
  assign gap_mobile = section.settings.card_gap_mobile | default: 8
  assign card_radius = section.settings.card_radius | default: 16
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 0
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0
  assign show_overlay = section.settings.show_overlay
  assign overlay_opacity = section.settings.overlay_opacity | default: 30
  assign text_color = section.settings.text_color | default: '#FFFFFF'
  assign content_align_d = section.settings.content_align_desktop | default: 'center'
  assign content_valign_d = section.settings.content_valign_desktop | default: 'top'
  assign content_align_m = section.settings.content_align_mobile | default: 'center'
  assign content_valign_m = section.settings.content_valign_mobile | default: 'top'
  assign show_arrows = section.settings.show_arrows
  assign show_arrows_mobile = section.settings.show_arrows_mobile
  assign enable_autoplay = section.settings.enable_autoplay
  assign autoplay_delay = section.settings.autoplay_delay | default: 6 | times: 1000
  if enable_autoplay == false
    assign autoplay_delay = 0
  endif

  assign slide_count = 0
  for block in section.blocks
    if block.type == 'video'
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  assign overlay_css = 0
  if show_overlay
    assign overlay_css = overlay_opacity | divided_by: 100.0
  endif

  assign hide_arrows_mobile = true
  if show_arrows_mobile
    assign hide_arrows_mobile = false
  endif
%}

{{ 'xtu-video-swiper.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xtu-video-swiper.js' | asset_url }}" defer="defer"></script>

<section
  id="xtu-video-swiper-{{ section.id }}"
  class="xtu-vs{% unless show_overlay %} xtu-vs--overlay-off{% endunless %}{% if slide_count < 2 %} xtu-vs--single{% endif %}"
  data-xtu-video-swiper
  data-count="{{ slide_count }}"
  data-gap="{{ gap }}"
  data-gap-mobile="{{ gap_mobile }}"
  data-autoplay="{{ autoplay_delay }}"
  style="
    --xtu-vs-bg: {{ background_color }};
    --xtu-vs-slide-max: {{ slide_max_width }}px;
    --xtu-vs-slide-pct-d: {{ desktop_pct }}%;
    --xtu-vs-slide-pct-m: {{ mobile_pct }}%;
    --xtu-vs-gap-d: {{ gap }}px;
    --xtu-vs-gap-m: {{ gap_mobile }}px;
    --xtu-vs-ratio: {{ media_ratio }};
    --xtu-vs-radius: {{ card_radius }}px;
    --xtu-vs-pt: {{ padding_top }}px;
    --xtu-vs-pb: {{ padding_bottom }}px;
    --xtu-vs-pt-m: {{ padding_top_mobile }}px;
    --xtu-vs-pb-m: {{ padding_bottom_mobile }}px;
    --xtu-vs-overlay: {{ overlay_css }};
    --xtu-vs-text: {{ text_color }};
  "
>
  <div class="xtu-vs__stage">
    <div class="swiper xtu-vs__swiper" data-xtu-vs-swiper>
      <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% if block.type == 'video' %}
          {% liquid
            assign video_source = block.settings.video_source | default: 'upload'
            assign video = block.settings.video
            assign video_mobile = block.settings.video_mobile
            assign video_url = block.settings.video_url
            assign cover = block.settings.cover
            assign heading = block.settings.heading
            assign subheading = block.settings.subheading
            assign heading_color = block.settings.heading_color
            assign copy_color = heading_color | default: text_color
            assign alt_text = heading | default: 'Video'

            assign embed_id = blank
            assign embed_type = 'youtube'
            if video_source == 'youtube' and video_url != blank and video_url.id != blank
              assign embed_id = video_url.id
              if video_url.type != blank
                assign embed_type = video_url.type
              endif
            endif
          %}
          {% if video_source == 'upload' %}
            {% capture video_src %}{% render 'xtu-video-mp4-url', video: video %}{% endcapture %}
            {% assign video_src = video_src | strip %}
            {% capture video_src_m %}{% render 'xtu-video-mp4-url', video: video_mobile %}{% endcapture %}
            {% assign video_src_m = video_src_m | strip %}
          {% else %}
            {% assign video_src = '' %}
            {% assign video_src_m = '' %}
          {% endif %}
          {% liquid
            assign has_mobile_video = false
            if video_src_m != blank
              assign has_mobile_video = true
            endif

            assign cover_url = blank
            if cover != blank
              assign cover_url = cover | image_url: width: 2400
            elsif video_source == 'upload' and video != blank and video.preview_image != blank
              assign cover_url = video.preview_image | image_url: width: 2400
            elsif embed_id != blank and embed_type == 'youtube'
              assign cover_url = 'https://i.ytimg.com/vi/' | append: embed_id | append: '/hqdefault.jpg'
            endif

            assign has_media = false
            if embed_id != blank or video_src != blank or video_src_m != blank
              assign has_media = true
            endif
          %}
          <article
            class="swiper-slide xtu-vs__slide"
            {{ block.shopify_attributes }}
          >
            <div class="xtu-vs__card">
              <div
                class="xtu-vs__media{% if has_mobile_video %} xtu-vs__media--split{% endif %}"
                data-xtu-vs-media
                data-embed-id="{{ embed_id | escape }}"
                data-embed-type="{{ embed_type | escape }}"
                data-title="{{ alt_text | escape }}"
              >
                {% if video_src != blank %}
                  <video
                    class="xtu-vs__video xtu-vs__video--desktop"
                    muted
                    loop
                    playsinline
                    webkit-playsinline
                    preload="auto"
                    {% if cover_url != blank %}poster="{{ cover_url | escape }}"{% endif %}
                  >
                    <source src="{{ video_src | escape }}" type="video/mp4">
                  </video>
                {% endif %}
                {% if video_src_m != blank %}
                  <video
                    class="xtu-vs__video xtu-vs__video--mobile"
                    muted
                    loop
                    playsinline
                    webkit-playsinline
                    preload="auto"
                    {% if cover_url != blank %}poster="{{ cover_url | escape }}"{% endif %}
                  >
                    <source src="{{ video_src_m | escape }}" type="video/mp4">
                  </video>
                {% endif %}

                {% if cover_url != blank %}
                  <img
                    class="xtu-vs__cover"
                    src="{{ cover_url | escape }}"
                    alt="{{ alt_text | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    decoding="async"
                    width="1920"
                    height="1080"
                  >
                {% elsif video_src != blank %}
                  <video
                    class="xtu-vs__cover xtu-vs__cover-fallback"
                    muted
                    playsinline
                    preload="metadata"
                    aria-hidden="true"
                    data-src="{{ video_src | escape }}"
                  ></video>
                {% elsif has_media == false %}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'xtu-vs__placeholder xtu-vs__cover' }}
                {% endif %}
              </div>

              <div class="xtu-vs__overlay" aria-hidden="true"></div>

              {% if heading != blank or subheading != blank or block.settings.primary_label != blank or block.settings.secondary_label != blank %}
                <div
                  class="xtu-vs__copy xtu-vs__copy--d-{{ content_align_d }} xtu-vs__copy--d-{{ content_valign_d }} xtu-vs__copy--m-{{ content_align_m }} xtu-vs__copy--m-{{ content_valign_m }}"
                  style="--xtu-vs-text: {{ copy_color }};"
                >
                  {% if heading != blank %}
                    <h2 class="xtu-vs__heading">{{ heading | escape }}</h2>
                  {% endif %}
                  {% if subheading != blank %}
                    <p class="xtu-vs__subheading">{{ subheading | escape }}</p>
                  {% endif %}
                  {% if block.settings.primary_label != blank or block.settings.secondary_label != blank %}
                    <div class="xtu-vs__actions">
                      {% render 'xtu-btn',
                        label: block.settings.primary_label,
                        href: block.settings.primary_link,
                        show_arrow: block.settings.primary_show_arrow,
                        bg: block.settings.primary_bg,
                        color: block.settings.primary_color,
                        bg_hover: block.settings.primary_bg_hover,
                        color_hover: block.settings.primary_color_hover
                      %}
                      {% render 'xtu-btn',
                        label: block.settings.secondary_label,
                        href: block.settings.secondary_link,
                        show_arrow: block.settings.secondary_show_arrow,
                        bg: block.settings.secondary_bg,
                        color: block.settings.secondary_color,
                        bg_hover: block.settings.secondary_bg_hover,
                        color_hover: block.settings.secondary_color_hover
                      %}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
      </div>
    </div>

    {% if slide_count > 1 %}
      <div class="xtu-vs__hud">
        {% if show_arrows %}
          {% render 'xtu-swiper-nav',
            hide_mobile: hide_arrows_mobile,
            prev_attributes: 'data-xtu-vs-prev',
            next_attributes: 'data-xtu-vs-next'
          %}
        {% endif %}
        <div class="xtu-vs__pager" data-xtu-vs-pager></div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "XTU Video Swiper",
  "tag": "section",
  "class": "section-xtu-video-swiper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "全宽居中视频轮播（参考 DJI）：激活卡限宽居中；分页在视频框内距底 30px；左右箭头无缝循环。"
    },
    {
      "type": "header",
      "content": "布局"
    },
    {
      "type": "select",
      "id": "desktop_view",
      "label": "PC 激活卡宽度",
      "options": [
        { "value": "65", "label": "65%" },
        { "value": "70", "label": "70%（推荐，接近 DJI）" },
        { "value": "75", "label": "75%" },
        { "value": "80", "label": "80%" }
      ],
      "default": "70",
      "info": "相对版块全宽；大屏还会受下方最大宽度限制，左右露出相邻视频。"
    },
    {
      "type": "number",
      "id": "slide_max_width",
      "label": "PC 激活卡最大宽度",
      "default": 1200,
      "info": "单位 px，范围 600–1600。大屏不要把卡片拉满窗口。"
    },
    {
      "type": "select",
      "id": "mobile_view",
      "label": "移动端激活卡宽度",
      "options": [
        { "value": "82", "label": "82%" },
        { "value": "88", "label": "88%（推荐）" },
        { "value": "92", "label": "92%" }
      ],
      "default": "88"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "视频比例",
      "options": [
        { "value": "21 / 9", "label": "21:9" },
        { "value": "2 / 1", "label": "2:1" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "16 / 10", "label": "16:10" },
        { "value": "4 / 3", "label": "4:3" }
      ],
      "default": "16 / 9",
      "info": "高度由宽度 × 比例推导，不使用固定 px。"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "卡片间距（PC）",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "卡片间距（移动端）",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "卡片圆角",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "导航与播放"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "显示左右箭头",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "移动端显示左右箭头",
      "default": false,
      "info": "默认关闭（1.1 peek 可滑动）。箭头位于激活画面内。"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "自动切换",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "自动切换间隔",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "header",
      "content": "文案位置"
    },
    {
      "type": "select",
      "id": "content_align_desktop",
      "label": "水平对齐（PC）",
      "options": [
        { "value": "left", "label": "左" },
        { "value": "center", "label": "中" },
        { "value": "right", "label": "右" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_valign_desktop",
      "label": "垂直位置（PC）",
      "options": [
        { "value": "top", "label": "上" },
        { "value": "middle", "label": "中" },
        { "value": "bottom", "label": "下" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "content_align_mobile",
      "label": "水平对齐（移动端）",
      "options": [
        { "value": "left", "label": "左" },
        { "value": "center", "label": "中" },
        { "value": "right", "label": "右" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_valign_mobile",
      "label": "垂直位置（移动端）",
      "options": [
        { "value": "top", "label": "上" },
        { "value": "middle", "label": "中" },
        { "value": "bottom", "label": "下" }
      ],
      "default": "top"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "默认文字色",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "遮罩"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "显示内容遮罩",
      "default": false,
      "info": "默认关闭。深色视频上叠白字时可按需开启。"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "遮罩浓度",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "%",
      "default": 30,
      "visible_if": "{{ section.settings.show_overlay == true }}"
    },
    {
      "type": "header",
      "content": "外观"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "版块背景色",
      "default": "#000000",
      "info": "左右 peek 缝隙后露出的底色。"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "视频",
      "settings": [
        {
          "type": "select",
          "id": "video_source",
          "label": "视频来源",
          "options": [
            { "value": "upload", "label": "后台上传视频" },
            { "value": "youtube", "label": "YouTube / Vimeo 链接" }
          ],
          "default": "upload"
        },
        {
          "type": "video",
          "id": "video",
          "label": "上传视频（PC）",
          "visible_if": "{{ block.settings.video_source == 'upload' }}"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "上传视频（移动端）",
          "info": "可选。未配置时移动端使用 PC 视频。",
          "visible_if": "{{ block.settings.video_source == 'upload' }}"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "视频链接",
          "accept": ["youtube", "vimeo"],
          "visible_if": "{{ block.settings.video_source == 'youtube' }}"
        },
        {
          "type": "image_picker",
          "id": "cover",
          "label": "封面图",
          "info": "可选。未配置时：上传视频用首帧，YouTube 用官方缩略图。"
        },
        {
          "type": "header",
          "content": "文案"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "标题",
          "default": "Product title"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "副标题"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "本屏文字色",
          "info": "留空则跟随版块默认文字色。"
        },
        {
          "type": "header",
          "content": "主按钮"
        },
        {
          "type": "text",
          "id": "primary_label",
          "label": "按钮文案",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "primary_link",
          "label": "按钮链接"
        },
        {
          "type": "checkbox",
          "id": "primary_show_arrow",
          "label": "显示箭头",
          "default": true
        },
        {
          "type": "color",
          "id": "primary_bg",
          "label": "背景色",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "primary_color",
          "label": "文字色",
          "default": "#111827"
        },
        {
          "type": "color",
          "id": "primary_bg_hover",
          "label": "Hover 背景色",
          "default": "#0070CA"
        },
        {
          "type": "color",
          "id": "primary_color_hover",
          "label": "Hover 文字色",
          "default": "#FFFFFF"
        },
        {
          "type": "header",
          "content": "副按钮"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "按钮文案",
          "default": "Buy now"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "按钮链接"
        },
        {
          "type": "checkbox",
          "id": "secondary_show_arrow",
          "label": "显示箭头",
          "default": true
        },
        {
          "type": "color",
          "id": "secondary_bg",
          "label": "背景色",
          "default": "#1590F2"
        },
        {
          "type": "color",
          "id": "secondary_color",
          "label": "文字色",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "secondary_bg_hover",
          "label": "Hover 背景色",
          "default": "#0070CA"
        },
        {
          "type": "color",
          "id": "secondary_color_hover",
          "label": "Hover 文字色",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
