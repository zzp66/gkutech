60 160z"></path></svg><span>How long is each recorded video?</span></div></summary><div class="sc-dxcExB boHSLB pf-30_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-31_"><p class="sc-stwUW giqUXE pf-32_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-1c4138dd-3343-4863-9229-b7b5758c5cf0"/><span class="pf-paragraph-content ">The dash cam supports loop recording with selectable clip lengths of <strong>1 minute, 3 minutes, or 5 minutes</strong>.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-35_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-36_ pf-anchor pf-header-item-wrapper" data-header-id="c6d8cd3f-3062-4c9b-8565-855075d252f1" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>What temperature does the dash cam support?</span></div></summary><div class="sc-dxcExB boHSLB pf-38_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-39_"><p class="sc-stwUW giqUXE pf-40_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-179f4243-e8e5-4178-9ac8-ca9c388089d3"/><span class="pf-paragraph-content ">The working temperature range is <strong>-20°C to 70°C</strong>, suitable for most vehicle environments.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-43_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-44_ pf-anchor pf-header-item-wrapper" data-header-id="79fa374e-5d3a-4dc2-8023-095fe93c7b62" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Does the dash cam record audio?</span></div></summary><div class="sc-dxcExB boHSLB pf-46_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-47_"><p class="sc-stwUW giqUXE pf-48_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-cbdf0e56-e394-41bf-8b56-cb36f744c07f"/><span class="pf-paragraph-content ">Yes. Audio recording is enabled by default and can be turned off in the app settings.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-51_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-52_ pf-anchor pf-header-item-wrapper" data-header-id="4c1ffc98-cf04-4f5e-8e5d-07e476644dc0" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Loop Recording & Storage</span></div></summary><div class="sc-dxcExB boHSLB pf-54_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-55_"><div class="sc-gvZzpm gKmDqk pf-56_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-57_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-58_ pf-anchor pf-header-item-wrapper" data-header-id="8f5e4e5d-07e4-4664-8dc0-8845aaa8e5c5" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>What is loop recording and how does it work?</span></div></summary><div class="sc-dxcExB boHSLB pf-60_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-61_"><p class="sc-stwUW giqUXE pf-62_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-07e47664-4dc0-4845-aaa8-e5c5f70cbfee"/><span class="pf-paragraph-content "> When the memory card is full, the dash cam automatically overwrites the oldest normal videos. Locked emergency videos will not be overwritten.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-65_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-66_ pf-anchor pf-header-item-wrapper" data-header-id="4dc08845-aaa8-45c5-b70c-bfee09cc451d" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Why can I only select 1/3/5 minutes? Can it record continuously?</span></div></summary><div class="sc-dxcExB boHSLB pf-68_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-69_"><p class="sc-stwUW giqUXE pf-70_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-aaa8e5c5-f70c-4fee-89cc-451d4cee26b2"/><span class="pf-paragraph-content ">Short video segments help ensure file integrity and reliable playback. Continuous single-file recording is not supported by design.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-73_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-74_ pf-anchor pf-header-item-wrapper" data-header-id="4cee26b2-445a-49ec-99e3-5696af0075b4" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Do I need to delete files manually?</span></div></summary><div class="sc-dxcExB boHSLB pf-76_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-77_"><p class="sc-stwUW giqUXE pf-78_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-445a09ec-99e3-4696-af00-75b4d4ec3446"/><span class="pf-paragraph-content ">No. Normal videos are automatically overwritten. Only locked videos need to be deleted manually if storage is full.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-81_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-82_ pf-anchor pf-header-item-wrapper" data-header-id="8d28eb1d-6cbc-4d13-86f9-964ea19b93ab" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span> Parking Mode & G-Sensor</span></div></summary><div class="sc-dxcExB boHSLB pf-84_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-85_"><div class="sc-gvZzpm gKmDqk pf-86_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-87_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-88_ pf-anchor pf-header-item-wrapper" data-header-id="11dd04b8-1fbf-4a07-bf6b-a8751606a6ee" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>What is Parking Mode and how does it work?</span></div></summary><div class="sc-dxcExB boHSLB pf-90_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-91_"><p class="sc-stwUW giqUXE pf-92_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-1fdc2ffc-0300-42b4-b8c5-4ef0e1783db0"/><span class="pf-paragraph-content ">Parking Mode requires a<strong> Type-C hardwire kit (not included)</strong>. When enabled, the camera monitors the vehicle while parked and records if a collision is detected.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-95_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-96_ pf-anchor pf-header-item-wrapper" data-header-id="9f86e8ee-3069-4538-8cff-399bc4f2d797" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>How do I turn on Parking Monitor?</span></div></summary><div class="sc-dxcExB boHSLB pf-98_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-99_"><p class="sc-stwUW giqUXE pf-100_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-6c9e3e93-4fe8-492e-bd60-7dfe5db0411b"/><span class="pf-paragraph-content ">After installing the hardwire kit, enable Parking Mode or Parking Collision Detection in the app settings.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-103_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-104_ pf-anchor pf-header-item-wrapper" data-header-id="74b95e7a-a722-49fc-a405-3ca15c87bfe2" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>How long can Parking Mode work without starting the car?</span></div></summary><div class="sc-dxcExB boHSLB pf-106_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-107_"><p class="sc-stwUW giqUXE pf-108_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-d9990166-dcd7-4bc7-8d69-ae6ce3c780e8"/><span class="pf-paragraph-content ">This depends on the car battery capacity. The recording duration can be set to 12h, 24h, or 48h. The hardwire kit will cut power if voltage is too low.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-111_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-112_ pf-anchor pf-header-item-wrapper" data-header-id="3f64b748-998d-44e8-83e7-f8e6bbc54ff0" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>What is the G-sensor used for?</span></div></summary><div class="sc-dxcExB boHSLB pf-114_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-115_"><p class="sc-stwUW giqUXE pf-116_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-49e214ef-38ee-4105-8a68-69b1866a190b"/><span class="pf-paragraph-content ">The built-in G-sensor detects impacts or sudden vibrations and automatically locks the current video.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-119_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-120_ pf-anchor pf-header-item-wrapper" data-header-id="8284f3e1-29c3-4128-8bde-1a6fbe0fc9bd" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Why doesn’t the G-sensor trigger when I tap the car by hand?</span></div></summary><div class="sc-dxcExB boHSLB pf-122_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-123_"><p class="sc-stwUW giqUXE pf-124_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-1abee59a-af41-4049-a658-933c03f2ab78"/><span class="pf-paragraph-content ">Hand tapping is usually not strong enough. The G-sensor responds to real collisions or significant vibrations.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-127_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-128_ pf-anchor pf-header-item-wrapper" data-header-id="f2701486-4542-4dc0-8233-e94c76e12a2d" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Memory Card</span></div></summary><div class="sc-dxcExB boHSLB pf-130_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-131_"><div class="sc-gvZzpm gKmDqk pf-132_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-133_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-134_ pf-anchor pf-header-item-wrapper" data-header-id="3fdd3887-8139-4108-9e6e-8eb0373ebfbd" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>What memory card should I use?</span></div></summary><div class="sc-dxcExB boHSLB pf-136_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-137_"><p class="sc-stwUW giqUXE pf-138_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-0cf8dca2-6848-45c9-a7b7-4d2f080af89b"/><span class="pf-paragraph-content "> Use a branded micro SD card, Class 10 / U3, capacity 64GB–256GB. Please format the card in the GKU GO App before use.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-141_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-142_ pf-anchor pf-header-item-wrapper" data-header-id="10773cd2-fa03-49ba-90bc-fcd49e3fff3e" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Why does the camera ask to format the SD card regularly?</span></div></summary><div class="sc-dxcExB boHSLB pf-144_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-145_"><p class="sc-stwUW giqUXE pf-146_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-e829bd64-6aba-4daa-b1d9-bf568bd8c3c8"/><span class="pf-paragraph-content ">Regular formatting (every 15–30 days) helps maintain stable recording performance.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-149_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-150_ pf-anchor pf-header-item-wrapper" data-header-id="fbdbce72-8376-4f8f-b4ec-d558dd16067b" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>WiFi,  App & Playback</span></div></summary><div class="sc-dxcExB boHSLB pf-152_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-153_"><div class="sc-gvZzpm gKmDqk pf-154_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-155_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-156_ pf-anchor pf-header-item-wrapper" data-header-id="c17db3b4-ec22-4e7f-bff1-743285035c96" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Why does it say “No Internet Connection” after connecting WiFi?</span></div></summary><div class="sc-dxcExB boHSLB pf-158_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-159_"><p class="sc-stwUW giqUXE pf-160_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-aa7bdab7-2b4b-4fe9-b117-9941c0b45564"/><span class="pf-paragraph-content ">This is a local WiFi connection prompt. The dashcam's WiFi does not provide internet access; it is solely for establishing a connection. This message is normal.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-163_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-164_ pf-anchor pf-header-item-wrapper" data-header-id="de764368-c0f7-40a6-92a5-3274ab1232aa" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Can I view videos remotely?</span></div></summary><div class="sc-dxcExB boHSLB pf-166_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-167_"><p class="sc-stwUW giqUXE pf-168_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-bc001ec9-3695-47b4-89ca-f1b95fa7bf99"/><span class="pf-paragraph-content ">No. Remote viewing is not supported. Videos can only be viewed when connected to the dash cam WiFi nearby.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-171_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-172_ pf-anchor pf-header-item-wrapper" data-header-id="eaabb1af-e355-41ba-afe9-705bbed57bdd" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Can I view videos on my PC?</span></div></summary><div class="sc-dxcExB boHSLB pf-174_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-175_"><p class="sc-stwUW giqUXE pf-176_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-28ffc18c-86bc-466f-b370-79088cc0b250"/><span class="pf-paragraph-content ">Yes. Remove the SD card and use a card reader, or play downloaded files with a video player such as VLC.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-179_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-180_ pf-anchor pf-header-item-wrapper" data-header-id="99e3f784-847f-40ef-81ab-644999e2b353" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Installation & Others</span></div></summary><div class="sc-dxcExB boHSLB pf-182_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-183_"><div class="sc-gvZzpm gKmDqk pf-184_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-185_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-186_ pf-anchor pf-header-item-wrapper" data-header-id="9cb688a6-63e2-41e5-85cb-31b078cbd39a" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Can I use a power bank to power the dash cam?</span></div></summary><div class="sc-dxcExB boHSLB pf-188_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-189_"><p class="sc-stwUW giqUXE pf-190_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-ac897f6b-740d-4a98-acda-bcd5a686311e"/><span class="pf-paragraph-content "> Not recommended. Please use the car charger or a hardwire kit to ensure stable power supply.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-193_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-194_ pf-anchor pf-header-item-wrapper" data-header-id="53a213ad-1882-4dbe-b45f-df7af1730a8a" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Is it normal for the dash cam to get warm?</span></div></summary><div class="sc-dxcExB boHSLB pf-196_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-197_"><p class="sc-stwUW giqUXE pf-198_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-1882ddbe-745f-4f7a-b173-0a8af5254c01"/><span class="pf-paragraph-content ">Yes. Heat during 4K recording or WiFi use is normal and within safe operating limits.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-201_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-202_ pf-anchor pf-header-item-wrapper" data-header-id="8929ce9c-0381-407d-b529-76eafd61e169" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>How long is the rear camera cable?</span></div></summary><div class="sc-dxcExB boHSLB pf-204_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-205_"><p class="sc-stwUW giqUXE pf-206_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-8b691195-a09e-4649-bc14-93ba9c244e13"/><span class="pf-paragraph-content ">The rear camera cable is<strong> 19.69 ft</strong> long. If the cable isn’t long enough for your vehicle, we also offer a <strong>rear camera extension cable</strong>. Please contact the <strong>GKU support team</strong>, and they can send you one.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-209_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-210_ pf-anchor pf-header-item-wrapper" data-header-id="3bc2e8d0-77cd-4859-9701-737f1981839c" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>How to flip the rear camera view?</span></div></summary><div class="sc-dxcExB boHSLB pf-212_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-213_"><p class="sc-stwUW giqUXE pf-214_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-77cd6859-5701-437f-9981-839c34ef8727"/><span class="pf-paragraph-content ">You can adjust the image orientation (flip vertically/horizontally) in the app or camera settings.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-217_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-218_ pf-anchor pf-header-item-wrapper" data-header-id="b385363f-b31f-415e-9767-b0ddcf9857ab" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>How to use the static cling sticker?</span></div></summary><div class="sc-dxcExB boHSLB pf-220_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-221_"><p class="sc-stwUW giqUXE pf-222_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-a3621fc3-04e5-4c6a-be3b-fa5995e5c777"/><span class="pf-paragraph-content ">First clean the glass → Apply the static cling sticker → Then attach the 3M mount to the static cling sticker for easy removal later.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-225_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-226_ pf-anchor pf-header-item-wrapper" data-header-id="893b458c-14cc-4461-9a30-c258593bd11e" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>How to remove 3M adhesive?</span></div></summary><div class="sc-dxcExB boHSLB pf-228_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-229_"><p class="sc-stwUW giqUXE pf-230_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-59215dc1-b83c-4650-82f0-56bbc51d027c"/><span class="pf-paragraph-content ">Use a hairdryer to heat the adhesive, then slowly peel it off. This method won't damage the glass.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-233_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-234_ pf-anchor pf-header-item-wrapper" data-header-id="002d74b7-77fd-4b3c-9c0f-68587e883a81" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>How long is the warranty?</span></div></summary><div class="sc-dxcExB boHSLB pf-236_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-237_"><p class="sc-stwUW giqUXE pf-238_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-7478c621-c886-4803-bbcf-fbb35e901562"/><span class="pf-paragraph-content ">The standard warranty is<strong> 1 year</strong>, and we also provide<strong> lifetime technical support</strong>. If you <strong>register your product</strong>, you can <strong>extend the warranty by 1 additional year</strong> (for a total of<strong> 2 years</strong>).</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-241_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-242_ pf-anchor pf-header-item-wrapper" data-header-id="d9a8d475-05b2-441e-aaa2-28f4ce5a5f63" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Troubleshooting</span></div></summary><div class="sc-dxcExB boHSLB pf-244_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-245_"><div class="sc-gvZzpm gKmDqk pf-246_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-247_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-248_ pf-anchor pf-header-item-wrapper" data-header-id="f67b6c0c-5545-49bb-9317-32f7b28eab70" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Time & Recording Issues</span></div></summary><div class="sc-dxcExB boHSLB pf-250_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-251_"><div class="sc-gvZzpm gKmDqk pf-252_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-253_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-254_ pf-anchor pf-header-item-wrapper" data-header-id="867611be-b412-4a24-b11b-173cd4995c08" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>The recorded video time does not match the system time. What should I do?</span></div></summary><div class="sc-dxcExB boHSLB pf-256_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-257_"><p class="sc-stwUW giqUXE pf-258_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-932639c7-fb64-4362-acd0-a8e1c439a960"/><span class="pf-paragraph-content "> Connect the dash cam to the app via WiFi and confirm time sync. Check your phone’s time/time zone. Try a factory reset. If it persists, contact support.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-261_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-262_ pf-anchor pf-header-item-wrapper" data-header-id="0ec5d19f-851c-41eb-8aa4-fb66d6bba7e2" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Overheating</span></div></summary><div class="sc-dxcExB boHSLB pf-264_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-265_"><div class="sc-gvZzpm gKmDqk pf-266_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-267_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-268_ pf-anchor pf-header-item-wrapper" data-header-id="fb7acca4-9631-405c-bb81-1cbb35a3ab75" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Why does the dash cam get hot during use?</span></div></summary><div class="sc-dxcExB boHSLB pf-270_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-271_"><p class="sc-stwUW giqUXE pf-272_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-9aa94af4-4c9d-4043-9e40-93a42473d0ce"/><span class="pf-paragraph-content ">Mild heat is normal, especially during 4K recording, parking mode, or direct sunlight. The operating range is -4°F to 158°F. If it overheats abnormally, shuts down, or shows a high-temp warning, contact support.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-275_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-276_ pf-anchor pf-header-item-wrapper" data-header-id="4694c67c-bd7b-4e24-9574-7d0958f32e21" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Playback Issues</span></div></summary><div class="sc-dxcExB boHSLB pf-278_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-279_"><div class="sc-gvZzpm gKmDqk pf-280_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-281_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-282_ pf-anchor pf-header-item-wrapper" data-header-id="70074dc8-0870-4d6c-a099-3f2f7504fcb0" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Video playback is choppy or freezes. What should I do?</span></div></summary><div class="sc-dxcExB boHSLB pf-284_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-285_"><p class="sc-stwUW giqUXE pf-286_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-cae1ce2a-3e74-4422-a27d-0e26f4afa88b"/><span class="pf-paragraph-content ">In the app, download the video first, then play. On PC, use recommended players like PotPlayer or GKU Player. If it continues, provide an SD card photo to support.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-289_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-290_ pf-anchor pf-header-item-wrapper" data-header-id="d69f08dd-d7bc-4b9a-9d6b-3b0c34a0f895" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Power & Recording Problems</span></div></summary><div class="sc-dxcExB boHSLB pf-292_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-293_"><div class="sc-gvZzpm gKmDqk pf-294_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-295_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-296_ pf-anchor pf-header-item-wrapper" data-header-id="a6668ee3-4524-4267-ad61-ca7d71acd522" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>The dash cam beeps after power-on and does not record.</span></div></summary><div class="sc-dxcExB boHSLB pf-298_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-299_"><p class="sc-stwUW giqUXE pf-300_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-0f340a79-9f8f-4be8-a998-8b98a4f7ae3a"/><span class="pf-paragraph-content ">Check the power supply. Test at home using USB-A to USB-C power. Try a different SD card. If it persists, contact support.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-303_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-304_ pf-anchor pf-header-item-wrapper" data-header-id="7d5935eb-c522-41d5-bbdc-c7de4f342c53" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>The dash cam doesn’t record continuously or some videos are missing.</span></div></summary><div class="sc-dxcExB boHSLB pf-306_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-307_"><p class="sc-stwUW giqUXE pf-308_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-ca060573-5414-40b8-9851-56b33d67f67d"/><span class="pf-paragraph-content ">Ensure stable power. Check both the loop folder and the locked folder. Test at home recording for 1–2 hours with a phone USB charger, then verify in the app. If it persists, contact support.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-311_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-312_ pf-anchor pf-header-item-wrapper" data-header-id="e7f32ad1-f44a-46c7-8746-19c916a72ce9" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>G-Sensor & Voice Alerts</span></div></summary><div class="sc-dxcExB boHSLB pf-314_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-315_"><div class="sc-gvZzpm gKmDqk pf-316_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-317_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-318_ pf-anchor pf-header-item-wrapper" data-header-id="3aac99df-b1b8-4ec7-b3d2-a863bf32b78c" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Why does the dash cam frequently announce “Video Locked”?</span></div></summary><div class="sc-dxcExB boHSLB pf-320_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-321_"><p class="sc-stwUW giqUXE pf-322_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-0c5c4902-b274-4d7e-b581-e98575d69bdb"/><span class="pf-paragraph-content ">Connect to WiFi and lower the G-sensor sensitivity if it’s too high. If it persists, contact support and provide the firmware version.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-325_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-326_ pf-anchor pf-header-item-wrapper" data-header-id="d3b415a9-f03d-45a0-a043-05c3551d21e8" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Rear Camera Issues</span></div></summary><div class="sc-dxcExB boHSLB pf-328_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-329_"><div class="sc-gvZzpm gKmDqk pf-330_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-331_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-332_ pf-anchor pf-header-item-wrapper" data-header-id="15a0a043-05c3-451d-a1e8-a337138340e5" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>The dash cam can’t detect the rear camera or it doesn’t record.</span></div></summary><div class="sc-dxcExB boHSLB pf-334_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-335_"><p class="sc-stwUW giqUXE pf-336_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-05c3551d-21e8-4337-9383-40e5f45f5b2e"/><span class="pf-paragraph-content ">Reconnect the rear camera firmly before powering on. Unplug power and rear camera, plug the rear camera in first, then power on. Check the rear camera icon in the app. If it persists, contact support.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-339_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-340_ pf-anchor pf-header-item-wrapper" data-header-id="38ac6ecd-e516-4b3e-a4b4-72db303d1cd1" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Power Issues</span></div></summary><div class="sc-dxcExB boHSLB pf-342_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-343_"><div class="sc-gvZzpm gKmDqk pf-344_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-345_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-346_ pf-anchor pf-header-item-wrapper" data-header-id="fa534f91-278e-418d-911d-5b94b1707fb1" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>The dash cam doesn’t turn on.</span></div></summary><div class="sc-dxcExB boHSLB pf-348_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-349_"><p class="sc-stwUW giqUXE pf-350_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-3b1b7960-6e0a-462f-b584-f52a42f90afa"/><span class="pf-paragraph-content ">Check the power cable and source. Test with a wall charger using USB-A to USB-C. Do not use USB-C to USB-C cable as it may cause compatibility issues. If it still won’t power on, contact support.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-353_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-354_ pf-anchor pf-header-item-wrapper" data-header-id="5ce34baa-d302-40a4-b4cb-acc4f147feb0" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>WiFi Password & Settings</span></div></summary><div class="sc-dxcExB boHSLB pf-356_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-357_"><div class="sc-gvZzpm gKmDqk pf-358_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-359_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-360_ pf-anchor pf-header-item-wrapper" data-header-id="3db8f88e-ada2-484b-8956-8239b4d172a3" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>What is the default WiFi password?</span></div></summary><div class="sc-dxcExB boHSLB pf-362_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-363_"><p class="sc-stwUW giqUXE pf-364_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-61eaba76-2f6b-4298-827b-a7ba165d289c"/><span class="pf-paragraph-content ">The default password is 12345678</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-367_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-368_ pf-anchor pf-header-item-wrapper" data-header-id="e044aa08-0bde-4d51-9e7f-e0b8c2fc4e71" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>How do I change the WiFi password?</span></div></summary><div class="sc-dxcExB boHSLB pf-370_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-371_"><p class="sc-stwUW giqUXE pf-372_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-cef5e7d5-fd65-47ec-9c27-fff547790503"/><span class="pf-paragraph-content ">Reset the dash cam and connect using the default password. In the app go to Camera Settings → WiFi Password. After changing it, forget the old network on your phone and reconnect. Use numbers only.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-375_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-376_ pf-anchor pf-header-item-wrapper" data-header-id="9e6c87ab-b6ae-41e3-b7a1-550e658d8dd3" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Why can’t I reconnect after changing the WiFi password?</span></div></summary><div class="sc-dxcExB boHSLB pf-378_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-379_"><p class="sc-stwUW giqUXE pf-380_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-db9b6f4d-e1db-4fb2-b65c-65d5fa194383"/><span class="pf-paragraph-content ">Forget the previous dash cam WiFi network in your phone settings and reconnect with the new password. Special characters are not supported.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-383_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-384_ pf-anchor pf-header-item-wrapper" data-header-id="376d369b-2a1f-484e-83a0-e1b942c042fd" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Android-Specific</span></div></summary><div class="sc-dxcExB boHSLB pf-386_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-387_"><div class="sc-gvZzpm gKmDqk pf-388_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-389_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-390_ pf-anchor pf-header-item-wrapper" data-header-id="c241a1bd-3dbe-4c27-8661-0c6eb8fdcebd" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Android WiFi connection fails or disconnects automatically.</span></div></summary><div class="sc-dxcExB boHSLB pf-392_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-393_"><p class="sc-stwUW giqUXE pf-394_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-4dd13d57-2572-438f-b96b-8a7344666044"/><span class="pf-paragraph-content ">When prompted, select “Stay connected even without internet.” Also disable VPN and nearby car WiFi systems (CarPlay/Android Auto) that may interfere.</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-397_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-398_ pf-anchor pf-header-item-wrapper" data-header-id="86fdf475-323f-4e50-b7ae-496a0de2e3c2" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Android has no internet after connecting to the dash cam WiFi.</span></div></summary><div class="sc-dxcExB boHSLB pf-400_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-401_"><p class="sc-stwUW giqUXE pf-402_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-99fee42b-2ac8-425b-a6bb-4d330a74dff2"/><span class="pf-paragraph-content ">This is normal due to Android system behavior. Disconnect from the dash cam WiFi when you need internet. Recording is not affected.</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-405_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-406_ pf-anchor pf-header-item-wrapper" data-header-id="bdcba344-dd5f-4123-997b-7ac4cb663d1e" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span> Memory Card (SD Card)</span></div></summary><div class="sc-dxcExB boHSLB pf-408_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-409_"><div class="sc-gvZzpm gKmDqk pf-410_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-411_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-412_ pf-anchor pf-header-item-wrapper" data-header-id="dc73505e-a39b-4c57-905f-98fe34220f2c" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span> It says “Please format the memory card” / “Card error”. What should I do?</span></div></summary><div class="sc-dxcExB boHSLB pf-414_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-415_"><p class="sc-stwUW giqUXE pf-416_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-33b44a03-6b02-4b93-874e-834a645bcdfb"/><span class="pf-paragraph-content ">  Step-by-step:<br> <br>1) Power on the dash cam and connect your phone to the dash cam WiFi<br><br>2) Open the APP → Settings → Format SD Card<br> <br>3) After formatting, record for 5–10 minutes and check whether new files are created<br> <br>4) If the message returns, remove the card and do a slow format on a computer with a card reader (do not quick format)<br> <br>5) Insert the card back into the dash cam, then format again inside the APP</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-419_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-420_ pf-anchor pf-header-item-wrapper" data-header-id="b8fd47b9-f4b3-42da-92f6-cbc269005c19" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span> The dash cam beeps after power-on and doesn’t record.</span></div></summary><div class="sc-dxcExB boHSLB pf-422_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-423_"><p class="sc-stwUW giqUXE pf-424_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-a3ec2805-d8ce-4a21-8c9a-37b6e3f49638"/><span class="pf-paragraph-content ">Step-by-step:<br> <br>1) Confirm stable power supply (use the original car charger)<br><br>2) Test the camera at home with a wall charger using USB-A to USB-C<br> <br>3) Replace the memory card and test again<br> <br>4) If it still doesn’t record, format the card in the APP once more</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-427_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-428_ pf-anchor pf-header-item-wrapper" data-header-id="67589696-1c66-454f-b4c8-8fa2ecd3a78c" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Some videos are missing / it’s not recording in a loop.</span></div></summary><div class="sc-dxcExB boHSLB pf-430_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-431_"><p class="sc-stwUW giqUXE pf-432_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-5c9747e9-e76a-402a-9d44-d29fed5f787d"/><span class="pf-paragraph-content ">Step-by-step:<br><br>1) Confirm Loop Recording is enabled in settings<br><br>2) Check both folders: - Loop/Normal folder (regular recording) - Locked/Emergency folder (protected clips)<br><br>3) Test recording at home for 1–2 hours with a stable wall charger<br> <br>4) If the locked folder is full (G-sensor too sensitive), lower the G-sensor sensitivity<br> <br>5) If the SD card is near full and loop doesn’t work, back up files and format the card</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-435_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-436_ pf-anchor pf-header-item-wrapper" data-header-id="59cd6bd2-9dc2-4059-8ee2-2218119862a5" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Video playback fails on PC or shows “playback error”.</span></div></summary><div class="sc-dxcExB boHSLB pf-438_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-439_"><p class="sc-stwUW giqUXE pf-440_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-cc63470f-c63f-48e8-b7d4-a2bd3ed6bccb"/><span class="pf-paragraph-content ">Step-by-step:<br><br>1) Remove the SD card and use a card reader to play the files on a computer <br><br>2) If the files are in TS format, use PotPlayer (or GKU Player) to open them<br> <br>3) If videos play fine on PC, the camera is recording normally and the issue is likely the APP/WiFi connection <br><br>4) If videos also fail on PC, the files may be corrupted — format the card and test again</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-443_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-444_ pf-anchor pf-header-item-wrapper" data-header-id="85bc5f69-6ad4-4abf-bb91-92dafbb7aafb" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span> I use 256GB/512GB and it freezes or becomes unstable.</span></div></summary><div class="sc-dxcExB boHSLB pf-446_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-447_"><p class="sc-stwUW giqUXE pf-448_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-8c344923-e906-4e02-bea3-6f3831828e5d"/><span class="pf-paragraph-content ">Step-by-step:<br><br>1) Do a slow format on PC (not quick format)<br> <br>2) Insert into the dash cam and format again in the APP <br><br>3) Use a high-quality card (example: SanDisk Extreme microSD)<br><br>4) If the issue continues, switch to 128GB for best stability</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-451_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-452_ pf-anchor pf-header-item-wrapper" data-header-id="ab5d3b3b-c232-4bce-8e29-faac45119a0a" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>APP & WiFi</span></div></summary><div class="sc-dxcExB boHSLB pf-454_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-455_"><div class="sc-gvZzpm gKmDqk pf-456_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-457_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-458_ pf-anchor pf-header-item-wrapper" data-header-id="681bd2ed-9978-49ae-a268-ddad29482315" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>I connected to WiFi, but it says “No Internet” / “WiFi has no internet access”.</span></div></summary><div class="sc-dxcExB boHSLB pf-460_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-461_"><p class="sc-stwUW giqUXE pf-462_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-7add6e13-c2c3-46f0-b059-c945e60b775d"/><span class="pf-paragraph-content ">Step-by-step:<br><br>1) This is normal: dash cam WiFi is a hub-type WiFi for data transfer only<br> <br>2) Keep your phone within 3–5 meters<br> <br>3) Open the APP and add/connect the camera normally</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-465_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-466_ pf-anchor pf-header-item-wrapper" data-header-id="e88122b3-552f-47b1-81db-5ee796855237" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>I can’t connect to the dash cam WiFi.</span></div></summary><div class="sc-dxcExB boHSLB pf-468_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-469_"><p class="sc-stwUW giqUXE pf-470_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-23c411e5-365b-4560-b9f2-de1ffab2cb62"/><span class="pf-paragraph-content ">Step-by-step:<br> <br>1) Confirm the dash cam is powered on and recording (indicator light blinking)<br> <br>2) Stand within 3–5 meters<br> <br>3) Turn off: VPN, Bluetooth, mobile data, security/antivirus apps<br> <br>4) On your phone WiFi list, tap the device WiFi and select Forget This Network<br> <br>5) Factory reset the camera (press/hold the function button for &gt;5 seconds)<br> <br>6) Reconnect to device WiFi and enter the default password 12345678 <br><br>7) Open the APP and add the camera</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-473_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-474_ pf-anchor pf-header-item-wrapper" data-header-id="354f0c52-6f2e-485a-b157-885c7efb8dd6" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>The dash cam WiFi name doesn’t show up (can’t find WiFi).</span></div></summary><div class="sc-dxcExB boHSLB pf-476_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-477_"><p class="sc-stwUW giqUXE pf-478_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-ae60dfc3-3ca7-4378-b248-a34c5644d779"/><span class="pf-paragraph-content ">Step-by-step:<br><br>1) Use the original car charger and start the engine to ensure full power<br><br>2) If still not found, do a factory reset (hold the function button &gt;5 seconds)<br> <br>3) Test at home with a wall charger and USB-A to USB-C cable (stable power)<br> <br>4) If it works at home, the vehicle power supply may be unstable</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-481_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-482_ pf-anchor pf-header-item-wrapper" data-header-id="ff3c33ee-bd15-4c05-8081-6718cbb270f4" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>The APP can’t preview / buffering is slow / can’t download videos.</span></div></summary><div class="sc-dxcExB boHSLB pf-484_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-485_"><p class="sc-stwUW giqUXE pf-486_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-53afc363-6a4a-4e78-ab90-f4fc9fa17a7b"/><span class="pf-paragraph-content ">Step-by-step:<br><br>1) Keep the phone close (within 3–5m) and ensure WiFi is stable<br><br>2) Turn off mobile data while connected to the dash cam WiFi<br> <br>3) For 4K files, download first, then play from your phone gallery to avoid buffering<br> <br>4) If preview/download still fails: - Delete the APP and reinstall the latest version - Test the SD card on a PC via card reader to confirm the files are OK</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-489_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-490_ pf-anchor pf-header-item-wrapper" data-header-id="2d7ddb15-d4c6-470c-957a-eed1971afde0" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Why can’t I see videos in the APP “Album”?</span></div></summary><div class="sc-dxcExB boHSLB pf-492_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-493_"><p class="sc-stwUW giqUXE pf-494_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-791be93f-c23e-4be3-ab06-c10e70290927"/><span class="pf-paragraph-content ">Step-by-step:<br> <br>1) The “Album” shows only the files you downloaded to the phone<br><br>2) Connect to dash cam WiFi → open playback → select videos → download<br> <br>3) After download, they will appear in the APP Album / phone gallery</span></p></div></div></div></details></div></div></div></div></details><details class="sc-kRRxPL iQTArD pf-497_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-498_ pf-anchor pf-header-item-wrapper" data-header-id="4f67e1f7-09f0-495a-9d4d-4f4de899b6d0" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Parking Monitor</span></div></summary><div class="sc-dxcExB boHSLB pf-500_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-501_"><div class="sc-gvZzpm gKmDqk pf-502_ pf-icon-right" data-scroll-to-top="true" data-open-multiple="false" data-pf-type="Accordion3"><details class="sc-kRRxPL iQTArD pf-503_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-504_ pf-anchor pf-header-item-wrapper" data-header-id="807d3ae9-aea6-4db1-8d6a-c9ef3a761c57" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span> How do I install the hardwire kit (step-down voltage kit)?</span></div></summary><div class="sc-dxcExB boHSLB pf-506_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-507_"><p class="sc-stwUW giqUXE pf-508_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-1a9ca56f-2d7d-4281-871c-fd9e376836a6"/><span class="pf-paragraph-content "><strong>Step 1: Locate your vehicle’s fuse box</strong><br>Please find your fuse box using your vehicle’s Fuse Box Diagram (owner’s manual or fuse box cover diagram). Please open the fuse box cover. Some covers lift by a small tab; others may require gently prying a panel—please use the included trim tool if needed.<br><br>If you have trouble locating the fuse box, please let us know and we’ll help.<br><br><strong>Step 2: Identify the correct fuse slots (ACC + Constant Power)</strong><br>You will need two fuse slots:<br><br>Constant Power fuse (Yellow wire): provides power all the time, even when the engine is off. (Required for parking mode.)<br><br>ACC fuse (Red wire): provides power only when the key is in ACC/ON. (Used for normal driving recording.)<br><br><strong>Step 3: Connect the Red &amp; Yellow fuse taps (Add-A-Fuse) and verify with a voltmeter</strong><br>Please use a voltmeter to confirm you picked the correct fuse slots:<br><br>Red Wire (ACC): Please turn the car key to the ACC position.Please test the aluminum end of the RED Add-A-Fuse with a voltmeter.If you see voltage, it confirms this slot is powered in ACC.<br><br>Yellow Wire (Constant/B+): Please turn the car off. Please test the aluminum end of the YELLOW Add-A-Fuse with a voltmeter. If you still see voltage, it confirms this slot is constant (always-on) power.<br><br><strong>Step 4: Locate a good ground point (Black wire)<br></strong>Please connect the Black wire (Ground) to a solid metal screw/bolt on the vehicle chassis. We strongly recommend using a proper ground point for stable power.<br><br>Please note: an improper ground connection may cause the dash cam to malfunction or restart intermittently.<br><br>After wiring, please power on the dash cam and confirm it records normally.Please check that Parking Mode appears in the app/settings after a correct hardwire installation. If your fuse type doesn’t match the fuse taps you have, please contact us</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-511_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-512_ pf-anchor pf-header-item-wrapper" data-header-id="431cfe00-3749-461c-8b3e-8e36a9919042" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Parking Monitoring option doesn’t appear in the APP.</span></div></summary><div class="sc-dxcExB boHSLB pf-514_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-515_"><p class="sc-stwUW giqUXE pf-516_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-f45714ac-8a12-411e-8b1d-c2be9fab0adc"/><span class="pf-paragraph-content ">Step-by-step (<strong>wiring verification</strong>):<br> <br>1) Use a multimeter to find the correct fuses: - ACC fuse (for RED wire): - Engine ON: has power - Engine OFF: 0V - BATT/Constant fuse (for YELLOW wire): - Engine ON: has power - Engine OFF: 12V+ <br><br>2) Connect BLACK wire to a metal ground point <br><br>3) Restart the car, power on the dash cam, connect WiFi, and check the APP again <br><br>4) If Parking Monitoring still doesn’t show, re-check fuse selection and wiring</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-519_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-520_ pf-anchor pf-header-item-wrapper" data-header-id="1e575ee0-ad96-4428-8155-070c09912262" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>After the car is off, I can’t connect to the dash cam WiFi / the camera looks “offline”.</span></div></summary><div class="sc-dxcExB boHSLB pf-522_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-523_"><p class="sc-stwUW giqUXE pf-524_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-f8ae3269-a59b-49c8-b625-aac66d1491fd"/><span class="pf-paragraph-content ">Step-by-step: <br><br>1) This can be normal in parking mode: WiFi may be disabled to reduce power and prevent tampering<br><br> 2) To check parking recordings: - Start the car → connect WiFi → open playback - Look for time-lapse files in the loop folder (often with “tlp” in the filename) - Look for collision-triggered files in the locked folder</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-527_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-528_ pf-anchor pf-header-item-wrapper" data-header-id="2d23dc50-d705-4efd-889c-33f7ae0b91ea" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Time-lapse parking videos play very fast. Is that normal?</span></div></summary><div class="sc-dxcExB boHSLB pf-530_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-531_"><p class="sc-stwUW giqUXE pf-532_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-7aca865e-099c-4b2c-8a4e-a0fb0cd1e332"/><span class="pf-paragraph-content ">Step-by-step: <br><br>1) Yes. Time-lapse records at a very low frame rate (e.g., 1 frame per second) <br><br>2) That means a short clip may contain a long parking period, so playback looks fast <br><br>3) For better viewing, download the file and play on a PC with PotPlayer</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-535_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-536_ pf-anchor pf-header-item-wrapper" data-header-id="6b99201f-6bdb-47d9-b822-406baa5f250a" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>Will parking mode drain my car battery?</span></div></summary><div class="sc-dxcExB boHSLB pf-538_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-539_"><p class="sc-stwUW giqUXE pf-540_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-f841e22d-6355-46f8-afbf-70e247018f8d"/><span class="pf-paragraph-content "> Step-by-step:<br><br>1) The hardwire kit has low-voltage protection and will cut off power when voltage drops below about 11.8V <br><br>2) Battery drain risk depends on your battery health and how long the car is parked <br><br>3) To reduce risk: - Use Collision Detection mode for long parking - Or set a limited time-lapse duration (e.g., 12h/24h) instead of always-on</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-543_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-544_ pf-anchor pf-header-item-wrapper" data-header-id="94b165e9-2ee6-4557-8412-b11b2976d3cf" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>After installing the fuse tap, my car’s original function stopped working.</span></div></summary><div class="sc-dxcExB boHSLB pf-546_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-547_"><p class="sc-stwUW giqUXE pf-548_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-c66add4f-ad08-4ce8-bf77-d959cf2e4e78"/><span class="pf-paragraph-content "> Step-by-step: <br><br>1) Make sure you inserted the original vehicle fuse back into the fuse tap<br><br>2) The fuse tap has two slots: one for the original circuit fuse, one for the dash cam <br><br>3) After installation, test both the vehicle function and dash cam power</span></p></div></div></div></details><details class="sc-kRRxPL iQTArD pf-551_" data-pf-type="Accordion3.Content.Wrapper"><summary><div class="sc-kqGpvY cmTzNW pf-552_ pf-anchor pf-header-item-wrapper" data-header-id="fac2f281-9182-4a5d-99c3-08ffc0b8c7c4" data-active="false" data-pf-type="Accordion3.Header"><svg class="pf-accordion-icon pfa-chevron-right pfa-arrow" style="width:auto;fill:currentcolor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M278.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-160 160c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L210.7 256 73.4 118.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l160 160z"></path></svg><span>What fuse rating can the hardwire kit use? Can it go into a 15A or higher slot?</span></div></summary><div class="sc-dxcExB boHSLB pf-554_ pf-accordion-body" data-pf-expandable="true" data-pf-type="Accordion3.Content"><div class="pf-accordion-display-content"><div data-pf-type="Accordion3.Flex.Content" class="sc-ijaoyg fLgXwO pf-555_"><p class="sc-stwUW giqUXE pf-556_" data-pf-type="Paragraph4"><input type="checkbox" id="compact-1dc70910-a6ec-42e8-b458-ff692cced59a"/><span class="pf-paragraph-content ">Step-by-step: <br><br>1) The hardwire kit supports up to 15A <br><br>2) In parking mode, the dash cam current is typically under 700mA <br><br>3) You can use a 15A-or-higher fuse slot as long as that circuit is not shared with other high-load devices</span></p></div></div></div></details></div></div></div></div></details></div></div></div></div></details></div></div></section></div></div></div><script>
