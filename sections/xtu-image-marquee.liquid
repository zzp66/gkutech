{%- comment -%}
  XTU Image Marquee — 全宽无缝图片滚动（媒体/品牌 logo 条）。

  数据来源：Theme Editor 本 section 的「图片」block（图 + 可选链接）。
  高度统一、宽度按图片比例自适应；间距 / 方向 / 速度可配。
  Hover 到图片：xtu-img-zoom 放大，整条滚动暂停；移开恢复。
  无封面资源时用 placeholder，便于后台预览。

  运营：添加「XTU Image Marquee」，按顺序上传图片；可选链接。
  Logo / 图标位允许统一高度（非内容媒体比例规则）。

  相关：assets/xtu-image-marquee.js、assets/xtu-image-marquee.css、assets/xtu-motion.css
{%- endcomment -%}

{% liquid
  assign heading = section.settings.heading
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#000000'
  assign placeholder_bg = section.settings.placeholder_bg | default: '#E8EAED'
  assign image_height = section.settings.image_height | default: 48
  assign image_height_mobile = section.settings.image_height_mobile | default: 36
  assign gap = section.settings.gap | default: 48
  assign gap_mobile = section.settings.gap_mobile | default: 32
  assign direction = section.settings.direction | default: 'rtl'
  assign speed = section.settings.speed | default: 40
  assign padding_top = section.settings.padding_top | default: 40
  assign padding_bottom = section.settings.padding_bottom | default: 40
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 24
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 24
  assign item_count = 0
  for block in section.blocks
    if block.type == 'image'
      assign item_count = item_count | plus: 1
    endif
  endfor
%}

{{ 'xtu-image-marquee.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xtu-image-marquee.js' | asset_url }}" defer="defer"></script>

<section
  id="xtu-image-marquee-{{ section.id }}"
  class="xtu-im"
  data-xtu-image-marquee
  data-speed="{{ speed }}"
  data-direction="{{ direction }}"
  style="
    --xtu-im-bg: {{ background_color }};
    --xtu-im-heading: {{ heading_color }};
    --xtu-im-placeholder-bg: {{ placeholder_bg }};
    --xtu-im-h: {{ image_height }}px;
    --xtu-im-h-m: {{ image_height_mobile }}px;
    --xtu-im-gap: {{ gap }}px;
    --xtu-im-gap-m: {{ gap_mobile }}px;
    --xtu-im-pt: {{ padding_top }}px;
    --xtu-im-pb: {{ padding_bottom }}px;
    --xtu-im-pt-m: {{ padding_top_mobile }}px;
    --xtu-im-pb-m: {{ padding_bottom_mobile }}px;
  "
>
  {% if heading != blank %}
    <h2 class="xtu-im__heading">{{ heading | escape }}</h2>
  {% endif %}

  {% if item_count > 0 %}
    <div class="xtu-im__viewport" data-xtu-im-viewport>
      <div class="xtu-im__track xtu-im__track--{{ direction }}" data-xtu-im-track>
        {% for pass in (1..2) %}
          <div
            class="xtu-im__group"
            data-xtu-im-group
            {% if pass == 2 %}aria-hidden="true"{% endif %}
          >
            {% for block in section.blocks %}
              {% if block.type == 'image' %}
                {% liquid
                  assign image = block.settings.image
                  assign link = block.settings.link
                  assign alt_text = image.alt | default: heading | default: 'Logo'
                  assign ph_mod = forloop.index0 | modulo: 3
                  assign placeholder_name = 'image'
                  if ph_mod == 1
                    assign placeholder_name = 'lifestyle-1'
                  elsif ph_mod == 2
                    assign placeholder_name = 'lifestyle-2'
                  endif
                %}
                {% if link != blank and pass == 1 %}
                  <a
                    class="xtu-im__item xtu-img-zoom"
                    href="{{ link }}"
                    {% if pass == 1 %}data-xtu-im-source{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {% if image != blank %}
                      {{
                        image
                        | image_url: width: 800
                        | image_tag:
                          class: 'xtu-im__image xtu-img-zoom__media',
                          loading: 'lazy',
                          widths: '120, 200, 320, 480, 640, 800',
                          sizes: '200px',
                          alt: alt_text
                      }}
                    {% else %}
                      {{ placeholder_name | placeholder_svg_tag: 'xtu-im__placeholder xtu-img-zoom__media' }}
                    {% endif %}
                  </a>
                {% else %}
                  <div
                    class="xtu-im__item xtu-img-zoom"
                    {% if pass == 1 %}data-xtu-im-source{% endif %}
                    {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}
                  >
                    {% if image != blank %}
                      {{
                        image
                        | image_url: width: 800
                        | image_tag:
                          class: 'xtu-im__image xtu-img-zoom__media',
                          loading: 'lazy',
                          widths: '120, 200, 320, 480, 640, 800',
                          sizes: '200px',
                          alt: alt_text
                      }}
                    {% else %}
                      {{ placeholder_name | placeholder_svg_tag: 'xtu-im__placeholder xtu-img-zoom__media' }}
                    {% endif %}
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "XTU Image Marquee",
  "tag": "section",
  "class": "section-xtu-image-marquee",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 20,
  "settings": [
    {
      "type": "paragraph",
      "content": "全宽无缝滚动图片条。图片高度统一，宽度随图片比例变化。Hover 放大并暂停滚动。"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "大标题",
      "info": "可留空，不显示标题。"
    },
    {
      "type": "header",
      "content": "滚动"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "滚动方向",
      "options": [
        { "value": "rtl", "label": "从右往左" },
        { "value": "ltr", "label": "从左往右" }
      ],
      "default": "rtl"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "滚动速度",
      "min": 10,
      "max": 120,
      "step": 2,
      "default": 40,
      "info": "每秒移动的像素。数值越大越快。"
    },
    {
      "type": "header",
      "content": "图片尺寸"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "图片高度（PC）",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "图片高度（移动端）",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "gap",
      "label": "图片间距（PC）",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "图片间距（移动端）",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "外观"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "版块背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "placeholder_bg",
      "label": "占位背景色",
      "default": "#E8EAED"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "图片",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "url",
          "id": "link",
          "label": "跳转链接",
          "info": "选填。填写后点击图片跳转。"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "XTU Image Marquee",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
