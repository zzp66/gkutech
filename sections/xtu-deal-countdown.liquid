{%- comment -%}
  XTU Deal Countdown — 促销倒计时 Banner（类「Deals Of The Day」排版）。

  数据来源：Theme Editor 本 section。
  - 布局：PC / 移动端各自可选全宽或版心宽度。
    · 全宽：背景通栏 100%；文案落在「版心宽度」轨内再做左/中/右对齐。
    · 版心：整块 Banner（含背景）收窄到版心，左右不留 section 色带/空占位。
  - 背景：PC / 移动端分图；可选遮罩（默认关）。
  - 内容：副标题、标题、文案、倒计时、按钮；PC 水平对齐，移动端垂直对齐。
  - 字号 / 颜色 / 按钮样式均可配；倒计时结束行为可配。

  运营配置
  1. Theme Editor 添加「XTU Deal Countdown」。
  2. 上传背景图，填写文案与结束时间（ISO，如 2026-12-31T23:59:59）。
  3. 按需调整对齐、字号、颜色与按钮。

  前台：Banner 叠字 + 实时倒计时；媒体 cover 填满比例/视口高度。

  相关：assets/xtu-deal-countdown.css、assets/xtu-deal-countdown.js
{%- endcomment -%}

{% liquid
  assign layout_desktop = section.settings.layout_desktop | default: 'full'
  assign layout_mobile = section.settings.layout_mobile | default: 'full'
  assign content_width = section.settings.content_width | default: 1200 | at_least: 600 | at_most: 1600
  assign copy_width = section.settings.copy_width | default: 560 | at_least: 280 | at_most: 900
  assign media_radius = section.settings.media_radius | default: 0
  assign height_mode = section.settings.height_mode | default: 'ratio'
  assign media_ratio = section.settings.media_ratio | default: '21 / 9'
  assign media_ratio_mobile = section.settings.media_ratio_mobile | default: '3 / 4'
  assign height_desktop = section.settings.height_desktop | default: 70
  assign height_mobile = section.settings.height_mobile | default: 70
  assign min_height = section.settings.min_height | default: 360
  assign min_height_mobile = section.settings.min_height_mobile | default: 280

  assign bg_image = section.settings.bg_image
  assign bg_image_mobile = section.settings.bg_image_mobile
  assign has_mobile_bg = false
  if bg_image_mobile != blank
    assign has_mobile_bg = true
  endif

  assign enable_overlay = section.settings.enable_overlay
  assign overlay_opacity = section.settings.overlay_opacity | default: 30

  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign body = section.settings.body
  assign align_desktop = section.settings.align_desktop | default: 'left'
  assign align_mobile = section.settings.align_mobile | default: 'center'

  assign show_countdown = section.settings.show_countdown
  assign countdown_end = section.settings.countdown_end | strip
  assign expired_behavior = section.settings.expired_behavior | default: 'zero'
  assign expired_message = section.settings.expired_message
  assign label_days = section.settings.label_days | default: 'DAYS'
  assign label_hours = section.settings.label_hours | default: 'HRS'
  assign label_minutes = section.settings.label_minutes | default: 'MIN'
  assign label_seconds = section.settings.label_seconds | default: 'SEC'
  assign show_days = section.settings.show_days
  assign show_hours = section.settings.show_hours
  assign show_minutes = section.settings.show_minutes
  assign show_seconds = section.settings.show_seconds

  assign btn_label = section.settings.button_label
  assign btn_link = section.settings.button_link
  assign btn_style = section.settings.button_style | default: 'outline'
  assign show_button_arrow = section.settings.show_button_arrow

  assign eyebrow_size = section.settings.eyebrow_size | default: 14
  assign eyebrow_size_m = section.settings.eyebrow_size_mobile | default: 12
  assign heading_size = section.settings.heading_size | default: 40
  assign heading_size_m = section.settings.heading_size_mobile | default: 24
  assign body_size = section.settings.body_size | default: 14
  assign body_size_m = section.settings.body_size_mobile | default: 14
  assign timer_number_size = section.settings.timer_number_size | default: 24
  assign timer_number_size_m = section.settings.timer_number_size_mobile | default: 20
  assign timer_label_size = section.settings.timer_label_size | default: 10
  assign timer_label_size_m = section.settings.timer_label_size_mobile | default: 10

  assign shell_bg = section.settings.shell_background | default: '#111111'
  assign placeholder_bg = section.settings.placeholder_bg | default: '#1A1A1A'
  assign eyebrow_color = section.settings.eyebrow_color | default: '#F2E715'
  assign heading_color = section.settings.heading_color | default: '#FFFFFF'
  assign body_color = section.settings.body_color | default: '#FFFFFF'
  assign timer_bg = section.settings.timer_bg | default: '#000000'
  assign timer_bg_opacity = section.settings.timer_bg_opacity | default: 55
  assign timer_number_color = section.settings.timer_number_color | default: '#FFFFFF'
  assign timer_label_color = section.settings.timer_label_color | default: '#FFFFFF'
  assign timer_sep_color = section.settings.timer_sep_color | default: '#FFFFFF'
  assign expired_color = section.settings.expired_color | default: '#FFFFFF'
  assign btn_bg = section.settings.button_bg | default: 'transparent'
  assign btn_color = section.settings.button_color | default: '#FFFFFF'
  assign btn_border = section.settings.button_border | default: '#FFFFFF'
  assign btn_bg_hover = section.settings.button_bg_hover | default: '#FFFFFF'
  assign btn_color_hover = section.settings.button_color_hover | default: '#111111'
  assign btn_border_hover = section.settings.button_border_hover | default: '#FFFFFF'

  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 0
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 0

  assign overlay_alpha = 0
  if enable_overlay
    assign overlay_alpha = overlay_opacity | divided_by: 100.0
  endif

  assign show_timer = false
  if show_countdown and countdown_end != blank
    assign show_timer = true
  endif
%}

{{ 'xtu-deal-countdown.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xtu-deal-countdown.js' | asset_url }}" defer="defer"></script>

<section
  id="xtu-deal-countdown-{{ section.id }}"
  class="
    xtu-dc
    xtu-dc--layout-d-{{ layout_desktop }}
    xtu-dc--layout-m-{{ layout_mobile }}
    {% if height_mode == 'viewport' %}xtu-dc--height-viewport{% endif %}
  "
  {% if show_timer %}
    data-xtu-deal-countdown
    data-end="{{ countdown_end | escape }}"
    data-expired="{{ expired_behavior | escape }}"
  {% endif %}
  style="
    --xtu-dc-shell-bg: {{ shell_bg }};
    --xtu-dc-content-width: {{ content_width }}px;
    --xtu-dc-copy-width: {{ copy_width }}px;
    --xtu-dc-radius: {{ media_radius }}px;
    --xtu-dc-ratio: {{ media_ratio }};
    --xtu-dc-ratio-m: {{ media_ratio_mobile }};
    --xtu-dc-vh: {{ height_desktop }}svh;
    --xtu-dc-vh-m: {{ height_mobile }}svh;
    --xtu-dc-min-h: {{ min_height }}px;
    --xtu-dc-min-h-m: {{ min_height_mobile }}px;
    --xtu-dc-placeholder-bg: {{ placeholder_bg }};
    --xtu-dc-overlay: {{ overlay_alpha }};
    --xtu-dc-eyebrow-size: {{ eyebrow_size }}px;
    --xtu-dc-eyebrow-size-m: {{ eyebrow_size_m }}px;
    --xtu-dc-heading-size: {{ heading_size }}px;
    --xtu-dc-heading-size-m: {{ heading_size_m }}px;
    --xtu-dc-body-size: {{ body_size }}px;
    --xtu-dc-body-size-m: {{ body_size_m }}px;
    --xtu-dc-timer-number-size: {{ timer_number_size }}px;
    --xtu-dc-timer-number-size-m: {{ timer_number_size_m }}px;
    --xtu-dc-timer-label-size: {{ timer_label_size }}px;
    --xtu-dc-timer-label-size-m: {{ timer_label_size_m }}px;
    --xtu-dc-eyebrow-color: {{ eyebrow_color }};
    --xtu-dc-heading-color: {{ heading_color }};
    --xtu-dc-body-color: {{ body_color }};
    --xtu-dc-timer-bg: color-mix(in srgb, {{ timer_bg }} {{ timer_bg_opacity }}%, transparent);
    --xtu-dc-timer-number: {{ timer_number_color }};
    --xtu-dc-timer-label: {{ timer_label_color }};
    --xtu-dc-timer-sep: {{ timer_sep_color }};
    --xtu-dc-expired-color: {{ expired_color }};
    --xtu-dc-btn-bg: {{ btn_bg }};
    --xtu-dc-btn-color: {{ btn_color }};
    --xtu-dc-btn-border: {{ btn_border }};
    --xtu-dc-btn-bg-hover: {{ btn_bg_hover }};
    --xtu-dc-btn-color-hover: {{ btn_color_hover }};
    --xtu-dc-btn-border-hover: {{ btn_border_hover }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  "
>
  <style>
    @media screen and (max-width: 749px) {
      #xtu-deal-countdown-{{ section.id }} {
        padding-top: {{ padding_top_mobile }}px;
        padding-bottom: {{ padding_bottom_mobile }}px;
      }
    }
  </style>

  <div class="xtu-dc__shell">
    <div class="xtu-dc__stage">
      <div class="xtu-dc__media{% if has_mobile_bg %} xtu-dc__media--split{% endif %}">
        {% if bg_image != blank %}
          {{
            bg_image
            | image_url: width: 2400
            | image_tag:
              class: 'xtu-dc__bg xtu-dc__bg--desktop',
              loading: 'lazy',
              widths: '750, 1100, 1500, 2000, 2400',
              sizes: '100vw',
              alt: heading
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'xtu-dc__bg xtu-dc__bg--desktop xtu-dc__placeholder' }}
        {% endif %}
        {% if has_mobile_bg %}
          {{
            bg_image_mobile
            | image_url: width: 1500
            | image_tag:
              class: 'xtu-dc__bg xtu-dc__bg--mobile',
              loading: 'lazy',
              widths: '480, 750, 1100, 1500',
              sizes: '100vw',
              alt: heading
          }}
        {% endif %}
        {% if enable_overlay %}
          <div class="xtu-dc__overlay" aria-hidden="true"></div>
        {% endif %}
      </div>

      <div
        class="
          xtu-dc__content
          xtu-dc__content--desktop-{{ align_desktop }}
          xtu-dc__content--mobile-{{ align_mobile }}
        "
      >
        <div class="xtu-dc__rail">
          <div class="xtu-dc__inner" data-xtu-reveal="fade-up" data-xtu-stagger>
            {% if eyebrow != blank %}
              <p class="xtu-dc__eyebrow" data-xtu-reveal-child>{{ eyebrow | escape }}</p>
            {% endif %}

            {% if heading != blank %}
              <h2 class="xtu-dc__heading" data-xtu-reveal-child>{{ heading | escape }}</h2>
            {% endif %}

            {% if body != blank %}
              <p class="xtu-dc__body" data-xtu-reveal-child>{{ body | escape }}</p>
            {% endif %}

            {% if show_timer %}
              <div class="xtu-dc__timer" data-xtu-dc-timer data-xtu-reveal-child aria-live="polite">
                {% assign prev_unit = false %}
                {% if show_days %}
                  <div class="xtu-dc__unit">
                    <span class="xtu-dc__unit-value" data-xtu-dc-unit="days">00</span>
                    <span class="xtu-dc__unit-label">{{ label_days | escape }}</span>
                  </div>
                  {% assign prev_unit = true %}
                {% endif %}
                {% if show_hours %}
                  {% if prev_unit %}<span class="xtu-dc__sep" aria-hidden="true">:</span>{% endif %}
                  <div class="xtu-dc__unit">
                    <span class="xtu-dc__unit-value" data-xtu-dc-unit="hours">00</span>
                    <span class="xtu-dc__unit-label">{{ label_hours | escape }}</span>
                  </div>
                  {% assign prev_unit = true %}
                {% endif %}
                {% if show_minutes %}
                  {% if prev_unit %}<span class="xtu-dc__sep" aria-hidden="true">:</span>{% endif %}
                  <div class="xtu-dc__unit">
                    <span class="xtu-dc__unit-value" data-xtu-dc-unit="minutes">00</span>
                    <span class="xtu-dc__unit-label">{{ label_minutes | escape }}</span>
                  </div>
                  {% assign prev_unit = true %}
                {% endif %}
                {% if show_seconds %}
                  {% if prev_unit %}<span class="xtu-dc__sep" aria-hidden="true">:</span>{% endif %}
                  <div class="xtu-dc__unit">
                    <span class="xtu-dc__unit-value" data-xtu-dc-unit="seconds">00</span>
                    <span class="xtu-dc__unit-label">{{ label_seconds | escape }}</span>
                  </div>
                {% endif %}
              </div>

              {% if expired_message != blank %}
                <p class="xtu-dc__expired" data-xtu-dc-expired-msg hidden data-xtu-reveal-child>
                  {{ expired_message | escape }}
                </p>
              {% endif %}
            {% endif %}

            {% if btn_label != blank %}
              <a
                class="xtu-dc__btn xtu-dc__btn--{{ btn_style }}"
                href="{{ btn_link | default: '#' }}"
                data-xtu-reveal-child
              >
                <span>{{ btn_label | escape }}</span>
                {% if show_button_arrow %}
                  <span class="xtu-dc__btn-arrow" aria-hidden="true">
                    <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M2 6h7.5M6.5 2.5 10 6l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                {% endif %}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "XTU Deal Countdown",
  "tag": "section",
  "class": "section-xtu-deal-countdown",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "促销倒计时 Banner：背景图 + 副标题/标题/文案/倒计时/按钮。PC 水平对齐，移动端垂直对齐。"
    },
    {
      "type": "header",
      "content": "布局与尺寸"
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "PC 宽度",
      "options": [
        { "value": "full", "label": "全宽" },
        { "value": "content", "label": "版心宽度" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "移动端宽度",
      "options": [
        { "value": "full", "label": "全宽" },
        { "value": "content", "label": "版心宽度" }
      ],
      "default": "full"
    },
    {
      "type": "number",
      "id": "content_width",
      "label": "版心最大宽度（px）",
      "default": 1200,
      "info": "全宽：约束文案对齐轨；版心宽度：约束整块 Banner（含背景）。范围 600–1600。"
    },
    {
      "type": "number",
      "id": "copy_width",
      "label": "文案区最大宽度（px）",
      "default": 560,
      "info": "范围 280–900。"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "媒体圆角",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "版心宽度时更常用；全宽建议 0。"
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "高度模式",
      "options": [
        { "value": "ratio", "label": "按比例（aspect-ratio）" },
        { "value": "viewport", "label": "视口高度（svh）" }
      ],
      "default": "ratio"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "PC 比例",
      "options": [
        { "value": "21 / 9", "label": "21:9" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "16 / 10", "label": "16:10" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "3 / 2", "label": "3:2" },
        { "value": "1 / 1", "label": "1:1" }
      ],
      "default": "21 / 9",
      "visible_if": "{{ section.settings.height_mode == 'ratio' }}"
    },
    {
      "type": "select",
      "id": "media_ratio_mobile",
      "label": "移动端比例",
      "options": [
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "16 / 9", "label": "16:9" }
      ],
      "default": "3 / 4",
      "visible_if": "{{ section.settings.height_mode == 'ratio' }}"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "PC 最小高度",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 360,
      "visible_if": "{{ section.settings.height_mode == 'ratio' }}"
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "移动端最小高度",
      "min": 180,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 280,
      "visible_if": "{{ section.settings.height_mode == 'ratio' }}"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "PC 视口高度",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "svh",
      "default": 70,
      "visible_if": "{{ section.settings.height_mode == 'viewport' }}"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "移动端视口高度",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "svh",
      "default": 70,
      "visible_if": "{{ section.settings.height_mode == 'viewport' }}"
    },
    {
      "type": "header",
      "content": "背景"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "背景图（PC）"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "背景图（移动端，可选）",
      "info": "未配置时移动端回退 PC 图。"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "启用背景遮罩",
      "default": false,
      "info": "加深背景以便浅色文案可读；默认关闭。"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "遮罩透明度",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "%",
      "default": 30,
      "visible_if": "{{ section.settings.enable_overlay }}"
    },
    {
      "type": "color",
      "id": "shell_background",
      "label": "版块底色",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "placeholder_bg",
      "label": "占位背景色",
      "default": "#1A1A1A"
    },
    {
      "type": "header",
      "content": "文案内容"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "副标题",
      "default": "Back to School 40%OFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Deals Of The Day"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "文案",
      "default": "D600 Pro Max\n4K+1080P Dash Cam Front and Rear."
    },
    {
      "type": "select",
      "id": "align_desktop",
      "label": "PC 水平对齐",
      "options": [
        { "value": "left", "label": "居左" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "居右" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "align_mobile",
      "label": "移动端垂直对齐",
      "options": [
        { "value": "top", "label": "居上" },
        { "value": "center", "label": "居中" },
        { "value": "bottom", "label": "居下" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "倒计时"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "显示倒计时",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "结束时间",
      "info": "ISO 格式，例如 2026-12-31T23:59:59（按访客本地时区解析）。",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "select",
      "id": "expired_behavior",
      "label": "结束后行为",
      "options": [
        { "value": "zero", "label": "显示 00" },
        { "value": "hide", "label": "隐藏倒计时" }
      ],
      "default": "zero",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "结束后提示文案",
      "default": "Deal ended",
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "checkbox",
      "id": "show_days",
      "label": "显示天",
      "default": true,
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "显示时",
      "default": true,
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "checkbox",
      "id": "show_minutes",
      "label": "显示分",
      "default": true,
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "checkbox",
      "id": "show_seconds",
      "label": "显示秒",
      "default": true,
      "visible_if": "{{ section.settings.show_countdown }}"
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "天标签",
      "default": "DAYS",
      "visible_if": "{{ section.settings.show_countdown and section.settings.show_days }}"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "时标签",
      "default": "HRS",
      "visible_if": "{{ section.settings.show_countdown and section.settings.show_hours }}"
    },
    {
      "type": "text",
      "id": "label_minutes",
