{% liquid
  assign heading = section.settings.heading
  assign gap = section.settings.card_gap | default: 16
  assign gap_mobile = section.settings.card_gap_mobile | default: 8
  assign card_radius = section.settings.card_radius | default: 16
  assign card_ratio = section.settings.card_ratio | default: '1 / 1'
  assign ratio_auto = false
  if card_ratio == 'auto'
    assign ratio_auto = true
  endif
  assign show_arrows = section.settings.show_arrows
  assign show_arrows_mobile = section.settings.show_arrows_mobile
  assign show_image_overlay = section.settings.show_image_overlay
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign mobile_per_view = section.settings.mobile_per_view | default: '2.1'
%}

<script src="{{ 'xtu-activity-slider.js' | asset_url }}" defer="defer"></script>

<section
  id="xtu-activity-slider-{{ section.id }}"
  class="xtu-activity-slider{% if ratio_auto %} xtu-activity-slider--ratio-auto{% endif %}"
  data-xtu-activity-slider
  data-gap="{{ gap }}"
  data-gap-mobile="{{ gap_mobile }}"
  data-mobile-per-view="{{ mobile_per_view }}"
  style="
    --xtu-as-gap: {{ gap }}px;
    --xtu-as-gap-mobile: {{ gap_mobile }}px;
    --xtu-as-radius: {{ card_radius }}px;
    {% unless ratio_auto %}--xtu-as-ratio: {{ card_ratio }};{% endunless %}
    --xtu-as-padding-top: {{ padding_top }}px;
    --xtu-as-padding-bottom: {{ padding_bottom }}px;
    --xtu-as-padding-top-mobile: {{ padding_top_mobile }}px;
    --xtu-as-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  "
>
  <div class="xtu-activity-slider__intro" data-xtu-reveal="fade-up">
    {% if heading != blank %}
      <h2 class="xtu-activity-slider__heading">
        {{ heading | escape }}
      </h2>
    {% endif %}

    {% if show_arrows and section.blocks.size > 1 %}
      <div class="xtu-swiper-nav-group{% unless show_arrows_mobile %} xtu-swiper-nav-group--hide-mobile{% endunless %}">
        {% render 'xtu-swiper-nav',
          variant: 'on-light',
          prev_attributes: 'data-xtu-activity-prev',
          next_attributes: 'data-xtu-activity-next'
        %}
      </div>
    {% endif %}
  </div>

  <div class="xtu-activity-slider__viewport" data-xtu-reveal="fade-up">
    <div class="swiper xtu-activity-slider__swiper" data-xtu-activity-swiper>
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% if block.type == 'card' %}
            {% liquid
              assign card_title = block.settings.title
              assign card_link = block.settings.link
              assign media_type = block.settings.media_type | default: 'image'
              assign card_image = block.settings.image
              assign card_image_mobile = block.settings.image_mobile
              assign card_video = block.settings.video
              assign card_video_mobile = block.settings.video_mobile
              assign video_url = block.settings.video_url
              assign has_mobile_image = false
              if card_image_mobile != blank
                assign has_mobile_image = true
              endif
              assign has_mobile_video = false
              if card_video_mobile != blank
                assign has_mobile_video = true
              endif
              assign youtube_thumb = blank
              if media_type == 'youtube' and video_url != blank and video_url.type == 'youtube' and video_url.id != blank
                assign youtube_thumb = 'https://i.ytimg.com/vi/' | append: video_url.id | append: '/hqdefault.jpg'
              endif
            %}
            <article
              class="swiper-slide xtu-activity-slider__card"
              {{ block.shopify_attributes }}
            >
              <a
                class="xtu-activity-slider__link xtu-img-zoom"
                href="{{ card_link | default: '#' }}"
                {% if card_link == blank %}
                  aria-disabled="true"
                {% endif %}
              >
                <div class="xtu-activity-slider__media{% if media_type == 'image' and has_mobile_image %} xtu-activity-slider__media--split{% endif %}{% if media_type == 'video' and has_mobile_video %} xtu-activity-slider__media--split{% endif %}">
                  {% if media_type == 'video' %}
                    {% if card_video != blank %}
                      {{
                        card_video
                        | video_tag:
                          class: 'xtu-activity-slider__video xtu-activity-slider__video--desktop',
                          image_size: '900x',
                          autoplay: true,
                          loop: true,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          preload: 'metadata'
                      }}
                    {% endif %}
                    {% if has_mobile_video %}
                      {{
                        card_video_mobile
                        | video_tag:
                          class: 'xtu-activity-slider__video xtu-activity-slider__video--mobile',
                          image_size: '800x',
                          autoplay: true,
                          loop: true,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          preload: 'metadata'
                      }}
                    {% endif %}
                    {% if card_video == blank and has_mobile_video == false %}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'xtu-activity-slider__image xtu-img-zoom__media xtu-activity-slider__placeholder' }}
                    {% endif %}
                  {% elsif media_type == 'youtube' and youtube_thumb != blank %}
                    <img
                      class="xtu-activity-slider__image xtu-img-zoom__media"
                      src="{{ youtube_thumb | escape }}"
                      alt="{{ card_title | escape }}"
                      loading="lazy"
                      decoding="async"
                      width="1280"
                      height="720"
                    >
                  {% elsif card_image != blank %}
                    {{
                      card_image
                      | image_url: width: 900
                      | image_tag:
                        class: 'xtu-activity-slider__image xtu-activity-slider__image--desktop xtu-img-zoom__media',
                        loading: 'lazy',
                        widths: '240, 360, 480, 640, 900',
                        sizes: '(min-width: 750px) 15vw, 42vw',
                        alt: card_title
                    }}
                    {% if has_mobile_image %}
                      {{
                        card_image_mobile
                        | image_url: width: 800
                        | image_tag:
                          class: 'xtu-activity-slider__image xtu-activity-slider__image--mobile xtu-img-zoom__media',
                          loading: 'lazy',
                          widths: '240, 360, 480, 640, 800',
                          sizes: '42vw',
                          alt: card_title
                      }}
                    {% endif %}
                  {% else %}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'xtu-activity-slider__image xtu-img-zoom__media xtu-activity-slider__placeholder' }}
                  {% endif %}
                  {% if show_image_overlay %}
                    <div class="xtu-activity-slider__wash" aria-hidden="true"></div>
                  {% endif %}
                </div>
                {% if card_title != blank %}
                  <span class="xtu-activity-slider__label">{{ card_title | escape }}</span>
                {% endif %}
              </a>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .xtu-activity-slider {
    padding: var(--xtu-as-padding-top, 80px) 0 var(--xtu-as-padding-bottom, 80px);
    background: #fff;
    overflow: hidden;
  }

  .xtu-activity-slider__intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: min(var(--page-content-width), calc(100% - var(--page-margin) * 2));
    margin: 0 auto var(--xtu-space-40, 40px);
    box-sizing: border-box;
    min-height: 45px;
  }

  .xtu-activity-slider__heading {
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-align: left;
    color: #111827;
  }

  .xtu-activity-slider__viewport {
    width: min(var(--page-content-width), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
    box-sizing: border-box;
    overflow: hidden;
  }

  .xtu-activity-slider__swiper {
    overflow: hidden;
  }

  .xtu-activity-slider__card {
    height: auto;
  }

  .xtu-activity-slider__link {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--xtu-as-ratio, 3 / 4);
    border-radius: var(--xtu-as-radius, 16px);
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    background: #e8eaed;
  }

  .xtu-activity-slider__media {
    position: absolute;
    inset: 0;
  }

  .xtu-activity-slider__image,
  .xtu-activity-slider__video,
  .xtu-activity-slider__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .xtu-activity-slider__image--mobile,
  .xtu-activity-slider__video--mobile {
    display: none;
  }

  .xtu-activity-slider__placeholder {
    background: #d0d5dd;
  }

  .xtu-activity-slider__wash {
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    background: linear-gradient(to top, rgb(0 0 0 / 0.55), transparent);
    pointer-events: none;
  }

  .xtu-activity-slider__label {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 16px;
    z-index: 2;
    display: block;
    font-family: var(--font-heading--family);
    font-size: clamp(0.75rem, 1.1vw, 0.875rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.35);
  }

  .xtu-activity-slider__link[aria-disabled='true'] {
    cursor: default;
  }

  @media screen and (max-width: 749px) {
    .xtu-activity-slider__media--split .xtu-activity-slider__image--desktop,
    .xtu-activity-slider__media--split .xtu-activity-slider__video--desktop {
      display: none;
    }

    .xtu-activity-slider__media--split .xtu-activity-slider__image--mobile,
    .xtu-activity-slider__media--split .xtu-activity-slider__video--mobile {
      display: block;
    }

    .xtu-activity-slider {
      padding: var(--xtu-as-padding-top-mobile, 40px) 0 var(--xtu-as-padding-bottom-mobile, 40px);
      overflow-x: hidden;
    }

    /* 左右均保留版心边距；2.1 peek 在内容区内，滑至末尾也不贴屏边 */
    .xtu-activity-slider__viewport {
      width: 100%;
      max-width: none;
      margin-inline: 0;
      padding-inline: var(--page-margin);
      box-sizing: border-box;
      overflow: hidden;
    }

    .xtu-activity-slider__swiper {
      overflow: hidden;
    }

    .xtu-activity-slider__intro {
      width: 100%;
      margin-bottom: var(--xtu-space-20, 20px);
      padding-inline: var(--page-margin);
      box-sizing: border-box;
      min-height: 40px;
      gap: 12px;
    }

    .xtu-activity-slider__heading {
      font-size: 1.5rem;
    }

    .xtu-activity-slider__label {
      bottom: 12px;
      font-size: var(--xtu-type-eyebrow, 0.75rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU Activity Slider",
  "tag": "section",
  "class": "xtu-activity-slider-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Shop by Activity"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "显示左右切换按钮",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows_mobile",
      "label": "移动端显示左右切换按钮",
      "info": "Peek 露出邻卡时默认关闭，可滑动浏览",
      "default": false,
      "visible_if": "{{ section.settings.show_arrows == true }}"
    },
    {
      "type": "checkbox",
      "id": "show_image_overlay",
      "label": "显示图片底部遮罩",
      "info": "便于白色标题叠在图片上阅读；默认关闭",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "桌面端在版心（--page-content-width）内等分，不露出邻卡：≥1400px 显示 6 个；＜1400px 显示 5 个；＜1200px 显示 4 个。"
    },
    {
      "type": "select",
      "id": "mobile_per_view",
      "label": "移动端每行显示",
      "options": [
        { "value": "1.1", "label": "1.1" },
        { "value": "2.1", "label": "2.1" },
        { "value": "2.2", "label": "2.2" }
      ],
      "default": "2.1"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "桌面卡片间距",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "移动端卡片间距",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "卡片圆角",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "卡片比例",
      "options": [
        { "value": "auto", "label": "自适应（按图片/视频比例）" },
        { "value": "1 / 1", "label": "1:1" },
        { "value": "2 / 3", "label": "2:3" },
        { "value": "3 / 4", "label": "3:4" },
        { "value": "4 / 5", "label": "4:5" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "header",
      "content": "边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "活动卡片",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "媒体类型",
          "options": [
            { "value": "image", "label": "图片" },
            { "value": "video", "label": "上传视频" },
            { "value": "youtube", "label": "视频链接" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片（PC）",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "图片（移动端）",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "上传视频（PC）",
          "info": "静音循环，作为卡片背景。",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "上传视频（移动端）",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "视频链接",
          "accept": ["youtube", "vimeo"],
          "info": "卡片为跳转链接，YouTube 显示封面图。",
          "visible_if": "{{ block.settings.media_type == 'youtube' }}"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Activity"
        },
        {
          "type": "url",
          "id": "link",
          "label": "跳转链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "XTU Activity Slider",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Dive + Snorkel"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Surf"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Travel + Adventure"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Kids + Pets"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Mountain Bike"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Hike + Camp"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Snow"
          }
        }
      ]
    }
  ]
}
{% endschema %}
