{% liquid
  assign heading = section.settings.heading
  assign background_color = section.settings.background_color | default: '#FFFFFF'
  assign content_background = section.settings.content_background | default: '#F5F5F7'
  assign content_width = section.settings.content_width | default: 900
  assign content_radius = section.settings.content_radius | default: 16
  assign padding_top = section.settings.padding_top | default: 80
  assign padding_bottom = section.settings.padding_bottom | default: 80
  assign padding_top_mobile = section.settings.padding_top_mobile | default: 40
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile | default: 40
  assign heading_color = section.settings.heading_color | default: '#000000'
  assign text_color = section.settings.text_color | default: '#333333'
  assign link_color = section.settings.link_color | default: '#0070CA'
%}

<section
  id="xtu-faq-{{ section.id }}"
  class="xtu-faq"
  style="
    --xtu-faq-bg: {{ background_color }};
    --xtu-faq-content-bg: {{ content_background }};
    --xtu-faq-content-width: {{ content_width }}px;
    --xtu-faq-content-radius: {{ content_radius }}px;
    --xtu-faq-pt: {{ padding_top }}px;
    --xtu-faq-pb: {{ padding_bottom }}px;
    --xtu-faq-pt-m: {{ padding_top_mobile }}px;
    --xtu-faq-pb-m: {{ padding_bottom_mobile }}px;
    --xtu-faq-heading-color: {{ heading_color }};
    --xtu-faq-text-color: {{ text_color }};
    --xtu-faq-link-color: {{ link_color }};
  "
>
  <div class="xtu-faq__inner" data-xtu-reveal="fade-up" data-xtu-stagger>
    {% if heading != blank %}
      <h2 class="xtu-faq__heading" data-xtu-reveal-child>{{ heading | escape }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="xtu-faq__panel" data-xtu-reveal-child>
        {% for block in section.blocks %}
          {% liquid
            assign question = block.settings.question
            assign answer = block.settings.answer
            assign is_open = false
            if forloop.first and section.settings.open_first
              assign is_open = true
            endif
          %}
          {% if question != blank %}
            <details
              class="xtu-faq__item"
              {% if is_open %}open{% endif %}
              {{ block.shopify_attributes }}
            >
              <summary class="xtu-faq__question">
                <span class="xtu-faq__question-text">{{ question | escape }}</span>
                <span class="xtu-faq__icon" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 6.5 8 10.5 12 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </summary>
              {% if answer != blank %}
                <div class="xtu-faq__answer rte">
                  {{ answer }}
                </div>
              {% endif %}
            </details>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .xtu-faq {
    padding: var(--xtu-faq-pt) 0 var(--xtu-faq-pb);
    background: var(--xtu-faq-bg, #fff);
  }

  .xtu-faq__inner {
    width: min(var(--xtu-faq-content-width, 900px), calc(100% - var(--page-margin) * 2));
    margin-inline: auto;
  }

  .xtu-faq__heading {
    margin: 0 0 var(--xtu-space-40, 40px);
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-section-title);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    color: var(--xtu-faq-heading-color, #000);
  }

  .xtu-faq__panel {
    padding: 8px 40px;
    border-radius: var(--xtu-faq-content-radius, 16px);
    background: var(--xtu-faq-content-bg, #f5f5f7);
    box-sizing: border-box;
  }

  .xtu-faq__item {
    border-bottom: 1px solid color-mix(in srgb, var(--xtu-faq-text-color, #333) 18%, transparent);
  }

  .xtu-faq__item:last-child {
    border-bottom: 0;
  }

  .xtu-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: var(--xtu-space-20, 20px) 0;
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  .xtu-faq__question::-webkit-details-marker {
    display: none;
  }

  .xtu-faq__question-text {
    flex: 1;
    min-width: 0;
    font-family: var(--font-heading--family);
    font-size: var(--xtu-type-body);
    font-weight: 600;
    line-height: 1.2;
    color: var(--xtu-faq-heading-color, #000);
  }

  .xtu-faq__icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: var(--xtu-faq-heading-color, #000);
    transition: transform 0.25s ease;
  }

  .xtu-faq__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .xtu-faq__item[open] .xtu-faq__icon {
    transform: rotate(180deg);
  }

  .xtu-faq__answer {
    padding: 0 0 var(--xtu-space-20, 20px);
    font-family: var(--font-body--family);
    font-size: var(--xtu-type-body);
    font-weight: 400;
    line-height: 1.2;
    color: var(--xtu-faq-text-color, #333);
  }

  .xtu-faq__answer > *:first-child {
    margin-top: 0;
  }

  .xtu-faq__answer > *:last-child {
    margin-bottom: 0;
  }

  .xtu-faq__answer p {
    margin: 0 0 0.75em;
    line-height: 1.2;
  }

  .xtu-faq__answer a {
    color: var(--xtu-faq-link-color, #0070ca);
    text-decoration-color: color-mix(in srgb, var(--xtu-faq-link-color, #0070ca) 55%, transparent);
  }

  @media (max-width: 749px) {
    .xtu-faq {
      padding: var(--xtu-faq-pt-m) 0 var(--xtu-faq-pb-m);
    }

    .xtu-faq__heading {
      margin-bottom: var(--xtu-space-20, 20px);
      font-size: var(--xtu-type-section-title-m);
    }

    .xtu-faq__panel {
      padding: 4px 20px;
    }

    .xtu-faq__question {
      padding: 18px 0;
    }

    .xtu-faq__question-text {
      font-size: var(--xtu-type-body-m);
    }

    .xtu-faq__answer {
      padding-bottom: 18px;
      font-size: var(--xtu-type-body-m);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xtu-faq__icon {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU FAQ",
  "tag": "section",
  "class": "section-xtu-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "大标题",
      "default": "FAQ"
    },
    {
      "type": "header",
      "content": "外观"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "版块背景色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "内容区背景色",
      "default": "#F5F5F7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题色",
      "default": "#000000",
      "info": "大标题、问题标题"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "正文色",
      "default": "#333333",
      "info": "答案正文；分割线随正文色自动调整"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "链接色",
      "default": "#0070CA"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "内容区最大宽度",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 900,
      "info": "用于产品页等场景，避免内容过宽"
    },
    {
      "type": "range",
      "id": "content_radius",
      "label": "内容区圆角",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "默认展开第一项",
      "default": true
    },
    {
      "type": "header",
      "content": "边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下边距（PC）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "上边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "下边距（移动端）",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "问答项",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "问题（子项标题）",
          "default": "Question title"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "回答（子项内容）",
          "default": "<p>Answer content goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "XTU FAQ",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "What is included in the box?",
            "answer": "<p>The package includes the camera body, mounting accessories, and a quick start guide.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Is this waterproof?",
            "answer": "<p>Please check the product specifications for waterproof rating and recommended usage.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How long is the warranty?",
            "answer": "<p>Warranty coverage depends on your region and purchase channel. Contact support for details.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Where can I download the app?",
            "answer": "<p>Search for the official XTU app in the App Store or Google Play.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
