{% doc %}
  XTU Payment Methods — leading icon + title, with configurable payment logos (or shop enabled types).

  @example
  {% content_for 'block', type: 'xtu-payment-methods', id: 'payments' %}
{% enddoc %}

{% liquid
  assign bs = block.settings
%}

{% capture custom_icons_html %}
  {% content_for 'blocks' %}
{% endcapture %}
{% assign custom_icons_html = custom_icons_html | strip %}

<div
  class="xtu-payment-methods"
  {{ block.shopify_attributes }}
>
  <div class="xtu-info-row xtu-info-row--static">
    <span class="xtu-info-row__lead">
      {% if bs.icon != blank %}
        {{
          bs.icon
          | image_url: width: 80
          | image_tag:
            class: 'xtu-info-row__icon',
            loading: 'lazy',
            widths: '40, 60, 80',
            sizes: '24px',
            alt: bs.title
        }}
      {% else %}
        <span class="xtu-info-row__icon xtu-info-row__icon--placeholder" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 10h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-8Z" stroke="currentColor" stroke-width="1.5"/>
            <path d="M3 10 5.2 5.4A2 2 0 0 1 7 4.5h10a2 2 0 0 1 1.8.9L21 10" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M8 15.5h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </span>
      {% endif %}
      <span class="xtu-info-row__title">{{ bs.title | escape }}</span>
    </span>
  </div>

  <ul class="xtu-payment-methods__list" role="list">
    {% if custom_icons_html != blank %}
      {{ custom_icons_html }}
    {% elsif shop.enabled_payment_types.size > 0 %}
      {% for type in shop.enabled_payment_types %}
        <li class="xtu-payment-methods__item">
          {{ type | payment_type_svg_tag: class: 'xtu-payment-methods__logo xtu-payment-methods__logo--svg' }}
        </li>
      {% endfor %}
    {% endif %}
  </ul>
</div>

{% stylesheet %}
  .xtu-payment-methods {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    padding-block: 14px;
  }

  /* 仅在相邻条款/支付区块之间显示分隔线 */
  .group-block-content > .xtu-payment-methods:has(+ .xtu-info-modal),
  .group-block-content > .xtu-payment-methods:has(+ .xtu-payment-methods) {
    border-bottom: 1px solid #e5e5e5;
  }

  .xtu-payment-methods .xtu-info-row {
    appearance: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: start;
    color: #111;
    font-family: var(--font-body--family);
  }

  .xtu-payment-methods .xtu-info-row--static {
    pointer-events: none;
  }

  .xtu-payment-methods .xtu-info-row__lead {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .xtu-payment-methods .xtu-info-row__icon {
    display: block;
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
    object-fit: contain;
  }

  .xtu-payment-methods .xtu-info-row__icon--placeholder {
    color: #111;
  }

  .xtu-payment-methods .xtu-info-row__icon--placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .xtu-payment-methods .xtu-info-row__title {
    font-size: var(--xtu-type-body, 0.875rem);
    font-weight: 600;
    line-height: 1.2;
    color: #111;
  }

  .xtu-payment-methods__list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    width: 100%;
    margin: 0;
    padding: 0;
    padding-inline-start: 36px; /* 24px lead icon + 12px gap → align with title */
    list-style: none;
    overflow: hidden;
  }

  .xtu-payment-methods__item {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    flex: 1 1 0;
    min-width: 0;
    max-width: 40px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    overflow: hidden;
  }

  .xtu-payment-methods__logo {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 18px;
    object-fit: contain;
  }

  .xtu-payment-methods__logo--svg {
    width: 100%;
    height: 100%;
    max-height: 18px;
  }

  @media (max-width: 749px) {
    .xtu-payment-methods {
      gap: 10px;
      padding-block: 12px;
    }

    .xtu-payment-methods .xtu-info-row__lead {
      gap: 10px;
    }

    .xtu-payment-methods .xtu-info-row__icon {
      width: 20px;
      height: 20px;
      flex-basis: 20px;
    }

    .xtu-payment-methods .xtu-info-row__title {
      font-size: 0.8125rem;
    }

    .xtu-payment-methods__list {
      padding-inline-start: 30px;
      gap: 6px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "XTU Payment Methods",
  "tag": null,
  "blocks": [
    {
      "type": "_xtu-payment-icon"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "左侧图标"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Payment method"
    },
    {
      "type": "paragraph",
      "content": "添加「Payment Icon」子块上传自定义支付图标；未添加时显示店铺已启用的支付方式。"
    }
  ],
  "presets": [
    {
      "name": "XTU Payment Methods",
      "category": "Product",
      "settings": {
        "title": "Payment method"
      }
    }
  ]
}
{% endschema %}
