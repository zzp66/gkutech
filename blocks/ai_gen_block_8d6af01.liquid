{% doc %}
  @prompt
    可以，在对应页面的生成框里粘贴下面这段即可：
    
    > 创建一个 YouTube 视频横向滑块模块，匹配当前主题风格，支持电脑端和手机端。
    >
    > 每张视频卡片可单独填写 YouTube 链接、标题和自定义封面，支持 youtube.com/watch 和 youtu.be 链接。可增加、删除视频并调整顺序。未填写有效链接的卡片不在店面显示。
    >
    > 视频采用 16:9 比例。电脑端默认并排显示 3 张卡片，可通过左右箭头切换。手机端显示 1 张完整卡片，并露出下一张的一部分，支持手指左右滑动，滑动后自动对齐。不要造成整个页面横向溢出。
    >
    > 增加自动轮播开关，默认开启；切换间隔可调整，默认 5 秒。每次切换一张，到末尾后回到第一张。只有视频数量超过当前可见数量时才自动轮播。用户手动滑动或点击箭头后重新计时。电脑端鼠标悬停或键盘焦点进入模块时暂停，离开后恢复。提供访客可操作的暂停／继续轮播按钮。访客开启减少动态效果时，默认不自动轮播。
    >
    > 视频默认显示封面，点击播放按钮才加载并播放，不自动播放视频，保留 YouTube 原生播放控件。通过 YouTube 播放状态事件，在视频播放期间暂停轮播，视频暂停或结束后恢复计时。切换卡片时停止上一段视频，避免多个视频同时播放。手机端视频未播放时，可在封面上左右滑动。
    >
    > 在编辑器中提供以下设置，并确保实际生效：模块标题、每个视频的链接／标题／封面和排序、电脑端可见卡片数、自动轮播开关和间隔、箭头显示、卡片间距、圆角、背景颜色、上下留白。
    >
    > 使用简洁稳定的实现，不依赖外部轮播库。兼容主题编辑器内模块重新加载，避免重复绑定事件和重复启动计时器，模块移除时清理相关资源。按钮支持键盘操作并具有无障碍标签。
    >
    > 只创建这个新模块，不修改其他分区，不删除现有模块。
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-youtube-slider-{{ ai_gen_id }} { display:block; width:100%; max-width:100%; overflow:hidden; box-sizing:border-box; background:{{ block.settings.background_color }}; color:#111827; padding:{{ block.settings.vertical_padding }}px 0; }
  .ai-youtube-slider-{{ ai_gen_id }} *, .ai-youtube-slider-{{ ai_gen_id }} *::before, .ai-youtube-slider-{{ ai_gen_id }} *::after { box-sizing:border-box; }
  .ai-youtube-slider-{{ ai_gen_id }}__inner { width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; padding:0 20px; }
  .ai-youtube-slider-{{ ai_gen_id }}__heading-row { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:18px; }
  .ai-youtube-slider-{{ ai_gen_id }}__title { margin:0; font-size:clamp(22px, 3vw, 32px); line-height:1.2; }
  .ai-youtube-slider-{{ ai_gen_id }}__controls { display:flex; align-items:center; gap:8px; }
  .ai-youtube-slider-{{ ai_gen_id }}__control { width:40px; height:40px; display:inline-flex; align-items:center; justify-content:center; border:0; border-radius:50%; background:#f0f0f0; color:#111827; cursor:pointer; }
  .ai-youtube-slider-{{ ai_gen_id }}__control:hover { background:#ffbf01; }
  .ai-youtube-slider-{{ ai_gen_id }}__control:focus-visible, .ai-youtube-slider-{{ ai_gen_id }}__play:focus-visible { outline:3px solid #0070ca; outline-offset:3px; }
  .ai-youtube-slider-{{ ai_gen_id }}__control[hidden] { display:none; }
  .ai-youtube-slider-{{ ai_gen_id }}__track { display:flex; gap:{{ block.settings.card_gap }}px; overflow-x:auto; overscroll-behavior-x:contain; scroll-snap-type:x mandatory; scrollbar-width:none; }
  .ai-youtube-slider-{{ ai_gen_id }}__track::-webkit-scrollbar { display:none; }
  .ai-youtube-slider-{{ ai_gen_id }}__card { flex:0 0 calc((100% - ({{ block.settings.desktop_cards | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.desktop_cards }}); min-width:0; scroll-snap-align:start; overflow:hidden; border-radius:{{ block.settings.corner_radius }}px; background:#fff; }
  .ai-youtube-slider-{{ ai_gen_id }}__media { position:relative; aspect-ratio:16/9; background:#e8e8ed; overflow:hidden; }
  .ai-youtube-slider-{{ ai_gen_id }}__media img, .ai-youtube-slider-{{ ai_gen_id }}__media iframe { display:block; width:100%; height:100%; border:0; object-fit:cover; }
  .ai-youtube-slider-{{ ai_gen_id }}__play { position:absolute; inset:0; width:100%; height:100%; border:0; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,.12); color:#fff; cursor:pointer; }
  .ai-youtube-slider-{{ ai_gen_id }}__play span { width:58px; height:58px; display:grid; place-items:center; border-radius:50%; background:#111827; box-shadow:0 2px 10px rgba(0,0,0,.25); }
  .ai-youtube-slider-{{ ai_gen_id }}__caption { margin:0; padding:12px 14px; font-size:16px; font-weight:600; line-height:1.4; }
  .ai-youtube-slider-{{ ai_gen_id }}__empty { padding:22px; text-align:center; color:#535f11; }
  @media(max-width:749px) { .ai-youtube-slider-{{ ai_gen_id }}__inner { width:100%; padding:0 16px; } .ai-youtube-slider-{{ ai_gen_id }}__card { flex-basis:84%; } .ai-youtube-slider-{{ ai_gen_id }}__controls { gap:6px; } }
  @media(prefers-reduced-motion:reduce) { .ai-youtube-slider-{{ ai_gen_id }}__track { scroll-behavior:auto; } }
{% endstyle %}
<youtube-slider-{{ ai_gen_id }} class="ai-youtube-slider-{{ ai_gen_id }}" data-autoplay="{{ block.settings.autoplay }}" data-interval="{{ block.settings.interval | times: 1000 }}" data-desktop-cards="{{ block.settings.desktop_cards }}" data-arrows="{{ block.settings.show_arrows }}" {{ block.shopify_attributes }}>
  <div class="ai-youtube-slider-{{ ai_gen_id }}__inner">
    <div class="ai-youtube-slider-{{ ai_gen_id }}__heading-row">
      {% if block.settings.heading != blank %}<h2 class="ai-youtube-slider-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% else %}<span></span>{% endif %}
      <div class="ai-youtube-slider-{{ ai_gen_id }}__controls">
        <button class="ai-youtube-slider-{{ ai_gen_id }}__control" type="button" data-prev aria-label="Previous videos" hidden>‹</button>
        <button class="ai-youtube-slider-{{ ai_gen_id }}__control" type="button" data-toggle aria-label="Pause slideshow">Ⅱ</button>
        <button class="ai-youtube-slider-{{ ai_gen_id }}__control" type="button" data-next aria-label="Next videos" hidden>›</button>
      </div>
    </div>
    <div class="ai-youtube-slider-{{ ai_gen_id }}__track" data-track>
      {% assign valid_count = 0 %}
      {% for i in (1..8) %}
        {% assign url_key = 'video_' | append: i | append: '_url' %}{% assign title_key = 'video_' | append: i | append: '_title' %}{% assign image_key = 'video_' | append: i | append: '_cover' %}
        {% assign video_url = block.settings[url_key] | strip %}{% assign video_id = '' %}
        {% if video_url contains 'youtu.be/' %}{% assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first | split: '/' | first %}{% elsif video_url contains 'youtube.com/watch' %}{% assign video_id = video_url | split: 'v=' | last | split: '&' | first %}{% elsif video_url contains 'youtube.com/embed/' %}{% assign video_id = video_url | split: 'youtube.com/embed/' | last | split: '?' | first | split: '/' | first %}{% endif %}
        {% assign video_id_size = video_id | size %}
        {% if video_id_size > 0 and video_id_size < 20 %}
          {% assign valid_count = valid_count | plus: 1 %}
          {% assign video_title = block.settings[title_key] %}{% assign video_cover = block.settings[image_key] %}
          <article class="ai-youtube-slider-{{ ai_gen_id }}__card" data-video-card data-video-id="{{ video_id | escape }}">
            <div class="ai-youtube-slider-{{ ai_gen_id }}__media">
              {% if video_cover != blank %}<img src="{{ video_cover | image_url: width: 1200 }}" alt="{{ video_title | default: 'YouTube video' | escape }}" loading="lazy" width="{{ video_cover.width }}" height="{{ video_cover.height }}">{% else %}<img src="https://img.youtube.com/vi/{{ video_id | escape }}/hqdefault.jpg" alt="{{ video_title | default: 'YouTube video' | escape }}" loading="lazy" width="480" height="360">{% endif %}
              <button class="ai-youtube-slider-{{ ai_gen_id }}__play" type="button" data-play aria-label="Play {{ video_title | default: 'video' | escape }}"><span aria-hidden="true">▶</span></button>
            </div>
            {% if video_title != blank %}<h3 class="ai-youtube-slider-{{ ai_gen_id }}__caption">{{ video_title | escape }}</h3>{% endif %}
          </article>
        {% endif %}
      {% endfor %}
      {% if valid_count == 0 %}<div class="ai-youtube-slider-{{ ai_gen_id }}__empty">Add a valid YouTube link in the block settings to show a video.</div>{% endif %}
    </div>
  </div>
</youtube-slider-{{ ai_gen_id }}>
<script>
(function(){
  const tag='youtube-slider-{{ ai_gen_id }}';
  if(customElements.get(tag)) return;
  class YouTubeSlider extends HTMLElement {
    connectedCallback(){
      if(this.initialized) return; this.initialized=true;
      this.track=this.querySelector('[data-track]'); this.cards=[...this.querySelectorAll('[data-video-card]')]; this.prev=this.querySelector('[data-prev]'); this.next=this.querySelector('[data-next]'); this.toggle=this.querySelector('[data-toggle]');
      this.enabled=this.dataset.autoplay==='true' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches; this.userPaused=!this.enabled; this.interval=Number(this.dataset.interval)||5000; this.timer=null; this.playing=false;
      this.updateControls(); this.onScroll=()=>{this.stopCurrentVideo(); this.resetTimer();}; this.track.addEventListener('scroll',this.onScroll,{passive:true});
      this.prev.addEventListener('click',()=>this.move(-1)); this.next.addEventListener('click',()=>this.move(1)); this.toggle.addEventListener('click',()=>{this.userPaused=!this.userPaused; this.updateToggle(); this.resetTimer();});
      this.onEnter=()=>this.pauseTimer(); this.onLeave=()=>this.resetTimer(); this.addEventListener('mouseenter',this.onEnter); this.addEventListener('mouseleave',this.onLeave); this.addEventListener('focusin',this.onEnter); this.addEventListener('focusout',e=>{if(!this.contains(e.relatedTarget)) this.onLeave();});
      this.cards.forEach(card=>card.querySelector('[data-play]').addEventListener('click',()=>this.loadVideo(card)));
      this.resetTimer(); this.resizeObserver=new ResizeObserver(()=>this.updateControls()); this.resizeObserver.observe(this.track);
    }
    visible(){return window.matchMedia('(max-width: 749px)').matches?1:Number(this.dataset.desktopCards)||3;}
    maxIndex(){return Math.max(0,this.cards.length-this.visible());}
    updateControls(){if(!this.track)return; const show=this.cards.length>this.visible(); this.prev.hidden=!show||this.dataset.arrows!=='true'; this.next.hidden=!show||this.dataset.arrows!=='true'; this.toggle.hidden=!show;}
    updateToggle(){this.toggle.textContent=this.userPaused?'▶':'Ⅱ'; this.toggle.setAttribute('aria-label',this.userPaused?'Start slideshow':'Pause slideshow');}
    pauseTimer(){clearInterval(this.timer);this.timer=null;}
    resetTimer(){this.pauseTimer(); if(this.enabled&&!this.userPaused&&!this.playing&&this.cards.length>this.visible()) this.timer=setInterval(()=>this.move(1,true),this.interval);}
    move(direction,automatic){const width=this.cards[0]?.getBoundingClientRect().width||0; if(!width)return; let index=Math.round(this.track.scrollLeft/(width+parseFloat(getComputedStyle(this.track).gap||0))); let target=index+direction; if(target>this.maxIndex())target=0;if(target<0)target=this.maxIndex();this.track.scrollTo({left:target*(width+parseFloat(getComputedStyle(this.track).gap||0)),behavior:automatic?'smooth':'smooth'});this.stopCurrentVideo();if(!automatic)this.resetTimer();}
    stopCurrentVideo(){this.querySelectorAll('iframe').forEach(frame=>{frame.src='about:blank';frame.remove();});this.playing=false;this.resetTimer();}
    loadVideo(card){this.stopCurrentVideo();const id=card.dataset.videoId;const iframe=document.createElement('iframe');iframe.src='https://www.youtube-nocookie.com/embed/'+encodeURIComponent(id)+'?autoplay=1&enablejsapi=1&origin='+encodeURIComponent(location.origin);iframe.title=card.querySelector('h3')?.textContent||'YouTube video';iframe.allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';iframe.allowFullscreen=true;card.querySelector('.ai-youtube-slider-{{ ai_gen_id }}__media').replaceChildren(iframe);this.playing=true;this.pauseTimer();}
    disconnectedCallback(){this.pauseTimer();this.track?.removeEventListener('scroll',this.onScroll);this.resizeObserver?.disconnect();this.initialized=false;}
  }
  customElements.define(tag,YouTubeSlider);
})();
</script>
{% schema %}
{
  "name": "YouTube video slider",
  "settings": [
    {"type":"text","id":"heading","label":"Module title","default":"Featured videos"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"select","id":"desktop_cards","label":"Desktop cards visible","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}],"default":"3"},
    {"type":"checkbox","id":"autoplay","label":"Enable autoplay","default":true},
    {"type":"range","id":"interval","label":"Switch interval","min":3,"max":15,"step":1,"unit":"s","default":5},
    {"type":"checkbox","id":"show_arrows","label":"Show arrows","default":true},
    {"type":"range","id":"card_gap","label":"Card spacing","min":0,"max":40,"step":2,"unit":"px","default":16},
    {"type":"range","id":"corner_radius","label":"Corner radius","min":0,"max":32,"step":2,"unit":"px","default":8},
    {"type":"color","id":"background_color","label":"Background","default":"#f8f9fd"},
    {"type":"range","id":"vertical_padding","label":"Top and bottom spacing","min":0,"max":80,"step":4,"unit":"px","default":32},
    {"type":"header","content":"Video cards"},
    {"type":"paragraph","content":"Add up to 8 cards. Leave the YouTube link blank to hide a card. Reorder cards by moving their settings together in the editor."},
    {"type":"url","id":"video_1_url","label":"Video 1 YouTube link"},{"type":"text","id":"video_1_title","label":"Video 1 title"},{"type":"image_picker","id":"video_1_cover","label":"Video 1 custom cover"},
    {"type":"url","id":"video_2_url","label":"Video 2 YouTube link"},{"type":"text","id":"video_2_title","label":"Video 2 title"},{"type":"image_picker","id":"video_2_cover","label":"Video 2 custom cover"},
    {"type":"url","id":"video_3_url","label":"Video 3 YouTube link"},{"type":"text","id":"video_3_title","label":"Video 3 title"},{"type":"image_picker","id":"video_3_cover","label":"Video 3 custom cover"},
    {"type":"url","id":"video_4_url","label":"Video 4 YouTube link"},{"type":"text","id":"video_4_title","label":"Video 4 title"},{"type":"image_picker","id":"video_4_cover","label":"Video 4 custom cover"},
    {"type":"url","id":"video_5_url","label":"Video 5 YouTube link"},{"type":"text","id":"video_5_title","label":"Video 5 title"},{"type":"image_picker","id":"video_5_cover","label":"Video 5 custom cover"},
    {"type":"url","id":"video_6_url","label":"Video 6 YouTube link"},{"type":"text","id":"video_6_title","label":"Video 6 title"},{"type":"image_picker","id":"video_6_cover","label":"Video 6 custom cover"},
    {"type":"url","id":"video_7_url","label":"Video 7 YouTube link"},{"type":"text","id":"video_7_title","label":"Video 7 title"},{"type":"image_picker","id":"video_7_cover","label":"Video 7 custom cover"},
    {"type":"url","id":"video_8_url","label":"Video 8 YouTube link"},{"type":"text","id":"video_8_title","label":"Video 8 title"},{"type":"image_picker","id":"video_8_cover","label":"Video 8 custom cover"}
  ],
  "presets": [{"name":"YouTube video slider"}],
  "tag": null,
  "class": "youtube-video-slider-block"
}
{% endschema %}