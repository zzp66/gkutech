{% doc %}
  @prompt
    Why Choose a Touch Screen Dash Cam?
    
    A touch screen dash cam gives you more direct control over your camera without relying entirely on a smartphone app. With an integrated touchscreen display, you can quickly check the camera view, review recorded footage, navigate menus, and adjust important settings directly from the dash cam.
    
    For drivers who prefer simple on-device controls, a touchscreen can make everyday dash cam use faster and more intuitive.
    
    Easier Camera Control
    
    Navigate settings and recording options directly from the dash cam without using physical buttons for every adjustment.
    
    Quick Video Playback
    
    Review important footage directly on the built-in display before transferring the video to your smartphone or computer.
    
    Easier Camera Positioning
    
    Use the screen to check the live camera view during installation and make sure the road is properly framed.
    
    Touchscreen + WiFi App Control
    
    A touchscreen and smartphone app can complement each other. Use the touchscreen for quick in-car adjustments and WiFi connectivity when you want to preview, download, or manage footage from your phone. 根据这些文案帮我生成一个符合这个模板风格的section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-dashcam-guide-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-dashcam-guide__inner-{{ ai_gen_id }} {
    max-width: 1180px;
    margin: 0 auto;
  }

  .ai-dashcam-guide__intro-{{ ai_gen_id }} {
    max-width: 820px;
    margin: 0 auto {{ block.settings.content_gap }}px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-dashcam-guide__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 12px;
    color: {{ block.settings.accent_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ai-dashcam-guide__title-{{ ai_gen_id }} {
    margin: 0 0 20px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .ai-dashcam-guide__copy-{{ ai_gen_id }} {
    margin: 0;
    font-size: 16px;
    line-height: 1.75;
  }

  .ai-dashcam-guide__copy-{{ ai_gen_id }} p {
    margin: 0 0 14px;
  }

  .ai-dashcam-guide__copy-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-dashcam-guide__features-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .ai-dashcam-guide__feature-{{ ai_gen_id }} {
    min-height: 190px;
    padding: 26px 22px;
    background: {{ block.settings.card_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.card_radius }}px;
  }

  .ai-dashcam-guide__number-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    margin-bottom: 24px;
    border-radius: 50%;
    background: {{ block.settings.accent_color }};
    color: {{ block.settings.accent_text_color }};
    font-size: 14px;
    font-weight: 700;
  }

  .ai-dashcam-guide__feature-title-{{ ai_gen_id }} {
    margin: 0 0 10px;
    color: {{ block.settings.heading_color }};
    font-size: 19px;
    line-height: 1.3;
  }

  .ai-dashcam-guide__feature-copy-{{ ai_gen_id }} {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
  }

  @media screen and (max-width: 989px) {
    .ai-dashcam-guide__features-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-dashcam-guide-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px 18px;
    }

    .ai-dashcam-guide__intro-{{ ai_gen_id }} {
      margin-bottom: 32px;
    }

    .ai-dashcam-guide__title-{{ ai_gen_id }} {
      font-size: 34px;
    }

    .ai-dashcam-guide__features-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-dashcam-guide__feature-{{ ai_gen_id }} {
      min-height: auto;
    }
  }
{% endstyle %}

<section class="ai-dashcam-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-dashcam-guide__inner-{{ ai_gen_id }}">
    <div class="ai-dashcam-guide__intro-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-dashcam-guide__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="ai-dashcam-guide__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      <div class="ai-dashcam-guide__copy-{{ ai_gen_id }}">{{ block.settings.introduction }}</div>
    </div>

    <div class="ai-dashcam-guide__features-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign title_key = 'feature_' | append: i | append: '_title'
          assign copy_key = 'feature_' | append: i | append: '_copy'
          assign feature_title = block.settings[title_key]
          assign feature_copy = block.settings[copy_key]
        %}
        <article class="ai-dashcam-guide__feature-{{ ai_gen_id }}">
          <div class="ai-dashcam-guide__number-{{ ai_gen_id }}" aria-hidden="true">0{{ i }}</div>
          <h3 class="ai-dashcam-guide__feature-title-{{ ai_gen_id }}">{{ feature_title }}</h3>
          <p class="ai-dashcam-guide__feature-copy-{{ ai_gen_id }}">{{ feature_copy }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Dash cam benefits",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Touch screen dash cam" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why choose a touch screen dash cam?" },
    { "type": "richtext", "id": "introduction", "label": "Introduction", "default": "<p>A touch screen dash cam gives you more direct control over your camera without relying entirely on a smartphone app. With an integrated touchscreen display, you can quickly check the camera view, review recorded footage, navigate menus, and adjust important settings directly from the dash cam.</p><p>For drivers who prefer simple on-device controls, a touchscreen can make everyday dash cam use faster and more intuitive.</p>" },
    { "type": "text", "id": "feature_1_title", "label": "Feature 1 title", "default": "Easier camera control" },
    { "type": "textarea", "id": "feature_1_copy", "label": "Feature 1 text", "default": "Navigate settings and recording options directly from the dash cam without using physical buttons for every adjustment." },
    { "type": "text", "id": "feature_2_title", "label": "Feature 2 title", "default": "Quick video playback" },
    { "type": "textarea", "id": "feature_2_copy", "label": "Feature 2 text", "default": "Review important footage directly on the built-in display before transferring the video to your smartphone or computer." },
    { "type": "text", "id": "feature_3_title", "label": "Feature 3 title", "default": "Easier camera positioning" },
    { "type": "textarea", "id": "feature_3_copy", "label": "Feature 3 text", "default": "Use the screen to check the live camera view during installation and make sure the road is properly framed." },
    { "type": "text", "id": "feature_4_title", "label": "Feature 4 title", "default": "Touchscreen + WiFi app control" },
    { "type": "textarea", "id": "feature_4_copy", "label": "Feature 4 text", "default": "Use the touchscreen for quick in-car adjustments and WiFi connectivity when you want to preview, download, or manage footage from your phone." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "section_padding", "label": "Desktop padding", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile padding", "min": 20, "max": 60, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "content_gap", "label": "Content spacing", "min": 24, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F8F9FD" },
    { "type": "color", "id": "card_color", "label": "Cards", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#333333" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#DFDFDF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#FFF002" },
    { "type": "color", "id": "accent_text_color", "label": "Accent text", "default": "#111111" }
  ],
  "presets": [{ "name": "Dash cam benefits" }],
  "tag": null,
  "class": "dash-cam-benefits-block"
}
{% endschema %}