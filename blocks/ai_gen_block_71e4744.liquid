{% doc %}
  @prompt
    生成一个秋促的按折扣力度展示产品系列的section，6折区，五折区，插入系列合集, 再增加一个六五折区, 整个section文案都是英文, 折扣力度可编辑
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign sale_collections = 'six_discount_collection,five_discount_collection,sixfive_discount_collection' | split: ',' %}
{% assign sale_labels = 'six_discount_label,five_discount_label,sixfive_discount_label' | split: ',' %}
{% style %}.ai-autumn-sale-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:{{ block.settings.section_padding }}px 20px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}.ai-autumn-sale-{{ ai_gen_id }}__inner{max-width:1440px;margin:0 auto}.ai-autumn-sale-{{ ai_gen_id }}__header{text-align:{{ block.settings.text_alignment }};margin-bottom:32px}.ai-autumn-sale-{{ ai_gen_id }}__title{margin:0 0 10px;font-size:{{ block.settings.heading_size }}px;line-height:1.1}.ai-autumn-sale-{{ ai_gen_id }}__intro{margin:0;color:{{ block.settings.muted_text_color }};font-size:16px}.ai-autumn-sale-{{ ai_gen_id }}__group+ .ai-autumn-sale-{{ ai_gen_id }}__group{margin-top:48px}.ai-autumn-sale-{{ ai_gen_id }}__group-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}.ai-autumn-sale-{{ ai_gen_id }}__group-title{display:flex;align-items:center;gap:12px;margin:0;font-size:26px}.ai-autumn-sale-{{ ai_gen_id }}__discount,.ai-autumn-sale-{{ ai_gen_id }}__badge{background:{{ block.settings.accent_color }};color:{{ block.settings.accent_text_color }};border-radius:999px;font-weight:700}.ai-autumn-sale-{{ ai_gen_id }}__discount{padding:7px 12px;font-size:14px}.ai-autumn-sale-{{ ai_gen_id }}__link{color:{{ block.settings.text_color }};font-size:14px;font-weight:600;text-decoration:underline}.ai-autumn-sale-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat({{ block.settings.columns_desktop }},minmax(0,1fr));gap:20px}.ai-autumn-sale-{{ ai_gen_id }}__media{position:relative;display:block;overflow:hidden;aspect-ratio:1/1;border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.image_background_color }};}.ai-autumn-sale-{{ ai_gen_id }}__media img,.ai-autumn-sale-{{ ai_gen_id }}__media svg{display:block;width:100%;height:100%;object-fit:cover}.ai-autumn-sale-{{ ai_gen_id }}__badge{position:absolute;top:12px;left:12px;padding:6px 10px;font-size:12px}.ai-autumn-sale-{{ ai_gen_id }}__info{padding-top:12px}.ai-autumn-sale-{{ ai_gen_id }}__product-title{display:block;margin-bottom:7px;color:{{ block.settings.text_color }};font-size:15px;font-weight:600;text-decoration:none}.ai-autumn-sale-{{ ai_gen_id }}__price{font-size:14px;font-weight:700}.ai-autumn-sale-{{ ai_gen_id }}__compare{margin-left:6px;color:{{ block.settings.muted_text_color }};font-weight:400;text-decoration:line-through}.ai-autumn-sale-{{ ai_gen_id }}__empty{padding:28px;border:1px dashed {{ block.settings.muted_text_color }};border-radius:{{ block.settings.card_radius }}px;color:{{ block.settings.muted_text_color }};text-align:center;font-size:14px}@media(max-width:749px){.ai-autumn-sale-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px 16px}.ai-autumn-sale-{{ ai_gen_id }}__title{font-size:34px}.ai-autumn-sale-{{ ai_gen_id }}__grid{grid-template-columns:repeat({{ block.settings.columns_mobile }},minmax(0,1fr));gap:14px}.ai-autumn-sale-{{ ai_gen_id }}__group-heading{align-items:flex-start;flex-direction:column}.ai-autumn-sale-{{ ai_gen_id }}__group-title{font-size:22px}}
{% endstyle %}
<div class="ai-autumn-sale-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-autumn-sale-{{ ai_gen_id }}__inner"><header class="ai-autumn-sale-{{ ai_gen_id }}__header"><h2 class="ai-autumn-sale-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h2>{% if block.settings.intro != blank %}<p class="ai-autumn-sale-{{ ai_gen_id }}__intro">{{ block.settings.intro }}</p>{% endif %}</header>{% for collection_key in sale_collections %}{% assign collection = block.settings[collection_key] %}{% assign label_key = sale_labels[forloop.index0] %}{% assign sale_label = block.settings[label_key] %}<section class="ai-autumn-sale-{{ ai_gen_id }}__group"><div class="ai-autumn-sale-{{ ai_gen_id }}__group-heading"><h3 class="ai-autumn-sale-{{ ai_gen_id }}__group-title"><span class="ai-autumn-sale-{{ ai_gen_id }}__discount">{{ sale_label }}</span>{{ sale_label }}</h3>{% if collection != blank %}<a class="ai-autumn-sale-{{ ai_gen_id }}__link" href="{{ collection.url }}">Shop all</a>{% endif %}</div>{% if collection != blank and collection.products.size > 0 %}<div class="ai-autumn-sale-{{ ai_gen_id }}__grid">{% for product in collection.products limit:block.settings.products_limit %}<article><a class="ai-autumn-sale-{{ ai_gen_id }}__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width:900 }}" alt="{{ product.featured_image.alt | default:product.title | escape }}" loading="lazy" width="900" height="900">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}<span class="ai-autumn-sale-{{ ai_gen_id }}__badge">{{ sale_label }}</span></a><div class="ai-autumn-sale-{{ ai_gen_id }}__info"><a class="ai-autumn-sale-{{ ai_gen_id }}__product-title" href="{{ product.url }}">{{ product.title }}</a><div class="ai-autumn-sale-{{ ai_gen_id }}__price">{{ product.price | money }}{% if product.compare_at_price > product.price %}<span class="ai-autumn-sale-{{ ai_gen_id }}__compare">{{ product.compare_at_price | money }}</span>{% endif %}</div></div></article>{% endfor %}</div>{% else %}<div class="ai-autumn-sale-{{ ai_gen_id }}__empty">Select a collection for this discount tier in the theme editor.</div>{% endif %}</section>{% endfor %}</div></div>
{% schema %}{"name":"Autumn sale collections","settings":[{"type":"header","content":"Content"},{"type":"text","id":"heading","label":"Heading","default":"Autumn sale picks"},{"type":"textarea","id":"intro","label":"Introduction","default":"Shop our best autumn offers by discount tier."},{"type":"text","id":"six_discount_label","label":"First discount label","default":"60% OFF"},{"type":"collection","id":"six_discount_collection","label":"First collection"},{"type":"text","id":"five_discount_label","label":"Second discount label","default":"50% OFF"},{"type":"collection","id":"five_discount_collection","label":"Second collection"},{"type":"text","id":"sixfive_discount_label","label":"Third discount label","default":"35% OFF"},{"type":"collection","id":"sixfive_discount_collection","label":"Third collection"},{"type":"range","id":"products_limit","label":"Products per tier","min":2,"max":12,"step":1,"default":4},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"columns_desktop","label":"Desktop columns","options":[{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"5","label":"5"}],"default":"4"},{"type":"select","id":"columns_mobile","label":"Mobile columns","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"2"},{"type":"range","id":"section_padding","label":"Desktop vertical spacing","min":20,"max":100,"step":5,"unit":"px","default":55},{"type":"range","id":"mobile_padding","label":"Mobile vertical spacing","min":16,"max":60,"step":4,"unit":"px","default":36},{"type":"range","id":"card_radius","label":"Card corner radius","min":0,"max":24,"step":2,"unit":"px","default":8},{"type":"select","id":"text_alignment","label":"Heading alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},{"type":"range","id":"heading_size","label":"Heading size","min":28,"max":64,"step":2,"unit":"px","default":48},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#F8F9FD"},{"type":"color","id":"text_color","label":"Text","default":"#000000"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#535F11"},{"type":"color","id":"accent_color","label":"Discount badge background","default":"#FFF001"},{"type":"color","id":"accent_text_color","label":"Discount badge text","default":"#000000"},{"type":"color","id":"image_background_color","label":"Image background","default":"#FFFFFF"}],"presets":[{"name":"Autumn sale collections"}],"tag":null,"class":"autumn-sale-collection-block"}{% endschema %}