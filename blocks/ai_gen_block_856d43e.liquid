{% doc %}
  @prompt
    生成一个block，shop by卖点功能标签，每个标签可以调转到相应的页面或者合集, 标签可以不限量增加
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-by-tags-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 0;
  }

  .ai-shop-by-tags-{{ ai_gen_id }}__heading {
    margin: 0 0 18px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    font-weight: 600;
    text-align: {{ block.settings.alignment }};
  }

  .ai-shop-by-tags-{{ ai_gen_id }}__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ block.settings.alignment }};
    gap: 12px;
    width: 100%;
  }

  .ai-shop-by-tags-{{ ai_gen_id }}__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 11px 20px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.tag_background }};
    color: {{ block.settings.tag_text_color }};
    font-size: {{ block.settings.tag_size }}px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .ai-shop-by-tags-{{ ai_gen_id }}__item:hover,
  .ai-shop-by-tags-{{ ai_gen_id }}__item:focus-visible {
    background-color: {{ block.settings.tag_hover_background }};
    border-color: {{ block.settings.tag_hover_background }};
    color: {{ block.settings.tag_hover_text_color }};
  }

  .ai-shop-by-tags-{{ ai_gen_id }}__item:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-shop-by-tags-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_vertical_padding }}px 0;
    }

    .ai-shop-by-tags-{{ ai_gen_id }}__heading {
      margin-bottom: 14px;
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-shop-by-tags-{{ ai_gen_id }}__list {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      padding: 2px 2px 8px;
      scrollbar-width: thin;
    }

    .ai-shop-by-tags-{{ ai_gen_id }}__item {
      flex: 0 0 auto;
      min-height: 42px;
      padding: 10px 16px;
      font-size: {{ block.settings.mobile_tag_size }}px;
    }
  }
{% endstyle %}

<div class="ai-shop-by-tags-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-shop-by-tags-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  <nav class="ai-shop-by-tags-{{ ai_gen_id }}__list" aria-label="{{ block.settings.heading | default: 'Shop by' | escape }}">
    {% assign tag_lines = block.settings.tags | newline_to_br | split: '<br />' %}
    {% for tag_line in tag_lines %}
      {% assign tag_parts = tag_line | split: '|' %}
      {% assign tag_label = tag_parts[0] | strip %}
      {% assign tag_link = tag_parts[1] | strip %}
      {% if tag_label != blank and tag_link != blank %}
        <a class="ai-shop-by-tags-{{ ai_gen_id }}__item" href="{{ tag_link }}">{{ tag_label | escape }}</a>
      {% endif %}
    {% endfor %}
  </nav>
</div>

{% schema %}
{
  "name": "Shop by tags",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by interest"
    },
    {
      "type": "textarea",
      "id": "tags",
      "label": "Tags",
      "default": "New arrivals | /collections/new-arrivals\nBest sellers | /collections/best-sellers\nAction cameras | /collections/action-cameras",
      "info": "One tag per line. Format: label | page or collection URL"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Desktop spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_vertical_padding",
      "label": "Mobile spacing",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "tag_size",
      "label": "Tag text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_tag_size",
      "label": "Mobile tag text size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tag_background",
      "label": "Tag background",
      "default": "#FFF001"
    },
    {
      "type": "color",
      "id": "tag_text_color",
      "label": "Tag text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tag_hover_background",
      "label": "Hover background",
      "default": "#0070CA"
    },
    {
      "type": "color",
      "id": "tag_hover_text_color",
      "label": "Hover text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "Focus outline",
      "default": "#0070CA"
    }
  ],
  "presets": [
    {
      "name": "Shop by tags"
    }
  ],
  "tag": null,
  "class": "shop-by-tags-block"
}
{% endschema %}