{% doc %}
  @prompt
    Create a NEW self-contained Limited deals slider block. Do not modify or delete existing blocks. All customer-facing interface text must be English. Include these features from the start: Editable main heading default 'Halloween Dash Cam Flash Deals' and subtitle default 'Limited-time dash cam deals. Shop your favorites before the countdown ends.' Position heading/subtitle top-left and ONE countdown top-right within the module, never fixed to the viewport. Countdown: editable end date/time including timezone, label 'Ends in', digit font size default 28, each digit in its own small background tile; editable digit color, tile background color, tile size/padding and corner radius, with readable Days/Hours/Minutes/Seconds labels. Mobile layout must avoid overlaps. Support up to five separately selectable collections. Each collection has an editable heading and independent Display discount percentage (first two defaults 40 and 35), used for display only, not changing actual product prices or checkout discounts. Each product card has a top-left badge: allow custom badge text separately per collection; when custom text is empty use the collection discount percentage. Expose SEPARATE badge text color, background color, border color and border width controls, allowing no border. Product cards show actual product image, title and price. Each collection's products stay in ONE horizontal row, independently scrollable, desktop default 4 cards per view with arrows and mobile default 2 with touch swiping, editable per-view counts. Below EACH PRODUCT card put a 'Shop now' button linking to that product, with editable label and independently editable background/text/border colors and hover background/text colors. Below EACH COLLECTION slider at bottom-left put a separate 'View more' button with its own editable label and destination URL, supporting internal or external links, hidden when URL is empty. Keep product-button styling independent from collection-button styling and global theme colors. Match the existing theme and original Limited deals visual style as closely as possible. All named text, collection selections, countdown properties, badge properties, colors and links must have working theme editor controls. Do not include unverified spend-threshold discounts or automatic checkout discount claims. Prioritize reliable generation with a straightforward responsive layout and complete editable settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.deals-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto;padding:24px;border-radius:16px;background:{{ block.settings.panel_bg }};color:{{ block.settings.panel_text }};font-family:inherit}.deals-{{ ai_gen_id }} *{box-sizing:border-box}.deals-{{ ai_gen_id }}__head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}.deals-{{ ai_gen_id }}__title{font-size:clamp(24px,3vw,36px);margin:0 0 8px}.deals-{{ ai_gen_id }}__subtitle{margin:0;line-height:1.5}.deals-{{ ai_gen_id }}__timer-label{margin:0 0 6px;font-weight:bold}.deals-{{ ai_gen_id }}__units{display:flex;gap:7px}.deals-{{ ai_gen_id }}__unit{text-align:center}.deals-{{ ai_gen_id }}__number{display:block;font-size:{{ block.settings.digit_size }}px;color:{{ block.settings.digit_color }};background:{{ block.settings.tile_bg }};padding:{{ block.settings.tile_padding }}px;border-radius:{{ block.settings.tile_radius }}px;min-width:{{ block.settings.tile_size }}px;line-height:1.1}.deals-{{ ai_gen_id }}__unit-label{font-size:11px}.deals-{{ ai_gen_id }}__collection{margin-top:24px}.deals-{{ ai_gen_id }}__collection h3{margin:0 0 12px}.deals-{{ ai_gen_id }}__viewport{overflow:auto;scroll-snap-type:x mandatory}.deals-{{ ai_gen_id }}__track{display:flex;gap:14px}.deals-{{ ai_gen_id }}__card{position:relative;flex:0 0 calc((100% - ({{ block.settings.desktop_cards }} - 1)*14px)/{{ block.settings.desktop_cards }});min-width:0;scroll-snap-align:start;background:{{ block.settings.card_bg }};border-radius:10px;overflow:hidden;padding-bottom:12px}.deals-{{ ai_gen_id }}__image,.deals-{{ ai_gen_id }}__placeholder{display:block;width:100%;aspect-ratio:1;object-fit:cover}.deals-{{ ai_gen_id }}__placeholder{background:#eee}.deals-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.deals-{{ ai_gen_id }}__badge{position:absolute;top:8px;left:8px;padding:5px 8px;border-radius:4px;background:{{ block.settings.badge_bg }};color:{{ block.settings.badge_text }};border:{{ block.settings.badge_border_width }}px solid {{ block.settings.badge_border }};font-size:12px;font-weight:bold}.deals-{{ ai_gen_id }}__product-title{margin:10px 10px 5px;font-size:14px;min-height:2.7em}.deals-{{ ai_gen_id }}__price{margin:0 10px 10px;font-weight:bold}.deals-{{ ai_gen_id }}__product-button,.deals-{{ ai_gen_id }}__more{display:block;text-align:center;text-decoration:none;padding:10px;border-radius:{{ block.settings.button_radius }}px;font-weight:bold}.deals-{{ ai_gen_id }}__product-button{margin:0 10px;background:{{ block.settings.product_btn_bg }};color:{{ block.settings.product_btn_text }};border:{{ block.settings.product_btn_border_width }}px solid {{ block.settings.product_btn_border }}}.deals-{{ ai_gen_id }}__product-button:hover{background:{{ block.settings.product_btn_hover_bg }};color:{{ block.settings.product_btn_hover_text }}}.deals-{{ ai_gen_id }}__more{display:inline-block;margin-top:14px;background:{{ block.settings.more_bg }};color:{{ block.settings.more_text }};border:{{ block.settings.more_border_width }}px solid {{ block.settings.more_border }}}.deals-{{ ai_gen_id }}__arrows{text-align:right;margin-bottom:7px}.deals-{{ ai_gen_id }}__arrow{border:0;border-radius:50%;width:36px;height:36px;background:#eee;color:#111;cursor:pointer}@media(max-width:749px){.deals-{{ ai_gen_id }}{padding:16px}.deals-{{ ai_gen_id }}__head{flex-direction:column}.deals-{{ ai_gen_id }}__card{flex-basis:calc((100% - 10px)/{{ block.settings.mobile_cards }})}.deals-{{ ai_gen_id }}__number{font-size:min({{ block.settings.digit_size }}px,6vw);min-width:40px;padding:{{ block.settings.tile_padding | at_most: 8 }}px}.deals-{{ ai_gen_id }}__arrows{display:none}}{% endstyle %}
<limited-deals-{{ ai_gen_id }} class="deals-{{ ai_gen_id }}" data-end="{{ block.settings.end_datetime | escape }}" {{ block.shopify_attributes }}><div class="deals-{{ ai_gen_id }}__head"><div><h2 class="deals-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2><p class="deals-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle | escape }}</p></div><div class="deals-{{ ai_gen_id }}__timer" aria-live="polite"><p class="deals-{{ ai_gen_id }}__timer-label">{{ block.settings.timer_label | escape }}</p><div class="deals-{{ ai_gen_id }}__units"><div class="deals-{{ ai_gen_id }}__unit"><span class="deals-{{ ai_gen_id }}__number" data-days>00</span><span class="deals-{{ ai_gen_id }}__unit-label">Days</span></div><div class="deals-{{ ai_gen_id }}__unit"><span class="deals-{{ ai_gen_id }}__number" data-hours>00</span><span class="deals-{{ ai_gen_id }}__unit-label">Hours</span></div><div class="deals-{{ ai_gen_id }}__unit"><span class="deals-{{ ai_gen_id }}__number" data-minutes>00</span><span class="deals-{{ ai_gen_id }}__unit-label">Minutes</span></div><div class="deals-{{ ai_gen_id }}__unit"><span class="deals-{{ ai_gen_id }}__number" data-seconds>00</span><span class="deals-{{ ai_gen_id }}__unit-label">Seconds</span></div></div></div></div>
{% for i in (1..5) %}{% assign ck='collection_' | append:i %}{% assign hk='collection_' | append:i | append:'_heading' %}{% assign dk='collection_' | append:i | append:'_discount' %}{% assign bk='collection_' | append:i | append:'_badge' %}{% assign uk='collection_' | append:i | append:'_url' %}{% assign col=block.settings[ck] %}{% if col != blank %}<section class="deals-{{ ai_gen_id }}__collection"><h3>{{ block.settings[hk] | default:col.title | escape }}</h3><div class="deals-{{ ai_gen_id }}__arrows"><button class="deals-{{ ai_gen_id }}__arrow" type="button" aria-label="Scroll left" data-dir="-1">‹</button> <button class="deals-{{ ai_gen_id }}__arrow" type="button" aria-label="Scroll right" data-dir="1">›</button></div><div class="deals-{{ ai_gen_id }}__viewport"><div class="deals-{{ ai_gen_id }}__track">{% for product in col.products limit:20 %}<article class="deals-{{ ai_gen_id }}__card"><span class="deals-{{ ai_gen_id }}__badge">{% if block.settings[bk] != blank %}{{ block.settings[bk] | escape }}{% else %}{{ block.settings[dk] }}% OFF{% endif %}</span>{% if product.featured_image %}<a href="{{ product.url }}"><img class="deals-{{ ai_gen_id }}__image" src="{{ product.featured_image | image_url: width:600 }}" alt="{{ product.featured_image.alt | default:product.title | escape }}" loading="lazy" width="600" height="600"></a>{% else %}<div class="deals-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<h4 class="deals-{{ ai_gen_id }}__product-title">{{ product.title | escape }}</h4><p class="deals-{{ ai_gen_id }}__price">{{ product.price | money }}</p><a class="deals-{{ ai_gen_id }}__product-button" href="{{ product.url }}">{{ block.settings.product_button_label | escape }}</a></article>{% endfor %}</div></div>{% assign url=block.settings[uk] %}{% if url != blank %}<a class="deals-{{ ai_gen_id }}__more" href="{{ url }}">{{ block.settings.more_button_label | escape }}</a>{% endif %}</section>{% endif %}{% endfor %}</limited-deals-{{ ai_gen_id }}>
<script>(function(){const n='limited-deals-{{ ai_gen_id }}';if(customElements.get(n))return;class Deals extends HTMLElement{connectedCallback(){this.tick();this.interval=setInterval(()=>this.tick(),1000);this.querySelectorAll('.deals-{{ ai_gen_id }}__arrow').forEach(b=>b.addEventListener('click',()=>{const v=b.closest('.deals-{{ ai_gen_id }}__collection').querySelector('.deals-{{ ai_gen_id }}__viewport');v.scrollBy({left:v.clientWidth*Number(b.dataset.dir),behavior:'smooth'})}))}disconnectedCallback(){clearInterval(this.interval)}tick(){let t=Date.parse(this.dataset.end);let s=Number.isFinite(t)?Math.max(0,Math.floor((t-Date.now())/1000)):0;const x={days:Math.floor(s/86400),hours:Math.floor(s%86400/3600),minutes:Math.floor(s%3600/60),seconds:s%60};Object.keys(x).forEach(k=>{let e=this.querySelector('[data-'+k+']');if(e)e.textContent=String(x[k]).padStart(2,'0')})}}customElements.define(n,Deals)})();</script>
{% schema %}{"name":"Limited deals slider","tag":null,"class":"limited-deals-block","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Heading and subtitle"},{"type":"text","id":"heading","label":"Heading","default":"Halloween Dash Cam Flash Deals"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Limited-time dash cam deals. Shop your favorites before the countdown ends."},{"type":"header","content":"Countdown"},{"type":"text","id":"end_datetime","label":"End date/time with timezone","default":"2026-10-31T23:59:59+08:00"},{"type":"text","id":"timer_label","label":"Countdown label","default":"Ends in"},{"type":"range","id":"digit_size","label":"Digit font size","min":16,"max":48,"step":2,"unit":"px","default":28},{"type":"color","id":"digit_color","label":"Digit color","default":"#111111"},{"type":"color","id":"tile_bg","label":"Tile background","default":"#FFF001"},{"type":"range","id":"tile_size","label":"Tile size","min":36,"max":70,"step":2,"unit":"px","default":48},{"type":"range","id":"tile_padding","label":"Tile padding","min":0,"max":16,"step":2,"unit":"px","default":8},{"type":"range","id":"tile_radius","label":"Tile radius","min":0,"max":20,"step":2,"unit":"px","default":6},{"type":"header","content":"Slider layout"},{"type":"range","id":"desktop_cards","label":"Desktop cards per view","min":2,"max":6,"step":1,"default":4},{"type":"range","id":"mobile_cards","label":"Mobile cards per view","min":1,"max":3,"step":1,"default":2},{"type":"header","content":"Colors and buttons"},{"type":"color","id":"panel_bg","label":"Module background","default":"#F8F9FD"},{"type":"color","id":"panel_text","label":"Module text","default":"#111111"},{"type":"color","id":"card_bg","label":"Card background","default":"#FFFFFF"},{"type":"color","id":"badge_text","label":"Badge text color","default":"#111111"},{"type":"color","id":"badge_bg","label":"Badge background color","default":"#FFF001"},{"type":"color","id":"badge_border","label":"Badge border color","default":"#FFF001"},{"type":"range","id":"badge_border_width","label":"Badge border width","min":0,"max":4,"step":1,"unit":"px","default":0},{"type":"text","id":"product_button_label","label":"Product button label","default":"Shop now"},{"type":"color","id":"product_btn_bg","label":"Product button background","default":"#FFF001"},{"type":"color","id":"product_btn_text","label":"Product button text","default":"#111111"},{"type":"color","id":"product_btn_border","label":"Product button border","default":"#111111"},{"type":"range","id":"product_btn_border_width","label":"Product button border width","min":0,"max":4,"step":1,"unit":"px","default":0},{"type":"color","id":"product_btn_hover_bg","label":"Product button hover background","default":"#F2C615"},{"type":"color","id":"product_btn_hover_text","label":"Product button hover text","default":"#111111"},{"type":"text","id":"more_button_label","label":"View more label","default":"View more"},{"type":"color","id":"more_bg","label":"View more background","default":"#FFFFFF"},{"type":"color","id":"more_text","label":"View more text","default":"#111111"},{"type":"color","id":"more_border","label":"View more border","default":"#111111"},{"type":"range","id":"more_border_width","label":"View more border width","min":0,"max":4,"step":1,"unit":"px","default":1},{"type":"range","id":"button_radius","label":"Button corner radius","min":0,"max":20,"step":2,"unit":"px","default":8},{"type":"header","content":"Collection 1"},{"type":"collection","id":"collection_1","label":"Collection"},{"type":"text","id":"collection_1_heading","label":"Collection heading","default":"Featured deals"},{"type":"range","id":"collection_1_discount","label":"Display discount percentage","min":0,"max":90,"step":5,"unit":"%","default":40},{"type":"text","id":"collection_1_badge","label":"Custom badge text (optional)"},{"type":"url","id":"collection_1_url","label":"View more destination"},{"type":"header","content":"Collection 2"},{"type":"collection","id":"collection_2","label":"Collection"},{"type":"text","id":"collection_2_heading","label":"Collection heading","default":"More deals"},{"type":"range","id":"collection_2_discount","label":"Display discount percentage","min":0,"max":90,"step":5,"unit":"%","default":35},{"type":"text","id":"collection_2_badge","label":"Custom badge text (optional)"},{"type":"url","id":"collection_2_url","label":"View more destination"},{"type":"header","content":"Collection 3"},{"type":"collection","id":"collection_3","label":"Collection"},{"type":"text","id":"collection_3_heading","label":"Collection heading","default":"More deals 3"},{"type":"range","id":"collection_3_discount","label":"Display discount percentage","min":0,"max":90,"step":5,"unit":"%","default":30},{"type":"text","id":"collection_3_badge","label":"Custom badge text (optional)"},{"type":"url","id":"collection_3_url","label":"View more destination"},{"type":"header","content":"Collection 4"},{"type":"collection","id":"collection_4","label":"Collection"},{"type":"text","id":"collection_4_heading","label":"Collection heading","default":"More deals 4"},{"type":"range","id":"collection_4_discount","label":"Display discount percentage","min":0,"max":90,"step":5,"unit":"%","default":25},{"type":"text","id":"collection_4_badge","label":"Custom badge text (optional)"},{"type":"url","id":"collection_4_url","label":"View more destination"},{"type":"header","content":"Collection 5"},{"type":"collection","id":"collection_5","label":"Collection"},{"type":"text","id":"collection_5_heading","label":"Collection heading","default":"More deals 5"},{"type":"range","id":"collection_5_discount","label":"Display discount percentage","min":0,"max":90,"step":5,"unit":"%","default":20},{"type":"text","id":"collection_5_badge","label":"Custom badge text (optional)"},{"type":"url","id":"collection_5_url","label":"View more destination"}],"presets":[{"name":"Limited deals slider"}]}{% endschema %}