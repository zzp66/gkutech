{% doc %}
  @prompt
    加一个H1标题
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-h1-title-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0;
    padding: {{ block.settings.vertical_padding }}px 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-align: {{ block.settings.alignment }};
    text-transform: {{ block.settings.text_case }};
  }

  @media screen and (max-width: 749px) {
    .ai-h1-title-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_vertical_padding }}px 0;
      font-size: {{ block.settings.mobile_font_size }}px;
    }
  }
{% endstyle %}

<h1 class="ai-h1-title-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {{ block.settings.title | escape }}
</h1>

{% schema %}
{
  "name": "H1 title",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Affiliate program"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "text_case",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "Default" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 24,
      "max": 88,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "min": 20,
      "max": 56,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_vertical_padding",
      "label": "Mobile spacing",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    { "name": "H1 title" }
  ],
  "tag": null,
  "class": "h1-title-block"
}
{% endschema %}