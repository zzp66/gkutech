{% doc %}
  @prompt
    标题加正文加图片的组合模块，字体大小可以设置
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-content-image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-content-image-{{ ai_gen_id }}__inner {
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    gap: {{ block.settings.gap }}px;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-content-image-{{ ai_gen_id }}__media,
  .ai-content-image-{{ ai_gen_id }}__content {
    flex: 1 1 0;
    min-width: 0;
  }

  .ai-content-image-{{ ai_gen_id }}__media {
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-content-image-{{ ai_gen_id }}__media img,
  .ai-content-image-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: {{ block.settings.image_ratio }};
    object-fit: cover;
  }

  .ai-content-image-{{ ai_gen_id }}__placeholder {
    position: relative;
    background: #f5f5f7;
  }

  .ai-content-image-{{ ai_gen_id }}__placeholder svg {
    color: #6b7280;
  }

  .ai-content-image-{{ ai_gen_id }}__empty-state {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    padding: 8px 10px;
    color: #4b5563;
    background: rgba(255, 255, 255, 0.92);
    border-radius: 6px;
    font-size: 12px;
    text-align: center;
  }

  .ai-content-image-{{ ai_gen_id }}__content {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-content-image-{{ ai_gen_id }}__title {
    margin: 0 0 {{ block.settings.title_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.15;
    font-weight: 600;
  }

  .ai-content-image-{{ ai_gen_id }}__body {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
  }

  .ai-content-image-{{ ai_gen_id }}__body p {
    margin: 0 0 1em;
  }

  .ai-content-image-{{ ai_gen_id }}__body p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-content-image-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-content-image-{{ ai_gen_id }}__inner {
      flex-direction: column;
      align-items: stretch;
      gap: {{ block.settings.mobile_gap }}px;
      padding: {{ block.settings.mobile_padding }}px;
    }

    .ai-content-image-{{ ai_gen_id }}__content {
      text-align: {{ block.settings.text_alignment_mobile }};
    }

    .ai-content-image-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.mobile_title_size }}px;
    }

    .ai-content-image-{{ ai_gen_id }}__body {
      font-size: {{ block.settings.mobile_body_size }}px;
    }
  }
{% endstyle %}

<div class="ai-content-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-content-image-{{ ai_gen_id }}__inner">
    {% if block.settings.image_position == 'left' %}
      <div class="ai-content-image-{{ ai_gen_id }}__media">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
        {% else %}
          <div class="ai-content-image-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-content-image-{{ ai_gen_id }}__empty-state">请在主题编辑器中添加图片</div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-content-image-{{ ai_gen_id }}__content">
      {% if block.settings.title != blank %}
        <h2 class="ai-content-image-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h2>
      {% endif %}
      {% if block.settings.body != blank %}
        <div class="ai-content-image-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>
      {% endif %}
    </div>

    {% if block.settings.image_position == 'right' %}
      <div class="ai-content-image-{{ ai_gen_id }}__media">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
        {% else %}
          <div class="ai-content-image-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-content-image-{{ ai_gen_id }}__empty-state">请在主题编辑器中添加图片</div>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "标题正文图片",
  "settings": [
    { "type": "header", "content": "内容" },
    { "type": "text", "id": "title", "label": "标题", "default": "探索更多可能" },
    { "type": "richtext", "id": "body", "label": "正文", "default": "<p>在这里介绍产品特点、品牌理念或其他重要信息。</p>" },
    { "type": "image_picker", "id": "image", "label": "图片" },
    { "type": "select", "id": "image_position", "label": "图片位置", "options": [{ "value": "left", "label": "左侧" }, { "value": "right", "label": "右侧" }], "default": "left" },
    { "type": "header", "content": "字体" },
    { "type": "range", "id": "title_size", "label": "标题字号", "min": 16, "max": 72, "step": 1, "unit": "px", "default": 36 },
    { "type": "range", "id": "body_size", "label": "正文字号", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "mobile_title_size", "label": "移动端标题字号", "min": 16, "max": 56, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "mobile_body_size", "label": "移动端正文字号", "min": 12, "max": 26, "step": 1, "unit": "px", "default": 15 },
    { "type": "header", "content": "布局" },
    { "type": "range", "id": "desktop_width_percent", "label": "桌面宽度", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "text_alignment", "label": "文字对齐", "options": [{ "value": "left", "label": "左对齐" }, { "value": "center", "label": "居中" }, { "value": "right", "label": "右对齐" }], "default": "left" },
    { "type": "select", "id": "text_alignment_mobile", "label": "移动端对齐", "options": [{ "value": "left", "label": "左对齐" }, { "value": "center", "label": "居中" }, { "value": "right", "label": "右对齐" }], "default": "left" },
    { "type": "select", "id": "vertical_alignment", "label": "垂直对齐", "options": [{ "value": "flex-start", "label": "顶部" }, { "value": "center", "label": "居中" }, { "value": "flex-end", "label": "底部" }], "default": "center" },
    { "type": "range", "id": "gap", "label": "内容间距", "min": 8, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "mobile_gap", "label": "移动端间距", "min": 8, "max": 48, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding", "label": "内边距", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_padding", "label": "移动端内边距", "min": 0, "max": 48, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "title_spacing", "label": "标题间距", "min": 4, "max": 32, "step": 4, "unit": "px", "default": 12 },
    { "type": "range", "id": "border_radius", "label": "模块圆角", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "image_radius", "label": "图片圆角", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "select", "id": "image_ratio", "label": "图片比例", "options": [{ "value": "1 / 1", "label": "正方形" }, { "value": "4 / 3", "label": "横向" }, { "value": "16 / 9", "label": "宽屏" }], "default": "4 / 3" },
    { "type": "header", "content": "颜色" },
    { "type": "color", "id": "background_color", "label": "背景", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "文字", "default": "#000000" }
  ],
  "presets": [{ "name": "标题正文图片" }],
  "tag": null,
  "class": "content-image-block"
}
{% endschema %}