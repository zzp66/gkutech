{% doc %}
  @prompt
    请帮我生存一个限时秒杀的section放首页，可以针对单独一款产品设置倒计时秒杀，也可以同时针对一个系列合集设置折扣活动，产品同步显示折扣力度, 所有section文案都是英文，折扣力度可设置，还有有一款单独可以展示的限时秒杀单品，合集折扣力度可以自由设置, 带是一个按钮可以去跳转整个合集, 单独产品的限时秒杀目前与合集无法共存，请修改下
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-flash-sale-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;color:{{ block.settings.text_color }};background:{{ block.settings.background_color }};border-radius:{{ block.settings.border_radius }}px;overflow:hidden}.ai-flash-sale-{{ ai_gen_id }}__inner{padding:clamp(24px,4vw,52px)}.ai-flash-sale-{{ ai_gen_id }}__header{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:28px}.ai-flash-sale-{{ ai_gen_id }}__eyebrow{margin:0 0 8px;color:{{ block.settings.accent_color }};font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.ai-flash-sale-{{ ai_gen_id }}__title{margin:0;font-size:clamp(26px,4vw,48px);line-height:1.05}.ai-flash-sale-{{ ai_gen_id }}__subtitle{margin:10px 0 0;opacity:.75}.ai-flash-sale-{{ ai_gen_id }}__timer{display:flex;gap:8px;flex-shrink:0}.ai-flash-sale-{{ ai_gen_id }}__time{min-width:58px;padding:10px 8px;text-align:center;background:{{ block.settings.timer_background }};color:{{ block.settings.timer_text_color }};border-radius:{{ block.settings.card_radius }}px}.ai-flash-sale-{{ ai_gen_id }}__time strong{display:block;font-size:24px;line-height:1}.ai-flash-sale-{{ ai_gen_id }}__time span{display:block;margin-top:5px;font-size:10px;opacity:.75}.ai-flash-sale-{{ ai_gen_id }}__section{margin-top:30px}.ai-flash-sale-{{ ai_gen_id }}__section-title{margin:0 0 14px;font-size:20px}.ai-flash-sale-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.ai-flash-sale-{{ ai_gen_id }}__card{min-width:0;padding:12px;background:{{ block.settings.card_background }};border-radius:{{ block.settings.card_radius }}px}.ai-flash-sale-{{ ai_gen_id }}__image{display:block;aspect-ratio:1;overflow:hidden;border-radius:calc({{ block.settings.card_radius }}px - 2px);background:#f1f1f1}.ai-flash-sale-{{ ai_gen_id }}__image img,.ai-flash-sale-{{ ai_gen_id }}__image svg{width:100%;height:100%;object-fit:cover}.ai-flash-sale-{{ ai_gen_id }}__name{display:block;margin:14px 0 8px;color:inherit;text-decoration:none;font-weight:600;line-height:1.35}.ai-flash-sale-{{ ai_gen_id }}__prices{display:flex;align-items:center;flex-wrap:wrap;gap:8px}.ai-flash-sale-{{ ai_gen_id }}__sale{color:{{ block.settings.accent_color }};font-size:18px;font-weight:700}.ai-flash-sale-{{ ai_gen_id }}__compare{opacity:.55;text-decoration:line-through;font-size:13px}.ai-flash-sale-{{ ai_gen_id }}__discount{display:inline-block;margin-top:10px;padding:4px 8px;color:{{ block.settings.discount_text_color }};background:{{ block.settings.accent_color }};border-radius:999px;font-size:11px;font-weight:700}.ai-flash-sale-{{ ai_gen_id }}__button{display:inline-flex;margin-top:20px;padding:12px 22px;color:{{ block.settings.button_text_color }};background:{{ block.settings.button_background }};border-radius:999px;text-decoration:none;font-weight:700}.ai-flash-sale-{{ ai_gen_id }}__empty{padding:22px;background:{{ block.settings.card_background }};border-radius:{{ block.settings.card_radius }}px;opacity:.75}@media(max-width:749px){.ai-flash-sale-{{ ai_gen_id }}__header{display:block}.ai-flash-sale-{{ ai_gen_id }}__timer{margin-top:20px}.ai-flash-sale-{{ ai_gen_id }}__time{flex:1;min-width:0}.ai-flash-sale-{{ ai_gen_id }}__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
{% endstyle %}
<flash-sale-{{ ai_gen_id }} class="ai-flash-sale-{{ ai_gen_id }}" data-end-time="{{ block.settings.end_time | escape }}" {{ block.shopify_attributes }}><div class="ai-flash-sale-{{ ai_gen_id }}__inner"><div class="ai-flash-sale-{{ ai_gen_id }}__header"><div>{% if block.settings.eyebrow != blank %}<p class="ai-flash-sale-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}<h2 class="ai-flash-sale-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h2>{% if block.settings.subheading != blank %}<p class="ai-flash-sale-{{ ai_gen_id }}__subtitle">{{ block.settings.subheading }}</p>{% endif %}</div><div class="ai-flash-sale-{{ ai_gen_id }}__timer" aria-label="{{ block.settings.timer_label }}"><div class="ai-flash-sale-{{ ai_gen_id }}__time"><strong data-days>00</strong><span>Days</span></div><div class="ai-flash-sale-{{ ai_gen_id }}__time"><strong data-hours>00</strong><span>Hours</span></div><div class="ai-flash-sale-{{ ai_gen_id }}__time"><strong data-minutes>00</strong><span>Minutes</span></div><div class="ai-flash-sale-{{ ai_gen_id }}__time"><strong data-seconds>00</strong><span>Seconds</span></div></div></div>
{% if block.settings.featured_product != blank %}{% assign product = block.settings.featured_product %}{% assign amount = product.price | times: block.settings.product_discount_percent | divided_by: 100 %}{% assign sale_price = product.price | minus: amount %}<div class="ai-flash-sale-{{ ai_gen_id }}__section"><h3 class="ai-flash-sale-{{ ai_gen_id }}__section-title">{{ block.settings.product_section_title }}</h3><div class="ai-flash-sale-{{ ai_gen_id }}__grid"><article class="ai-flash-sale-{{ ai_gen_id }}__card"><a class="ai-flash-sale-{{ ai_gen_id }}__image" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width:700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="700" height="700">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</a><a class="ai-flash-sale-{{ ai_gen_id }}__name" href="{{ product.url }}">{{ product.title }}</a><div class="ai-flash-sale-{{ ai_gen_id }}__prices"><span class="ai-flash-sale-{{ ai_gen_id }}__sale">{{ sale_price | money }}</span><span class="ai-flash-sale-{{ ai_gen_id }}__compare">{{ product.price | money }}</span></div><span class="ai-flash-sale-{{ ai_gen_id }}__discount">Save {{ block.settings.product_discount_percent }}%</span></article></div></div>{% endif %}
{% if block.settings.featured_collection != blank %}<div class="ai-flash-sale-{{ ai_gen_id }}__section"><h3 class="ai-flash-sale-{{ ai_gen_id }}__section-title">{{ block.settings.collection_section_title }}</h3><div class="ai-flash-sale-{{ ai_gen_id }}__grid">{% for product in block.settings.featured_collection.products limit:block.settings.product_limit %}{% assign amount = product.price | times: block.settings.collection_discount_percent | divided_by: 100 %}{% assign sale_price = product.price | minus: amount %}<article class="ai-flash-sale-{{ ai_gen_id }}__card"><a class="ai-flash-sale-{{ ai_gen_id }}__image" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width:700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="700" height="700">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}</a><a class="ai-flash-sale-{{ ai_gen_id }}__name" href="{{ product.url }}">{{ product.title }}</a><div class="ai-flash-sale-{{ ai_gen_id }}__prices"><span class="ai-flash-sale-{{ ai_gen_id }}__sale">{{ sale_price | money }}</span><span class="ai-flash-sale-{{ ai_gen_id }}__compare">{{ product.price | money }}</span></div><span class="ai-flash-sale-{{ ai_gen_id }}__discount">Save {{ block.settings.collection_discount_percent }}%</span></article>{% endfor %}</div><a class="ai-flash-sale-{{ ai_gen_id }}__button" href="{{ block.settings.featured_collection.url }}">{{ block.settings.collection_button_label }}</a></div>{% endif %}
{% if block.settings.featured_product == blank and block.settings.featured_collection == blank %}<div class="ai-flash-sale-{{ ai_gen_id }}__empty">Select a featured product and/or collection in the theme editor.</div>{% endif %}</div></flash-sale-{{ ai_gen_id }}>
<script>(function(){class FlashSale{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.end=new Date(this.dataset.endTime.replace(' ','T')).getTime();this.tick();this.interval=setInterval(()=>this.tick(),1000)}disconnectedCallback(){clearInterval(this.interval)}tick(){var left=Math.max(0,this.end-Date.now()),v=[Math.floor(left/86400000),Math.floor(left/3600000)%24,Math.floor(left/60000)%60,Math.floor(left/1000)%60];['days','hours','minutes','seconds'].forEach((k,i)=>{var e=this.querySelector('[data-'+k+']');if(e)e.textContent=String(v[i]).padStart(2,'0')});if(left===0)clearInterval(this.interval)}}customElements.define('flash-sale-{{ ai_gen_id }}',FlashSale{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Flash sale","tag":null,"class":"flash-sale-block","settings":[{"type":"header","content":"Content"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Limited time offer"},{"type":"text","id":"heading","label":"Heading","default":"Flash sale"},{"type":"text","id":"subheading","label":"Subheading","default":"Save more on selected products"},{"type":"text","id":"timer_label","label":"Timer label","default":"Time remaining"},{"type":"text","id":"end_time","label":"End date and time","default":"2026-12-31 23:59:59"},{"type":"product","id":"featured_product","label":"Featured product"},{"type":"text","id":"product_section_title","label":"Product section title","default":"Featured deal"},{"type":"range","id":"product_discount_percent","label":"Product discount","min":5,"max":90,"step":5,"unit":"%","default":20},{"type":"collection","id":"featured_collection","label":"Featured collection"},{"type":"text","id":"collection_section_title","label":"Collection section title","default":"Collection deals"},{"type":"range","id":"collection_discount_percent","label":"Collection discount","min":5,"max":90,"step":5,"unit":"%","default":15},{"type":"range","id":"product_limit","label":"Collection product count","min":2,"max":12,"step":1,"default":8},{"type":"text","id":"collection_button_label","label":"Collection button label","default":"Shop the collection"},{"type":"header","content":"Style"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"background_color","label":"Background","default":"#F8F9FD"},{"type":"color","id":"card_background","label":"Card background","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#000000"},{"type":"color","id":"accent_color","label":"Accent","default":"#FFF001"},{"type":"color","id":"discount_text_color","label":"Discount text","default":"#000000"},{"type":"color","id":"timer_background","label":"Timer background","default":"#000000"},{"type":"color","id":"timer_text_color","label":"Timer text","default":"#FFFFFF"},{"type":"color","id":"button_background","label":"Button background","default":"#FFF001"},{"type":"color","id":"button_text_color","label":"Button text","default":"#000000"},{"type":"range","id":"border_radius","label":"Section radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":24,"step":2,"unit":"px","default":12}],"presets":[{"name":"Flash sale"}]}{% endschema %}