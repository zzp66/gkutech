{% doc %}
  @prompt
    帮我生成一个7行三列的表格，带二级标题, 标题第一行第一列是表头，设计点差异化字体和底色, 可以增加列或者行，增加一个副标题
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign table_rows = block.settings.table_data | split: '||' %}

{% style %}
  .ai-table-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; color:{{ block.settings.text_color }}; }
  .ai-table-{{ ai_gen_id }}__heading { margin:0 0 8px; color:{{ block.settings.heading_color }}; font-size:{{ block.settings.heading_size }}px; line-height:1.25; font-weight:700; }
  .ai-table-{{ ai_gen_id }}__subtitle { margin:0 0 18px; color:{{ block.settings.subtitle_color }}; font-size:{{ block.settings.subtitle_size }}px; line-height:1.5; }
  .ai-table-{{ ai_gen_id }}__wrap { overflow-x:auto; border:1px solid {{ block.settings.border_color }}; border-radius:{{ block.settings.border_radius }}px; background:{{ block.settings.background_color }}; }
  .ai-table-{{ ai_gen_id }}__table { width:100%; min-width:560px; border-collapse:collapse; table-layout:auto; }
  .ai-table-{{ ai_gen_id }}__cell, .ai-table-{{ ai_gen_id }}__header { padding:14px 16px; border-right:1px solid {{ block.settings.border_color }}; border-bottom:1px solid {{ block.settings.border_color }}; text-align:{{ block.settings.text_alignment }}; vertical-align:middle; font-size:{{ block.settings.cell_size }}px; line-height:1.45; overflow-wrap:anywhere; }
  .ai-table-{{ ai_gen_id }}__header { background:{{ block.settings.header_background_color }}; color:{{ block.settings.header_text_color }}; font-family:{{ block.settings.header_font.family }}; font-weight:700; letter-spacing:.03em; }
  .ai-table-{{ ai_gen_id }}__header:last-child, .ai-table-{{ ai_gen_id }}__cell:last-child { border-right:0; }
  .ai-table-{{ ai_gen_id }}__row:last-child .ai-table-{{ ai_gen_id }}__cell { border-bottom:0; }
  .ai-table-{{ ai_gen_id }}__row:nth-child(odd) .ai-table-{{ ai_gen_id }}__cell { background:{{ block.settings.alternate_color }}; }
  @media screen and (max-width:749px) { .ai-table-{{ ai_gen_id }}__cell, .ai-table-{{ ai_gen_id }}__header { padding:12px; font-size:{{ block.settings.mobile_cell_size }}px; } }
{% endstyle %}

<div class="ai-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-table-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.subtitle != blank %}<p class="ai-table-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle | escape }}</p>{% endif %}
  <div class="ai-table-{{ ai_gen_id }}__wrap">
    <table class="ai-table-{{ ai_gen_id }}__table">
      {% for row in table_rows %}
        {% assign cells = row | split: '|' %}
        {% if forloop.first %}<thead>{% endif %}
        <tr class="ai-table-{{ ai_gen_id }}__row">
          {% for cell in cells %}
            {% if forloop.parentloop.first %}<th scope="col" class="ai-table-{{ ai_gen_id }}__header">{{ cell | strip | escape }}</th>{% else %}<td class="ai-table-{{ ai_gen_id }}__cell">{{ cell | strip | escape }}</td>{% endif %}
          {% endfor %}
        </tr>
        {% if forloop.first %}</thead><tbody>{% endif %}
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "可扩展数据表格",
  "settings": [
    { "type": "text", "id": "heading", "label": "主标题", "default": "产品信息" },
    { "type": "textarea", "id": "subtitle", "label": "副标题", "default": "清晰了解产品的主要特点与规格" },
    { "type": "textarea", "id": "table_data", "label": "表格内容", "default": "项目|内容|备注||项目 1|内容 1|备注 1||项目 2|内容 2|备注 2||项目 3|内容 3|备注 3||项目 4|内容 4|备注 4||项目 5|内容 5|备注 5||项目 6|内容 6|备注 6", "info": "第一行会作为表头。使用 | 分隔列，使用 || 分隔行；可自由增加或删除行列。" },
    { "type": "range", "id": "desktop_width_percent", "label": "桌面宽度", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "text_alignment", "label": "文字对齐", "options": [{ "value": "left", "label": "左对齐" }, { "value": "center", "label": "居中" }, { "value": "right", "label": "右对齐" }], "default": "left" },
    { "type": "range", "id": "heading_size", "label": "标题字号", "min": 16, "max": 40, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "subtitle_size", "label": "副标题字号", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "cell_size", "label": "文字字号", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "mobile_cell_size", "label": "移动端字号", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "border_radius", "label": "圆角", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "font_picker", "id": "header_font", "label": "表头字体", "default": "inter_n6" },
    { "type": "color", "id": "background_color", "label": "表格背景", "default": "#FFFFFF" },
    { "type": "color", "id": "alternate_color", "label": "交替行背景", "default": "#F8F9FD" },
    { "type": "color", "id": "header_background_color", "label": "表头背景", "default": "#FFF002" },
    { "type": "color", "id": "header_text_color", "label": "表头文字", "default": "#000000" },
    { "type": "color", "id": "border_color", "label": "边框颜色", "default": "#DFDFDF" },
    { "type": "color", "id": "text_color", "label": "文字颜色", "default": "#333333" },
    { "type": "color", "id": "heading_color", "label": "标题颜色", "default": "#000000" },
    { "type": "color", "id": "subtitle_color", "label": "副标题颜色", "default": "#535F11" }
  ],
  "presets": [{ "name": "可扩展数据表格" }],
  "tag": null,
  "class": "table-block"
}
{% endschema %}