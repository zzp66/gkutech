{% doc %}
  @prompt
    生成一个系列展示section，展示what's new， 英文, 这个不是展示合集，而是展示合集中的所有产品
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-whats-new-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; padding: {{ block.settings.section_padding }}px 24px; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; }
  .ai-whats-new-{{ ai_gen_id }}__inner { max-width: 1600px; margin: 0 auto; }
  .ai-whats-new-{{ ai_gen_id }}__header { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  .ai-whats-new-{{ ai_gen_id }}__eyebrow { margin: 0 0 8px; color: {{ block.settings.accent_color }}; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .ai-whats-new-{{ ai_gen_id }}__title { margin: 0; color: {{ block.settings.text_color }}; font-size: {{ block.settings.heading_size }}px; line-height: 1.1; }
  .ai-whats-new-{{ ai_gen_id }}__intro { max-width: 520px; margin: 10px 0 0; color: {{ block.settings.muted_color }}; font-size: 15px; line-height: 1.5; }
  .ai-whats-new-{{ ai_gen_id }}__link { flex: 0 0 auto; padding: 11px 18px; border: 1px solid {{ block.settings.text_color }}; border-radius: 16px; color: {{ block.settings.text_color }}; font-size: 14px; font-weight: 600; text-decoration: none; }
  .ai-whats-new-{{ ai_gen_id }}__link:hover, .ai-whats-new-{{ ai_gen_id }}__link:focus-visible { background: {{ block.settings.text_color }}; color: {{ block.settings.background_color }}; }
  .ai-whats-new-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat({{ block.settings.columns }}, minmax(0, 1fr)); gap: 24px 18px; }
  .ai-whats-new-{{ ai_gen_id }}__card { min-width: 0; color: {{ block.settings.text_color }}; text-decoration: none; }
  .ai-whats-new-{{ ai_gen_id }}__media { aspect-ratio: 1 / 1; overflow: hidden; border-radius: {{ block.settings.image_radius }}px; background: {{ block.settings.placeholder_color }}; }
  .ai-whats-new-{{ ai_gen_id }}__media img, .ai-whats-new-{{ ai_gen_id }}__media svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-whats-new-{{ ai_gen_id }}__media svg { color: {{ block.settings.muted_color }}; }
  .ai-whats-new-{{ ai_gen_id }}__card-title { margin: 14px 0 0; font-size: 16px; line-height: 1.3; }
  .ai-whats-new-{{ ai_gen_id }}__card-price { margin: 6px 0 0; color: {{ block.settings.muted_color }}; font-size: 14px; }
  @media screen and (max-width: 749px) { .ai-whats-new-{{ ai_gen_id }} { padding: 36px 16px; } .ai-whats-new-{{ ai_gen_id }}__header { display: block; margin-bottom: 22px; } .ai-whats-new-{{ ai_gen_id }}__title { font-size: 32px; } .ai-whats-new-{{ ai_gen_id }}__link { display: inline-block; margin-top: 18px; } .ai-whats-new-{{ ai_gen_id }}__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 12px; } }
{% endstyle %}

<div class="ai-whats-new-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-whats-new-{{ ai_gen_id }}__inner">
    <div class="ai-whats-new-{{ ai_gen_id }}__header">
      <div>
        {% if block.settings.eyebrow != blank %}<p class="ai-whats-new-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
        <h2 class="ai-whats-new-{{ ai_gen_id }}__title">{{ block.settings.title }}</h2>
        {% if block.settings.description != blank %}<p class="ai-whats-new-{{ ai_gen_id }}__intro">{{ block.settings.description }}</p>{% endif %}
      </div>
      {% if block.settings.collection != blank %}<a class="ai-whats-new-{{ ai_gen_id }}__link" href="{{ block.settings.collection.url }}">{{ block.settings.button_label }}</a>{% endif %}
    </div>

    {% if block.settings.collection != blank %}
      <div class="ai-whats-new-{{ ai_gen_id }}__grid">
        {% for product in block.settings.collection.products limit: block.settings.product_limit %}
          <a class="ai-whats-new-{{ ai_gen_id }}__card" href="{{ product.url }}">
            <div class="ai-whats-new-{{ ai_gen_id }}__media">
              {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="900" height="900">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}
            </div>
            <h3 class="ai-whats-new-{{ ai_gen_id }}__card-title">{{ product.title }}</h3>
            <p class="ai-whats-new-{{ ai_gen_id }}__card-price">{{ product.price | money }}</p>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "What's new products",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fresh arrivals" },
    { "type": "text", "id": "title", "label": "Title", "default": "What's new" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Discover the latest products from our newest collection." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all products" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 4, "max": 24, "step": 1, "default": 8 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "columns", "label": "Columns", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "range", "id": "section_padding", "label": "Vertical spacing", "min": 20, "max": 100, "step": 5, "unit": "px", "default": 65 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 72, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F8F9FD" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#000000" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#333333" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#0070CA" },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder", "default": "#E8E8ED" }
  ],
  "presets": [{ "name": "What's new products" }],
  "tag": null,
  "class": "whats-new-products-block"
}
{% endschema %}