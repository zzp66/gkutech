{% doc %}
  @prompt
    加一个正文段落section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-paragraph-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.alignment }};
  }

  .ai-paragraph-{{ ai_gen_id }}__content {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    font-family: {{ settings.type_body_font.family }}, sans-serif;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.7;
  }

  .ai-paragraph-{{ ai_gen_id }}__content p {
    margin: 0 0 1em;
  }

  .ai-paragraph-{{ ai_gen_id }}__content p:last-child {
    margin-bottom: 0;
  }

  .ai-paragraph-{{ ai_gen_id }}__content a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-paragraph-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.mobile_padding_vertical }}px {{ block.settings.mobile_padding_horizontal }}px;
    }
  }
{% endstyle %}

<div class="ai-paragraph-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-paragraph-{{ ai_gen_id }}__content">
    {{ block.settings.content }}
  </div>
</div>

{% schema %}
{
  "name": "正文段落",
  "settings": [
    {
      "type": "richtext",
      "id": "content",
      "label": "正文内容",
      "default": "<p>在这里添加正文内容。</p>"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "桌面宽度",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "内容最大宽度",
      "min": 400,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "default": 960
    },
    {
      "type": "radio",
      "id": "alignment",
      "label": "文字对齐",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "字号",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "链接颜色",
      "default": "#0070ca"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "桌面上下间距",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "桌面左右间距",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_padding_vertical",
      "label": "移动端上下间距",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_horizontal",
      "label": "移动端左右间距",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "正文段落"
    }
  ],
  "tag": null,
  "class": "paragraph-block"
}
{% endschema %}