{% doc %}
  @prompt
    副标题和正文section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-subtitle-body-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    text-align: {{ block.settings.alignment }};
    color: {{ block.settings.text_color }};
  }

  .ai-subtitle-body-{{ ai_gen_id }}__subtitle {
    margin: 0 0 {{ block.settings.spacing }}px;
    color: {{ block.settings.subtitle_color }};
    font-family: {{ settings.type_subheading_font.family }}, {{ settings.type_subheading_font.fallback_families }};
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.02em;
  }

  .ai-subtitle-body-{{ ai_gen_id }}__body {
    margin: 0;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.7;
  }

  .ai-subtitle-body-{{ ai_gen_id }}__body p {
    margin: 0 0 1em;
  }

  .ai-subtitle-body-{{ ai_gen_id }}__body p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-subtitle-body-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-subtitle-body-{{ ai_gen_id }}__subtitle {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-subtitle-body-{{ ai_gen_id }}__body {
      font-size: {{ block.settings.body_size | times: 0.95 }}px;
    }
  }
{% endstyle %}

<div class="ai-subtitle-body-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.subtitle != blank %}
    <div class="ai-subtitle-body-{{ ai_gen_id }}__subtitle">
      {{ block.settings.subtitle | escape }}
    </div>
  {% endif %}

  {% if block.settings.body != blank %}
    <div class="ai-subtitle-body-{{ ai_gen_id }}__body">
      {{ block.settings.body }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "副标题和正文",
  "settings": [
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "副标题",
      "default": "了解更多产品细节"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "正文",
      "default": "<p>在这里介绍产品特点、使用场景或品牌故事，为顾客提供清晰、实用的信息。</p>"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "对齐方式",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "桌面宽度",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "副标题字号",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "正文字号",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "内容间距",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "副标题颜色",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "正文颜色",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "副标题和正文"
    }
  ],
  "tag": null,
  "class": "subtitle-body-block"
}
{% endschema %}