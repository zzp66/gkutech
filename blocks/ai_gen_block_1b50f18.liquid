{% doc %}
  @prompt
    请帮我生成一个营销section,既可以设置单款产品的限时秒杀，又可以上传一个deals的产品系列，带倒计时模块，时间展示是英文的，
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-deals-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 36px 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.radius }}px;
  }
  .ai-deals-{{ ai_gen_id }}__inner { max-width: 1280px; margin: 0 auto; }
  .ai-deals-{{ ai_gen_id }}__header { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 24px; }
  .ai-deals-{{ ai_gen_id }}__eyebrow { margin: 0 0 6px; color: {{ block.settings.accent_color }}; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .ai-deals-{{ ai_gen_id }}__title { margin: 0; font-size: 32px; line-height: 1.1; }
  .ai-deals-{{ ai_gen_id }}__subtitle { margin: 8px 0 0; opacity: .75; }
  .ai-deals-{{ ai_gen_id }}__timer { display: flex; gap: 8px; flex-wrap: wrap; justify-content: end; }
  .ai-deals-{{ ai_gen_id }}__unit { min-width: 58px; padding: 9px 8px; text-align: center; background: {{ block.settings.timer_background }}; border-radius: 8px; }
  .ai-deals-{{ ai_gen_id }}__number { display: block; font-size: 22px; font-weight: 700; line-height: 1; }
  .ai-deals-{{ ai_gen_id }}__label { display: block; margin-top: 5px; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
  .ai-deals-{{ ai_gen_id }}__product { display: grid; grid-template-columns: minmax(160px, 260px) 1fr; gap: 24px; align-items: center; margin-bottom: 36px; padding: 18px; background: {{ block.settings.card_background }}; border-radius: 12px; }
  .ai-deals-{{ ai_gen_id }}__image, .ai-deals-{{ ai_gen_id }}__placeholder { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; background: #f1f1f1; }
  .ai-deals-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; }
  .ai-deals-{{ ai_gen_id }}__product h3 { margin: 0 0 10px; font-size: 24px; }
  .ai-deals-{{ ai_gen_id }}__price { margin-bottom: 18px; font-size: 20px; font-weight: 700; }
  .ai-deals-{{ ai_gen_id }}__button { display: inline-block; padding: 12px 22px; background: {{ block.settings.button_background }}; color: {{ block.settings.button_text }}; border-radius: 16px; text-decoration: none; font-weight: 700; }
  .ai-deals-{{ ai_gen_id }}__collection-title { margin: 0 0 16px; font-size: 22px; }
  .ai-deals-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .ai-deals-{{ ai_gen_id }}__card { min-width: 0; color: inherit; text-decoration: none; }
  .ai-deals-{{ ai_gen_id }}__card img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; }
  .ai-deals-{{ ai_gen_id }}__card-title { margin: 10px 0 4px; font-weight: 600; }
  .ai-deals-{{ ai_gen_id }}__card-price { font-size: 14px; }
  @media (max-width: 749px) { .ai-deals-{{ ai_gen_id }} { padding: 28px 16px; } .ai-deals-{{ ai_gen_id }}__header { display: block; } .ai-deals-{{ ai_gen_id }}__timer { justify-content: start; margin-top: 18px; } .ai-deals-{{ ai_gen_id }}__product { grid-template-columns: 1fr; } .ai-deals-{{ ai_gen_id }}__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
{% endstyle %}

<limited-deals-{{ ai_gen_id }} class="ai-deals-{{ ai_gen_id }}" data-end="{{ block.settings.end_time | escape }}" {{ block.shopify_attributes }}>
  <div class="ai-deals-{{ ai_gen_id }}__inner">
    <div class="ai-deals-{{ ai_gen_id }}__header">
      <div>
        {% if block.settings.eyebrow != blank %}<p class="ai-deals-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
        <h2 class="ai-deals-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h2>
        {% if block.settings.subtitle != blank %}<p class="ai-deals-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle }}</p>{% endif %}
      </div>
      <div class="ai-deals-{{ ai_gen_id }}__timer" role="timer" aria-label="Time remaining">
        <div class="ai-deals-{{ ai_gen_id }}__unit"><span class="ai-deals-{{ ai_gen_id }}__number" data-days>00</span><span class="ai-deals-{{ ai_gen_id }}__label">Days</span></div>
        <div class="ai-deals-{{ ai_gen_id }}__unit"><span class="ai-deals-{{ ai_gen_id }}__number" data-hours>00</span><span class="ai-deals-{{ ai_gen_id }}__label">Hours</span></div>
        <div class="ai-deals-{{ ai_gen_id }}__unit"><span class="ai-deals-{{ ai_gen_id }}__number" data-minutes>00</span><span class="ai-deals-{{ ai_gen_id }}__label">Minutes</span></div>
        <div class="ai-deals-{{ ai_gen_id }}__unit"><span class="ai-deals-{{ ai_gen_id }}__number" data-seconds>00</span><span class="ai-deals-{{ ai_gen_id }}__label">Seconds</span></div>
      </div>
    </div>
    {% assign featured = block.settings.featured_product %}
    {% if featured != blank %}
      <div class="ai-deals-{{ ai_gen_id }}__product">
        {% if featured.featured_image %}<img class="ai-deals-{{ ai_gen_id }}__image" src="{{ featured.featured_image | image_url: width: 700 }}" alt="{{ featured.featured_image.alt | default: featured.title | escape }}" loading="lazy" width="700" height="700">{% else %}<div class="ai-deals-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
        <div><h3>{{ featured.title }}</h3><div class="ai-deals-{{ ai_gen_id }}__price">{{ featured.price | money }}</div><a class="ai-deals-{{ ai_gen_id }}__button" href="{{ featured.url }}">{{ block.settings.button_label }}</a></div>
      </div>
    {% endif %}
    {% assign deals = block.settings.deals_collection %}
    {% if deals != blank %}<h3 class="ai-deals-{{ ai_gen_id }}__collection-title">{{ block.settings.collection_heading }}</h3><div class="ai-deals-{{ ai_gen_id }}__grid">{% for item in deals.products limit: 8 %}<a class="ai-deals-{{ ai_gen_id }}__card" href="{{ item.url }}">{% if item.featured_image %}<img src="{{ item.featured_image | image_url: width: 500 }}" alt="{{ item.featured_image.alt | default: item.title | escape }}" loading="lazy" width="500" height="500">{% else %}<div class="ai-deals-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-deals-{{ ai_gen_id }}__card-title">{{ item.title }}</div><div class="ai-deals-{{ ai_gen_id }}__card-price">{{ item.price | money }}</div></a>{% endfor %}</div>{% endif %}
  </div>
</limited-deals-{{ ai_gen_id }}>

<script>
(function(){
  class LimitedDeals{{ ai_gen_id }} extends HTMLElement {
    connectedCallback(){
      this.end = new Date(this.dataset.end).getTime();
      this.tick();
      this.interval = setInterval(() => this.tick(), 1000);
    }
    disconnectedCallback(){ clearInterval(this.interval); }
    tick(){
      let remaining = Math.max(0, this.end - Date.now());
      const days = Math.floor(remaining / 86400000); remaining %= 86400000;
      const hours = Math.floor(remaining / 3600000); remaining %= 3600000;
      const minutes = Math.floor(remaining / 60000); remaining %= 60000;
      const seconds = Math.floor(remaining / 1000);
      this.querySelector('[data-days]').textContent = String(days).padStart(2, '0');
      this.querySelector('[data-hours]').textContent = String(hours).padStart(2, '0');
      this.querySelector('[data-minutes]').textContent = String(minutes).padStart(2, '0');
      this.querySelector('[data-seconds]').textContent = String(seconds).padStart(2, '0');
      if (!this.end || remaining === 0) clearInterval(this.interval);
    }
  }
  customElements.define('limited-deals-{{ ai_gen_id }}', LimitedDeals{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Limited deals",
  "tag": null,
  "class": "limited-deals-block",
  "settings": [
    {"type":"header","content":"Content"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Limited-time offer"},
    {"type":"text","id":"heading","label":"Heading","default":"Deals of the day"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"Shop selected offers before time runs out."},
    {"type":"text","id":"end_time","label":"End date and time","default":"2026-12-31T23:59:59+08:00"},
    {"type":"product","id":"featured_product","label":"Flash-sale product"},
    {"type":"collection","id":"deals_collection","label":"Deals collection"},
    {"type":"text","id":"collection_heading","label":"Collection heading","default":"More deals"},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop deal"},
    {"type":"header","content":"Style"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"radius","label":"Corner radius","min":0,"max":40,"step":2,"unit":"px","default":12},
    {"type":"color","id":"background_color","label":"Background","default":"#F8F9FD"},
    {"type":"color","id":"card_background","label":"Card background","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Text","default":"#111111"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#0070CA"},
    {"type":"color","id":"timer_background","label":"Timer background","default":"#FFF002"},
    {"type":"color","id":"button_background","label":"Button background","default":"#FFF002"},
    {"type":"color","id":"button_text","label":"Button text","default":"#111111"}
  ],
  "presets": [{"name":"Limited deals"}]
}
{% endschema %}