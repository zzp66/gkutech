{% doc %}
  @prompt
    页面大标题, 大标题，副标题，正文
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-page-intro-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_vertical }}px 24px;
    text-align: {{ block.settings.alignment }};
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-page-intro-{{ ai_gen_id }}__content {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-page-intro-{{ ai_gen_id }}__heading {
    margin: 0;
    color: inherit;
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .ai-page-intro-{{ ai_gen_id }}__subtitle {
    margin: 16px 0 0;
    color: inherit;
    font-family: {{ settings.type_subheading_font.family }}, {{ settings.type_subheading_font.fallback_families }};
    font-size: {{ block.settings.subtitle_size }}px;
    font-weight: 600;
    line-height: 1.4;
  }

  .ai-page-intro-{{ ai_gen_id }}__body {
    margin: 12px 0 0;
    color: inherit;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.6;
  }

  .ai-page-intro-{{ ai_gen_id }}__subtitle p,
  .ai-page-intro-{{ ai_gen_id }}__body p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-page-intro-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.mobile_padding_vertical }}px 16px;
    }

    .ai-page-intro-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-page-intro-{{ ai_gen_id }}__subtitle {
      font-size: {{ block.settings.mobile_subtitle_size }}px;
    }

    .ai-page-intro-{{ ai_gen_id }}__body {
      font-size: {{ block.settings.mobile_body_size }}px;
    }
  }
{% endstyle %}

<div class="ai-page-intro-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-page-intro-{{ ai_gen_id }}__content">
    <h1 class="ai-page-intro-{{ ai_gen_id }}__heading">{{ block.settings.title | escape }}</h1>
    {% if block.settings.subtitle != blank %}
      <div class="ai-page-intro-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle }}</div>
    {% endif %}
    {% if block.settings.body != blank %}
      <div class="ai-page-intro-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "大标题与正文",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "大标题",
      "default": "页面标题"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "副标题",
      "default": "<p>用一句话介绍本页面</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "正文",
      "default": "<p>在这里添加页面说明、活动信息或品牌故事。</p>"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "对齐方式",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "桌面宽度",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "内容最大宽度",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "桌面标题字号",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "移动端标题字号",
      "min": 20,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "桌面副标题字号",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "mobile_subtitle_size",
      "label": "移动端副标题字号",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "桌面正文字号",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_body_size",
      "label": "移动端正文字号",
      "min": 12,
      "max": 22,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "桌面上下间距",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding_vertical",
      "label": "移动端上下间距",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "大标题与正文"
    }
  ],
  "tag": null,
  "class": "page-intro-block"
}
{% endschema %}