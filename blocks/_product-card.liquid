

{%- doc -%}
  @param {string} [product_view_context] - Context value passed through to the card snippet.
{%- enddoc -%}

{% liquid
  assign product = closest.product
  assign xtu_plp_card = false
  if product != blank
    if product_view_context == 'collection' or product_view_context == 'search' or product_view_context == 'recommendation'
      assign xtu_plp_card = true
    endif
  endif
%}

{% capture children %}
  {% if xtu_plp_card %}
    {%- if product.available == false or product.compare_at_price > product.price -%}
      <div
        class="product-badges product-badges--top-left xtu-collection-card__badge"
        style="
          --badge-font-family: var(--font-{{ settings.badge_font_family }}--family);
          --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight);
          --badge-text-transform: {{ settings.badge_text_transform }};
        "
      >
        <div
          class="
            product-badges__badge product-badges__badge--rectangle
            {% if product.available == false %} color-custom-badge-sold-out{% elsif product.compare_at_price > product.price %} color-custom-badge-sale{% endif %}
          "
        >
          {%- if product.available == false -%}
            {{ 'content.product_badge_sold_out' | t }}
          {%- elsif product.compare_at_price > product.price -%}
            {{ 'content.product_badge_sale' | t }}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {% endif %}
  {% content_for 'blocks', closest.product: product %}
  {% if xtu_plp_card %}
    <div
      class="xtu-collection-card__cta-wrap"
      style="
        --xtu-atc-bg: {{ block.settings.atc_bg | default: settings.xtu_atc_bg | default: '#1590F2' }};
        --xtu-atc-color: {{ block.settings.atc_color | default: settings.xtu_atc_color | default: '#FFFFFF' }};
        --xtu-atc-bg-hover: {{ block.settings.atc_bg_hover | default: settings.xtu_atc_bg_hover | default: '#0070CA' }};
        --xtu-atc-color-hover: {{ block.settings.atc_color_hover | default: settings.xtu_atc_color_hover | default: '#FFFFFF' }};
        --xtu-atc-bg-disabled: {{ block.settings.atc_bg_disabled | default: settings.xtu_atc_bg_disabled | default: '#E8E8ED' }};
        --xtu-atc-color-disabled: {{ block.settings.atc_color_disabled | default: settings.xtu_atc_color_disabled | default: '#8E8E93' }};
      "
    >
      {% render 'xtu-collection-card-cta', product: product, section_id: section.id %}
    </div>
  {% endif %}
{% endcapture %}

{% render 'product-card', children: children, product: product, product_view_context: product_view_context %}
{% render 'quantity-selector-styles' %}
{% render 'buy-buttons-styles' %}
{% render 'gift-card-recipient-form-styles' %}
{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'swatch-styles' %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}

{% schema %}
{
  "name": "t:names.product_card",
  "blocks": [
    {
      "type": "_product-card-group"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "buy-buttons"
    },
    {
      "type": "price"
    },
    {
      "type": "review"
    },
    {
      "type": "sku"
    },
    {
      "type": "swatches"
    },
    {
      "type": "_product-card-gallery"
    },
    {
      "type": "product-title"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_card"
    },
    {
      "type": "range",
      "id": "product_card_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "加购按钮颜色"
    },
    {
      "type": "paragraph",
      "content": "集合页 / 搜索 / 推荐产品卡底部 CTA。默认跟随主题「XTU 通用颜色 → 加购按钮」。"
    },
    {
      "type": "color",
      "id": "atc_bg",
      "label": "背景色",
      "default": "#1590F2"
    },
    {
      "type": "color",
      "id": "atc_color",
      "label": "文字色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "atc_bg_hover",
      "label": "Hover 背景色",
      "default": "#0070CA"
    },
    {
      "type": "color",
      "id": "atc_color_hover",
      "label": "Hover 文字色",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "atc_bg_disabled",
      "label": "不可用背景色",
      "default": "#E8E8ED"
    },
    {
      "type": "color",
      "id": "atc_color_disabled",
      "label": "不可用文字色",
      "default": "#8E8E93"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
