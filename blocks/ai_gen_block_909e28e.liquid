{% doc %}
  @prompt
    请帮我生成一个带倒计时的营销模块，可上传一个deals打折的产品系列，同时又可以营销单款产品限时秒杀
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-deal-countdown-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 32px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }
  .ai-deal-countdown-{{ ai_gen_id }}__header { display:flex; justify-content:space-between; align-items:end; gap:20px; margin-bottom:24px; }
  .ai-deal-countdown-{{ ai_gen_id }}__title { margin:0; font-size:clamp(24px,4vw,42px); line-height:1.05; }
  .ai-deal-countdown-{{ ai_gen_id }}__subtitle { margin:8px 0 0; opacity:.78; }
  .ai-deal-countdown-{{ ai_gen_id }}__timer { display:flex; gap:8px; flex-shrink:0; }
  .ai-deal-countdown-{{ ai_gen_id }}__unit { min-width:58px; padding:10px 8px; text-align:center; background:{{ block.settings.timer_color }}; color:{{ block.settings.timer_text_color }}; border-radius:{{ block.settings.timer_radius }}px; }
  .ai-deal-countdown-{{ ai_gen_id }}__number { display:block; font-size:24px; font-weight:700; line-height:1; }
  .ai-deal-countdown-{{ ai_gen_id }}__label { display:block; margin-top:5px; font-size:11px; }
  .ai-deal-countdown-{{ ai_gen_id }}__content { display:grid; grid-template-columns:minmax(0,1fr) minmax(220px, .7fr); gap:24px; }
  .ai-deal-countdown-{{ ai_gen_id }}__products { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
  .ai-deal-countdown-{{ ai_gen_id }}__card { background:{{ block.settings.card_color }}; border-radius:{{ block.settings.card_radius }}px; overflow:hidden; color:{{ block.settings.text_color }}; }
  .ai-deal-countdown-{{ ai_gen_id }}__image { aspect-ratio:1/1; display:block; width:100%; object-fit:cover; background:#f4f4f4; }
  .ai-deal-countdown-{{ ai_gen_id }}__placeholder { aspect-ratio:1/1; display:flex; align-items:center; justify-content:center; background:#f4f4f4; }
  .ai-deal-countdown-{{ ai_gen_id }}__placeholder svg { width:100%; height:100%; }
  .ai-deal-countdown-{{ ai_gen_id }}__info { padding:14px; }
  .ai-deal-countdown-{{ ai_gen_id }}__name { margin:0 0 8px; font-weight:600; }
  .ai-deal-countdown-{{ ai_gen_id }}__price { font-weight:700; }
  .ai-deal-countdown-{{ ai_gen_id }}__price s { margin-left:6px; opacity:.55; font-weight:400; }
  .ai-deal-countdown-{{ ai_gen_id }}__flash { display:flex; flex-direction:column; justify-content:center; padding:24px; background:{{ block.settings.flash_color }}; color:{{ block.settings.flash_text_color }}; border-radius:{{ block.settings.card_radius }}px; }
  .ai-deal-countdown-{{ ai_gen_id }}__flash h3 { margin:0 0 12px; font-size:26px; }
  .ai-deal-countdown-{{ ai_gen_id }}__flash p { margin:0 0 18px; opacity:.85; }
  .ai-deal-countdown-{{ ai_gen_id }}__button { display:inline-flex; justify-content:center; padding:12px 20px; border-radius:{{ block.settings.button_radius }}px; background:{{ block.settings.button_color }}; color:{{ block.settings.button_text_color }}; text-decoration:none; font-weight:600; }
  @media (max-width: 749px) { .ai-deal-countdown-{{ ai_gen_id }} { padding:22px 16px; } .ai-deal-countdown-{{ ai_gen_id }}__header { display:block; } .ai-deal-countdown-{{ ai_gen_id }}__timer { margin-top:18px; } .ai-deal-countdown-{{ ai_gen_id }}__content { grid-template-columns:1fr; } .ai-deal-countdown-{{ ai_gen_id }}__products { grid-template-columns:repeat(2,minmax(0,1fr)); } .ai-deal-countdown-{{ ai_gen_id }}__unit { min-width:50px; } }
{% endstyle %}

<deal-countdown-{{ ai_gen_id }} class="ai-deal-countdown-{{ ai_gen_id }}" data-end-time="{{ block.settings.end_time | escape }}" {{ block.shopify_attributes }}>
  <div class="ai-deal-countdown-{{ ai_gen_id }}__header">
    <div><h2 class="ai-deal-countdown-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h2><p class="ai-deal-countdown-{{ ai_gen_id }}__subtitle">{{ block.settings.subheading }}</p></div>
    <div class="ai-deal-countdown-{{ ai_gen_id }}__timer" aria-label="倒计时"><div class="ai-deal-countdown-{{ ai_gen_id }}__unit"><span data-days class="ai-deal-countdown-{{ ai_gen_id }}__number">00</span><span class="ai-deal-countdown-{{ ai_gen_id }}__label">天</span></div><div class="ai-deal-countdown-{{ ai_gen_id }}__unit"><span data-hours class="ai-deal-countdown-{{ ai_gen_id }}__number">00</span><span class="ai-deal-countdown-{{ ai_gen_id }}__label">时</span></div><div class="ai-deal-countdown-{{ ai_gen_id }}__unit"><span data-minutes class="ai-deal-countdown-{{ ai_gen_id }}__number">00</span><span class="ai-deal-countdown-{{ ai_gen_id }}__label">分</span></div><div class="ai-deal-countdown-{{ ai_gen_id }}__unit"><span data-seconds class="ai-deal-countdown-{{ ai_gen_id }}__number">00</span><span class="ai-deal-countdown-{{ ai_gen_id }}__label">秒</span></div></div>
  </div>
  <div class="ai-deal-countdown-{{ ai_gen_id }}__content">
    <div class="ai-deal-countdown-{{ ai_gen_id }}__products">
      {% if block.settings.deal_collection != blank %}{% for product in block.settings.deal_collection.products limit: 4 %}<a class="ai-deal-countdown-{{ ai_gen_id }}__card" href="{{ product.url }}">{% if product.featured_image %}<img class="ai-deal-countdown-{{ ai_gen_id }}__image" src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="700" height="700">{% else %}<div class="ai-deal-countdown-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-deal-countdown-{{ ai_gen_id }}__info"><p class="ai-deal-countdown-{{ ai_gen_id }}__name">{{ product.title }}</p><span class="ai-deal-countdown-{{ ai_gen_id }}__price">{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</span></div></a>{% endfor %}{% else %}<div class="ai-deal-countdown-{{ ai_gen_id }}__card"><div class="ai-deal-countdown-{{ ai_gen_id }}__placeholder">{{ 'collection-apparel-1' | placeholder_svg_tag }}</div><div class="ai-deal-countdown-{{ ai_gen_id }}__info">请选择 Deals 产品系列</div></div>{% endif %}
    </div>
    <div class="ai-deal-countdown-{{ ai_gen_id }}__flash">{% if block.settings.flash_product != blank %}{% if block.settings.flash_product.featured_image %}<img class="ai-deal-countdown-{{ ai_gen_id }}__image" src="{{ block.settings.flash_product.featured_image | image_url: width: 700 }}" alt="{{ block.settings.flash_product.featured_image.alt | default: block.settings.flash_product.title | escape }}" loading="lazy" width="700" height="700">{% endif %}<h3>{{ block.settings.flash_title }}</h3><p>{{ block.settings.flash_product.title }}<br><strong>{{ block.settings.flash_product.price | money }}</strong></p><a class="ai-deal-countdown-{{ ai_gen_id }}__button" href="{{ block.settings.flash_product.url }}">{{ block.settings.button_label }}</a>{% else %}<h3>{{ block.settings.flash_title }}</h3><p>请选择一款限时秒杀产品。</p>{% endif %}</div>
  </div>
</deal-countdown-{{ ai_gen_id }}>

<script>
(function(){
  class DealCountdown{{ ai_gen_id }} extends HTMLElement {
    connectedCallback(){
      this.end = new Date(this.dataset.endTime).getTime();
      this.timer = setInterval(() => this.update(), 1000); this.update();
    }
    disconnectedCallback(){ clearInterval(this.timer); }
    update(){
      let diff = Math.max(0, this.end - Date.now());
      const values = {days:Math.floor(diff/86400000), hours:Math.floor(diff%86400000/3600000), minutes:Math.floor(diff%3600000/60000), seconds:Math.floor(diff%60000/1000)};
      Object.keys(values).forEach(key => { const el=this.querySelector('[data-'+key+']'); if(el) el.textContent=String(values[key]).padStart(2,'0'); });
      if(diff === 0) clearInterval(this.timer);
    }
  }
  customElements.define('deal-countdown-{{ ai_gen_id }}', DealCountdown{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "限时促销倒计时",
  "settings": [
    {"type":"header","content":"促销内容"},
    {"type":"text","id":"heading","label":"主标题","default":"限时优惠，抓住机会"},
    {"type":"text","id":"subheading","label":"副标题","default":"精选 Deals 与限时秒杀，优惠即将结束"},
    {"type":"collection","id":"deal_collection","label":"Deals 产品系列"},
    {"type":"product","id":"flash_product","label":"秒杀产品"},
    {"type":"text","id":"flash_title","label":"秒杀标题","default":"单款限时秒杀"},
    {"type":"text","id":"button_label","label":"按钮文字","default":"立即抢购"},
    {"type":"text","id":"end_time","label":"结束时间","default":"2026-12-31T23:59:59+08:00"},
    {"type":"header","content":"布局"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"border_radius","label":"模块圆角","min":0,"max":40,"step":2,"unit":"px","default":16},
    {"type":"range","id":"card_radius","label":"卡片圆角","min":0,"max":32,"step":2,"unit":"px","default":12},
    {"type":"range","id":"timer_radius","label":"倒计时圆角","min":0,"max":24,"step":2,"unit":"px","default":8},
    {"type":"range","id":"button_radius","label":"按钮圆角","min":0,"max":32,"step":2,"unit":"px","default":16},
    {"type":"header","content":"颜色"},
    {"type":"color","id":"background_color","label":"背景","default":"#F8F9FD"},
    {"type":"color","id":"card_color","label":"卡片背景","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"文字","default":"#000000"},
    {"type":"color","id":"timer_color","label":"倒计时背景","default":"#FFF002"},
    {"type":"color","id":"timer_text_color","label":"倒计时文字","default":"#000000"},
    {"type":"color","id":"flash_color","label":"秒杀背景","default":"#0070CA"},
    {"type":"color","id":"flash_text_color","label":"秒杀文字","default":"#FFFFFF"},
    {"type":"color","id":"button_color","label":"按钮背景","default":"#FFF002"},
    {"type":"color","id":"button_text_color","label":"按钮文字颜色","default":"#000000"}
  ],
  "presets": [{"name":"限时促销倒计时"}],
  "tag": null,
  "class": "deal-countdown-block"
}
{% endschema %}