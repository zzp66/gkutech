{% doc %}
  @prompt
    Shop by Need
    Dual 4K / Night Vision / 3-Channel / 4G LTE 根据这个文案生成一个section，点击四个按钮或标签可以跳转到对应的合集, 改成既可以跳转产品合集，也可以跳转指定产品页面
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shop-by-need-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; padding:{{ block.settings.padding_vertical }}px 24px; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; }
  .ai-shop-by-need__inner-{{ ai_gen_id }} { width:100%; max-width:1200px; margin:0 auto; }
  .ai-shop-by-need__heading-{{ ai_gen_id }} { margin:0 0 24px; color:{{ block.settings.text_color }}; font-size:{{ block.settings.heading_size }}px; line-height:1.15; font-weight:700; letter-spacing:-.02em; }
  .ai-shop-by-need__links-{{ ai_gen_id }} { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }
  .ai-shop-by-need__link-{{ ai_gen_id }} { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:56px; padding:14px 18px; border:{{ block.settings.border_width }}px solid {{ block.settings.border_color }}; border-radius:{{ block.settings.border_radius }}px; background:{{ block.settings.button_color }}; color:{{ block.settings.button_text_color }}; font-size:{{ block.settings.button_text_size }}px; font-weight:600; line-height:1.2; text-decoration:none; transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease; }
  .ai-shop-by-need__link-{{ ai_gen_id }}:hover, .ai-shop-by-need__link-{{ ai_gen_id }}:focus-visible { background:{{ block.settings.button_hover_color }}; color:{{ block.settings.button_hover_text_color }}; border-color:{{ block.settings.button_hover_color }}; }
  .ai-shop-by-need__link-{{ ai_gen_id }}:focus-visible { outline:3px solid {{ block.settings.focus_color }}; outline-offset:3px; }
  .ai-shop-by-need__arrow-{{ ai_gen_id }} { flex:0 0 auto; font-size:20px; line-height:1; }
  .ai-shop-by-need__empty-{{ ai_gen_id }} { padding:18px; border:1px dashed {{ block.settings.border_color }}; color:{{ block.settings.muted_text_color }}; font-size:14px; }
  @media screen and (max-width:749px) { .ai-shop-by-need-{{ ai_gen_id }} { padding-right:16px; padding-left:16px; } .ai-shop-by-need__heading-{{ ai_gen_id }} { margin-bottom:18px; font-size:{{ block.settings.mobile_heading_size }}px; } .ai-shop-by-need__links-{{ ai_gen_id }} { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; } .ai-shop-by-need__link-{{ ai_gen_id }} { min-height:52px; padding:12px 14px; font-size:14px; } }
{% endstyle %}

<div class="ai-shop-by-need-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-shop-by-need__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}<h2 class="ai-shop-by-need__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>{% endif %}
    <nav class="ai-shop-by-need__links-{{ ai_gen_id }}" aria-label="{{ block.settings.heading | escape }}">
      {% for i in (1..4) %}
        {% assign type_key = 'need_' | append: i | append: '_type' %}
        {% assign label_key = 'need_' | append: i | append: '_label' %}
        {% assign collection_key = 'need_' | append: i | append: '_collection' %}
        {% assign product_key = 'need_' | append: i | append: '_product' %}
        {% assign link_type = block.settings[type_key] %}
        {% assign link_label = block.settings[label_key] %}
        {% assign link_resource = blank %}
        {% if link_type == 'collection' %}{% assign link_resource = block.settings[collection_key] %}{% else %}{% assign link_resource = block.settings[product_key] %}{% endif %}
        {% if link_resource != blank %}<a class="ai-shop-by-need__link-{{ ai_gen_id }}" href="{{ link_resource.url }}"><span>{{ link_label | escape }}</span><span class="ai-shop-by-need__arrow-{{ ai_gen_id }}" aria-hidden="true">→</span></a>{% endif %}
      {% endfor %}
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Shop by need",
  "settings": [
    {"type":"header","content":"内容"},
    {"type":"text","id":"heading","label":"标题","default":"Shop by Need"},
    {"type":"paragraph","content":"每个标签可选择跳转到合集或指定产品。"},
    {"type":"select","id":"need_1_type","label":"标签 1类型","options":[{"value":"collection","label":"合集"},{"value":"product","label":"产品"}],"default":"collection"},
    {"type":"text","id":"need_1_label","label":"标签 1","default":"Dual 4K"},
    {"type":"collection","id":"need_1_collection","label":"标签 1合集"},
    {"type":"product","id":"need_1_product","label":"标签 1产品"},
    {"type":"select","id":"need_2_type","label":"标签 2类型","options":[{"value":"collection","label":"合集"},{"value":"product","label":"产品"}],"default":"collection"},
    {"type":"text","id":"need_2_label","label":"标签 2","default":"Night Vision"},
    {"type":"collection","id":"need_2_collection","label":"标签 2合集"},
    {"type":"product","id":"need_2_product","label":"标签 2产品"},
    {"type":"select","id":"need_3_type","label":"标签 3类型","options":[{"value":"collection","label":"合集"},{"value":"product","label":"产品"}],"default":"collection"},
    {"type":"text","id":"need_3_label","label":"标签 3","default":"3-Channel"},
    {"type":"collection","id":"need_3_collection","label":"标签 3合集"},
    {"type":"product","id":"need_3_product","label":"标签 3产品"},
    {"type":"select","id":"need_4_type","label":"标签 4类型","options":[{"value":"collection","label":"合集"},{"value":"product","label":"产品"}],"default":"collection"},
    {"type":"text","id":"need_4_label","label":"标签 4","default":"4G LTE"},
    {"type":"collection","id":"need_4_collection","label":"标签 4合集"},
    {"type":"product","id":"need_4_product","label":"标签 4产品"},
    {"type":"header","content":"布局"},
    {"type":"range","id":"desktop_width_percent","label":"桌面宽度","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"padding_vertical","label":"上下间距","min":0,"max":80,"step":4,"unit":"px","default":32},
    {"type":"range","id":"heading_size","label":"标题字号","min":18,"max":56,"step":2,"unit":"px","default":32},
    {"type":"range","id":"mobile_heading_size","label":"移动端标题字号","min":16,"max":36,"step":2,"unit":"px","default":24},
    {"type":"range","id":"button_text_size","label":"标签字号","min":12,"max":22,"step":1,"unit":"px","default":16},
    {"type":"range","id":"border_radius","label":"圆角","min":0,"max":32,"step":2,"unit":"px","default":16},
    {"type":"range","id":"border_width","label":"边框宽度","min":0,"max":4,"step":1,"unit":"px","default":1},
    {"type":"header","content":"颜色"},
    {"type":"color","id":"background_color","label":"背景","default":"#F8F9FD"},
    {"type":"color","id":"text_color","label":"标题文字","default":"#000000"},
    {"type":"color","id":"button_color","label":"标签背景","default":"#FFF002"},
    {"type":"color","id":"button_text_color","label":"标签文字","default":"#000000"},
    {"type":"color","id":"button_hover_color","label":"悬停背景","default":"#0070CA"},
    {"type":"color","id":"button_hover_text_color","label":"悬停文字","default":"#FFFFFF"},
    {"type":"color","id":"border_color","label":"边框","default":"#000000"},
    {"type":"color","id":"focus_color","label":"焦点轮廓","default":"#0070CA"},
    {"type":"color","id":"muted_text_color","label":"辅助文字","default":"#535F11"}
  ],
  "presets":[{"name":"Shop by need"}],
  "tag":null,
  "class":"shop-by-need-block"
}
{% endschema %}