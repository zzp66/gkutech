{% doc %}
  @prompt
    Create a NEW Limited deals slider block without deleting/modifying existing blocks. Match and preserve this current module configuration. All UI text English. Main heading 'Halloween Dash Cam Flash Deals'. Subtitle exactly 'Limited-time dash cam deals, plus an extra $10 OFF orders $100+, $15 OFF $150+, or $20 OFF $200+.' This is existing merchant text; do not add further discount claims or create checkout discounts. Single countdown top-right, heading/subtitle top-left, no mobile overlap. Label 'Ends in', end '2026-10-31T23:59:59+08:00', digit size28, digit color #111111, individual digit tiles background #fff001 size48 padding8 radius6, readable time-unit labels. All countdown settings editable. Module background #f8f9fd, text #111111, cards #ffffff, width100%. Independent single-row collection sliders: desktop4 per view with arrows, mobile2 with touch, editable counts. Up to5 selectable collections. Seed collection1 handle halloween-sale-save-40, resource gid://shopify/Collection/513284210915, heading 'Halloween Deals: 40% OFF', discount40, custom badge '40% OFF', collection destination EMPTY. Seed collection2 handle halloween-sale-save-35, resource gid://shopify/Collection/513284178147, heading 'More Halloween Deals: 35% OFF', discount35, custom badge EMPTY, collection destination shopify://pages/halloween-dash-cam-sale (page gid://shopify/Page/167282802915). Slots3–5 empty collections, headings 'More deals 3','More deals 4','More deals 5', discounts30/25/20, empty badge text/links, hidden until selected. CRITICAL NEW FEATURE: automatically calculate displayed product sale price independently using its collection percentage: selected_or_first_available_variant.price * (100-discount)/100; 40 means40% OFF so $100 becomes$60. Show calculation-base current selling price struck through beside calculated sale price, not compare_at_price. Same variant for both, currency-aware formatting and rounding. At0% show normal price only. Custom badge text does not affect calculation. This is card display calculation only; do not alter actual product records or checkout discounts. Each card top-left editable badge; custom text per collection else percentage OFF; text#111111 background#fff001 border#fff001 width0, text/background/border independently editable. Each PRODUCT button 'Shop now' links to product; background#fff001 text#111111 border#111111 width0 hover background#f2c615 hover text#111111. Separately each COLLECTION slider has bottom-left button label 'Explore More Deals→', editable destination per collection supporting internal/external links, hidden if destination empty; collection button background/border use theme palette color7 (currently#fff001), text#111111 border width1. Button radius8. Expose independent product/collection button colors and editable labels, preserve links and empty destinations exactly. Expose all main/subheadings, selections, independent discounts, badges, countdown colors/sizes and buttons as functioning editor settings. Keep straightforward responsive structure and original Limited deals style. Seed exact settings/resource references where supported rather than silently choosing other resources.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-deals-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;box-sizing:border-box;background:{{ block.settings.bg_color }};color:{{ block.settings.text_color }};padding:24px}.ai-deals-{{ ai_gen_id }}__header{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:24px}.ai-deals-{{ ai_gen_id }}__intro{min-width:0}.ai-deals-{{ ai_gen_id }}__title{margin:0 0 8px;font-size:clamp(24px,3vw,36px);line-height:1.15}.ai-deals-{{ ai_gen_id }}__subtitle{margin:0;line-height:1.5}.ai-deals-{{ ai_gen_id }}__timer{flex:none;text-align:center}.ai-deals-{{ ai_gen_id }}__timer-label{display:block;margin-bottom:6px;font-weight:600}.ai-deals-{{ ai_gen_id }}__timer-values{display:flex;gap:6px}.ai-deals-{{ ai_gen_id }}__unit{min-width:48px;padding:{{ block.settings.tile_padding }}px 4px 5px;background:{{ block.settings.tile_bg }};border-radius:{{ block.settings.tile_radius }}px}.ai-deals-{{ ai_gen_id }}__number{display:block;font-size:{{ block.settings.digit_size }}px;line-height:1;color:{{ block.settings.digit_color }}}.ai-deals-{{ ai_gen_id }}__unit-label{display:block;margin-top:4px;font-size:11px;color:{{ block.settings.text_color }}}.ai-deals-{{ ai_gen_id }}__slider{margin:0 0 28px}.ai-deals-{{ ai_gen_id }}__slider-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.ai-deals-{{ ai_gen_id }}__collection-title{margin:0;font-size:22px}.ai-deals-{{ ai_gen_id }}__arrows{display:flex;gap:8px}.ai-deals-{{ ai_gen_id }}__arrow{width:38px;height:38px;border:1px solid #111;border-radius:50%;background:#fff;color:#111;cursor:pointer;font-size:20px}.ai-deals-{{ ai_gen_id }}__track{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - ({{ block.settings.desktop_count | minus: 1 }} * 16px))/{{ block.settings.desktop_count }});gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;padding-bottom:8px}.ai-deals-{{ ai_gen_id }}__card{min-width:0;background:{{ block.settings.card_bg }};border-radius:8px;overflow:hidden;scroll-snap-align:start}.ai-deals-{{ ai_gen_id }}__media{position:relative;aspect-ratio:1;background:#f4f4f4}.ai-deals-{{ ai_gen_id }}__media img,.ai-deals-{{ ai_gen_id }}__placeholder svg{display:block;width:100%;height:100%;object-fit:cover}.ai-deals-{{ ai_gen_id }}__badge{position:absolute;top:10px;left:10px;z-index:1;background:{{ block.settings.badge_bg }};color:{{ block.settings.badge_text }};border:{{ block.settings.badge_border_width }}px solid {{ block.settings.badge_border }};padding:6px 10px;font-size:13px;font-weight:700}.ai-deals-{{ ai_gen_id }}__info{padding:12px}.ai-deals-{{ ai_gen_id }}__product-title{display:block;color:inherit;text-decoration:none;font-weight:600;margin-bottom:8px;line-height:1.35}.ai-deals-{{ ai_gen_id }}__prices{display:flex;align-items:baseline;gap:8px;margin-bottom:12px}.ai-deals-{{ ai_gen_id }}__was{text-decoration:line-through;opacity:.72}.ai-deals-{{ ai_gen_id }}__sale{font-weight:700}.ai-deals-{{ ai_gen_id }}__shop{display:block;text-align:center;padding:10px 12px;border-radius:{{ block.settings.button_radius }}px;text-decoration:none}.ai-deals-{{ ai_gen_id }}__shop--product{background:{{ block.settings.product_btn_bg }};color:{{ block.settings.product_btn_text }};border:{{ block.settings.product_btn_border_width }}px solid {{ block.settings.product_btn_border }}}.ai-deals-{{ ai_gen_id }}__shop--product:hover{background:{{ block.settings.product_btn_hover_bg }};color:{{ block.settings.product_btn_hover_text }}}.ai-deals-{{ ai_gen_id }}__shop--collection{display:inline-block;margin-top:12px;background:{{ block.settings.collection_btn_bg }};color:{{ block.settings.collection_btn_text }};border:{{ block.settings.collection_btn_border_width }}px solid {{ block.settings.collection_btn_border }}}@media(max-width:749px){.ai-deals-{{ ai_gen_id }}{padding:16px}.ai-deals-{{ ai_gen_id }}__header{align-items:flex-start;flex-direction:column;gap:16px}.ai-deals-{{ ai_gen_id }}__timer{text-align:left}.ai-deals-{{ ai_gen_id }}__track{grid-auto-columns:calc((100% - 12px)/{{ block.settings.mobile_count }});gap:12px}.ai-deals-{{ ai_gen_id }}__collection-title{font-size:19px}}
{% endstyle %}
<limited-deals-{{ ai_gen_id }} class="ai-deals-{{ ai_gen_id }}" data-end="{{ block.settings.end_time | escape }}" {{ block.shopify_attributes }}><div class="ai-deals-{{ ai_gen_id }}__header"><div class="ai-deals-{{ ai_gen_id }}__intro"><h2 class="ai-deals-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2><p class="ai-deals-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle | escape }}</p></div><div class="ai-deals-{{ ai_gen_id }}__timer"><span class="ai-deals-{{ ai_gen_id }}__timer-label">{{ block.settings.timer_label | escape }}</span><div class="ai-deals-{{ ai_gen_id }}__timer-values">{% for unit in (1..4) %}{% case unit %}{% when 1 %}{% assign unit_name='days' %}{% assign unit_label='Days' %}{% when 2 %}{% assign unit_name='hours' %}{% assign unit_label='Hours' %}{% when 3 %}{% assign unit_name='minutes' %}{% assign unit_label='Minutes' %}{% else %}{% assign unit_name='seconds' %}{% assign unit_label='Seconds' %}{% endcase %}<div class="ai-deals-{{ ai_gen_id }}__unit"><span class="ai-deals-{{ ai_gen_id }}__number" data-{{ unit_name }}>00</span><span class="ai-deals-{{ ai_gen_id }}__unit-label">{{ unit_label }}</span></div>{% endfor %}</div></div></div>
{% for i in (1..5) %}{% liquid
assign collection_key='collection_' | append:i
assign title_key='collection_heading_' | append:i
assign discount_key='discount_' | append:i
assign badge_key='badge_' | append:i
assign link_key='collection_link_' | append:i
assign selected_collection=block.settings[collection_key]
assign collection_title=block.settings[title_key]
assign discount=block.settings[discount_key]
assign custom_badge=block.settings[badge_key]
assign collection_link=block.settings[link_key]
%}{% if selected_collection != blank %}<section class="ai-deals-{{ ai_gen_id }}__slider" data-slider><div class="ai-deals-{{ ai_gen_id }}__slider-head"><h3 class="ai-deals-{{ ai_gen_id }}__collection-title">{{ collection_title | escape }}</h3><div class="ai-deals-{{ ai_gen_id }}__arrows"><button class="ai-deals-{{ ai_gen_id }}__arrow" type="button" aria-label="Scroll products left" data-direction="-1">‹</button><button class="ai-deals-{{ ai_gen_id }}__arrow" type="button" aria-label="Scroll products right" data-direction="1">›</button></div></div><div class="ai-deals-{{ ai_gen_id }}__track">{% for item in selected_collection.products %}{% assign variant=item.selected_or_first_available_variant %}{% assign sale_cents=variant.price | times: 100 | minus: variant.price | times: discount | divided_by: 100 %}{% assign badge_label=custom_badge %}{% if badge_label == blank %}{% assign badge_label=discount | append:'% OFF' %}{% endif %}<article class="ai-deals-{{ ai_gen_id }}__card"><div class="ai-deals-{{ ai_gen_id }}__media"><span class="ai-deals-{{ ai_gen_id }}__badge">{{ badge_label | escape }}</span>{% if item.featured_image %}<a href="{{ item.url }}"><img src="{{ item.featured_image | image_url: width:700 }}" alt="{{ item.featured_image.alt | default:item.title | escape }}" loading="lazy" width="{{ item.featured_image.width }}" height="{{ item.featured_image.height }}"></a>{% else %}<div class="ai-deals-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-deals-{{ ai_gen_id }}__info"><a class="ai-deals-{{ ai_gen_id }}__product-title" href="{{ item.url }}">{{ item.title | escape }}</a><div class="ai-deals-{{ ai_gen_id }}__prices">{% if discount > 0 %}<span class="ai-deals-{{ ai_gen_id }}__was">{{ variant.price | money_with_currency }}</span><span class="ai-deals-{{ ai_gen_id }}__sale">{{ sale_cents | money_with_currency }}</span>{% else %}<span class="ai-deals-{{ ai_gen_id }}__sale">{{ variant.price | money_with_currency }}</span>{% endif %}</div><a class="ai-deals-{{ ai_gen_id }}__shop ai-deals-{{ ai_gen_id }}__shop--product" href="{{ item.url }}">{{ block.settings.product_button_label | escape }}</a></div></article>{% endfor %}</div>{% if collection_link != blank %}<a class="ai-deals-{{ ai_gen_id }}__shop ai-deals-{{ ai_gen_id }}__shop--collection" href="{{ collection_link }}">{{ block.settings.collection_button_label | escape }}</a>{% endif %}</section>{% endif %}{% endfor %}</limited-deals-{{ ai_gen_id }}>
<script>(function(){class LimitedDeals{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.querySelectorAll('[data-slider]').forEach((slider)=>{const track=slider.querySelector('.ai-deals-{{ ai_gen_id }}__track');slider.querySelectorAll('[data-direction]').forEach((button)=>button.addEventListener('click',()=>track.scrollBy({left:button.dataset.direction*(track.clientWidth*.85),behavior:'smooth'})))});const end=Date.parse(this.dataset.end);const update=()=>{let remaining=Math.max(0,end-Date.now());const v={days:Math.floor(remaining/86400000),hours:Math.floor(remaining%86400000/3600000),minutes:Math.floor(remaining%3600000/60000),seconds:Math.floor(remaining%60000/1000)};Object.keys(v).forEach((u)=>{const node=this.querySelector('[data-'+u+']');if(node)node.textContent=String(v[u]).padStart(2,'0')})};update();this.timer=setInterval(update,1000)}disconnectedCallback(){clearInterval(this.timer)}}if(!customElements.get('limited-deals-{{ ai_gen_id }}'))customElements.define('limited-deals-{{ ai_gen_id }}',LimitedDeals{{ ai_gen_id }})})();</script>
