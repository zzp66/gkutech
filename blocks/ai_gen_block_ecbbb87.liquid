ault":0},{"type":"header","content":"Product button"},{"type":"text","id":"product_button_label","label":"Label","default":"Shop now"},{"type":"color","id":"product_btn_bg","label":"Background","default":"#fff001"},{"type":"color","id":"product_btn_text","label":"Text","default":"#111111"},{"type":"color","id":"product_btn_border","label":"Border","default":"#111111"},{"type":"range","id":"product_btn_border_width","label":"Border width","min":0,"max":4,"step":1,"unit":"px","default":0},{"type":"color","id":"product_btn_hover_bg","label":"Hover background","default":"#f2c615"},{"type":"color","id":"product_btn_hover_text","label":"Hover text","default":"#111111"},{"type":"header","content":"Collection button"},{"type":"text","id":"collection_button_label","label":"Label","default":"Explore More Deals→"},{"type":"color","id":"collection_btn_bg","label":"Background","default":"#fff001"},{"type":"color","id":"collection_btn_text","label":"Text","default":"#111111"},{"type":"color","id":"collection_btn_border","label":"Border","default":"#111111"},{"type":"range","id":"collection_btn_border_width","label":"Border width","min":0,"max":4,"step":1,"unit":"px","default":1},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":8},{"type":"header","content":"Collection 1"},{"type":"collection","id":"collection_1","label":"Collection"},{"type":"text","id":"collection_heading_1","label":"Heading","default":"Halloween Deals: 40% OFF"},{"type":"range","id":"discount_1","label":"Display discount percent","min":0,"max":90,"step":5,"unit":"%","default":40},{"type":"text","id":"badge_1","label":"Custom badge","default":"40% OFF"},{"type":"url","id":"collection_link_1","label":"Collection destination"},{"type":"header","content":"Collection 2"},{"type":"collection","id":"collection_2","label":"Collection"},{"type":"text","id":"collection_heading_2","label":"Heading","default":"More Halloween Deals: 35% OFF"},{"type":"range","id":"discount_2","label":"Display discount percent","min":0,"max":90,"step":5,"unit":"%","default":35},{"type":"text","id":"badge_2","label":"Custom badge"},{"type":"url","id":"collection_link_2","label":"Collection destination"},{"type":"header","content":"Collection 3"},{"type":"collection","id":"collection_3","label":"Collection"},{"type":"text","id":"collection_heading_3","label":"Heading","default":"More deals 3"},{"type":"range","id":"discount_3","label":"Display discount percent","min":0,"max":90,"step":5,"unit":"%","default":30},{"type":"text","id":"badge_3","label":"Custom badge"},{"type":"url","id":"collection_link_3","label":"Collection destination"},{"type":"header","content":"Collection 4"},{"type":"collection","id":"collection_4","label":"Collection"},{"type":"text","id":"collection_heading_4","label":"Heading","default":"More deals 4"},{"type":"range","id":"discount_4","label":"Display discount percent","min":0,"max":90,"step":5,"unit":"%","default":25},{"type":"text","id":"badge_4","label":"Custom badge"},{"type":"url","id":"collection_link_4","label":"Collection destination"},{"type":"header","content":"Collection 5"},{"type":"collection","id":"collection_5","label":"Collection"},{"type":"text","id":"collection_heading_5","label":"Heading","default":"More deals 5"},{"type":"range","id":"discount_5","label":"Display discount percent","min":0,"max":90,"step":5,"unit":"%","default":20},{"type":"text","id":"badge_5","label":"Custom badge"},{"type":"url","id":"collection_link_5","label":"Collection destination"}],"presets":[{"name":"Limited deals slider"}],"tag":null,"class":"limited-deals-block"}{% endschema %}