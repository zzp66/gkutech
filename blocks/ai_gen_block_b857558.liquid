{% doc %}
  @prompt
    Create a NEW block named Seasonal Deals Carousel matching the existing Limited deals slider style; never modify/delete existing blocks. English UI. Heading Halloween Dash Cam Flash Deals; subtitle exactly: Limited-time dash cam deals, plus an extra $10 OFF orders $100+, $15 OFF $150+, or $20 OFF $200+. Full width, background #f8f9fd, text #111111, white cards. Up to5 selectable independent single-row collection sliders; hide empty collections. Desktop4 cards with arrows, mobile2 with swipe, editable counts. Editable per-collection headings, discounts, badge text, button label and URL. Product Shop now links to product. CRITICAL: render entire collection Explore More Deals→ button and its wrapper ONLY if show-button toggle is enabled AND label AND destination are nonblank. Otherwise no arrow, button, border, background or space. All collection destinations default blank. Product buttons and carousel navigation unaffected. Yellow #fff001 buttons, dark text, radius8, independently editable product/collection button styling. Badge custom text else percentage OFF, yellow background, editable styling. Display sale price using same selected_or_first_available_variant current price: first separately assign factor=100-discount, then price*factor/100, round minor units and money-format. $100 at40% OFF=$60; $169.99 at50% OFF=$85.00. Strike through base current selling price, NOT compare_at_price; at0% normal price only. Never change actual product prices or checkout discounts. Single editable countdown top-right, headings top-left, no mobile overlap: Ends in, end2026-10-31T23:59:59+08:00, digits28 color#111111, tiles#fff001 size48 padding8 radius6, readable units. Expose all headings, selections, discounts, badges, countdown settings and button settings. Copy current module resource selections only if accessible, otherwise leave unset, never substitute resources. Keep original Limited deals responsive style., Update this existing block only. Move each collection’s editable “Shop all” text link to the top-right of its row heading, styled as small black underlined text. Hide the entire link when its destination or label is empty. Replace each row’s circular navigation arrows with a horizontal scrollbar below the product cards, keeping desktop scrolling and mobile swipe. Preserve all other settings, collection selections, price calculations and product buttons. Do not create another block.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-seasonal-deals-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;box-sizing:border-box;padding:32px 24px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}
.ai-seasonal-deals-{{ ai_gen_id }} *, .ai-seasonal-deals-{{ ai_gen_id }} *::before,.ai-seasonal-deals-{{ ai_gen_id }} *::after{box-sizing:border-box}.ai-seasonal-deals-{{ ai_gen_id }}__top{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;margin-bottom:24px}.ai-seasonal-deals-{{ ai_gen_id }}__title{margin:0 0 8px;font-size:clamp(24px,3vw,36px);line-height:1.15}.ai-seasonal-deals-{{ ai_gen_id }}__subtitle{margin:0;line-height:1.5}.ai-seasonal-deals-{{ ai_gen_id }}__timer{flex:0 0 auto;text-align:right}.ai-seasonal-deals-{{ ai_gen_id }}__timer-label{display:block;margin-bottom:7px;font-weight:600}.ai-seasonal-deals-{{ ai_gen_id }}__timer-digits{display:flex;justify-content:flex-end;gap:6px;color:{{ block.settings.timer_digit_color }};font-size:28px;line-height:1}.ai-seasonal-deals-{{ ai_gen_id }}__unit{display:flex;flex-direction:column;align-items:center;gap:5px}.ai-seasonal-deals-{{ ai_gen_id }}__number{min-width:48px;padding:8px;border-radius:6px;background:{{ block.settings.timer_tile_color }}}.ai-seasonal-deals-{{ ai_gen_id }}__unit-label{font-size:11px}.ai-seasonal-deals-{{ ai_gen_id }}__collection{margin-top:26px}.ai-seasonal-deals-{{ ai_gen_id }}__collection-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.ai-seasonal-deals-{{ ai_gen_id }}__collection-title{margin:0;font-size:22px;line-height:1.25}.ai-seasonal-deals-{{ ai_gen_id }}__track{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 48px)/4);gap:16px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:#111 #d9dbe2;padding:2px 1px 10px}.ai-seasonal-deals-{{ ai_gen_id }}__track::-webkit-scrollbar{height:8px}.ai-seasonal-deals-{{ ai_gen_id }}__track::-webkit-scrollbar-track{background:#d9dbe2;border-radius:8px}.ai-seasonal-deals-{{ ai_gen_id }}__track::-webkit-scrollbar-thumb{background:#111;border-radius:8px}.ai-seasonal-deals-{{ ai_gen_id }}__card{position:relative;min-width:0;background:{{ block.settings.card_color }};border-radius:10px;overflow:hidden;scroll-snap-align:start}.ai-seasonal-deals-{{ ai_gen_id }}__image-link{display:block;aspect-ratio:1;background:#eceef3}.ai-seasonal-deals-{{ ai_gen_id }}__image{display:block;width:100%;height:100%;object-fit:cover}.ai-seasonal-deals-{{ ai_gen_id }}__placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#eceef3}.ai-seasonal-deals-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;object-fit:cover}.ai-seasonal-deals-{{ ai_gen_id }}__badge{position:absolute;top:10px;left:10px;z-index:1;padding:6px 10px;border-radius:{{ block.settings.badge_radius }}px;background:{{ block.settings.badge_color }};color:{{ block.settings.badge_text_color }};font-size:12px;font-weight:700}.ai-seasonal-deals-{{ ai_gen_id }}__details{display:flex;flex-direction:column;gap:10px;padding:14px}.ai-seasonal-deals-{{ ai_gen_id }}__product-title{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;min-height:2.6em;margin:0;color:inherit;font-size:15px;line-height:1.3;text-decoration:none}.ai-seasonal-deals-{{ ai_gen_id }}__prices{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-weight:700}.ai-seasonal-deals-{{ ai_gen_id }}__original{color:#555;font-size:13px;font-weight:400}.ai-seasonal-deals-{{ ai_gen_id }}__button{display:flex;justify-content:center;align-items:center;width:100%;min-height:42px;padding:10px 14px;border:0;border-radius:{{ block.settings.product_button_radius }}px;background:{{ block.settings.product_button_color }};color:{{ block.settings.product_button_text_color }};font:inherit;font-weight:700;text-align:center;text-decoration:none;cursor:pointer}.ai-seasonal-deals-{{ ai_gen_id }}__button:focus-visible,.ai-seasonal-deals-{{ ai_gen_id }}__shop-all:focus-visible{outline:3px solid #111;outline-offset:3px}.ai-seasonal-deals-{{ ai_gen_id }}__shop-all{color:#111;text-decoration:underline;text-underline-offset:3px;font-size:14px;font-weight:500;white-space:nowrap}.ai-seasonal-deals-{{ ai_gen_id }}__shop-all:hover{color:#444}.ai-seasonal-deals-{{ ai_gen_id }}__button:hover{filter:brightness(.94)}
@media(max-width:749px){.ai-seasonal-deals-{{ ai_gen_id }}{padding:24px 16px}.ai-seasonal-deals-{{ ai_gen_id }}__top{flex-direction:column;gap:18px}.ai-seasonal-deals-{{ ai_gen_id }}__timer{text-align:left;width:100%}.ai-seasonal-deals-{{ ai_gen_id }}__timer-digits{justify-content:flex-start}.ai-seasonal-deals-{{ ai_gen_id }}__track{grid-auto-columns:calc((100% - 12px)/2);gap:12px}.ai-seasonal-deals-{{ ai_gen_id }}__details{padding:11px}.ai-seasonal-deals-{{ ai_gen_id }}__collection-title{font-size:19px}.ai-seasonal-deals-{{ ai_gen_id }}__collection-head{align-items:center}}
{% endstyle %}
<seasonal-deals-{{ ai_gen_id }} class="ai-seasonal-deals-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-seasonal-deals-{{ ai_gen_id }}__top"><div><h2 class="ai-seasonal-deals-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2><p class="ai-seasonal-deals-{{ ai_gen_id }}__subtitle">{{ block.settings.subtitle | escape }}</p></div>{% if block.settings.countdown_enabled %}<div class="ai-seasonal-deals-{{ ai_gen_id }}__timer" data-end="{{ block.settings.countdown_end | escape }}"><span class="ai-seasonal-deals-{{ ai_gen_id }}__timer-label">{{ block.settings.countdown_label | escape }}</span><div class="ai-seasonal-deals-{{ ai_gen_id }}__timer-digits"><span class="ai-seasonal-deals-{{ ai_gen_id }}__unit"><span class="ai-seasonal-deals-{{ ai_gen_id }}__number" data-days>00</span><span class="ai-seasonal-deals-{{ ai_gen_id }}__unit-label">Days</span></span><span class="ai-seasonal-deals-{{ ai_gen_id }}__unit"><span class="ai-seasonal-deals-{{ ai_gen_id }}__number" data-hours>00</span><span class="ai-seasonal-deals-{{ ai_gen_id }}__unit-label">Hours</span></span><span class="ai-seasonal-deals-{{ ai_gen_id }}__unit"><span class="ai-seasonal-deals-{{ ai_gen_id }}__number" data-minutes>00</span><span class="ai-seasonal-deals-{{ ai_gen_id }}__unit-label">Minutes</span></span><span class="ai-seasonal-deals-{{ ai_gen_id }}__unit"><span class="ai-seasonal-deals-{{ ai_gen_id }}__number" data-seconds>00</span><span class="ai-seasonal-deals-{{ ai_gen_id }}__unit-label">Seconds</span></span></div></div>{% endif %}</div>
{% for i in (1..5) %}{% liquid
assign collection_key = 'collection_' | append: i
assign title_key = 'collection_' | append: i | append: '_heading'
assign discount_key = 'collection_' | append: i | append: '_discount'
assign badge_key = 'collection_' | append: i | append: '_badge'
assign show_button_key = 'collection_' | append: i | append: '_show_button'
assign label_key = 'collection_' | append: i | append: '_button_label'
assign url_key = 'collection_' | append: i | append: '_button_url'
assign collection = block.settings[collection_key]
assign collection_heading = block.settings[title_key]
assign discount = block.settings[discount_key]
assign badge_text = block.settings[badge_key]
assign show_button = block.settings[show_button_key]
assign collection_button_label = block.settings[label_key]
assign collection_button_url = block.settings[url_key]
%}{% if collection != blank and collection.products_count > 0 %}<section class="ai-seasonal-deals-{{ ai_gen_id }}__collection" aria-label="{{ collection_heading | default: collection.title | escape }}"><div class="ai-seasonal-deals-{{ ai_gen_id }}__collection-head"><h3 class="ai-seasonal-deals-{{ ai_gen_id }}__collection-title">{{ collection_heading | default: collection.title | escape }}</h3>{% if show_button and collection_button_label != blank and collection_button_url != blank %}<a class="ai-seasonal-deals-{{ ai_gen_id }}__shop-all" href="{{ collection_button_url }}">{{ collection_button_label | escape }}</a>{% endif %}</div><div class="ai-seasonal-deals-{{ ai_gen_id }}__track" tabindex="0">{% for product in collection.products limit: 12 %}{% assign current_variant = product.selected_or_first_available_variant %}{% assign factor = 100 | minus: discount %}{% assign adjusted_price = current_variant.price | times: factor | divided_by: 100.0 | round %}<article class="ai-seasonal-deals-{{ ai_gen_id }}__card">{% if badge_text != blank %}<span class="ai-seasonal-deals-{{ ai_gen_id }}__badge">{{ badge_text | escape }}</span>{% elsif discount > 0 %}<span class="ai-seasonal-deals-{{ ai_gen_id }}__badge">{{ discount }}% OFF</span>{% endif %}<a class="ai-seasonal-deals-{{ ai_gen_id }}__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">{% if product.featured_image %}<img class="ai-seasonal-deals-{{ ai_gen_id }}__image" src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="700" height="700">{% else %}<div class="ai-seasonal-deals-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</a><div class="ai-seasonal-deals-{{ ai_gen_id }}__details"><a class="ai-seasonal-deals-{{ ai_gen_id }}__product-title" href="{{ product.url }}">{{ product.title | escape }}</a><div class="ai-seasonal-deals-{{ ai_gen_id }}__prices">{% if discount > 0 %}<span>{{ adjusted_price | money }}</span><s class="ai-seasonal-deals-{{ ai_gen_id }}__original">{{ current_variant.price | money }}</s>{% else %}<span>{{ current_variant.price | money }}</span>{% endif %}</div><a class="ai-seasonal-deals-{{ ai_gen_id }}__button" href="{{ product.url }}">{{ block.settings.product_button_label | escape }}</a></div></article>{% endfor %}</div></section>{% endif %}{% endfor %}</seasonal-deals-{{ ai_gen_id }}>
<script>(function(){const tagName='seasonal-deals-{{ ai_gen_id }}';if(customElements.get(tagName))return;class SeasonalDeals extends HTMLElement{connectedCallback(){const timer=this.querySelector('.ai-seasonal-deals-{{ ai_gen_id }}__timer');if(!timer)return;const end=new Date(timer.dataset.end).getTime();const update=()=>{let remaining=Math.max(0,Math.floor((end-Date.now())/1000));const days=Math.floor(remaining/86400);remaining%=86400;const hours=Math.floor(remaining/3600);remaining%=3600;const minutes=Math.floor(remaining/60);const seconds=remaining%60;timer.querySelector('[data-days]').textContent=String(days).padStart(2,'0');timer.querySelector('[data-hours]').textContent=String(hours).padStart(2,'0');timer.querySelector('[data-minutes]').textContent=String(minutes).padStart(2,'0');timer.querySelector('[data-seconds]').textContent=String(seconds).padStart(2,'0')};update();this.countdownInterval=window.setInterval(update,1000)}disconnectedCallback(){if(this.countdownInterval)window.clearInterval(this.countdownInterval)}}customElements.define(tagName,SeasonalDeals)})();</script>
{% schema %}{"name":"Seasonal deals carousel","settings":[{"type":"header","content":"Content"},{"type":"text","id":"heading","label":"Heading","default":"Halloween Dash Cam Flash Deals"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Limited-time dash cam deals, plus an extra $10 OFF orders $100+, $15 OFF $150+, or $20 OFF $200+."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Countdown"},{"type":"checkbox","id":"countdown_enabled","label":"Show countdown","default":true},{"type":"text","id":"countdown_label","label":"Label","default":"Ends in"},{"type":"text","id":"countdown_end","label":"End date and time","default":"2026-10-31T23:59:59+08:00"},{"type":"color","id":"timer_digit_color","label":"Digit color","default":"#111111"},{"type":"color","id":"timer_tile_color","label":"Tile color","default":"#fff001"},{"type":"header","content":"Appearance"},{"type":"color","id":"background_color","label":"Background","default":"#f8f9fd"},{"type":"color","id":"text_color","label":"Text","default":"#111111"},{"type":"color","id":"card_color","label":"Card background","default":"#ffffff"},{"type":"color","id":"badge_color","label":"Badge background","default":"#fff001"},{"type":"color","id":"badge_text_color","label":"Badge text","default":"#111111"},{"type":"range","id":"badge_radius","label":"Badge radius","min":0,"max":20,"step":1,"unit":"px","default":6},{"type":"header","content":"Product button"},{"type":"text","id":"product_button_label","label":"Label","default":"Shop now"},{"type":"color","id":"product_button_color","label":"Background","default":"#fff001"},{"type":"color","id":"product_button_text_color","label":"Text","default":"#111111"},{"type":"range","id":"product_button_radius","label":"Radius","min":0,"max":20,"step":1,"unit":"px","default":8},{"type":"header","content":"Collection button"},{"type":"color","id":"collection_button_color","label":"Background","default":"#fff001"},{"type":"color","id":"collection_button_text_color","label":"Text","default":"#111111"},{"type":"range","id":"collection_button_radius","label":"Radius","min":0,"max":20,"step":1,"unit":"px","default":8},{"type":"header","content":"Collection 1"},{"type":"collection","id":"collection_1","label":"Collection"},{"type":"text","id":"collection_1_heading","label":"Heading","default":"Featured deals"},{"type":"range","id":"collection_1_discount","label":"Discount","min":0,"max":90,"step":5,"unit":"%","default":40},{"type":"text","id":"collection_1_badge","label":"Badge text"},{"type":"checkbox","id":"collection_1_show_button","label":"Show Shop all link","default":false},{"type":"text","id":"collection_1_button_label","label":"Link label"},{"type":"url","id":"collection_1_button_url","label":"Link destination"},{"type":"header","content":"Collection 2"},{"type":"collection","id":"collection_2","label":"Collection"},{"type":"text","id":"collection_2_heading","label":"Heading","default":"More deals"},{"type":"range","id":"collection_2_discount","label":"Discount","min":0,"max":90,"step":5,"unit":"%","default":35},{"type":"text","id":"collection_2_badge","label":"Badge text"},{"type":"checkbox","id":"collection_2_show_button","label":"Show Shop all link","default":false},{"type":"text","id":"collection_2_button_label","label":"Link label"},{"type":"url","id":"collection_2_button_url","label":"Link destination"},{"type":"header","content":"Collection 3"},{"type":"collection","id":"collection_3","label":"Collection"},{"type":"text","id":"collection_3_heading","label":"Heading","default":"Collection three"},{"type":"range","id":"collection_3_discount","label":"Discount","min":0,"max":90,"step":5,"unit":"%","default":30},{"type":"text","id":"collection_3_badge","label":"Badge text"},{"type":"checkbox","id":"collection_3_show_button","label":"Show Shop all link","default":false},{"type":"text","id":"collection_3_button_label","label":"Link label"},{"type":"url","id":"collection_3_button_url","label":"Link destination"},{"type":"header","content":"Collection 4"},{"type":"collection","id":"collection_4","label":"Collection"},{"type":"text","id":"collection_4_heading","label":"Heading","default":"Collection four"},{"type":"range","id":"collection_4_discount","label":"Discount","min":0,"max":90,"step":5,"unit":"%","default":25},{"type":"text","id":"collection_4_badge","label":"Badge text"},{"type":"checkbox","id":"collection_4_show_button","label":"Show Shop all link","default":false},{"type":"text","id":"collection_4_button_label","label":"Link label"},{"type":"url","id":"collection_4_button_url","label":"Link destination"},{"type":"header","content":"Collection 5"},{"type":"collection","id":"collection_5","label":"Collection"},{"type":"text","id":"collection_5_heading","label":"Heading","default":"Collection five"},{"type":"range","id":"collection_5_discount","label":"Discount","min":0,"max":90,"step":5,"unit":"%","default":20},{"type":"text","id":"collection_5_badge","label":"Badge text"},{"type":"checkbox","id":"collection_5_show_button","label":"Show Shop all link","default":false},{"type":"text","id":"collection_5_button_label","label":"Link label"},{"type":"url","id":"collection_5_button_url","label":"Link destination"}],"presets":[{"name":"Seasonal deals carousel"}],"tag":null,"class":"seasonal-deals-carousel"}{% endschema %}