{% doc %}
  @prompt
    Built for the Way You Drive
    Daily Commuters
    
    Capture everyday journeys with front and rear coverage, GPS, and easy access to important footage.
    
    Night Drivers
    
    Sony STARVIS 2 imaging helps deliver clearer footage when driving after dark.
    
    Road Trip Drivers
    
    Record long journeys with GPS data, large storage support, and reliable front and rear coverage.
    
    Drivers Who Park Outdoors
    
    Add 24-hour parking monitoring with the optional hardwire kit for extra protection while you're away.
    
    First-Time Dash Cam Buyers
    
    Easy installation, voice control, Wi-Fi connectivity, and the GKU GO app make everyday operation simple.请对应这些文案生成一个新的section, 把标题字体改为Arial 700
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-driving-audience-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:{{ block.settings.section_padding }}px 24px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}.ai-driving-audience__inner-{{ ai_gen_id }}{max-width:1200px;margin:0 auto}.ai-driving-audience__header-{{ ai_gen_id }}{max-width:760px;margin:0 auto {{ block.settings.header_spacing }}px;text-align:{{ block.settings.alignment }}}.ai-driving-audience__title-{{ ai_gen_id }},.ai-driving-audience__card-title-{{ ai_gen_id }}{font-family:Arial,sans-serif;font-weight:700;color:{{ block.settings.heading_color }}}.ai-driving-audience__title-{{ ai_gen_id }}{margin:0 0 16px;font-size:{{ block.settings.heading_size }}px;line-height:1.1}.ai-driving-audience__intro-{{ ai_gen_id }}{margin:0;font-size:17px;line-height:1.6}.ai-driving-audience__grid-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:16px}.ai-driving-audience__card-{{ ai_gen_id }}{display:flex;flex-direction:column;min-height:250px;padding:24px 20px;background:{{ block.settings.card_color }};border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.card_radius }}px}.ai-driving-audience__number-{{ ai_gen_id }}{display:flex;align-items:center;justify-content:center;width:34px;height:34px;margin-bottom:32px;border-radius:50%;background:{{ block.settings.accent_color }};color:{{ block.settings.accent_text_color }};font-size:14px;font-weight:700}.ai-driving-audience__card-title-{{ ai_gen_id }}{margin:0 0 12px;font-size:20px;line-height:1.2}.ai-driving-audience__card-text-{{ ai_gen_id }}{margin:0;font-size:14px;line-height:1.6}@media(max-width:1100px){.ai-driving-audience__grid-{{ ai_gen_id }}{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:749px){.ai-driving-audience-{{ ai_gen_id }}{padding-right:16px;padding-left:16px}.ai-driving-audience__title-{{ ai_gen_id }}{font-size:{{ block.settings.mobile_heading_size }}px}.ai-driving-audience__grid-{{ ai_gen_id }}{grid-template-columns:1fr}.ai-driving-audience__card-{{ ai_gen_id }}{min-height:0;padding:22px}}
{% endstyle %}
<section class="ai-driving-audience-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-driving-audience__inner-{{ ai_gen_id }}"><header class="ai-driving-audience__header-{{ ai_gen_id }}"><h2 class="ai-driving-audience__title-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2><p class="ai-driving-audience__intro-{{ ai_gen_id }}">{{ block.settings.intro | escape | newline_to_br }}</p></header><div class="ai-driving-audience__grid-{{ ai_gen_id }}">{% for i in (1..5) %}{% assign title_key = 'audience_' | append: i | append: '_title' %}{% assign text_key = 'audience_' | append: i | append: '_text' %}{% assign audience_title = block.settings[title_key] %}{% assign audience_text = block.settings[text_key] %}<article class="ai-driving-audience__card-{{ ai_gen_id }}"><div class="ai-driving-audience__number-{{ ai_gen_id }}" aria-hidden="true">{{ i }}</div><h3 class="ai-driving-audience__card-title-{{ ai_gen_id }}">{{ audience_title | escape }}</h3><p class="ai-driving-audience__card-text-{{ ai_gen_id }}">{{ audience_text | escape | newline_to_br }}</p></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Driving audience","settings":[{"type":"text","id":"heading","label":"Heading","default":"Built for the Way You Drive"},{"type":"textarea","id":"intro","label":"Intro","default":"Find the right protection for your everyday drives, night journeys, road trips, and parked car."},{"type":"text","id":"audience_1_title","label":"Audience 1 title","default":"Daily Commuters"},{"type":"textarea","id":"audience_1_text","label":"Audience 1 text","default":"Capture everyday journeys with front and rear coverage, GPS, and easy access to important footage."},{"type":"text","id":"audience_2_title","label":"Audience 2 title","default":"Night Drivers"},{"type":"textarea","id":"audience_2_text","label":"Audience 2 text","default":"Sony STARVIS 2 imaging helps deliver clearer footage when driving after dark."},{"type":"text","id":"audience_3_title","label":"Audience 3 title","default":"Road Trip Drivers"},{"type":"textarea","id":"audience_3_text","label":"Audience 3 text","default":"Record long journeys with GPS data, large storage support, and reliable front and rear coverage."},{"type":"text","id":"audience_4_title","label":"Audience 4 title","default":"Drivers Who Park Outdoors"},{"type":"textarea","id":"audience_4_text","label":"Audience 4 text","default":"Add 24-hour parking monitoring with the optional hardwire kit for extra protection while you are away."},{"type":"text","id":"audience_5_title","label":"Audience 5 title","default":"First-Time Dash Cam Buyers"},{"type":"textarea","id":"audience_5_text","label":"Audience 5 text","default":"Easy installation, voice control, Wi-Fi connectivity, and the GKU GO app make everyday operation simple."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"select","id":"alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},{"type":"range","id":"section_padding","label":"Section spacing","min":24,"max":120,"step":8,"unit":"px","default":72},{"type":"range","id":"header_spacing","label":"Header spacing","min":24,"max":80,"step":8,"unit":"px","default":48},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":32,"step":2,"unit":"px","default":16},{"type":"range","id":"heading_size","label":"Heading size","min":28,"max":64,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":24,"max":48,"step":4,"unit":"px","default":32},{"type":"color","id":"background_color","label":"Background","default":"#f8f9fd"},{"type":"color","id":"card_color","label":"Cards","default":"#ffffff"},{"type":"color","id":"heading_color","label":"Headings","default":"#000000"},{"type":"color","id":"text_color","label":"Text","default":"#333333"},{"type":"color","id":"border_color","label":"Borders","default":"#dfdfdf"},{"type":"color","id":"accent_color","label":"Accent","default":"#0070ca"},{"type":"color","id":"accent_text_color","label":"Accent text","default":"#ffffff"}],"presets":[{"name":"Driving audience"}],"tag":null,"class":"driving-audience-block"}{% endschema %}