{% doc %}
  @prompt
    主推一款产品打大折扣，输入一个单独一个产品的营销block，突出折扣信息，倒计时, 改成英文
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-offer-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;color:{{ block.settings.text_color }}}.ai-offer-{{ ai_gen_id }}__inner{display:grid;grid-template-columns:1fr 1fr;overflow:hidden;background:{{ block.settings.background_color }};border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.border_radius }}px}.ai-offer-{{ ai_gen_id }}__media{position:relative;min-height:360px;background:{{ block.settings.image_background }}}.ai-offer-{{ ai_gen_id }}__media img,.ai-offer-{{ ai_gen_id }}__placeholder,.ai-offer-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}.ai-offer-{{ ai_gen_id }}__media img{display:block;object-fit:cover}.ai-offer-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center;color:{{ block.settings.muted_color }}}.ai-offer-{{ ai_gen_id }}__placeholder svg{max-width:420px;max-height:420px}.ai-offer-{{ ai_gen_id }}__badge{position:absolute;top:20px;left:20px;padding:10px 16px;color:{{ block.settings.badge_text_color }};background:{{ block.settings.badge_color }};border-radius:999px;font-size:14px;font-weight:700;letter-spacing:.04em}.ai-offer-{{ ai_gen_id }}__content{display:flex;flex-direction:column;justify-content:center;gap:20px;padding:clamp(28px,5vw,64px)}.ai-offer-{{ ai_gen_id }}__eyebrow{margin:0;color:{{ block.settings.accent_color }};font-size:14px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.ai-offer-{{ ai_gen_id }}__heading{margin:0;color:{{ block.settings.text_color }};font-size:clamp(28px,4vw,52px);line-height:1.05}.ai-offer-{{ ai_gen_id }}__description{margin:0;font-size:16px;line-height:1.6}.ai-offer-{{ ai_gen_id }}__product{margin:0;font-size:18px;font-weight:700}.ai-offer-{{ ai_gen_id }}__prices{display:flex;align-items:baseline;flex-wrap:wrap;gap:12px}.ai-offer-{{ ai_gen_id }}__price{color:{{ block.settings.accent_color }};font-size:clamp(30px,4vw,48px);font-weight:800;line-height:1}.ai-offer-{{ ai_gen_id }}__compare{color:{{ block.settings.muted_color }};font-size:18px;text-decoration:line-through}.ai-offer-{{ ai_gen_id }}__discount{padding:6px 10px;color:{{ block.settings.badge_text_color }};background:{{ block.settings.badge_color }};border-radius:6px;font-size:13px;font-weight:700}.ai-offer-{{ ai_gen_id }}__timer-label{margin:0 0 8px;font-size:13px;font-weight:700}.ai-offer-{{ ai_gen_id }}__timer{display:flex;gap:8px}.ai-offer-{{ ai_gen_id }}__time{min-width:58px;padding:10px 8px;text-align:center;background:{{ block.settings.timer_background }};border-radius:8px}.ai-offer-{{ ai_gen_id }}__number{display:block;font-size:24px;font-weight:800;line-height:1}.ai-offer-{{ ai_gen_id }}__unit{display:block;margin-top:5px;color:{{ block.settings.muted_color }};font-size:11px}.ai-offer-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;width:100%;min-height:52px;padding:14px 24px;color:{{ block.settings.button_text_color }};background:{{ block.settings.button_color }};border-radius:{{ block.settings.button_radius }}px;font-weight:700;text-decoration:none}.ai-offer-{{ ai_gen_id }}__button:hover,.ai-offer-{{ ai_gen_id }}__button:focus-visible{background:{{ block.settings.button_hover_color }}}@media(max-width:749px){.ai-offer-{{ ai_gen_id }}__inner{grid-template-columns:1fr}.ai-offer-{{ ai_gen_id }}__media{min-height:280px}.ai-offer-{{ ai_gen_id }}__content{padding:28px 22px}}
{% endstyle %}
{% assign featured_product = block.settings.product %}{% assign featured_variant = featured_product.selected_or_first_available_variant %}
<sale-offer-{{ ai_gen_id }} class="ai-offer-{{ ai_gen_id }}" data-deadline="{{ block.settings.end_time | escape }}" {{ block.shopify_attributes }}><div class="ai-offer-{{ ai_gen_id }}__inner"><div class="ai-offer-{{ ai_gen_id }}__media">{% if featured_product != blank and featured_product.featured_image %}<img src="{{ featured_product.featured_image | image_url: width: 1200 }}" alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}" loading="lazy" width="1200" height="1200">{% else %}<div class="ai-offer-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<span class="ai-offer-{{ ai_gen_id }}__badge">{{ block.settings.badge_text }}</span></div><div class="ai-offer-{{ ai_gen_id }}__content"><p class="ai-offer-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p><h2 class="ai-offer-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% if block.settings.description != blank %}<p class="ai-offer-{{ ai_gen_id }}__description">{{ block.settings.description }}</p>{% endif %}{% if featured_product != blank %}<p class="ai-offer-{{ ai_gen_id }}__product">{{ featured_product.title }}</p><div class="ai-offer-{{ ai_gen_id }}__prices"><span class="ai-offer-{{ ai_gen_id }}__price">{{ featured_variant.price | money }}</span>{% if featured_variant.compare_at_price > featured_variant.price %}<span class="ai-offer-{{ ai_gen_id }}__compare">{{ featured_variant.compare_at_price | money }}</span>{% assign saved_percent = featured_variant.compare_at_price | minus: featured_variant.price | times: 100 | divided_by: featured_variant.compare_at_price %}<span class="ai-offer-{{ ai_gen_id }}__discount">Save {{ saved_percent }}%</span>{% endif %}</div>{% endif %}<div><p class="ai-offer-{{ ai_gen_id }}__timer-label">{{ block.settings.timer_label }}</p><div class="ai-offer-{{ ai_gen_id }}__timer" role="timer" aria-live="polite"><div class="ai-offer-{{ ai_gen_id }}__time"><span class="ai-offer-{{ ai_gen_id }}__number" data-days>00</span><span class="ai-offer-{{ ai_gen_id }}__unit">Days</span></div><div class="ai-offer-{{ ai_gen_id }}__time"><span class="ai-offer-{{ ai_gen_id }}__number" data-hours>00</span><span class="ai-offer-{{ ai_gen_id }}__unit">Hours</span></div><div class="ai-offer-{{ ai_gen_id }}__time"><span class="ai-offer-{{ ai_gen_id }}__number" data-minutes>00</span><span class="ai-offer-{{ ai_gen_id }}__unit">Minutes</span></div><div class="ai-offer-{{ ai_gen_id }}__time"><span class="ai-offer-{{ ai_gen_id }}__number" data-seconds>00</span><span class="ai-offer-{{ ai_gen_id }}__unit">Seconds</span></div></div></div>{% if featured_product != blank %}<a class="ai-offer-{{ ai_gen_id }}__button" href="{{ featured_product.url }}">{{ block.settings.button_label }}</a>{% endif %}</div></div></sale-offer-{{ ai_gen_id }}>
<script>(function(){class SaleOffer{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.deadline=new Date(this.dataset.deadline.replace(' ','T')).getTime();this.interval=setInterval(()=>this.updateTimer(),1000);this.updateTimer()}disconnectedCallback(){clearInterval(this.interval)}updateTimer(){let d=this.deadline-Date.now();if(!Number.isFinite(d)||d<0)d=0;this.querySelector('[data-days]').textContent=String(Math.floor(d/86400000)).padStart(2,'0');this.querySelector('[data-hours]').textContent=String(Math.floor(d%86400000/3600000)).padStart(2,'0');this.querySelector('[data-minutes]').textContent=String(Math.floor(d%3600000/60000)).padStart(2,'0');this.querySelector('[data-seconds]').textContent=String(Math.floor(d%60000/1000)).padStart(2,'0')}}customElements.define('sale-offer-{{ ai_gen_id }}',SaleOffer{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Limited-time offer","tag":null,"class":"sale-offer-block","settings":[{"type":"product","id":"product","label":"Featured product"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Content"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Limited-time offer"},{"type":"text","id":"heading","label":"Heading","default":"Big savings on our featured product"},{"type":"textarea","id":"description","label":"Description","default":"Enjoy an exclusive limited-time price before this offer ends."},{"type":"text","id":"badge_text","label":"Badge text","default":"Limited offer"},{"type":"text","id":"timer_label","label":"Timer label","default":"Offer ends in"},{"type":"text","id":"end_time","label":"End time","default":"2026-12-31 23:59:59"},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"header","content":"Style"},{"type":"color","id":"background_color","label":"Background","default":"#F8F9FD"},{"type":"color","id":"image_background","label":"Image background","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#111111"},{"type":"color","id":"muted_color","label":"Muted text","default":"#535F11"},{"type":"color","id":"accent_color","label":"Accent","default":"#0070CA"},{"type":"color","id":"badge_color","label":"Badge background","default":"#FFF001"},{"type":"color","id":"badge_text_color","label":"Badge text","default":"#111111"},{"type":"color","id":"timer_background","label":"Timer background","default":"#FFFFFF"},{"type":"color","id":"border_color","label":"Border","default":"#DFDFDF"},{"type":"color","id":"button_color","label":"Button background","default":"#FFF001"},{"type":"color","id":"button_hover_color","label":"Button hover background","default":"#F2C615"},{"type":"color","id":"button_text_color","label":"Button text","default":"#111111"},{"type":"range","id":"border_radius","label":"Card radius","min":0,"max":32,"step":1,"unit":"px","default":16},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":32,"step":1,"unit":"px","default":16}],"presets":[{"name":"Limited-time offer"}]}{% endschema %}