{% doc %}
  @prompt
    加一个文案section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-copy-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.text_alignment }};
    box-sizing: border-box;
  }
  .ai-copy-section-{{ ai_gen_id }}__inner { max-width: {{ block.settings.content_width }}px; margin: 0 auto; }
  .ai-copy-section-{{ ai_gen_id }}__eyebrow { margin: 0 0 12px; color: {{ block.settings.accent_color }}; font-size: 12px; font-weight: 600; letter-spacing: .12em; line-height: 1.4; text-transform: uppercase; }
  .ai-copy-section-{{ ai_gen_id }}__heading { margin: 0 0 16px; color: {{ block.settings.heading_color }}; font-family: inherit; font-size: {{ block.settings.heading_size }}px; font-weight: 600; line-height: 1.15; }
  .ai-copy-section-{{ ai_gen_id }}__body { color: {{ block.settings.text_color }}; font-size: {{ block.settings.body_size }}px; line-height: 1.6; }
  .ai-copy-section-{{ ai_gen_id }}__body p { margin: 0 0 12px; }
  .ai-copy-section-{{ ai_gen_id }}__body p:last-child { margin-bottom: 0; }
  @media screen and (max-width: 749px) {
    .ai-copy-section-{{ ai_gen_id }} { width: 100%; padding: {{ block.settings.mobile_padding_vertical }}px {{ block.settings.mobile_padding_horizontal }}px; }
    .ai-copy-section-{{ ai_gen_id }}__heading { font-size: {{ block.settings.heading_size | times: 0.75 | round }}px; }
  }
{% endstyle %}

<div class="ai-copy-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-copy-section-{{ ai_gen_id }}__inner">
    {% if block.settings.eyebrow != blank %}<p class="ai-copy-section-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
    {% if block.settings.heading != blank %}<h2 class="ai-copy-section-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    {% if block.settings.body != blank %}<div class="ai-copy-section-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "文案区块",
  "settings": [
    { "type": "header", "content": "内容" },
    { "type": "text", "id": "eyebrow", "label": "眉标题", "default": "GKU COMMUNITY" },
    { "type": "text", "id": "heading", "label": "标题", "default": "分享你的故事" },
    { "type": "richtext", "id": "body", "label": "正文", "default": "<p>欢迎来到 GKU 社区，分享你的想法、作品与灵感。</p>" },
    { "type": "header", "content": "布局" },
    { "type": "range", "id": "desktop_width_percent", "label": "桌面宽度", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "content_width", "label": "内容最大宽度", "min": 400, "max": 1200, "step": 50, "unit": "px", "default": 800 },
    { "type": "select", "id": "text_alignment", "label": "文字对齐", "options": [{ "value": "left", "label": "左对齐" }, { "value": "center", "label": "居中" }, { "value": "right", "label": "右对齐" }], "default": "center" },
    { "type": "range", "id": "padding_vertical", "label": "桌面上下间距", "min": 0, "max": 120, "step": 10, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_horizontal", "label": "桌面左右间距", "min": 0, "max": 80, "step": 10, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_padding_vertical", "label": "移动端上下间距", "min": 0, "max": 80, "step": 10, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_padding_horizontal", "label": "移动端左右间距", "min": 0, "max": 40, "step": 5, "unit": "px", "default": 20 },
    { "type": "header", "content": "样式" },
    { "type": "range", "id": "heading_size", "label": "标题字号", "min": 20, "max": 72, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "body_size", "label": "正文字号", "min": 12, "max": 24, "step": 2, "unit": "px", "default": 16 },
    { "type": "color", "id": "background_color", "label": "背景", "default": "#F8F9FD" },
    { "type": "color", "id": "heading_color", "label": "标题颜色", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "正文颜色", "default": "#333333" },
    { "type": "color", "id": "accent_color", "label": "强调色", "default": "#0070CA" }
  ],
  "presets": [{ "name": "文案区块" }],
  "tag": null,
  "class": "copy-section-block"
}
{% endschema %}