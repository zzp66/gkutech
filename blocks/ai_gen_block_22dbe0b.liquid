{% doc %}
  @prompt
    想有一个表格section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-table-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_body_font.family }}, sans-serif;
  }

  .ai-table-{{ ai_gen_id }}__heading {
    margin: 0 0 18px;
    color: {{ block.settings.heading_color }};
    font-family: {{ settings.type_heading_font.family }}, sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-table-{{ ai_gen_id }}__description {
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.6;
  }

  .ai-table-{{ ai_gen_id }}__scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-table-{{ ai_gen_id }}__table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    background: {{ block.settings.background_color }};
  }

  .ai-table-{{ ai_gen_id }}__table th,
  .ai-table-{{ ai_gen_id }}__table td {
    padding: 14px 16px;
    border-right: 1px solid {{ block.settings.border_color }};
    border-bottom: 1px solid {{ block.settings.border_color }};
    text-align: {{ block.settings.text_alignment }};
    vertical-align: middle;
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-table-{{ ai_gen_id }}__table th:last-child,
  .ai-table-{{ ai_gen_id }}__table td:last-child {
    border-right: 0;
  }

  .ai-table-{{ ai_gen_id }}__table tr:last-child td {
    border-bottom: 0;
  }

  .ai-table-{{ ai_gen_id }}__table th {
    background: {{ block.settings.header_background_color }};
    color: {{ block.settings.header_text_color }};
    font-weight: 600;
  }

  .ai-table-{{ ai_gen_id }}__table tbody tr:nth-child(even) td {
    background: {{ block.settings.alternate_row_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-table-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-table-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-table-{{ ai_gen_id }}__table th,
    .ai-table-{{ ai_gen_id }}__table td {
      padding: 12px;
    }
  }
{% endstyle %}

<div class="ai-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-table-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  {% if block.settings.description != blank %}
    <div class="ai-table-{{ ai_gen_id }}__description">{{ block.settings.description | escape | newline_to_br }}</div>
  {% endif %}

  {% assign table_headers = block.settings.headers | split: ',' %}
  {% assign table_rows = block.settings.rows | newline_to_br | split: '<br />' %}
  <div class="ai-table-{{ ai_gen_id }}__scroll">
    <table class="ai-table-{{ ai_gen_id }}__table">
      <thead>
        <tr>
          {% for header in table_headers limit: 6 %}
            <th scope="col">{{ header | strip | escape }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in table_rows limit: 20 %}
          {% assign cells = row | strip | split: ',' %}
          {% if row != blank %}
            <tr>
              {% for cell in cells limit: 6 %}
                <td>{{ cell | strip | escape }}</td>
              {% endfor %}
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "信息表格",
  "settings": [
    {
      "type": "header",
      "content": "内容"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "配送信息"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "说明",
      "default": "查看不同地区的配送时效和费用。"
    },
    {
      "type": "textarea",
      "id": "headers",
      "label": "表头",
      "default": "地区,配送方式,预计时效,费用"
    },
    {
      "type": "textarea",
      "id": "rows",
      "label": "表格内容",
      "default": "香港,标准配送,1-3 个工作日,免运费\n中国大陆,标准配送,3-7 个工作日,按结账页显示\n其他地区,国际配送,5-12 个工作日,按结账页显示"
    },
    {
      "type": "header",
      "content": "布局"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "桌面宽度",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "文字对齐",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题大小",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "圆角",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_background_color",
      "label": "表头背景",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "表头文字",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "alternate_row_color",
      "label": "交替行背景",
      "default": "#f5f5f7"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "边框",
      "default": "#dfdfdf"
    }
  ],
  "presets": [
    {
      "name": "信息表格"
    }
  ],
  "tag": null,
  "class": "information-table-block"
}
{% endschema %}