{% doc %}
  @prompt
    加一个标题文案和跳转按钮
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cta-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    text-align: {{ block.settings.alignment }};
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.border_radius }}px;
    box-sizing: border-box;
  }

  .ai-cta-{{ ai_gen_id }}__title {
    margin: 0 0 20px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_heading_font.family }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.2;
    font-weight: 600;
  }

  .ai-cta-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 24px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_radius }}px;
    font-family: {{ settings.type_body_font.family }};
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .ai-cta-{{ ai_gen_id }}__button:hover {
    opacity: 0.82;
  }

  .ai-cta-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-cta-{{ ai_gen_id }} {
      width: 100%;
      padding: 28px 20px;
    }

    .ai-cta-{{ ai_gen_id }}__title {
      font-size: {{ block.settings.mobile_title_size }}px;
    }
  }
{% endstyle %}

<div class="ai-cta-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-cta-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h2>
  {% endif %}
  {% if block.settings.button_label != blank %}
    <a class="ai-cta-{{ ai_gen_id }}__button" href="{{ block.settings.button_link | default: '#' }}">
      {{ block.settings.button_label | escape }}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "标题和跳转按钮",
  "settings": [
    {
      "type": "header",
      "content": "内容"
    },
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "加入我们的联盟计划"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文字",
      "default": "立即了解"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "header",
      "content": "布局"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "桌面宽度",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "对齐方式",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "标题字号",
      "min": 18,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "手机标题字号",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "上下内边距",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "左右内边距",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "容器圆角",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景",
      "default": "#f8f9fd"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "按钮背景",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "按钮文字",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "按钮边框",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "focus_color",
      "label": "焦点提示",
      "default": "#0070ca"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "按钮边框宽度",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "按钮圆角",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "标题和跳转按钮"
    }
  ],
  "tag": null,
  "class": "title-button-block"
}
{% endschema %}