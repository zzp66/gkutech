{% doc %}
  @prompt
    为当前黑五合集页面创建一个独立的横向秒杀倒计时模块，不修改或删除现有板块。左侧为可编辑标题，默认 FLASH SALE，可选副标题；右侧为天、时、分、秒倒计时数字，数字等宽，秒数实时更新，保持右对齐。整体紧凑，默认黑色背景、白色文案、红色数字，沿用主题字体。手机端也保持左侧文案、右侧数字的横向排列，缩小字号及间距以避免溢出。提供标题、副标题、时间单位标签、结束日期时间与时区、背景色、文字色、数字颜色及背景色、字体大小、宽度、圆角和上下间距等可编辑设置。未配置截止时间时仅在编辑器提示设置，不向顾客显示虚假倒计时。到期后停止在零，支持显示可编辑结束文案或隐藏，不自动循环重置。兼容编辑器重新加载，多个实例互不干扰。, 数字更大一些
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-flash-countdown-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: {{ block.settings.vertical_spacing }}px auto;
    padding: 12px 18px;
    box-sizing: border-box;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  }
  .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__row { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; }
  .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__copy { min-width: 0; }
  .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__title { margin: 0; color: inherit; font-size: {{ block.settings.title_size }}px; line-height: 1.15; font-weight: 700; }
  .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__subtitle { margin: 4px 0 0; color: inherit; font-size: 13px; line-height: 1.3; }
  .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__timer { display: flex; align-items: center; justify-content: flex-end; gap: 8px; flex: 0 0 auto; text-align: center; }
  .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__unit { min-width: 48px; }
  .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__number { display: block; color: {{ block.settings.digit_color }}; background: {{ block.settings.digit_background }}; border-radius: 4px; padding: 5px 6px; font-size: {{ block.settings.digit_size }}px; line-height: 1; font-variant-numeric: tabular-nums; font-feature-settings: 'tnum'; font-weight: 700; }
  .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__label { display: block; margin-top: 4px; color: inherit; font-size: 10px; line-height: 1.1; }
  .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__ended { margin: 0; color: inherit; font-weight: 600; }
  @media screen and (max-width: 749px) {
    .ai-flash-countdown-{{ ai_gen_id }} { padding: 10px 12px; }
    .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__row { gap: 8px; }
    .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__title { font-size: {{ block.settings.title_size | at_most: 20 }}px; }
    .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__subtitle { font-size: 11px; }
    .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__timer { gap: 4px; }
    .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__unit { min-width: 36px; }
    .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__number { padding: 4px 3px; font-size: {{ block.settings.digit_size | at_most: 24 }}px; }
    .ai-flash-countdown-{{ ai_gen_id }} .ai-flash-countdown__label { font-size: 8px; }
  }
{% endstyle %}

<flash-countdown-{{ ai_gen_id }} class="ai-flash-countdown-{{ ai_gen_id }}" data-deadline="{{ block.settings.deadline | escape }}" data-timezone="{{ block.settings.timezone | escape }}" data-ended="{{ block.settings.ended_behavior }}" {{ block.shopify_attributes }}>
  <div class="ai-flash-countdown__row">
    <div class="ai-flash-countdown__copy">
      {% if block.settings.heading != blank %}<h2 class="ai-flash-countdown__title">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.subtitle != blank %}<p class="ai-flash-countdown__subtitle">{{ block.settings.subtitle | escape }}</p>{% endif %}
      {% if request.design_mode and block.settings.deadline == blank %}<p class="ai-flash-countdown__subtitle">Set an end date and time to enable the countdown.</p>{% endif %}
    </div>
    {% if block.settings.deadline != blank %}
      <div class="ai-flash-countdown__timer" aria-label="Countdown" aria-live="off">
        <div class="ai-flash-countdown__unit"><span class="ai-flash-countdown__number" data-days>00</span><span class="ai-flash-countdown__label">{{ block.settings.days_label | escape }}</span></div>
        <div class="ai-flash-countdown__unit"><span class="ai-flash-countdown__number" data-hours>00</span><span class="ai-flash-countdown__label">{{ block.settings.hours_label | escape }}</span></div>
        <div class="ai-flash-countdown__unit"><span class="ai-flash-countdown__number" data-minutes>00</span><span class="ai-flash-countdown__label">{{ block.settings.minutes_label | escape }}</span></div>
        <div class="ai-flash-countdown__unit"><span class="ai-flash-countdown__number" data-seconds>00</span><span class="ai-flash-countdown__label">{{ block.settings.seconds_label | escape }}</span></div>
      </div>
      {% if block.settings.ended_behavior == 'message' %}<p class="ai-flash-countdown__ended" data-ended-message hidden>{{ block.settings.ended_message | escape }}</p>{% endif %}
    {% endif %}
  </div>
</flash-countdown-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'flash-countdown-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class FlashCountdown extends HTMLElement {
      connectedCallback() {
        this.timer = this.querySelector('.ai-flash-countdown__timer');
        if (!this.timer || !this.dataset.deadline) return;
        const rawDeadline = this.dataset.deadline.trim();
        const zone = this.dataset.timezone || 'UTC';
        let target;
        if (/Z$|[+-]\d{2}:?\d{2}$/.test(rawDeadline)) target = Date.parse(rawDeadline);
        else {
          const normalized = rawDeadline.replace(' ', 'T');
          try {
            const desired = Date.UTC(Number(normalized.slice(0, 4)), Number(normalized.slice(5, 7)) - 1, Number(normalized.slice(8, 10)), Number(normalized.slice(11, 13)), Number(normalized.slice(14, 16)));
            let guess = desired;
            for (let i = 0; i < 2; i += 1) {
              const formatted = new Intl.DateTimeFormat('en-US', { timeZone: zone, year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }).formatToParts(new Date(guess));
              const v = {};
              formatted.forEach((part) => { v[part.type] = part.value; });
              guess += desired - Date.UTC(Number(v.year), Number(v.month) - 1, Number(v.day), Number(v.hour), Number(v.minute), Number(v.second));
            }
            target = guess;
          } catch (error) { target = Date.parse(rawDeadline); }
        }
        if (!Number.isFinite(target)) return;
        const update = () => {
          const remaining = Math.max(0, target - Date.now());
          const totalSeconds = Math.floor(remaining / 1000);
          this.querySelector('[data-days]').textContent = String(Math.floor(totalSeconds / 86400)).padStart(2, '0');
          this.querySelector('[data-hours]').textContent = String(Math.floor((totalSeconds % 86400) / 3600)).padStart(2, '0');
          this.querySelector('[data-minutes]').textContent = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
          this.querySelector('[data-seconds]').textContent = String(totalSeconds % 60).padStart(2, '0');
          if (remaining <= 0) {
            window.clearInterval(this.intervalId);
            if (this.dataset.ended === 'message') {
              this.timer.hidden = true;
              const message = this.querySelector('[data-ended-message]');
              if (message) message.hidden = false;
            } else this.hidden = true;
          }
        };
        update();
        if (target > Date.now()) this.intervalId = window.setInterval(update, 1000);
      }
      disconnectedCallback() { window.clearInterval(this.intervalId); }
    }
    customElements.define(tagName, FlashCountdown);
  })();
</script>

{% schema %}
{
  "name": "Flash sale countdown",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FLASH SALE" },
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "deadline", "label": "End date and time", "info": "Use YYYY-MM-DD HH:MM, for example 2026-11-30 23:59. Leave blank to show no customer countdown." },
    { "type": "text", "id": "timezone", "label": "Time zone", "default": "Asia/Shanghai", "info": "Use an IANA time zone, such as Asia/Shanghai or America/New_York." },
    { "type": "header", "content": "Time labels" },
    { "type": "text", "id": "days_label", "label": "Days", "default": "DAYS" },
    { "type": "text", "id": "hours_label", "label": "Hours", "default": "HRS" },
    { "type": "text", "id": "minutes_label", "label": "Minutes", "default": "MIN" },
    { "type": "text", "id": "seconds_label", "label": "Seconds", "default": "SEC" },
    { "type": "header", "content": "After countdown" },
    { "type": "select", "id": "ended_behavior", "label": "When time is up", "options": [{ "value": "message", "label": "Show end message" }, { "value": "hide", "label": "Hide block" }], "default": "message" },
    { "type": "text", "id": "ended_message", "label": "End message", "default": "This sale has ended." },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "digit_color", "label": "Digit text", "default": "#FFFFFF" },
    { "type": "color", "id": "digit_background", "label": "Digit background", "default": "#D71920" },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 14, "max": 36, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "digit_size", "label": "Digit size", "min": 14, "max": 36, "step": 1, "unit": "px", "default": 28 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 6 },
    { "type": "range", "id": "vertical_spacing", "label": "Vertical spacing", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Flash sale countdown" }],
  "tag": null,
  "class": "flash-sale-countdown-block"
}
{% endschema %}