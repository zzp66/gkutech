
{%- doc -%}
  This block is used to display the add to cart button.
  Intended for product-form.liquid block.

  @param {string} can_add_to_cart - Whether the product can be added to the cart
  @param {string} add_to_cart_text - The text of the add to cart button
{%- enddoc -%}

{% liquid
  assign scoped_class = block.settings.style_class | append: '--' | append: block.id
  assign class = 'add-to-cart-button ' | append: block.settings.style_class | append: ' ' | append: scoped_class
  assign id = 'BuyButtons-ProductSubmitButton-' | append: block.id
  assign use_xtu_atc = false
  if block.settings.style_class == 'button'
    assign use_xtu_atc = true
  endif
%}
{% render 'button-custom-styles', block_settings: block.settings, block_id: block.id %}
{% render 'add-to-cart-button-styles' %}
{% render 'fly-to-cart-styles' %}

<span
  {{ block.shopify_attributes }}
  style="
    --add-to-cart-font-case: {{ settings.button_text_case }};
    {% if use_xtu_atc %}
      --xtu-atc-bg: {{ block.settings.atc_bg | default: settings.xtu_atc_bg | default: '#1590F2' }};
      --xtu-atc-color: {{ block.settings.atc_color | default: settings.xtu_atc_color | default: '#FFFFFF' }};
      --xtu-atc-bg-hover: {{ block.settings.atc_bg_hover | default: settings.xtu_atc_bg_hover | default: '#0070CA' }};
      --xtu-atc-color-hover: {{ block.settings.atc_color_hover | default: settings.xtu_atc_color_hover | default: '#FFFFFF' }};
      --xtu-atc-bg-disabled: {{ block.settings.atc_bg_disabled | default: settings.xtu_atc_bg_disabled | default: '#E8E8ED' }};
      --xtu-atc-color-disabled: {{ block.settings.atc_color_disabled | default: settings.xtu_atc_color_disabled | default: '#8E8E93' }};
    {% endif %}
  "
>
  {% render 'add-to-cart-button',
    id: id,
    class: class,
    can_add_to_cart: can_add_to_cart,
    product: closest.product,
    add_to_cart_text: add_to_cart_text,
    data_testid: 'standalone-add-to-cart'
  %}
</span>

{% schema %}
{
  "name": "t:names.add_to_cart",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "button-custom",
          "label": "t:options.custom"
        }
      ],
      "default": "button-secondary",
      "info": "t:info.edit_button_style_in_theme_settings"
    },
    {
      "type": "header",
      "content": "加购按钮颜色",
      "visible_if": "{{ block.settings.style_class == 'button' }}"
    },
    {
      "type": "paragraph",
      "content": "覆盖主题 / Product Information 的加购色。默认与主题「XTU 通用颜色 → 加购按钮」一致。",
      "visible_if": "{{ block.settings.style_class == 'button' }}"
    },
    {
      "type": "color",
      "id": "atc_bg",
      "label": "背景色",
      "default": "#1590F2",
      "visible_if": "{{ block.settings.style_class == 'button' }}"
    },
    {
      "type": "color",
      "id": "atc_color",
      "label": "文字色",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.style_class == 'button' }}"
    },
    {
      "type": "color",
      "id": "atc_bg_hover",
      "label": "Hover 背景色",
      "default": "#0070CA",
      "visible_if": "{{ block.settings.style_class == 'button' }}"
    },
    {
      "type": "color",
      "id": "atc_color_hover",
      "label": "Hover 文字色",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.style_class == 'button' }}"
    },
    {
      "type": "color",
      "id": "atc_bg_disabled",
      "label": "不可用背景色",
      "default": "#E8E8ED",
      "visible_if": "{{ block.settings.style_class == 'button' }}"
    },
    {
      "type": "color",
      "id": "atc_color_disabled",
      "label": "不可用文字色",
      "default": "#8E8E93",
      "visible_if": "{{ block.settings.style_class == 'button' }}"
    },
    {
      "type": "header",
      "content": "t:content.button_colors",
      "visible_if": "{{ block.settings.style_class == \"button-custom\" }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    }
  ]
}
{% endschema %}
