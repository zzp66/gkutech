{% doc %}
  @prompt
    媒体logo滚动展示模块，点击图片可跳转链接
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-logo-marquee-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;overflow:hidden;background:{{ block.settings.background_color }};padding:{{ block.settings.vertical_padding }}px 0}.ai-logo-marquee__viewport-{{ ai_gen_id }}{overflow:hidden;width:100%}.ai-logo-marquee__track-{{ ai_gen_id }},.ai-logo-marquee__group-{{ ai_gen_id }}{display:flex;align-items:center;gap:{{ block.settings.logo_gap }}px}.ai-logo-marquee__track-{{ ai_gen_id }}{width:max-content;animation:ai-logo-marquee-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite}.ai-logo-marquee__group-{{ ai_gen_id }}{flex-shrink:0}.ai-logo-marquee__item-{{ ai_gen_id }}{display:flex;width:{{ block.settings.logo_width }}px;height:{{ block.settings.logo_height }}px;align-items:center;justify-content:center;flex-shrink:0}.ai-logo-marquee__item-{{ ai_gen_id }} img{width:100%;height:100%;object-fit:contain;filter:grayscale({{ block.settings.grayscale }}%);opacity:{{ block.settings.logo_opacity | divided_by:100.0 }}}@keyframes ai-logo-marquee-{{ ai_gen_id }}{to{transform:translateX(calc(-50% - {{ block.settings.logo_gap | divided_by:2 }}px))}}@media(prefers-reduced-motion:reduce){.ai-logo-marquee__track-{{ ai_gen_id }}{animation-play-state:paused}}@media(max-width:749px){.ai-logo-marquee__item-{{ ai_gen_id }}{width:{{ block.settings.mobile_logo_width }}px;height:{{ block.settings.mobile_logo_height }}px}.ai-logo-marquee__track-{{ ai_gen_id }},.ai-logo-marquee__group-{{ ai_gen_id }}{gap:{{ block.settings.mobile_logo_gap }}px}}{% endstyle %}
<div class="ai-logo-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-logo-marquee__viewport-{{ ai_gen_id }}"><div class="ai-logo-marquee__track-{{ ai_gen_id }}">{% for group in (1..2) %}<div class="ai-logo-marquee__group-{{ ai_gen_id }}" aria-hidden="{% if group == 1 %}false{% else %}true{% endif %}">{% for i in (1..8) %}{% liquid
assign image_key = 'logo_' | append: i
assign link_key = 'logo_' | append: i | append: '_link'
assign logo_image = block.settings[image_key]
assign logo_link = block.settings[link_key]
%}{% if logo_image != blank %}{% if logo_link != blank %}<a href="{{ logo_link }}" class="ai-logo-marquee__item-{{ ai_gen_id }}" aria-label="{{ logo_image.alt | default: '品牌标志' | escape }}">{% else %}<div class="ai-logo-marquee__item-{{ ai_gen_id }}">{% endif %}<img src="{{ logo_image | image_url: width: 500 }}" alt="{{ logo_image.alt | escape }}" loading="lazy">{% if logo_link != blank %}</a>{% else %}</div>{% endif %}{% endif %}{% endfor %}</div>{% endfor %}</div></div></div>
{% schema %}{"name":"媒体 logo 滚动","settings":[{"type":"range","id":"desktop_width_percent","label":"桌面宽度","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"logo_width","label":"Logo 宽度","min":60,"max":240,"step":10,"unit":"px","default":140},{"type":"range","id":"logo_height","label":"Logo 高度","min":30,"max":100,"step":5,"unit":"px","default":60},{"type":"range","id":"logo_gap","label":"Logo 间距","min":10,"max":100,"step":5,"unit":"px","default":40},{"type":"range","id":"vertical_padding","label":"上下内边距","min":0,"max":80,"step":5,"unit":"px","default":25},{"type":"range","id":"scroll_speed","label":"滚动时长","min":10,"max":80,"step":5,"unit":"s","default":35},{"type":"range","id":"mobile_logo_width","label":"移动 Logo 宽度","min":50,"max":160,"step":10,"unit":"px","default":100},{"type":"range","id":"mobile_logo_height","label":"移动 Logo 高度","min":25,"max":80,"step":5,"unit":"px","default":45},{"type":"range","id":"mobile_logo_gap","label":"移动 Logo 间距","min":10,"max":60,"step":5,"unit":"px","default":25},{"type":"color","id":"background_color","label":"背景","default":"#ffffff"},{"type":"range","id":"grayscale","label":"灰度","min":0,"max":100,"step":10,"unit":"%","default":100},{"type":"range","id":"logo_opacity","label":"Logo 透明度","min":40,"max":100,"step":5,"unit":"%","default":85},{"type":"image_picker","id":"logo_1","label":"Logo 1"},{"type":"url","id":"logo_1_link","label":"Logo 1 链接"},{"type":"image_picker","id":"logo_2","label":"Logo 2"},{"type":"url","id":"logo_2_link","label":"Logo 2 链接"},{"type":"image_picker","id":"logo_3","label":"Logo 3"},{"type":"url","id":"logo_3_link","label":"Logo 3 链接"},{"type":"image_picker","id":"logo_4","label":"Logo 4"},{"type":"url","id":"logo_4_link","label":"Logo 4 链接"},{"type":"image_picker","id":"logo_5","label":"Logo 5"},{"type":"url","id":"logo_5_link","label":"Logo 5 链接"},{"type":"image_picker","id":"logo_6","label":"Logo 6"},{"type":"url","id":"logo_6_link","label":"Logo 6 链接"},{"type":"image_picker","id":"logo_7","label":"Logo 7"},{"type":"url","id":"logo_7_link","label":"Logo 7 链接"},{"type":"image_picker","id":"logo_8","label":"Logo 8"},{"type":"url","id":"logo_8_link","label":"Logo 8 链接"}],"presets":[{"name":"媒体 logo 滚动"}],"tag":null,"class":"media-logo-marquee"}{% endschema %}