{% doc %}
  @prompt
    请帮我生成一些可以跳转链接的标签帮助客户快速按照产品功能去下单购买产品
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-function-tags-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 0;
  }

  .ai-function-tags__heading-{{ ai_gen_id }} {
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.25;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-function-tags__list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ block.settings.text_alignment }};
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-function-tags__item-{{ ai_gen_id }} {
    margin: 0;
    padding: 0;
  }

  .ai-function-tags__link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 10px 16px;
    border: 1px solid {{ block.settings.tag_border_color }};
    border-radius: {{ block.settings.tag_radius }}px;
    background: {{ block.settings.tag_background_color }};
    color: {{ block.settings.tag_text_color }};
    font-family: {{ block.settings.body_font.family }};
    font-size: {{ block.settings.tag_font_size }}px;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .ai-function-tags__link-{{ ai_gen_id }}:hover,
  .ai-function-tags__link-{{ ai_gen_id }}:focus-visible {
    border-color: {{ block.settings.tag_hover_background_color }};
    background: {{ block.settings.tag_hover_background_color }};
    color: {{ block.settings.tag_hover_text_color }};
  }

  .ai-function-tags__link-{{ ai_gen_id }}:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  .ai-function-tags__arrow-{{ ai_gen_id }} {
    font-size: 16px;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-function-tags-{{ ai_gen_id }} {
      width: 100%;
      padding-right: 16px;
      padding-left: 16px;
    }

    .ai-function-tags__list-{{ ai_gen_id }} {
      justify-content: flex-start;
    }
  }
{% endstyle %}

<div class="ai-function-tags-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-function-tags__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  <ul class="ai-function-tags__list-{{ ai_gen_id }}" aria-label="{{ block.settings.aria_label | escape }}">
    {% for i in (1..8) %}
      {% liquid
        assign label_key = 'tag_' | append: i | append: '_label'
        assign link_key = 'tag_' | append: i | append: '_link'
        assign label = block.settings[label_key]
        assign link = block.settings[link_key]
      %}
      {% if label != blank and link != blank %}
        <li class="ai-function-tags__item-{{ ai_gen_id }}">
          <a class="ai-function-tags__link-{{ ai_gen_id }}" href="{{ link }}">
            <span>{{ label | escape }}</span>
            <span class="ai-function-tags__arrow-{{ ai_gen_id }}" aria-hidden="true">→</span>
          </a>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>

