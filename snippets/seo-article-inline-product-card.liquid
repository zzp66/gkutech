{% comment %}Inline product card used by SEO article content placeholders. Buy Now is configured by the section.{% endcomment %}
{%- liquid
  assign can_render_product_card = false

  if product != blank
    if product.published_at != blank
      assign product_published_at = product.published_at | date: '%s' | plus: 0
      assign current_timestamp = 'now' | date: '%s' | plus: 0

      if product_published_at <= current_timestamp
        assign can_render_product_card = true
      endif
    endif
  endif
-%}

{% if index == 1 %}
{% style %}
  /* --- CSS变量：主题色配置 --- */
  .pc-wrapper {
    --pc-badge-featured-bg: var(--color-error);
    --pc-badge-soldout-bg: var(--seo-article-accent);
  }

  /* --- 容器：更具现代感的卡片风格 --- */
  .pc-wrapper {
    display: flex;
    flex-direction: column;
    background-color: var(--seo-article-surface);
    border: 1px solid var(--seo-article-border); /* 更浅的灰色边框 */
    box-sizing: border-box;
    border-radius: 16px; /* 更圆润的角 */
    box-shadow: 0 4px 6px -1px var(--seo-article-accent-soft), 0 2px 4px -1px var(--seo-article-accent-soft); /* 极简阴影 */
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none !important;
    color: inherit;
    margin: 28px auto; /* 居中且保留正文上下间距 */
    position: relative;
    width: 100%;
    max-width: 820px;
    font-family: inherit; /* 继承网站字体 */
  }

  .pc-wrapper:hover {
    box-shadow: 0 20px 25px -5px var(--seo-article-accent-soft), 0 10px 10px -5px var(--seo-article-accent-soft);
    transform: translateY(-4px); /* 悬浮上浮效果 */
    border-color: var(--seo-article-border);
  }

  .pc-wrapper a {
    text-decoration: none !important;
    border-bottom: none !important;
    box-shadow: none !important;
    background: unset !important;
    color: inherit !important;
  }

  /* --- 桌面端布局：强制横向，节省垂直空间 --- */
  @media (min-width: 640px) {
    .pc-wrapper {
      flex-direction: row;
      height: auto; /* Size the card from its content. */
      align-items: flex-start;
    }
  }

  /* --- 图片区域 --- */
  .pc-img-container {
    position: relative;
    width: 100%;
    height: auto;
    min-height: 0;
    padding: 0;
    flex-shrink: 0;
    align-self: flex-start;
    background: var(--seo-article-surface);
  }

  @media (min-width: 640px) {
    .pc-img-container { width: 180px; }
  }

  .pc-img {
    display: block;
    width: 100%;
    height: auto !important;
    object-fit: contain;
    margin: 0 !important;
  }

  .pc-wrapper:hover .pc-img { transform: none; }

  .pc-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 10px;
    border-radius: 9999px; /* 胶囊圆角 */
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    z-index: 10;
    color: var(--seo-article-surface) !important;
    box-shadow: 0 2px 4px var(--seo-article-accent-soft);
    letter-spacing: 0.5px;
    line-height: 1;
    backdrop-filter: blur(4px); /* 毛玻璃微效 */
  }

  .pc-badge-featured { background-color: var(--pc-badge-featured-bg); }
  .pc-badge-soldout { background-color: var(--pc-badge-soldout-bg); }

  /* --- 内容区域 --- */
  .pc-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    min-width: 0; /* 防止Flex子项溢出 */
  }

  /* --- 标题 --- */
  .pc-title {
    font-size: 18px; /* 稍微调小一点显得更精致 */
    font-weight: 700;
    color: var(--seo-article-accent) !important;
    margin: 0 0 8px 0;
    line-height: 1.4;
    
    /* 限制2行 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pc-title a:hover {
    color: var(--seo-article-muted) !important; /* 标题悬停变色 */
  }

  /* --- 标签 --- */
  .pc-features {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
  }

  .pc-feature-tag {
    font-size: 11px;
    color: var(--seo-article-muted);
    background-color: var(--seo-article-accent-soft);
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--seo-article-border);
  }

  /* --- 底部栏 --- */
  .pc-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    gap: 12px;
    border-top: 1px dashed var(--seo-article-border); /* 虚线分割，增加层次 */
    padding-top: 12px;
  }

  .pc-price-box {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .pc-price {
    font-size: 18px;
    font-weight: 800;
    color: var(--seo-article-accent) !important;
    letter-spacing: -0.5px;
  }
  
  /* 折扣价颜色 */
  .pc-price-sale-color {
     color: var(--seo-article-accent) !important;
  }

  .pc-price-soldout {
    color: var(--seo-article-muted) !important;
  }

  .pc-compare-price {
    font-size: 12px;
    text-decoration: line-through;
    color: var(--seo-article-muted);
    margin-top: 4px;
    font-weight: 500;
  }

  /* --- 按钮优化 --- */
  .pc-wrapper .pc-btn {
    background-color: var(--seo-article-action, var(--seo-article-accent)) !important;
    color: var(--seo-article-action-text, var(--seo-article-surface)) !important;
    padding: 8px 18px;
    border-radius: 9999px; /* 全圆角按钮 */
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-decoration: none !important;
    white-space: nowrap;
    line-height: 1;
  }

  .pc-btn:hover {
    background-color: var(--seo-article-action, var(--seo-article-accent)) !important;
    transform: scale(1.02);
    box-shadow: 0 4px 12px var(--seo-article-accent-soft);
  }
  
  /* 按钮图标动画 */
  .pc-btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }
  
  .pc-btn:hover svg {
    transform: translateX(3px); /* 悬浮时箭头向右移动 */
  }

  .pc-btn-disabled {
    background-color: var(--seo-article-accent-soft) !important;
    color: var(--seo-article-muted) !important;
    border: 1px solid var(--seo-article-border);
    cursor: not-allowed;
    box-shadow: none;
  }
  
  /* 移动端微调：减小边距 */
  @media (max-width: 639px) {
      .pc-content { padding: 16px; }
      .pc-title { font-size: 16px; }
      .pc-btn { padding: 8px 14px; }
  }
  /* 专门针对价格区间的微调，防止价格太长换行 */
  .pc-price-range {
      font-size: 16px; /* 稍微缩小一点以容纳长价格 */
  }
{% endstyle %}
{% endif %}

{%- comment -%} Skip products that are no longer published or not yet live on the Online Store. {%- endcomment -%}
{% if can_render_product_card %}
{%- assign is_sold_out = false -%}
{%- unless product.available -%}
  {%- assign is_sold_out = true -%}
{%- endunless -%}

{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

<div class="pc-wrapper">
  {% if is_sold_out %}
    <div class="pc-badge pc-badge-soldout">{{ section.settings.sold_out_label | escape }}</div>
  {% else %}
    <div class="pc-badge pc-badge-featured">{{ section.settings.featured_label | escape }}</div>
  {% endif %}

  <div class="pc-img-container">
    <a href="{{ product.url }}" style="display:block;width:100%;height:auto;">
      {% if product.featured_image %}
        {% assign img_class = 'pc-img' | append: card_id %}
        {{
          product.featured_image
          | image_url: width: 600
          | image_tag: class: img_class, loading: 'lazy', alt: product.title
        }}
      {% else %}
        {% assign img_class = 'pc-img' | append: card_id %}
        {{ 'product-1' | placeholder_svg_tag: img_class }}
      {% endif %}
    </a>
  </div>

  <div class="pc-content">
    <div>
      <div class="pc-title">
        <a href="{{ product.url }}" title="{{ product.title | escape }}">{{ product.title | escape }}</a>
      </div>

      <div class="pc-features">
        {% for tag in product.tags limit: 2 %}
          <span class="pc-feature-tag">{{ tag }}</span>
        {% endfor %}
      </div>
    </div>

    <div class="pc-footer">
      <div class="pc-price-box">
        {% if product.price_varies %}
          <!-- 价格区间显示逻辑 -->
          <span class="pc-price pc-price-range {% if is_sold_out %}pc-price-soldout{% elsif on_sale %}pc-price-sale-color{% endif %}">
            {{ product.price_min | money }} - {{ product.price_max | money }}
          </span>
          <!-- 注意：当显示价格区间时，为了不造成混淆，通常隐藏 Compare Price (划线价格) -->
        {% else %}
          <!-- 单一价格显示逻辑 -->
          <span class="pc-price {% if is_sold_out %}pc-price-soldout{% elsif on_sale %}pc-price-sale-color{% endif %}">
            {{ product.price | money }}
          </span>
          {% if on_sale %}
            <span class="pc-compare-price">{{ product.compare_at_price | money }}</span>
          {% endif %}
        {% endif %}
      </div>

      {% if is_sold_out %}
        <button class="pc-btn pc-btn-disabled" disabled>{{ section.settings.sold_out_label | escape }}</button>
      {% else %}
        <a href="{{ product.url }}" class="pc-btn">
          {{ section.settings.inline_buy_label | escape }}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</div>
{% endif %}
