{% doc %}
  XTU blog article card — PLP-style hover card.

  @param {object} article - Shopify article object (required)
  @param {string} [button_label] - CTA label (default: Read More)
  @param {boolean} [show_button_arrow] - Show chevron on CTA
  @param {string} [date_format] - Liquid date format for published_at
  @param {boolean} [show_author] - Show author name (default true)
  @param {string} [button_bg] - CTA background
  @param {string} [button_color] - CTA text color
  @param {string} [button_bg_hover] - CTA hover background
  @param {string} [button_color_hover] - CTA hover text color
{% enddoc %}

{% liquid
  assign card_button_label = button_label | default: 'Read More'
  assign card_date_format = date_format | default: '%B %d, %Y'
  assign card_show_author = show_author
  if card_show_author == nil
    assign card_show_author = true
  endif
  assign card_button_bg = button_bg | default: settings.xtu_btn_bg | default: '#1590F2'
  assign card_button_color = button_color | default: settings.xtu_btn_color | default: '#FFFFFF'
  assign card_button_bg_hover = button_bg_hover | default: settings.xtu_btn_bg_hover | default: '#0070CA'
  assign card_button_color_hover = button_color_hover | default: settings.xtu_btn_color_hover | default: '#FFFFFF'

  assign excerpt_text = article.excerpt | strip_html
  if excerpt_text == blank
    assign excerpt_text = article.content | strip_html
  endif
%}

<article class="xtu-blog-list__card">
  <div class="xtu-blog-list__media xtu-img-zoom">
    <a class="xtu-blog-list__media-link" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
      {% if article.image != blank %}
        {{
          article.image
          | image_url: width: 900
          | image_tag:
            class: 'xtu-blog-list__image xtu-img-zoom__media',
            loading: 'lazy',
            widths: '400, 600, 800, 900',
            sizes: '(max-width: 749px) 50vw, 33vw',
            alt: article.title
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'xtu-blog-list__placeholder xtu-img-zoom__media' }}
      {% endif %}
    </a>
  </div>

  <div class="xtu-blog-list__body">
    <h3 class="xtu-blog-list__title">
      <a class="xtu-blog-list__title-link" href="{{ article.url }}">
        {{ article.title | escape }}
      </a>
    </h3>

    <div class="xtu-blog-list__meta">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
        {{ article.published_at | date: card_date_format }}
      </time>
      {% if card_show_author and article.author != blank %}
        <span class="xtu-blog-list__meta-sep" aria-hidden="true">·</span>
        <span class="xtu-blog-list__author">{{ article.author | escape }}</span>
      {% endif %}
    </div>

    {% if excerpt_text != blank %}
      <p class="xtu-blog-list__excerpt">{{ excerpt_text | truncate: 160 }}</p>
    {% endif %}

    <div class="xtu-blog-list__cta">
      {% render 'xtu-btn',
        label: card_button_label,
        href: article.url,
        size: 'sm',
        show_arrow: show_button_arrow,
        bg: card_button_bg,
        color: card_button_color,
        bg_hover: card_button_bg_hover,
        color_hover: card_button_color_hover
      %}
    </div>
  </div>
</article>
