const validateArticle = value => {
  if (!value || typeof value !== 'string' || value.length > 4096 || /[\u0000-\u0020\\]/.test(value)) return null;
  if (/(?:^|\/)(?:\.|%2e){1,2}(?:\/|$)/i.test(value.split(/[?#]/)[0])) return null;
  try {
    const url = new URL(value, location.origin);
    if (url.origin !== location.origin || !['http:', 'https:'].includes(url.protocol) || url.username || url.password) return null;
    if (url.pathname.includes('//')) return null;
    const parts = url.pathname.replace(/\/$/, '').split('/').slice(1).map(part => decodeURIComponent(part));
    if (parts[0] !== 'blogs' && /^[a-z]{2,3}(?:-[a-z0-9]{2,8}){0,2}$/i.test(parts[0] || '')) parts.shift();
    if (parts.length !== 3 || parts[0] !== 'blogs' || !parts.slice(1).every(part => /^[\p{L}\p{N}][\p{L}\p{N}_-]*$/u.test(part)) || parts[2].toLowerCase() === 'tagged') return null;
    return { url, key: parts.slice(1).join('/') };
  } catch { return null; }
};
