{%- liquid
  capture stocked_variant_id
    render 'seo-sidebar-product-variant', product: product
  endcapture
  assign stocked_variant_id = stocked_variant_id | strip
-%}
{%- if stocked_variant_id != blank -%}
  {%- for variant in product.variants -%}
    {%- assign variant_id = variant.id | append: '' -%}
    {%- if variant_id == stocked_variant_id -%}
      {%- assign product_image = variant.featured_image | default: product.featured_image -%}
      <article class="seo-blog-product">
        <a class="seo-blog-product__media" href="{{ variant.url | escape }}" aria-label="{{ product.title | escape }}">
          {%- if product_image -%}{{ product_image | image_url: width: 400 | image_tag: class: 'seo-blog-product__image', loading: 'lazy', widths: '160, 240, 400', sizes: '160px', alt: product.title }}{%- endif -%}
        </a>
        <div class="seo-blog-product__body">
          <h3 title="{{ product.title | escape }}"><a href="{{ variant.url | escape }}">{{ product.title | escape }}</a></h3>
          {%- unless variant.title == 'Default Title' -%}<p class="seo-blog-product__variant">{{ variant.title | escape }}</p>{%- endunless -%}
          <p class="seo-blog-product__price">{%- if variant.compare_at_price > variant.price -%}<s>{{ variant.compare_at_price | money }}</s>{%- endif -%}<strong>{{ variant.price | money }}</strong></p>
          <a class="seo-blog-button" href="{{ variant.url | escape }}">{{ section.settings.product_button_label | escape }}</a>
        </div>
      </article>
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
