    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D200 record in 4K?",
            "answer": "<p>Yes. The GKU D200 records the road ahead in <strong>4K UHD (3840 × 2160)</strong>, helping capture important details such as road signs, surrounding vehicles, and unexpected driving events.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Is the GKU D200 a front-only dash cam?",
            "answer": "<p>Yes. The D200 is a <strong>single-channel front dash cam</strong> designed for drivers who want a simple, compact recording setup without installing a rear camera.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "What is the field of view of the D200?",
            "answer": "<p>The D200 features a <strong>170° wide-angle field of view</strong>, providing broad coverage of the road ahead while helping capture activity across multiple lanes.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Does the D200 have night vision?",
            "answer": "<p>The D200 uses <strong>WDR, an F1.8 aperture, and a 6-glass lens</strong> to help improve visibility and balance bright and dark areas in challenging lighting conditions. This helps produce clearer footage during nighttime and changing-light driving.</p>"
          }
        },
        "item_6hB6JJ": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D200 support WiFi and app control?",
            "answer": "<p>Yes. Built-in <strong>5.8GHz WiFi</strong> allows you to connect the D200 to the GKU GO app, where you can preview recordings, download footage, manage files, and adjust camera settings from your smartphone.<br/><br/></p>"
          }
        },
        "item_D8EQhw": {
          "type": "item",
          "settings": {
            "question": "Can I remotely monitor the D200 when I am away from my car?",
            "answer": "<p>No. The D200's WiFi provides a <strong>local connection</strong> between the dash cam and your smartphone. It does not include 4G LTE connectivity for remote monitoring when you are away from the vehicle.<br/><br/></p>"
          }
        },
        "item_iTiF7P": {
          "type": "item",
          "settings": {
            "question": "Does the D200 support loop recording?",
            "answer": "<p>Yes. Loop recording automatically overwrites the oldest unlocked recordings when the memory card becomes full, allowing the D200 to continue recording without requiring you to manually delete old footage.</p>"
          }
        },
        "item_MGjfhM": {
          "type": "item",
          "settings": {
            "question": "Does the D200 have a G-Sensor?",
            "answer": "<p>Yes. The built-in <strong>G-Sensor</strong> detects significant impacts and automatically protects important event recordings from being overwritten during normal loop recording.</p>"
          }
        },
        "item_TGPJVN": {
          "type": "item",
          "settings": {
            "question": "Can I manually lock an important video?",
            "answer": "<p>Yes. The D200 supports <strong>one-click emergency video locking</strong>, allowing you to quickly protect important footage when an unexpected event occurs.</p>"
          }
        },
        "item_W9Nrjp": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D200 support parking mode?",
            "answer": "<p>Yes. The D200 supports <strong>24-hour parking surveillance and time-lapse recording</strong> when connected to a compatible hardwire kit, helping monitor your vehicle while it is parked.</p>"
          }
        },
        "item_F3BEmU": {
          "type": "item",
          "settings": {
            "question": "Does parking mode require a hardwire kit?",
            "answer": "<p>Yes. A compatible <strong>hardwire kit is required</strong> for continuous parking monitoring and is sold separately.</p>"
          }
        },
        "item_p9j4Px": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D200 come with a 64GB microSD card?",
            "answer": "<p>The D200 is available in different package options, including a version with a <strong>64GB microSD card</strong>. Please check the selected package before ordering, as some versions may not include a memory card.</p>"
          }
        },
        "item_CgdVKp": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D200 have built-in GPS?",
            "answer": "<p>No built-in GPS is currently listed for the D200. If GPS route and speed recording are important to you, consider a GKU model with built-in GPS, such as the D600.</p>"
          }
        }
      },
