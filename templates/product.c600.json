    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "What is a 4G LTE dash cam?",
            "answer": "<p>A 4G LTE dash cam uses a cellular connection to support compatible remote features when you're away from your vehicle. Unlike standard WiFi dash cams that typically require your phone to be near the camera, the GKU C600 is designed to keep your vehicle connected through a 4G LTE network.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Can I access the GKU C600 when I am away from my car?",
            "answer": "<p>Yes. With an active 4G LTE connection and supported service, the C600 can provide compatible remote monitoring features even when you're away from the vehicle. Availability may depend on cellular coverage, data service, and the specific remote feature being used.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "Does the GKU C600 require a SIM card and cellular data plan?",
            "answer": "<p>The C600's 4G LTE features require cellular connectivity. SIM card, data plan, supported carriers, service regions, and any applicable subscription requirements should be confirmed for your specific C600 package and market before use.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "What is the difference between 4G LTE and WiFi on the C600?",
            "answer": "<p>WiFi is mainly used for a local connection between the dash cam and your smartphone when you're near the vehicle. <strong>4G LTE extends connectivity beyond the vehicle</strong>, enabling supported remote functions over a cellular network.</p>"
          }
        },
        "item_gqHLrF": {
          "type": "item",
          "settings": {
            "question": "Does the GKU C600 support front and rear recording?",
            "answer": "<p>Yes. The C600 is a dual-channel dash cam with front and rear cameras, helping capture important events from both directions while you drive.</p>"
          }
        },
        "item_YVBLpe": {
          "type": "item",
          "settings": {
            "question": "Does the C600 use Sony STARVIS 2?",
            "answer": "<p>Yes. The C600 features <strong>Sony STARVIS 2 imaging technology</strong>, designed to improve image quality and capture clearer footage in challenging low-light driving conditions.</p>"
          }
        },
        "item_EmCDrP": {
          "type": "item",
          "settings": {
            "question": "Does parking mode require a hardwire kit?",
            "answer": "<p>Yes. Continuous parking monitoring requires a compatible hardwire kit or other supported continuous power solution so the dash cam can remain powered after the vehicle is turned off.</p>"
          }
        },
        "item_RLQa8H": {
          "type": "item",
          "settings": {
            "question": "Does the C600 support G-Sensor and loop recording?",
            "answer": "<p>Yes. Loop recording allows the camera to continue recording by automatically overwriting older unprotected footage when storage becomes full. The G-Sensor can detect significant impacts and protect important event recordings from normal loop overwriting.</p>"
          }
        },
        "item_yEad8j": {
          "type": "item",
          "settings": {
            "question": "Can I use the C600 without 4G LTE service?",
            "answer": "<p>The dash cam's standard recording functions can still be used without an active 4G connection, while features that rely on cellular connectivity will require active 4G LTE service.</p>"
          }
        }
      },
