    "xtu_faq_xq8BRt": {
      "type": "xtu-faq",
      "blocks": {
        "item_eMCDrh": {
          "type": "item",
          "settings": {
            "question": "Can I return an opened or used GKU product?",
            "answer": "<p>For non-quality returns, the condition of the product will be considered when determining return eligibility and the applicable refund.</p><p>Products should be returned in their original condition and, where reasonably possible, with the original packaging and included accessories.</p><p>Contact GKU Customer Support before returning the product so our team can review your request.</p>"
          }
        },
        "item_LgeEch": {
          "type": "item",
          "settings": {
            "question": "What should I do if my product is defective?",
            "answer": "<p>Contact <a href=\"mailto:support@gkutech.com\">support@gkutech.com</a> with your order number and photos or video showing the issue. Our support team will troubleshoot first. If a manufacturing defect is confirmed, we will arrange a replacement or cover the approved return shipping cost.</p>"
          }
        },
        "item_NwLTkW": {
          "type": "item",
          "settings": {
            "question": "How is approved return shipping reimbursed for a quality issue?",
            "answer": "<p>When instructed by GKU Support, the customer may need to pay the approved return shipping cost first. Keep the shipping receipt and tracking information. After the required proof is reviewed, GKU will reimburse the approved amount via PayPal.<br/><br/></p>"
          }
        },
        "item_bjwzkW": {
          "type": "item",
          "settings": {
            "question": "Who pays for return shipping?",
            "answer": "<p>For personal or non-quality returns, the customer is generally responsible for return shipping.</p><p>If GKU confirms a manufacturing defect and requires the product to be returned, GKU will cover or reimburse the approved return shipping cost according to the instructions provided by GKU Customer Support.</p>"
          }
        },
        "item_nkfEYV": {
          "type": "item",
          "settings": {
            "question": "Can I return a GKU product purchased from Amazon or another retailer?",
            "answer": "<p>Returns and refunds for products purchased through third-party marketplaces or retailers may be subject to the original seller's return policy.</p><p>For eligible warranty-related product issues, you may contact GKU Customer Support for assistance.</p>"
          }
        }
      },
