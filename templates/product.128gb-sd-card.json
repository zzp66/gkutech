    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "Is 128GB suitable for everyday dash cam recording?",
            "answer": "<p>Yes. The 128GB capacity provides more recording space than 64GB, making it a practical choice for daily driving, longer trips and users who want more recording history before loop recording overwrites older files.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Does the GKU 128GB MicroSD Card support 4K recording?",
            "answer": "<p>Yes. With <strong>U3, V30 and Class 10 speed ratings</strong>, the card is designed to support smooth high-resolution video recording, including compatible <strong>4K UHD dash cams</strong>.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "What is the transfer speed?",
            "answer": "<p>The GKU 128GB MicroSD Card supports read and write speeds of up to <strong>100MB/s</strong>.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Does it support loop recording?",
            "answer": "<p>Yes. When used with a compatible dash cam, the card supports loop recording. When storage becomes full, the dash cam can overwrite older normal video files with new recordings.</p>"
          }
        },
        "item_V6G4dQ": {
          "type": "item",
          "settings": {
            "question": "Is a card reader included?",
            "answer": "<p>Yes. A card reader is included for convenient access to files stored on the memory card.</p>"
          }
        },
        "item_wtaBKG": {
          "type": "item",
          "settings": {
            "question": "Should I format the memory card regularly?",
            "answer": "<p>Regular formatting is recommended to help maintain stable recording performance and reduce file-system issues caused by continuous recording and repeated overwriting.</p>"
          }
        },
        "item_zYMq8B": {
          "type": "item",
          "settings": {
            "question": "Is this memory card only for GKU dash cams?",
            "answer": "<p>It is designed primarily for dash cam recording, but it can also be used with other compatible devices that support microSD storage.</p><p>Always check the device's supported capacity and storage requirements before use.</p>"
          }
        },
        "item_UgYakm": {
          "type": "item",
          "settings": {
            "question": "Where can I find other memory card options?",
            "answer": "<p>Explore our <a href=\"https://www.gkutech.com/collections/dash-cam-memory-cards?utm_source=chatgpt.com\"><strong>Dash Cam Memory Cards</strong></a> collection for more storage options.</p>"
          }
        }
      },
