    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "What is the maximum video resolution?",
            "answer": "<p>The S7 Pro Max records up to 4K at 50fps, delivering smooth and detailed footage.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Does it perform well at night?",
            "answer": "<p>Yes. Its 1/1.28″ RYYB sensor and enhanced AI Night Vision help capture brighter, clearer footage in low-light environments.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "Does the camera have image stabilization?",
            "answer": "<p>Yes. Super EIS 5.0, horizon stabilization and 360° horizon correction help keep your footage smooth and level.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Is the S7 Pro Max waterproof?",
            "answer": "<p>The camera body is not waterproof by itself. When properly installed in the waterproof case, it can be used underwater at depths of up to 30 meters.</p>"
          }
        },
        "item_qdWgCD": {
          "type": "item",
          "settings": {
            "question": "How long does the battery last?",
            "answer": "<p>The 1800mAh battery provides up to approximately 200 minutes of recording at 1080p/30fps. Actual battery life may vary depending on settings and operating conditions.</p>"
          }
        },
        "item_egtgXk": {
          "type": "item",
          "settings": {
            "question": "What memory card does it support?",
            "answer": "<p>The S7 Pro Max supports high-speed microSD cards with capacities of up to 512GB. A suitable high-speed card is recommended for 4K recording.</p>"
          }
        },
        "item_NiiYYr": {
          "type": "item",
          "settings": {
            "question": "Does it have front and rear screens?",
            "answer": "<p>Yes. It features a 2.29″ rear touchscreen and a 1.4″ front display, making it convenient for both regular filming and selfies.</p>"
          }
        },
        "item_UhwWn7": {
          "type": "item",
          "settings": {
            "question": "What’s included in the box?",
            "answer": "<p>S7 Pro Max action camera*1</p><p> arechargeable battery*1</p><p>magnetic quick-release mount*1</p><p>USB-C cable*1</p><p>user manual*1</p><p>memory card guide*1</p>"
          }
        }
      },
      "block_order": [
