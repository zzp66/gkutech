    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "Is the GKU D900 a front and rear dash cam?",
            "answer": "<p>Yes. The GKU D900 is a dual-channel dash cam that records in <strong>4K from the front camera and 1080P from the rear camera</strong>, providing coverage of both the road ahead and behind your vehicle.<br/></p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D900 use a Sony STARVIS sensor?",
            "answer": "<p>Yes. The D900 features a <strong>Sony STARVIS image sensor</strong>, designed to capture clearer footage in low-light driving conditions and improve overall image quality during both daytime and nighttime driving.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "How does the D900 perform at night?",
            "answer": "<p>The D900 combines <strong>Sony STARVIS imaging with WDR technology</strong> to help capture clearer footage in challenging lighting conditions. It helps balance bright and dark areas when driving around headlights, streetlights, shadows, tunnels, and other high-contrast environments.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D900 support WiFi and app control?",
            "answer": "<p>Yes. The D900 features built-in WiFi, allowing you to connect the dash cam to the <strong>GKU GO app</strong> to preview recordings, download important footage, and manage camera settings directly from your smartphone.</p>"
          }
        },
        "item_nPd7z9": {
          "type": "item",
          "settings": {
            "question": "Does the D900 support parking mode?",
            "answer": "<p>Yes. When connected to a compatible hardwire kit, the D900 supports <strong>parking monitoring</strong> to help capture important events while your vehicle is parked.</p><p>Parking monitoring requires a compatible hardwire kit, which may be sold separately.</p>"
          }
        },
        "item_dRHRaQ": {
          "type": "item",
          "settings": {
            "question": "What microSD card does the GKU D900 support?",
            "answer": "<p>The D900 supports <strong>microSD cards up to 512GB</strong>. For stable high-resolution recording, a high-quality <strong>Class 10 U3 or higher</strong> microSD card is recommended.</p>"
          }
        },
        "item_3JEqp6": {
          "type": "item",
          "settings": {
            "question": "Is a memory card included with the D900?",
            "answer": "<p>Yes. The D900 package includes a <strong>64GB microSD card</strong>, allowing you to set up the dash cam and start recording without purchasing a separate memory card.</p><p>Package contents may vary by region or promotion, so please check the selected package before ordering.</p>"
          }
        }
      },
