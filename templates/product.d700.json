    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "Is the GKU D700 a front and rear dash cam?",
            "answer": "<p>Yes. The GKU D700 is a dual-channel dash cam that records the road ahead in <strong>4K UHD</strong> and the rear in <strong>1080P</strong>, providing front and rear coverage for everyday driving.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D700 have a touchscreen?",
            "answer": "<p>Yes. The D700 features a large <strong>3.18-inch touchscreen</strong>, allowing you to preview recordings, play back footage, adjust settings, and control key camera functions directly on the dash cam.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "What can I control from the 3.18-inch touchscreen?",
            "answer": "<p>The touchscreen provides quick access to commonly used camera functions, including video playback, recording settings, system settings, and other camera controls. This makes it easier to operate the D700 without relying entirely on your smartphone.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Does the D700 support WiFi and app control?",
            "answer": "<p>Yes. The D700 features built-in <strong>5GHz WiFi</strong> for connecting the dash cam to a compatible smartphone app. You can use the app to preview footage, download important recordings, and manage camera settings from your phone.</p><p>WiFi provides a local connection between your phone and the dash cam and does not provide cellular remote monitoring.</p>"
          }
        },
        "item_dW6pcP": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D700 have built-in GPS?",
            "answer": "<p>Yes. The D700 features <strong>built-in GPS</strong> to record driving information such as your route, speed, and location. This information can provide useful additional context when reviewing important driving footage.</p>"
          }
        },
        "item_zq789L": {
          "type": "item",
          "settings": {
            "question": "How does the D700 perform at night?",
            "answer": "<p>The D700 uses <strong>WDR technology, an F1.8 aperture, and a six-glass lens system</strong> to help capture clearer footage in low-light and high-contrast driving conditions.</p><p>WDR helps balance bright and dark areas of the image, which can be useful when driving around streetlights, headlights, tunnels, and other challenging lighting environments.</p>"
          }
        },
        "item_EtLdzK": {
          "type": "item",
          "settings": {
            "question": "Does the D700 support parking monitoring?",
            "answer": "<p>Yes. The D700 supports parking monitoring when connected to a <strong>compatible hardwire kit</strong>, helping the camera monitor important events while your vehicle is parked.</p><p>A compatible hardwire kit is required for extended parking monitoring and may be sold separately.</p>"
          }
        },
        "item_qT7t83": {
          "type": "item",
          "settings": {
            "question": "What happens if the D700 detects a collision?",
            "answer": "<p>The built-in <strong>G-Sensor</strong> can detect sudden impacts or unusual vehicle movement. When a significant event is detected, the dash cam can automatically protect the relevant recording from normal loop overwriting.</p>"
          }
        },
        "item_f4QMiY": {
          "type": "item",
          "settings": {
            "question": "Does the D700 support loop recording?",
            "answer": "<p>Yes. With <strong>loop recording</strong>, the D700 automatically overwrites the oldest unlocked recordings when the memory card becomes full, allowing the camera to continue recording without requiring you to manually delete old files.</p><p>Protected emergency recordings are not overwritten during normal loop recording.</p>"
          }
        }
      },
