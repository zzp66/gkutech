@media screen and (max-width: 749px) {\n  .gku-pr-section {\n    padding: 34px 0;\n  }\n\n  .gku-pr-inner {\n    width: min(100% - 24px, 1320px);\n  }\n\n  .gku-pr-title {\n    margin-bottom: 24px;\n    font-size: 22px;\n    letter-spacing: 3px;\n  }\n\n  .gku-pr-group {\n    gap: 34px;\n    padding-right: 34px;\n  }\n\n  .gku-pr-logo {\n    width: 125px;\n    height: 58px;\n  }\n\n  .gku-pr-logo img {\n    max-width: 118px;\n    max-height: 34px;\n  }\n\n  .gku-pr-track {\n    animation-duration: 26s;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .gku-pr-track {\n    animation: none;\n  }\n\n  .gku-pr-marquee {\n    overflow-x: auto;\n  }\n}\n</style>\n\n<script>\n(function () {\n  const track = document.getElementById('gkuPrTrack');\n  if (!track || track.dataset.ready === 'true') return;\n\n  const firstGroup = track.querySelector('.gku-pr-group');\n  if (!firstGroup) return;\n\n  const secondGroup = firstGroup.cloneNode(true);\n  secondGroup.setAttribute('aria-hidden', 'true');\n  track.appendChild(secondGroup);\n\n  track.dataset.ready = 'true';\n})();\n</script>",
