    "custom_liquid_zYRa6N": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<div class=\"gku-weeklybar-wrap\">\n  <div class=\"gku-weeklybar\" data-end=\"2026-09-21T23:59:59\">\n\n    <!-- 产品图 -->\n    <div class=\"gku-weeklybar__product\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0637/6135/0883/files/D600PM_900640d0-87c2-4f43-9442-17c7603b6400.png?v=1789463977\"\n        alt=\"GKU D600 Pro Max\"\n      >\n    </div>\n\n    <!-- 秒杀信息 -->\n    <div class=\"gku-weeklybar__info\">\n      <div class=\"gku-weeklybar__eyebrow\">\n        WEEKLY FLASH SALE\n      </div>\n\n      <h2 class=\"gku-weeklybar__title\">\n        D600 Pro Max\n      </h2>\n\n      <div class=\"gku-weeklybar__offer\">\n        <span class=\"gku-weeklybar__discount\">40% OFF</span>\n        <span class=\"gku-weeklybar__only\">THIS WEEK ONLY</span>\n      </div>\n    </div>\n\n    <!-- 倒计时 -->\n    <div class=\"gku-weeklybar__countdown\">\n\n      <div class=\"gku-weeklybar__ends\">\n        SALE ENDS IN\n      </div>\n\n      <div class=\"gku-weeklybar__timer\">\n\n        <div class=\"gku-weeklybar__time\">\n          <span data-days>00</span>\n          <small>DAYS</small>\n        </div>\n\n        <div class=\"gku-weeklybar__colon\">:</div>\n\n        <div class=\"gku-weeklybar__time\">\n          <span data-hours>00</span>\n          <small>HRS</small>\n        </div>\n\n        <div class=\"gku-weeklybar__colon\">:</div>\n\n        <div class=\"gku-weeklybar__time\">\n          <span data-minutes>00</span>\n          <small>MIN</small>\n        </div>\n\n        <div class=\"gku-weeklybar__colon\">:</div>\n\n        <div class=\"gku-weeklybar__time\">\n          <span data-seconds>00</span>\n          <small>SEC</small>\n        </div>\n\n      </div>\n\n    </div>\n\n    <!-- 按钮 -->\n    <div class=\"gku-weeklybar__action\">\n      <a\n        href=\"https://www.gkutech.com/products/gku-d600-pro-max-starvis-2-dual-dash-cam\"\n        class=\"gku-weeklybar__btn\"\n      >\n        SHOP THE DEAL\n      </a>\n    </div>\n\n  </div>\n</div>\n\n<style>\n.gku-weeklybar-wrap {\n  width: 100%;\n  max-width: 1320px;\n  margin: 28px auto;\n  padding: 0 20px;\n  box-sizing: border-box;\n}\n\n.gku-weeklybar {\n  position: relative;\n  width: 100%;\n  min-height: 185px;\n\n  display: grid;\n  grid-template-columns: 250px minmax(280px, 1fr) 390px 155px;\n  align-items: center;\n  gap: 28px;\n\n  padding: 14px 30px 14px 18px;\n  box-sizing: border-box;\n\n  overflow: hidden;\n\n  border: 1px solid #e5e7eb;\n  border-radius: 22px;\n\n  background:\n    linear-gradient(\n      105deg,\n      #ffffff 0%,\n      #f8f9fb 70%,\n      #fff5b5 100%\n    );\n}\n\n/* 黄色装饰线 */\n.gku-weeklybar::before {\n  content: \"\";\n  position: absolute;\n\n  left: 0;\n  top: 0;\n  bottom: 0;\n\n  width: 7px;\n\n  background: #f4d427;\n}\n\n\n/* 产品图 */\n\n.gku-weeklybar__product {\n  height: 155px;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.gku-weeklybar__product img {\n  display: block;\n\n  width: 100%;\n  max-width: 235px;\n  max-height: 150px;\n\n  object-fit: contain;\n\n  filter: drop-shadow(\n    0 14px 20px rgba(0,0,0,0.15)\n  );\n}\n\n\n/* 中间信息 */\n\n.gku-weeklybar__info {\n  min-width: 0;\n}\n\n.gku-weeklybar__eyebrow {\n  margin-bottom: 8px;\n\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 2px;\n\n  color: #b28c00;\n}\n\n.gku-weeklybar__title {\n  margin: 0 0 12px;\n\n  font-size: 30px;\n  line-height: 1.1;\n  font-weight: 800;\n\n  color: #111111;\n}\n\n.gku-weeklybar__offer {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n\n  flex-wrap: wrap;\n}\n\n.gku-weeklybar__discount {\n  display: inline-flex;\n  align-items: center;\n\n  padding: 8px 14px;\n\n  border-radius: 8px;\n\n  background: #f4d427;\n  color: #111111;\n\n  font-size: 22px;\n  line-height: 1;\n  font-weight: 900;\n}\n\n.gku-weeklybar__only {\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 1px;\n\n  color: #777777;\n}\n\n\n/* 倒计时 */\n\n.gku-weeklybar__countdown {\n  padding-left: 28px;\n\n  border-left: 1px solid #dedfe3;\n}\n\n.gku-weeklybar__ends {\n  margin-bottom: 12px;\n\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 1.4px;\n\n  color: #777777;\n}\n\n.gku-weeklybar__timer {\n  display: flex;\n  align-items: center;\n}\n\n.gku-weeklybar__time {\n  min-width: 55px;\n\n  text-align: center;\n}\n\n.gku-weeklybar__time span {\n  display: block;\n\n  font-size: 30px;\n  line-height: 1;\n  font-weight: 800;\n\n  color: #111111;\n}\n\n.gku-weeklybar__time small {\n  display: block;\n\n  margin-top: 7px;\n\n  font-size: 9px;\n  letter-spacing: .8px;\n\n  color: #888888;\n}\n\n.gku-weeklybar__colon {\n  margin: -13px 6px 0;\n\n  font-size: 22px;\n  font-weight: 700;\n\n  color: #d0a600;\n}\n\n\n/* 按钮 */\n\n.gku-weeklybar__action {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.gku-weeklybar__btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  min-width: 140px;\n\n  padding: 14px 20px;\n\n  border-radius: 999px;\n\n  background: #111111;\n  color: #ffffff;\n\n  text-decoration: none;\n\n  font-size: 12px;\n  font-weight: 800;\n\n  white-space: nowrap;\n\n  transition: all .2s ease;\n}\n\n.gku-weeklybar__btn:hover {\n  background: #f4d427;\n  color: #111111;\n\n  transform: translateY(-2px);\n}\n\n\n/* 中等屏幕 */\n\n@media screen and (max-width: 1100px) {\n\n  .gku-weeklybar {\n    grid-template-columns: 200px 1fr 330px;\n  }\n\n  .gku-weeklybar__action {\n    grid-column: 2 / 4;\n    justify-content: flex-start;\n  }\n\n}\n\n\n/* 手机和平板 */\n\n@media screen and (max-width: 749px) {\n\n  .gku-weeklybar-wrap {\n    padding: 0 12px;\n  }\n\n  .gku-weeklybar {\n    grid-template-columns: 120px 1fr;\n\n    gap: 16px;\n\n    padding: 18px;\n\n    border-radius: 18px;\n  }\n\n  .gku-weeklybar__product {\n    height: 110px;\n  }\n\n  .gku-weeklybar__product img {\n    max-width: 120px;\n    max-height: 105px;\n  }\n\n  .gku-weeklybar__title {\n    font-size: 22px;\n  }\n\n  .gku-weeklybar__discount {\n    font-size: 18px;\n  }\n\n  .gku-weeklybar__countdown {\n    grid-column: 1 / -1;\n\n    padding: 16px 0 0;\n\n    border-left: 0;\n    border-top: 1px solid #e1e3e7;\n\n    text-align: center;\n  }\n\n  .gku-weeklybar__timer {\n    justify-content: center;\n  }\n\n  .gku-weeklybar__action {\n    grid-column: 1 / -1;\n\n    justify-content: center;\n  }\n\n  .gku-weeklybar__btn {\n    width: 100%;\n  }\n\n}\n\n</style>\n\n<script>\n(function () {\n\n  const sections =\n    document.querySelectorAll('.gku-weeklybar');\n\n  sections.forEach((section) => {\n\n    const end =\n      new Date(section.dataset.end).getTime();\n\n    function updateCountdown() {\n\n      let distance =\n        end - Date.now();\n\n      if (distance < 0) {\n        distance = 0;\n      }\n\n      const days =\n        Math.floor(distance / 86400000);\n\n      const hours =\n        Math.floor(\n          (distance % 86400000) / 3600000\n        );\n\n      const minutes =\n        Math.floor(\n          (distance % 3600000) / 60000\n        );\n\n      const seconds =\n        Math.floor(\n          (distance % 60000) / 1000\n        );\n\n      section\n        .querySelector('[data-days]')\n        .textContent =\n        String(days).padStart(2, '0');\n\n      section\n        .querySelector('[data-hours]')\n        .textContent =\n        String(hours).padStart(2, '0');\n\n      section\n        .querySelector('[data-minutes]')\n        .textContent =\n        String(minutes).padStart(2, '0');\n\n      section\n        .querySelector('[data-seconds]')\n        .textContent =\n        String(seconds).padStart(2, '0');\n    }\n\n    updateCountdown();\n\n    setInterval(updateCountdown, 1000);\n\n  });\n\n})();\n</script>",
