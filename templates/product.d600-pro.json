    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "Is the GKU D600 Pro a front and rear dash cam?",
            "answer": "<p>Yes. The GKU D600 Pro is a dual-channel dash cam that records the road ahead in 4K UHD and the rear in 1080P Full HD, providing coverage from both directions.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D600 Pro have built-in GPS?",
            "answer": "<p>Yes. The D600 Pro features built-in GPS that can record driving information such as your route, location, and speed. GPS data can be reviewed through the GKU GO App or compatible GKU Player.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "Can I view the D600 Pro remotely when I am away from my car?",
            "answer": "<p>No. The D600 Pro's WiFi is designed for a local connection between the dash cam and your smartphone. Your phone needs to be near the camera and connected to its WiFi to access footage.</p><p>If you need remote vehicle monitoring through a cellular network, consider a compatible 4G LTE dash cam instead.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D600 Pro support parking mode?",
            "answer": "<p>Yes. The D600 Pro supports parking monitoring when connected to a compatible Type-C hardwire kit. When Parking Mode is enabled, the camera can monitor the vehicle while parked and record important events such as detected impacts.</p><p>A compatible hardwire kit is required for parking monitoring and is sold separately.</p>"
          }
        },
        "item_e9Eth4": {
          "type": "item",
          "settings": {
            "question": "Does the D600 Pro have a G-sensor?",
            "answer": "<p>Yes. The built-in G-sensor detects significant impacts or sudden vibrations and automatically locks the current recording to help prevent important event footage from being overwritten.</p>"
          }
        }
      },
