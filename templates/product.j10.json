    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "Does the J10 support 5GHz Wi-Fi?",
            "answer": "<p>No. The J10 connects only to a 2.4GHz Wi-Fi network. If your router uses both 2.4GHz and 5GHz bands, connect the doorbell to the 2.4GHz network during setup.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Is a microSD card included?",
            "answer": "<p>No. A microSD card is not included. The J10 supports microSD cards with a capacity of up to 128GB.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "Is cloud storage required?",
            "answer": "<p>No. Cloud storage is optional. You can use a compatible microSD card for local recording without purchasing a cloud storage plan.</p>"
          }
        },
        "item_LGcYiV": {
          "type": "item",
          "settings": {
            "question": "Does the doorbell work with Alexa and Google Home?",
            "answer": "<p>Yes. The J10 works with compatible Alexa and Google Home smart displays for live-view functionality. Available functions may vary depending on the connected device and platform.</p>"
          }
        },
        "item_qhfxi4": {
          "type": "item",
          "settings": {
            "question": "Can I talk to visitors remotely?",
            "answer": "<p>Yes. Two-way audio allows you to see and speak with visitors through the mobile app when the doorbell is connected to the internet.</p>"
          }
        },
        "item_7QJXUE": {
          "type": "item",
          "settings": {
            "question": "Can more than one person access the doorbell?",
            "answer": "<p>Yes. Device access can be shared with trusted family members through the app.</p>"
          }
        },
        "item_dThGUx": {
          "type": "item",
          "settings": {
            "question": "Can the viewing angle be adjusted?",
            "answer": "<p>Yes. The included multi-angle bracket provides five positions from -45° to 45° to accommodate different doorway layouts.</p>"
          }
        },
        "item_kL43pC": {
          "type": "item",
          "settings": {
            "question": "Can the doorbell be installed without drilling?",
            "answer": "<p>An adhesive mounting option can be used on a suitable clean, smooth and flat surface. Screw installation is recommended when a more secure and durable mount is required.</p>"
          }
        },
        "item_diHKba": {
          "type": "item",
          "settings": {
            "question": "Is the J10 suitable for outdoor use?",
            "answer": "<p>The J10 features an IP65 weather-resistant design. Install it in a suitable location and avoid prolonged submersion or direct exposure to high-pressure water.</p>"
          }
        },
        "item_q3QFFi": {
          "type": "item",
          "settings": {
            "question": "How long does the battery last?",
            "answer": "<p>Battery life depends on motion frequency, live-view usage, recording duration, Wi-Fi signal strength and environmental conditions. More frequent alerts and live viewing will require more frequent charging.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "What is included in the package?",
            "answer": "<ul><li>XTU J10 Video Doorbell</li><li>Wireless Indoor Chime</li><li>Multi-Angle Mounting Bracket</li><li>USB Charging Cable</li><li>Mounting Screws and Tools</li><li>User Guide</li></ul>"
          }
        }
      },
