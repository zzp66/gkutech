    "xtu_faq_VqQPMd": {
      "type": "xtu-faq",
      "blocks": {
        "item_grftqP": {
          "type": "item",
          "settings": {
            "question": "Do I need a subscription to use the C600?",
            "answer": "<p>No. Recording, Wi-Fi access, GPS route recording and local parking recording work without a subscription. A 4G plan is required for remote features.</p>"
          }
        },
        "item_n4ChAF": {
          "type": "item",
          "settings": {
            "question": "What’s included in the 4G plan?",
            "answer": "<p>The optional $9.90/month plan includes 4G data and 30-day cloud storage. A 7-day free trial of 4G data and cloud storage is included.</p>"
          }
        },
        "item_rrLdHa": {
          "type": "item",
          "settings": {
            "question": "Where can I use the 4G service?",
            "answer": "<p>The C600’s 4G service is currently available in the United States only</p>"
          }
        },
        "item_BjqjrP": {
          "type": "item",
          "settings": {
            "question": "Which app should I use?",
            "answer": "<p>Use the GKU LINK app for both Wi-Fi and 4G access.</p>"
          }
        },
        "item_hLT8zX": {
          "type": "item",
          "settings": {
            "question": "Does the C600 require a hardwire kit?",
            "answer": "<p>Yes. The C600 requires hardwire installation for continuous power and parking monitoring. An ACC Multi-Size Hardwire Kit is included in the package.</p>"
          }
        },
        "item_XytL8U": {
          "type": "item",
          "settings": {
            "question": "Is a memory card included?",
            "answer": "<p>Yes. A 64GB microSD card is included. The C600 supports microSD cards up to 512GB.</p>"
          }
        }
      },
