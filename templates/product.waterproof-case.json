    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "Is this waterproof case compatible with both the XTU S7 Pro and S7 Pro Max?",
            "answer": "<p>Yes. The waterproof housing is designed specifically for the XTU S7 Pro and S7 Pro Max action cameras.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Is the action camera included?",
            "answer": "<p>No. This package includes the waterproof housing and waterproof charging cable only. The camera and other accessories are sold separately.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "How deep can the waterproof housing go underwater?",
            "answer": "<p>When correctly installed and fully sealed, the housing supports underwater use at depths of up to 98 ft/30 m.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Is the XTU S7 Pro waterproof without the housing?",
            "answer": "<p>No. The camera body itself is not waterproof. The waterproof housing is required for underwater use and recommended for rainy or wet environments.</p>"
          }
        },
        "item_364Mby": {
          "type": "item",
          "settings": {
            "question": "Can the camera record while connected to external power?",
            "answer": "<p>Yes. The included waterproof charging cable allows the camera to connect to a compatible external power source for extended recording in suitable wet-weather and splash-prone environments.</p>"
          }
        },
        "item_9Lkgdw": {
          "type": "item",
          "settings": {
            "question": "Can I connect or disconnect the charging cable underwater?",
            "answer": "<p>No. Never connect or disconnect the charging cable underwater. Make all connections in a dry environment and ensure that the threaded connector is fully tightened before exposure to water.</p>"
          }
        },
        "item_fjkmtJ": {
          "type": "item",
          "settings": {
            "question": "Can I use the housing for surfing and kayaking?",
            "answer": "<p>Yes. The housing is suitable for surfing, kayaking, swimming, snorkeling, fishing, and other water sports when correctly installed and fully sealed.</p>"
          }
        },
        "item_pkae7z": {
          "type": "item",
          "settings": {
            "question": "Will the housing affect image quality?",
            "answer": "<p>The housing features a clear, round lens window designed to maintain an unobstructed shooting view. For the best results, keep the lens window clean and free from fingerprints, water spots, sand, and scratches.</p>"
          }
        },
        "item_B4wjXm": {
          "type": "item",
          "settings": {
            "question": "What should I do after using the housing in salt water?",
            "answer": "<p>Rinse the closed housing with fresh water and dry it thoroughly. Make sure the exterior is completely dry before opening the case.</p>"
          }
        },
        "item_ATRV8p": {
          "type": "item",
          "settings": {
            "question": "Should I test the housing before using it underwater?",
            "answer": "<p>Yes. Place a dry tissue inside the empty housing, close it correctly, and submerge it in shallow water. Check for leaks before installing the camera.</p>"
          }
        }
      },
