            "image_width": 100,
            "align": "center",
            "image_radius": 16,
            "spacing": 24,
            "spacing_mobile": 16
          }
        },
        "richtext_pQmd6A": {
          "type": "richtext",
          "settings": {
            "body": "<h4>Complete Your XTU S7 Pro Setup</h4>",
            "align": "left",
            "font_size": 14,
            "font_size_mobile": 14,
            "text_color": "#333333",
            "spacing": 12,
            "spacing_mobile": 8
          }
        },
        "richtext_XAwEjX": {
          "type": "richtext",
          "settings": {
            "body": "<p>This package includes the <strong>waterproof housing and waterproof charging cable only</strong>. The XTU S7 Pro/S7 Pro Max action camera and other accessories are sold separately.</p><p><a href=\"/products/xtu-s7-pro-4k-action-camera\" target=\"_blank\" title=\"XTU S7 Pro 4K Action Camera | 50FPS, AI ISP, Super 5.0 Stabilization, Wi-Fi 6 & 360° Horizon Lock\">Purchase the XTU S7 Pro Action Camera</a></p><p><a href=\"/collections/action-camera-accessories\" target=\"_blank\" title=\"Action Camera Accessories\">Explore XTU Action Camera Accessories</a></p>",
            "align": "left",
            "font_size": 18,
