    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "What video resolutions does the S7 PRO support?",
            "answer": "<p>The S7 PRO supports multiple resolutions, including 4K, 2.7K, 1440P, and 1080P. It can record at up to 4K 50fps or 1080P 120fps, making it suitable for travel, cycling, skiing, vlogging, and fast-action shooting.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Does the S7 PRO support image stabilization?",
            "answer": "<p>Yes. The S7 PRO offers Super Stabilization, Enhanced Super Stabilization, Horizon Lock, and 360° Horizon Correction to help reduce camera shake and keep action footage smooth and level.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "Can the S7 PRO record vertical videos?",
            "answer": "<p>Yes. It supports native 4K vertical recording. Simply switch to the 9:16 aspect ratio to create vertical videos for TikTok, Instagram Reels, YouTube Shorts, and other social platforms.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Does the S7 PRO support pre-recording?",
            "answer": "<p>Yes. Pre-recording captures footage before you press the record button, helping you save unexpected moments. It supports up to approximately 50 seconds in 4K and up to approximately 60 seconds in 1080P.</p>"
          }
        },
        "item_GdFPAt": {
          "type": "item",
          "settings": {
            "question": "Is the S7 PRO waterproof?",
            "answer": "<p>The camera itself is not waterproof. A compatible waterproof case is required for underwater recording or use in heavy rain. The waterproof case is sold separately.</p>"
          }
        },
        "item_pYryfF": {
          "type": "item",
          "settings": {
            "question": "What type of memory card does the S7 PRO support?",
            "answer": "<p>The S7 PRO supports microSD cards with capacities up to 512GB. For stable high-resolution recording, use a reliable U3-rated or faster microSD card. A memory card is not included.</p>"
          }
        },
        "item_Gre7Rr": {
          "type": "item",
          "settings": {
            "question": "Does the S7 PRO support Wi-Fi and app control?",
            "answer": "<p>Yes. The S7 PRO supports 5GHz Wi-Fi 6, allowing you to preview footage, adjust camera settings, and download files through the smartphone app. Transfer speeds can reach up to approximately 30MB/s under suitable conditions.</p>"
          }
        },
        "item_XaBAap": {
          "type": "item",
          "settings": {
            "question": "What battery and charging features does it offer?",
            "answer": "<p><br/>The S7 PRO uses a replaceable 1800mAh battery and supports PD fast charging, reaching approximately 80% in 46 minutes. It can also record while connected to a stable external power source.<br/><br/></p>"
          }
        },
        "item_rnddDk": {
          "type": "item",
          "settings": {
            "question": "Can I connect a Bluetooth microphone?",
            "answer": "<p>Yes. The S7 PRO supports compatible XTU Bluetooth microphones. Third-party Bluetooth microphones may not connect or function correctly, so an official XTU microphone is recommended.</p>"
          }
        },
        "item_iaMM9m": {
          "type": "item",
          "settings": {
            "question": "What accessories are available for the S7 PRO?",
            "answer": "<p>Compatible XTU accessories include a waterproof case, Bluetooth microphone, protective cage, neck mount, charging case, and mounting accessories for helmets, handlebars, chest mounts, tripods, and selfie sticks.</p>"
          }
        }
      },
