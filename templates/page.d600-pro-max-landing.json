    "xtu_faq_FgaLJX": {
      "type": "xtu-faq",
      "blocks": {
        "item_bVeYMA": {
          "type": "item",
          "settings": {
            "question": "1. What video resolution does the GKU D600 Pro Max record?",
            "answer": "<p>The GKU D600 Pro Max records <strong>4K UHD (3840 × 2160P) at 30fps from the front camera and 1080P (1920 × 1080P) from the rear camera</strong>, providing front and rear coverage to help capture important road details from both directions.</p>"
          }
        },
        "item_gGcErg": {
          "type": "item",
          "settings": {
            "question": "2. Does the D600 Pro Max use a Sony STARVIS 2 sensor?",
            "answer": "<p>Yes. The D600 Pro Max uses <strong>Sony STARVIS 2 imaging technology</strong> designed to improve image quality in challenging lighting conditions. Combined with WDR imaging, it helps capture clearer road details during nighttime driving and scenes with bright headlights, streetlights, shadows, or changing exposure.</p>"
          }
        },
        "item_gGXkQy": {
          "type": "item",
          "settings": {
            "question": "3. Does the D600 Pro Max support 24-hour parking monitoring?",
            "answer": "<p>Yes. The D600 Pro Max supports <strong>24/7 parking monitoring</strong> when connected to a compatible GKU hardwire kit.</p><p>Supported parking features include Time-Lapse Recording, Collision Detection, and Pre-Recording to help capture important footage while your vehicle is parked.</p><p>The hardwire kit is required for parking monitoring and is sold separately.</p>"
          }
        },
        "item_mdfMHj": {
          "type": "item",
          "settings": {
            "question": "4. Is the hardwire kit included with the D600 Pro Max?",
            "answer": "<p>No. The hardwire kit is <strong>not included</strong> with the standard D600 Pro Max package and must be purchased separately if you want to use 24-hour parking monitoring.</p>"
          }
        },
        "item_CpMzeQ": {
          "type": "item",
          "settings": {
            "question": "5. Does the D600 Pro Max have built-in GPS?",
            "answer": "<p>Yes. Built-in GPS records information such as <strong>driving route, speed, and location</strong> while you drive.</p><p>You can review videos through the GKU GO app, while more detailed GPS map playback is available through the GKU GPS Player on a PC or Mac.</p>"
          }
        },
        "item_zr73jF": {
          "type": "item",
          "settings": {
            "question": "6. Can I connect the D600 Pro Max to my smartphone?",
            "answer": "<p>Yes. The D600 Pro Max connects to your smartphone through the <strong>GKU GO app</strong> using built-in dual-band Wi-Fi.</p><p>You can preview recordings, review footage, download important clips, and adjust camera settings directly from your phone when connected to the dash cam.</p>"
          }
        },
        "item_DgKzP4": {
          "type": "item",
          "settings": {
            "question": "7. Does the D600 Pro Max support 5.8GHz Wi-Fi?",
            "answer": "<p>Yes. The D600 Pro Max supports both <strong>2.4GHz and 5.8GHz Wi-Fi</strong>.</p><p>5.8GHz provides faster video transfer on compatible smartphones, while 2.4GHz offers broader device compatibility. You can select the appropriate Wi-Fi band based on your phone and connection conditions.</p>"
          }
        },
        "item_LWzxWV": {
          "type": "item",
          "settings": {
            "question": "8. Can I remotely view the D600 Pro Max when I am away from my car?",
            "answer": "<p>No. The D600 Pro Max uses Wi-Fi for a <strong>local connection</strong> between the dash cam and your smartphone. It does not include cellular connectivity or cloud-based remote live viewing.</p><p>To view or download recordings through the GKU GO app, your smartphone needs to be near the dash cam.</p>"
          }
        },
        "item_W4NhzM": {
          "type": "item",
          "settings": {
            "question": "9. Does the D600 Pro Max support voice control?",
            "answer": "<p>Yes. The D600 Pro Max supports <strong>hands-free voice control</strong> for selected camera functions, allowing you to operate key features without reaching for the dash cam while driving.</p>"
          }
        },
        "item_VQEpgK": {
          "type": "item",
          "settings": {
            "question": "10. What size microSD card does the D600 Pro Max support?",
            "answer": "<p>The D600 Pro Max supports <strong>microSD cards from 64GB up to 512GB</strong>.</p><p>For reliable high-resolution recording, we recommend using a high-endurance <strong>U3/V30 or higher</strong> microSD card. Format the memory card through the GKU GO app before first use for best stability.</p>"
          }
        },
        "item_RgcMxg": {
          "type": "item",
          "settings": {
            "question": "11. Is a memory card included?",
            "answer": "<p>It depends on the package you select.</p><p>GKU offers D600 Pro Max purchase options with or without a memory card. Please check the selected package before placing your order.</p>"
          }
        },
        "item_imQE3V": {
          "type": "item",
          "settings": {
            "question": "12. What happens when the memory card is full?",
            "answer": "<p>The D600 Pro Max supports <strong>loop recording</strong>. When the memory card becomes full, the camera automatically overwrites the oldest unlocked normal recordings so it can continue recording.</p><p>When the built-in G-Sensor detects an impact or unusual vibration, the relevant recording can be locked to help prevent important footage from being automatically overwritten.</p>"
          }
        },
        "item_8qM6Mw": {
          "type": "item",
          "settings": {
            "question": "13. Is the D600 Pro Max easy to install?",
            "answer": "<p>Yes. The D600 Pro Max is designed for straightforward everyday installation and includes mounting options for positioning the front camera on your windshield.</p><p>The rear camera is typically installed on the rear windshield and connected to the front camera using the supplied rear camera cable.</p><p>For 24-hour parking monitoring, a compatible hardwire kit is required. Professional installation may be helpful if you are not familiar with vehicle fuse-box wiring.</p>"
          }
        },
        "item_cWnALg": {
          "type": "item",
          "settings": {
            "question": "14. What is the difference between the D600 Pro and D600 Pro Max?",
            "answer": "<p>The D600 Pro Max builds on the D600 Pro with upgrades including <strong>Sony STARVIS 2 imaging, voice control, faster connectivity, expanded storage support, and more flexible mounting options</strong>.</p><p>Both models provide front and rear recording, but the D600 Pro Max is designed for drivers looking for a more advanced overall dash cam experience.</p>"
          }
        },
        "item_mYQWzm": {
          "type": "item",
          "settings": {
            "question": "15. Does the D600 Pro Max come with a warranty?",
            "answer": "<p>Yes. Eligible GKU dash cams include a <strong>1-year standard manufacturer's warranty</strong>. Eligible customers can register their product to receive an additional <strong>1-year warranty extension</strong>, providing up to <strong>2 years of total manufacturer warranty coverage</strong>.</p><p>Please refer to the GKU Warranty Policy for complete warranty terms and eligibility requirements.</p>"
          }
        }
      },
      "block_order": [
        "item_bVeYMA",
