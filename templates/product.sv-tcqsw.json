    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "What’s included in the package?",
            "answer": "<ul><li>Solar Trail Camera × 1</li><li>Mounting Strap × 1</li><li>USB-C Cable × 1</li><li>Metal Mounting Bracket × 1</li><li>Metal Base × 1</li><li>Hex Key × 1</li><li>Screws × 4</li><li>Wall Anchors × 4</li><li>User Manual × 1</li></ul>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Is a microSD card included?",
            "answer": "<p>No. The camera supports microSD cards up to 256GB, but the card must be purchased separately. A reliable Class 10/U3 high-speed card is recommended.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "Can I view the camera remotely over the internet?",
            "answer": "<p>No. The camera uses local Wi-Fi and Bluetooth for nearby access through the TrailCamGO app. It does not connect to home Wi-Fi or support remote internet viewing.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Does the camera require AA batteries?",
            "answer": "<p>No. The camera has a built-in 2600mAh rechargeable battery and an integrated solar panel. Four 1.5V AA batteries can be added as backup power but are not included.</p>"
          }
        },
        "item_DyMHNk": {
          "type": "item",
          "settings": {
            "question": "Is the camera waterproof?",
            "answer": "<p>The camera has an IP66 weather-resistant rating and is designed for outdoor use in rain, snow and dust. Do not submerge it in water.</p>"
          }
        },
        "item_T6HNbf": {
          "type": "item",
          "settings": {
            "question": "What should I do before first use?",
            "answer": "<p>Fully charge the camera with a 5V/2A USB-C power source. Insert a compatible microSD card and format it in the camera before recording.</p>"
          }
        },
        "item_we4rkp": {
          "type": "item",
          "settings": {
            "question": "How can I access my photos and videos?",
            "answer": "<p>You can access recordings through the TrailCamGO app, connect the camera to a computer with the included USB-C cable, or use a compatible microSD card reader.</p>"
          }
        },
        "item_aL6WRp": {
          "type": "item",
          "settings": {
            "question": "Where should I install the camera?",
            "answer": "<p>Mount the camera approximately 1.6–6.5ft/0.5–2m above the ground and angle it slightly downward. Keep the lens and PIR sensor clear of branches or grass, and position the solar panel where it can receive direct sunlight.</p>"
          }
        },
        "item_jHxGEH": {
          "type": "item",
          "settings": {
            "question": "How do I start using the camera?",
            "answer": "<p>Insert and format a compatible microSD card, move the switch to TEST, configure the recording settings, and then switch it to ON. The screen will turn off and the camera will enter motion-detection standby mode.</p>"
          }
        },
        "item_rti3tB": {
          "type": "item",
          "settings": {
            "question": "What is the app connection range?",
            "answer": "<p>The local wireless connection works at distances of up to approximately 49ft/15m in an open area. Walls, trees and other obstacles may reduce the connection range.</p>"
          }
        }
      },
