    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "Does the D1000 support 24-hour parking mode?",
            "answer": "<p>Yes. The D1000 supports impact detection and time-lapse parking recording. A compatible GKU hardwire kit is required for parking monitoring after the vehicle is turned off.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "What size microSD card does the D1000 support?",
            "answer": "<p>The GKU D1000 supports microSD cards from 32GB up to 512GB. A Class 10 U3 or faster card is recommended for reliable multi-channel video recording.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "Is the GKU D1000 suitable for Uber and rideshare drivers?",
            "answer": "<p>Yes. With dedicated front, cabin, and rear cameras, the D1000 provides three-channel coverage that can document road conditions, passenger-area activity, and events behind the vehicle, making it a practical dash cam for Uber, rideshare, taxi, and other professional drivers.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D1000 have WiFi and app connectivity?",
            "answer": "<p>Yes. The D1000 supports dual-band 2.4GHz and 5.8GHz WiFi and works with the GKU GO app. You can use the app to preview footage, download videos, and manage dash cam settings from your smartphone. The WiFi connection is local and does not provide remote or cloud viewing.</p>"
          }
        }
      },
