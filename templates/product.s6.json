    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "What is the maximum video resolution?",
            "answer": "<p>The XTU S6 records video at up to 4K/30fps and captures photos at up to 20MP.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Does the S6 have image stabilization?",
            "answer": "<p>Yes. SuperSmooth 4.0 electronic image stabilization helps reduce camera shake and produce smoother footage.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "Is the S6 waterproof?",
            "answer": "<p>The camera body is not waterproof by itself. When correctly installed in the included waterproof case, it can be used underwater at depths of up to 131 ft (40 m).</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "How long does the battery last?",
            "answer": "<p>The included 1350mAh battery provides up to 150 minutes at 1080p/30fps, 120 minutes at 1080p/60fps or 90 minutes at 4K/30fps.</p>"
          }
        },
        "item_GdFPAt": {
          "type": "item",
          "settings": {
            "question": "Does the camera have front and rear screens?",
            "answer": "<p>Yes. The S6 features a 1.4″ front color display and a 2.0″ rear touchscreen.</p>"
          }
        },
        "item_pYryfF": {
          "type": "item",
          "settings": {
            "question": "Is a memory card included?",
            "answer": "<p>Yes. The package includes a 64GB microSD card and a microSD card reader.</p>"
          }
        },
        "item_Gre7Rr": {
          "type": "item",
          "settings": {
            "question": "Can I control the camera remotely?",
            "answer": "<p>Yes. The S6 supports voice control, the included 2.4GHz wrist remote and control through the XTU GO app. The wrist remote supports a range of up to approximately 20 m (65 ft).</p>"
          }
        },
        "item_XaBAap": {
          "type": "item",
          "settings": {
            "question": "Can I transfer videos to my phone?",
            "answer": "<p>Yes. Connect the camera to the XTU GO app through 2.4GHz Wi-Fi to preview, manage and transfer your content.</p>"
          }
        },
        "item_rnddDk": {
          "type": "item",
          "settings": {
            "question": "Does it support vertical shooting?",
            "answer": "<p>Yes. You can quickly switch between horizontal and vertical framing.</p>"
          }
        },
        "item_iaMM9m": {
          "type": "item",
          "settings": {
            "question": "What is pre-recording?",
            "answer": "<p>Pre-recording saves up to 20 seconds of footage from before you press the record button, helping you capture unexpected moments from the beginning.</p>"
          }
        }
      },
