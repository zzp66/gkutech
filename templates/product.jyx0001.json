    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "What Is Different About the Adjustable Multi-Size ACC Hardwire Kit?",
            "answer": "<p>Unlike the standard Multi-Size version with a fixed voltage cutoff, the adjustable version allows you to set the cutoff threshold between 11.3V and 13.5V. It also includes 8 fuse taps across 4 common types for flexible installation.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Does This Hardwire Kit Support 24-Hour Parking Mode?",
            "answer": "<p>Yes. It provides continuous power for compatible GKU dash cams to support parking monitoring while the vehicle is turned off. Available parking functions vary by model.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "How Does Adjustable Low-Voltage Protection Work?",
            "answer": "<p>The hardwire kit automatically disconnects power when battery voltage falls below the selected cutoff threshold, helping reduce excessive battery discharge.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Will the Hardwire Kit Drain My Car Battery?",
            "answer": "<p>The kit includes adjustable low-voltage protection to help protect your vehicle battery. Select an appropriate cutoff threshold based on your battery requirements.</p>"
          }
        },
        "item_3jErwb": {
          "type": "item",
          "settings": {
            "question": "What Fuse Types Are Included?",
            "answer": "<p>The package includes 8 fuse taps: 2 Low-Profile Mini, 2 Mini, 2 ATO (Regular), and 2 Micro2.</p>"
          }
        },
        "item_V6G4dQ": {
          "type": "item",
          "settings": {
            "question": "What Should I Check If My Dash Cam Does Not Enter Parking Mode?",
            "answer": "<p>Make sure parking mode is enabled in your dash cam settings. Check that the red wire is connected to ACC, the yellow wire to constant power, and the black wire to a suitable grounding point.</p>"
          }
        },
        "item_wtaBKG": {
          "type": "item",
          "settings": {
            "question": "Is Professional Installation Recommended?",
            "answer": "<p>Yes. Installation requires a direct connection to the vehicle's fuse box. Professional installation is strongly recommended to ensure correct and safe wiring.</p>"
          }
        }
      },
