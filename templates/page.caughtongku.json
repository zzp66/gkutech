    "xtu_faq_8azJwd": {
      "type": "xtu-faq",
      "blocks": {
        "item_9QVAJB": {
          "type": "item",
          "settings": {
            "question": "How are winners selected?",
            "answer": "<p>Winners are selected based on content quality, originality, relevance to #CaughtOnGKU, authentic engagement, and organic reach. Higher views and authentic engagement may improve your chances of winning, but they do not determine the winner alone. Artificially boosted views, likes, comments, followers, or paid engagement may result in disqualification.</p>"
          }
        },
        "item_ptYhkj": {
          "type": "item",
          "settings": {
            "question": "When will the winners be announced?",
            "answer": "<p>Winners are selected at the end of each month during the campaign. GKU will contact selected winners through the contact information or social account associated with their entry.</p>"
          }
        },
        "item_XaipDA": {
          "type": "item",
          "settings": {
            "question": "Do I have to use a GKU dash cam?",
            "answer": "<p>No. The #CaughtOnGKU Social Challenge welcomes original footage recorded with any dash cam brand.</p>"
          }
        },
        "item_HGBkpV": {
          "type": "item",
          "settings": {
            "question": "Which platforms can I use?",
            "answer": "<p>You may post on Instagram, TikTok, YouTube, Facebook, or X. Use #CaughtOnGKU and tag the official GKU account for that platform.</p>"
          }
        },
        "item_nUbrTC": {
          "type": "item",
          "settings": {
            "question": "What kind of footage can I enter?",
            "answer": "<p>Original close calls, road incidents, night driving, weather, unexpected moments, scenic drives, and other compelling road moments are welcome.</p>"
          }
        },
        "item_MHHjtz": {
          "type": "item",
          "settings": {
            "question": "Can the same video be entered more than once?",
            "answer": "<p>Submit each original road moment once. Reposted, copied, or misleading entries may be excluded from judging.</p>"
          }
        }
      },
      "block_order": [
        "item_9QVAJB",
        "item_ptYhkj",
        "item_XaipDA",
