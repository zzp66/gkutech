    "xtu_faq_nCz9r8": {
      "type": "xtu-faq",
      "blocks": {
        "item_DjGhde": {
          "type": "item",
          "settings": {
            "question": "Do I have to use a GKU dash cam?",
            "answer": "<p>Yes. Activity 02 footage must be recorded with the eligible GKU dash cam connected to your refund claim.</p>"
          }
        },
        "item_MQQUbX": {
          "type": "item",
          "settings": {
            "question": "What video quality is required?",
            "answer": "<p>1080P or higher is recommended. Clear SD-card original files are preferred whenever possible.</p>"
          }
        },
        "item_CxMWqP": {
          "type": "item",
          "settings": {
            "question": "Is the GKU watermark required?",
            "answer": "<p>Yes. Include an exported copy showing the GKU watermark. TikTok, Instagram, or other platform watermarks are not accepted.</p>"
          }
        },
        "item_PgmYLD": {
          "type": "item",
          "settings": {
            "question": "Can I submit more than one video?",
            "answer": "<p>Yes. The three videos counted toward the refund must feature three different valid events or scenes.</p>"
          }
        },
        "item_RtJb4b": {
          "type": "item",
          "settings": {
            "question": "How will I know if my footage has been selected?",
            "answer": "<p>GKU may reply to your post or contact you through your tagged social account. However, footage counts as officially selected only after confirmation from an official GKU email.</p>"
          }
        },
        "item_qgMXWM": {
          "type": "item",
          "settings": {
            "question": "Where will selected footage be featured?",
            "answer": "<p>Selected footage may be shared across GKU’s official social media channels and featured in a future footage gallery on the GKU website.</p>"
          }
        },
        "item_maL7Dd": {
          "type": "item",
          "settings": {
            "question": "How should I send large files?",
            "answer": "<p>Upload large files to Google Drive, Dropbox, OneDrive, or WeTransfer, enable download access, and email the shareable link to GKU.</p>"
          }
        },
        "item_FGA4p8": {
          "type": "item",
          "settings": {
            "question": "When will I receive my dash cam refund?",
            "answer": "<p>Once three different eligible videos have been officially selected and used by <a href=\"https://www.gkutech.com/\" target=\"_blank\">GKU</a>, we will confirm your refund eligibility and begin processing the refund. One refund is available per person and device; gifted products and review samples are not eligible.</p>"
          }
        }
      },
