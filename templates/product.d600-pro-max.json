    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "What video resolution does the GKU D600 Pro Max record?",
            "answer": "<p>The GKU D600 Pro Max records in <strong>4K UHD (3840 × 2160P) at 30fps from the front camera and 1080P (1920 × 1080P) from the rear camera</strong>, providing front and rear coverage to help capture important road details from both directions.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Does the D600 Pro Max use Sony STARVIS 2?",
            "answer": "<p>Yes. The D600 Pro Max features <strong>Sony STARVIS 2 imaging technology</strong>, designed to deliver clearer footage in challenging lighting conditions. Combined with WDR imaging, it helps preserve more useful road detail at night and in high-contrast scenes such as bright headlights, streetlights, shadows, and tunnels.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "Is the D600 Pro Max good for night driving?",
            "answer": "<p>Yes. The combination of <strong>Sony STARVIS 2 and WDR</strong> helps the D600 Pro Max capture clearer footage in low-light and high-contrast driving environments. This makes it particularly suitable for drivers who frequently commute or travel after dark.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Does the D600 Pro Max have WiFi 6?",
            "answer": "<p>Yes. The D600 Pro Max supports <strong>dual-band 2.4GHz and 5.8GHz WiFi</strong>, allowing you to connect the dash cam to the GKU GO app to preview, manage, and download recordings.</p><p>For faster video transfers, 5.8GHz WiFi is recommended when supported by your smartphone. 2.4GHz provides broader device compatibility.</p>"
          }
        },
        "item_EEHTma": {
          "type": "item",
          "settings": {
            "question": "Can I view the D600 Pro Max remotely when I am away from my car?",
            "answer": "<p>No. The D600 Pro Max uses WiFi for a <strong>local connection between the dash cam and your smartphone</strong>. It does not support cellular connectivity, cloud viewing, or remote live monitoring when you are away from the vehicle.</p><p>For remote vehicle monitoring, consider a compatible GKU 4G LTE dash cam instead.</p>"
          }
        },
        "item_TXqWqp": {
          "type": "item",
          "settings": {
            "question": "Does the D600 Pro Max support voice control?",
            "answer": "<p>Yes. The D600 Pro Max supports <strong>hands-free voice control for selected camera functions</strong>, allowing you to operate key features without reaching for the dash cam while driving.</p>"
          }
        },
        "item_jchhnT": {
          "type": "item",
          "settings": {
            "question": "Does the D600 Pro Max support 24-hour parking monitoring?",
            "answer": "<p>Yes. When connected to a compatible hardwire kit, the D600 Pro Max supports <strong>24-hour parking monitoring</strong>, including features such as time-lapse recording and collision detection to help capture important events while your vehicle is parked.</p><p>A compatible hardwire kit is required for parking monitoring and is sold separately.</p>"
          }
        },
        "item_bpw7Lj": {
          "type": "item",
          "settings": {
            "question": "What happens when the memory card is full?",
            "answer": "<p>The D600 Pro Max supports <strong>loop recording</strong>. When the memory card becomes full, the dash cam automatically overwrites the oldest unlocked normal recordings so it can continue recording without requiring you to manually delete files.</p><p>Important emergency or locked recordings are protected from normal loop overwriting.</p>"
          }
        },
        "item_FBgy6K": {
          "type": "item",
          "settings": {
            "question": "What microSD card does the D600 Pro Max support?",
            "answer": "<p>The D600 Pro Max supports <strong>32GB to 512GB microSD cards</strong>. For reliable 4K recording, we recommend using a high-endurance card rated <strong>U3/V30 or higher</strong>.</p><p>For best stability, format the memory card through the GKU GO app before first use.</p>"
          }
        },
        "item_n4TjnG": {
          "type": "item",
          "settings": {
            "question": "Is a memory card included with the D600 Pro Max?",
            "answer": "<p>Memory card availability depends on the package you select. Some D600 Pro Max packages may include a memory card, while others may not.</p><p>Please check the selected package contents before placing your order.</p>"
          }
        }
      },
