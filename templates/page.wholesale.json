        "ai_gen_block_54e8ec3_DCPpax": {
          "type": "ai_gen_block_54e8ec3",
          "settings": {
            "email_address": "marketing.gku@gkutech.com",
            "button_label": "Request a Wholesale Quote",
            "empty_state_text": "Add an email address to activate this button",
            "desktop_width_percent": 100,
            "text_size": 16,
            "border_radius": 16,
            "border_width": 0,
