        "ai_gen_block_d149a36_eb4969": {
          "type": "ai_gen_block_d149a36",
          "settings": {
            "eyebrow": "GKU BUSINESS",
            "title": "Wholesale Business",
            "policy_content": "<h2>Partner with GKU for Smarter Automotive Imaging</h2><p>GKU provides flexible wholesale and business solutions for distributors, retailers, fleet operators, automotive businesses, corporate buyers, and professional partners worldwide.</p><p>From 4K front and rear dash cams to multi-channel and connected vehicle camera solutions, GKU offers a growing product portfolio designed for different markets, vehicles, and business applications.</p><p>Whether you're looking to purchase GKU dash cams in bulk, expand your automotive product portfolio, equip a commercial fleet, or explore a long-term distribution partnership, our business team is ready to support your needs.</p><p>Business Inquiry: marketing.gku@gkutech.com</p>",
            "desktop_width_percent": 100,
            "content_max_width": 900,
            "heading_size": 48,
            "body_size": 14,
            "padding_top": 0,
