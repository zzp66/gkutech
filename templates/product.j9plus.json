    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "What is included in the box?",
            "answer": "<ul><li>J9 Plus Video Doorbell × 1</li><li>Wireless Indoor Chime × 1</li><li>USB Charging Cable × 1</li><li>Mounting Accessories</li><li>Adhesive Strips</li><li>Reset Pin × 1</li><li>User Manual × 1</li></ul>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Does the doorbell require a subscription?",
            "answer": "<p>No subscription is required for basic operation or local microSD card recording. Free 6-second basic cloud clips are also available. Optional extended cloud recording services may require a paid subscription.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "What type of microSD card should I use?",
            "answer": "<p>The J9 Plus supports 32–128GB microSD cards. We recommend using a reliable Class 10 high-speed card and formatting it in the app before first use. The microSD card is not included.</p>"
          }
        },
        "item_gVqTnH": {
          "type": "item",
          "settings": {
            "question": "Does the J9 Plus support 5GHz Wi-Fi?",
            "answer": "<p>No. The doorbell supports 2.4GHz Wi-Fi only. During setup, make sure your phone and doorbell are connected to a compatible 2.4GHz network.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Where can I download the app?",
            "answer": "<p>Search for the official XTU app in the App Store or Google Play.</p>"
          }
        },
        "item_j6WEmG": {
          "type": "item",
          "settings": {
            "question": "How long does the battery last?",
            "answer": "<p>Battery life depends on motion frequency, recording duration, live-view usage, night vision, temperature and Wi-Fi signal strength. Frequent notifications and live viewing will increase battery consumption.</p>"
          }
        },
        "item_em3G7r": {
          "type": "item",
          "settings": {
            "question": "Does it work with Alexa and Google Home?",
            "answer": "<p>Answer content goeYes. The J9 Plus works with compatible Alexa and Google Home smart displays. Available functions may vary by device, region and app version.s here.</p>"
          }
        },
        "item_P7UTmJ": {
          "type": "item",
          "settings": {
            "question": "Can the doorbell be used outdoors?",
            "answer": "<p>Yes. The J9 Plus has an IP66 weather-resistant design for outdoor use. Do not submerge it in water, and keep the charging port securely covered during operation.</p>"
          }
        },
        "item_DbqGFn": {
          "type": "item",
          "settings": {
            "question": "Can family members access the doorbell?",
            "answer": "<p>Yes. Device access can be shared with trusted family members through the companion app.</p>"
          }
        }
      },
