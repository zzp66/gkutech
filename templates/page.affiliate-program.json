    "xtu_faq_7BeaER": {
      "type": "xtu-faq",
      "blocks": {
        "item_4n6eVy": {
          "type": "item",
          "settings": {
            "question": "What is the GKU Affiliate Program?",
            "answer": "<p>The GKU Affiliate Program allows approved creators, publishers and partners to earn commission by referring eligible customers to GKU through tracked affiliate links.<br/></p>"
          }
        },
        "item_YLL7NE": {
          "type": "item",
          "settings": {
            "question": "Who can apply to become an GKU affiliate?",
            "answer": "<p>Content creators, YouTubers, bloggers, publishers, review websites, social media creators and other relevant partners may apply. Applications are reviewed before approval.<br/></p>"
          }
        },
        "item_amyeXC": {
          "type": "item",
          "settings": {
            "question": "How much commission can I earn?",
            "answer": "<p>Commission rates may vary by affiliate network, market or campaign. Please review the current terms displayed during your application through Impact.</p>"
          }
        },
        "item_gMhzzh": {
          "type": "item",
          "settings": {
            "question": "How do I join the GKU Affiliate Program?",
            "answer": "<p>Apply through one of GKU's supported affiliate networks. Once approved, you can access available tracking links and promotional resources and begin referring customers.</p>"
          }
        },
        "item_z7MaFg": {
          "type": "item",
          "settings": {
            "question": "Do I need to own an GKU product to become an affiliate?",
            "answer": "<p>Product ownership is not necessarily required to apply. However, partners should create accurate, useful and responsible promotional content about the products they recommend.</p>"
          }
        },
        "item_BGr3tD": {
          "type": "item",
          "settings": {
            "question": "Can YouTubers and social media creators join?",
            "answer": "<p>Yes. Relevant YouTube, TikTok, Instagram and other social media creators may apply to the GKU Affiliate Program.</p>"
          }
        },
        "item_bT9Hpx": {
          "type": "item",
          "settings": {
            "question": "Where can I track my affiliate sales?",
            "answer": "<p>Approved affiliates can track available clicks, conversions and commissions through the dashboard of the affiliate network they joined.</p>"
          }
        }
      },
      "block_order": [
        "item_4n6eVy",
