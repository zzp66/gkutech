    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D600 record in 4K?",
            "answer": "<p>Yes. The GKU D600 records the road ahead in <strong>4K UHD</strong>, helping capture clearer road details during everyday driving.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Is the GKU D600 a front and rear dash cam?",
            "answer": "<p>Yes. The D600 is a <strong>dual-channel front and rear dash cam</strong>, recording in <strong>4K from the front camera and 1080P from the rear camera</strong> for more complete coverage of your drive.</p>"
          }
        },
        "item_DHfHGc": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D600 have WiFi?",
            "answer": "<p>Yes. The D600 features built-in <strong>5GHz WiFi</strong>, allowing you to connect the dash cam to a compatible smartphone app to preview recordings, download important footage, and manage camera settings.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "Can I view the D600 remotely when I am away from my vehicle?",
            "answer": "<p>No. The D600's WiFi provides a <strong>local connection between the dash cam and your smartphone</strong>. It does not provide 4G cellular connectivity or remote live monitoring when you are away from your vehicle.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Does the D600 support parking monitoring?",
            "answer": "<p>Yes. The D600 supports parking monitoring when connected to a <strong>compatible hardwire kit</strong>, helping capture important events while your vehicle is parked.</p><p>A compatible hardwire kit is required for extended parking monitoring and may be sold separately.</p>"
          }
        },
        "item_pwAxfr": {
          "type": "item",
          "settings": {
            "question": "How does the G-Sensor work on the D600?",
            "answer": "<p>The built-in <strong>G-Sensor</strong> detects sudden impacts or unusual vehicle movement. When a significant event is detected, the D600 can automatically protect the relevant video file from normal loop overwriting.</p>"
          }
        },
        "item_GzMt37": {
          "type": "item",
          "settings": {
            "question": "Does the GKU D600 come with a memory card?",
            "answer": "<p>The D600 package includes a <strong>64GB microSD card</strong>, so you can set up the dash cam and start recording without purchasing a separate memory card.</p><p>Package contents may vary by region or promotion. Please check the selected package before ordering.</p>"
          }
        }
      },
