3937_006.png?v=1786092220\"\n              alt=\"The Gadgeteer\">\n          </a>\n\n          <a class=\"gku-pr-logo\"\n             href=\"https://www.neozone.org/bon-plan/black-friday-2025-profitez-de-remises-exclusives-sur-les-dashcams-gku-4k/\"\n             target=\"_blank\"\n             rel=\"noopener noreferrer\"\n             aria-label=\"Read GKU coverage on NeozOne\">\n            <img\n              src=\"https://cdn.shopify.com/s/files/1/0637/6135/0883/files/DM_20260807163937_005_1df78369-664d-4f5b-9242-08559dcfc21c.jpg?v=1786092303\"\n              alt=\"NeozOne\">\n          </a>\n\n        </div>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<style>\n.gku-pr-section {\n  width: 100%;\n  padding: 48px 0;\n  background: #ffffff;\n}\n\n.gku-pr-inner {\n  width: min(100% - 40px, 1320px);\n  margin: 0 auto;\n}\n\n.gku-pr-title {\n  margin: 0 0 34px;\n  text-align: center;\n  font-size: 30px;\n  line-height: 1.2;\n  font-weight: 800;\n  letter-spacing: 4px;\n  color: #111111;\n}\n\n.gku-pr-marquee {\n  width: 100%;\n  overflow: hidden;\n  position: relative;\n}\n\n.gku-pr-track {\n  display: flex;\n  align-items: center;\n  width: max-content;\n  animation: gku-pr-scroll 34s linear infinite;\n}\n\n.gku-pr-group {\n  display: flex;\n  align-items: center;\n  gap: 56px;\n  flex-shrink: 0;\n  padding-right: 56px;\n}\n\n.gku-pr-logo {\n  width: 170px;\n  height: 70px;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  text-decoration: none;\n}\n\n.gku-pr-logo img {\n  display: block;\n  width: auto;\n  height: auto;\n  max-width: 155px;\n  max-height: 44px;\n  object-fit: contain;\n  opacity: 1;\n  transition: transform .25s ease, opacity .25s ease;\n}\n\n.gku-pr-logo:hover img {\n  transform: scale(1.06);\n}\n\n.gku-pr-marquee:hover .gku-pr-track {\n  animation-play-state: paused;\n}\n\n@keyframes gku-pr-scroll {\n  from {\n    transform: translateX(0);\n  }\n  to {\n    transform: translateX(-50%);\n  }\n}\n\n@media screen and (max-width: 749px) {\n  .gku-pr-section {\n    padding: 34px 0;\n  }\n\n  .gku-pr-inner {\n    width: min(100% - 24px, 1320px);\n  }\n\n  .gku-pr-title {\n    margin-bottom: 24px;\n    font-size: 22px;\n    letter-spacing: 3px;\n  }\n\n  .gku-pr-group {\n    gap: 34px;\n    padding-right: 34px;\n  }\n\n  .gku-pr-logo {\n    width: 125px;\n    height: 58px;\n  }\n\n  .gku-pr-logo img {\n    max-width: 118px;\n    max-height: 34px;\n  }\n\n  .gku-pr-track {\n    animation-duration: 26s;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .gku-pr-track {\n    animation: none;\n  }\n\n  .gku-pr-marquee {\n    overflow-x: auto;\n  }\n}\n</style>\n\n<script>\n(function () {\n  const track = document.getElementById('gkuPrTrack');\n  if (!track || track.dataset.ready === 'true') return;\n\n  const firstGroup = track.querySelector('.gku-pr-group');\n  if (!firstGroup) return;\n\n  const secondGroup = firstGroup.cloneNode(true);\n  secondGroup.setAttribute('aria-hidden', 'true');\n  track.appendChild(secondGroup);\n\n  track.dataset.ready = 'true';\n})();\n</script>",
