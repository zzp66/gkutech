    "xtu_faq_7wnDnw": {
      "type": "xtu-faq",
      "blocks": {
        "item_4GJ9de": {
          "type": "item",
          "settings": {
            "question": "What payment methods do you accept?",
            "answer": "<p>We accept major payment methods available at checkout, including credit/debit cards, G-Pay and selected digital payment options.</p><p>Available methods may vary by country or region.</p>"
          }
        },
        "item_GKqEa9": {
          "type": "item",
          "settings": {
            "question": "How do I use a discount code?",
            "answer": "<p>Enter your code in the <strong>Discount Code</strong> field at checkout and click <strong>Apply</strong>.</p><p>Please check the promotion terms if your code does not work.</p>"
          }
        },
        "item_jghUcB": {
          "type": "item",
          "settings": {
            "question": "Can I use multiple discount codes?",
            "answer": "<p>Generally, only one discount code can be used per order unless otherwise stated.</p>"
          }
        },
        "item_443y69": {
          "type": "item",
          "settings": {
            "question": "Do you offer discounts for bulk orders?",
            "answer": "<p>Yes. For bulk purchases, wholesale inquiries, or business partnerships, please contact:</p><p><a href=\"mailto:marketing.xtu@xtucam.com\"><strong>marketing.xtu@xtucam.com</strong></a></p>"
          }
        }
      },
      "block_order": [
