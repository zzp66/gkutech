    "xtu_faq_fnt4xc": {
      "type": "xtu-faq",
      "blocks": {
        "item_EETz8k": {
          "type": "item",
          "settings": {
            "question": "Where does XTU ship?",
            "answer": "<p>XTU ships to selected countries and regions worldwide.</p><p>Available shipping methods depend on your destination, product availability, and warehouse location. The options available for your address will be shown at checkout.</p>"
          }
        },
        "item_7EUJDx": {
          "type": "item",
          "settings": {
            "question": "How long does order processing take?",
            "answer": "<p>Most orders are processed within <strong>1–2 business days</strong> after payment is confirmed.</p><p>Processing may take slightly longer during weekends, holidays, product launches, or major sales events.</p>"
          }
        },
        "item_DbgbNT": {
          "type": "item",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Estimated delivery times are:</p><p><strong>Express Shipping:</strong> 3–5 business days<br/><strong>Standard Shipping:</strong> 5–15 business days</p><p>Delivery times may vary depending on your location, warehouse availability, customs, and carrier conditions.</p>"
          }
        },
        "item_7gmbhL": {
          "type": "item",
          "settings": {
            "question": "Do you offer free shipping?",
            "answer": "<p>Yes. <strong>Standard Shipping is free on orders of $49.99 or more</strong> where available.</p><p>Actual shipping options and fees will be shown at checkout.</p>"
          }
        },
        "item_HTV3d3": {
          "type": "item",
          "settings": {
            "question": "Will I need to pay customs duties or taxes?",
            "answer": "<p>XTU offers <strong>DDP (Delivered Duty Paid)</strong> shipping for eligible destinations, meaning applicable import duties and taxes are generally handled through the shipping service.</p><p>If DDP is unavailable, additional local duties or taxes may apply.</p>"
          }
        }
      },
