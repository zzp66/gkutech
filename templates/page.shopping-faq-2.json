    "xtu_faq_jpDtFV": {
      "type": "xtu-faq",
      "blocks": {
        "item_dgQJzd": {
          "type": "item",
          "settings": {
            "question": "How do I place an order?",
            "answer": "<p>Select your product, click <strong>Add to Cart</strong> or <strong>Buy It Now</strong>, and follow the checkout steps to complete your order.</p><p>You’ll receive a confirmation email once your order is placed successfully.</p>"
          }
        },
        "item_EzttCd": {
          "type": "item",
          "settings": {
            "question": "Can I change or cancel my order?",
            "answer": "<p>Please contact <a href=\"mailto:support@xtucam.com\"><strong>support@xtucam.com</strong></a> as soon as possible.</p><p>If your order has not been shipped, we may be able to update or cancel it. Once shipped, changes may no longer be possible.</p>"
          }
        },
        "item_aGXGdJ": {
          "type": "item",
          "settings": {
            "question": "Can I change my shipping address?",
            "answer": "<p>Yes, if your order has not yet shipped. Contact <a href=\"mailto:support@xtucam.com\"><strong>support@xtucam.com</strong></a> with your order number and the correct address as soon as possible.</p>"
          }
        }
      },
      "block_order": [
        "item_dgQJzd",
        "item_EzttCd",
        "item_aGXGdJ"
      ],
