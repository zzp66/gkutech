    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "Does the C300 include a microSD card?",
            "answer": "<p>Yes. A 64GB microSD card is included and pre-installed. The C300 supports microSD cards from 64GB to 512GB, and a U3/V30 or faster card is recommended.<br/><br/></p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Does the C300 support 24-hour parking monitoring?",
            "answer": "<p>Yes. The C300 supports impact detection and time-lapse parking recording. A compatible GKU hardwire kit is required and sold separately.<br/><br/></p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "Can I view and download videos on my phone?",
            "answer": "<p>Yes. Connect the C300 to the GKU GO app through Wi-Fi to preview footage, play back recordings, download videos and adjust settings from your phone. <br/><br/></p>"
          }
        },
        "item_gVqTnH": {
          "type": "item",
          "settings": {
            "question": "Can I remotely view the C300 when I'm away from the car?",
            "answer": "<p>No. The C300 uses short-range local Wi-Fi for connecting your phone to the dash cam. It does not support cloud or remote viewing when you are away from the vehicle.<br/><br/></p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Does the C300 record all three cameras at the same time?",
            "answer": "<p>Yes. The GKU C300 records the front, cabin and rear cameras simultaneously, with 4K front, 1080P cabin and 4K rear recording for more complete coverage around your vehicle. <br/><br/></p>"
          }
        },
        "item_j6WEmG": {
          "type": "item",
          "settings": {
            "question": "Is the GKU C300 suitable for Uber, Lyft and rideshare drivers?",
            "answer": "<p>Yes. Its front, cabin and rear cameras help record road conditions, passenger-area activity and events behind the vehicle, making it especially useful for rideshare, taxi and other professional drivers.<br/></p>"
          }
        }
      },
