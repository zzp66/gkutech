    "xtu_rich_content_Q7NFYk": {
      "type": "xtu-rich-content",
      "blocks": {
        "paragraph_G7Hm3P": {
          "type": "paragraph",
          "settings": {
            "text": "Whether you're commuting to work, driving for Uber or Lyft, or taking long road trips, every journey deserves complete protection. The GKU C300 is designed to capture every important moment with its three-channel recording system, providing simultaneous coverage of the road ahead, the vehicle interior, and what's happening behind you.\n\nUnlike standard front-only dash cams, with 4K front, 1080P interior and 4K rear recording, the C300 delivers a full 360° perspective, helping protect you from false claims, capture valuable evidence in the event of an accident, and give you greater peace of mind wherever you drive.",
            "align": "left",
            "font_size": 20,
            "font_size_mobile": 14,
            "text_color": "#333333",
            "spacing": 24,
            "spacing_mobile": 16
          }
        },
