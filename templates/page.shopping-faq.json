    "xtu_faq_HeFV8t": {
      "type": "xtu-faq",
      "blocks": {
        "item_TYBd9A": {
          "type": "item",
          "settings": {
            "question": "Why hasn't my tracking information updated?",
            "answer": "<p>Carrier tracking may occasionally take time to refresh.</p><p>If there has been no update for several business days, please contact <a href=\"mailto:support@xtucam.com\"><strong>support@xtucam.com</strong></a> with your order number and tracking number.</p>"
          }
        },
        "item_P3fwiL": {
          "type": "item",
          "settings": {
            "question": "Is this waterproof?",
            "answer": "<p>Please check the product specifications for waterproof rating and recommended usage.</p>"
          }
        },
        "item_E7Qjtg": {
          "type": "item",
          "settings": {
            "question": "My package says “Delivered,” but I can't find it. What should I do?",
            "answer": "<p>Please check around the delivery location and contact the carrier first.</p><p>If you still cannot locate the package, contact <a href=\"mailto:support@xtucam.com\"><strong>support@xtucam.com</strong></a> and we’ll help investigate.</p>"
          }
        }
      },
