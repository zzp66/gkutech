    "xtu_faq_zmJJ6h": {
      "type": "xtu-faq",
      "blocks": {
        "item_qBggkp": {
          "type": "item",
          "settings": {
            "question": "How long is the GKU dash cam warranty?",
            "answer": "<p>Eligible GKU dash cams include a <strong>1-year standard manufacturer's warranty</strong> from the original purchase date. Eligible products may receive an additional <strong>1-year warranty extension after successful registration</strong>, providing up to <strong>2 years of total manufacturer warranty coverage</strong>.</p>"
          }
        },
        "item_4FCiqP": {
          "type": "item",
          "settings": {
            "question": "How do I extend my GKU warranty?",
            "answer": "<p>Register your eligible GKU dash cam through the GKU Product Registration page. After successful registration, eligible dash cam main units may receive an additional 12 months of manufacturer warranty coverage.</p>"
          }
        },
        "item_d9gEzf": {
          "type": "item",
          "settings": {
            "question": "When does my GKU warranty begin?",
            "answer": "<p>The warranty begins on the original purchase date shown on valid proof of purchase. Product registration extends eligible coverage but does not restart the warranty period.</p>"
          }
        },
        "item_jT3bgU": {
          "type": "item",
          "settings": {
            "question": "What does the GKU warranty cover?",
            "answer": "<p>The GKU manufacturer's warranty covers eligible defects in materials or workmanship that occur during normal use within the applicable warranty period. Please review the full GKU Warranty Policy for coverage, exclusions, and claim requirements.</p>"
          }
        },
        "item_acdcqJ": {
          "type": "item",
          "settings": {
            "question": "Is accidental or liquid damage covered by the GKU warranty?",
            "answer": "<p>Accidental damage, impact damage, liquid damage, misuse, unauthorized modification, and other damage unrelated to an eligible manufacturing defect are generally not covered by the manufacturer's warranty.</p>"
          }
        },
        "item_Qz6KWA": {
          "type": "item",
          "settings": {
            "question": "How do I make a GKU warranty claim?",
            "answer": "<p>Contact GKU Support with your order number, product model, purchase information, a description of the issue, and supporting photos or videos where applicable. Our support team may guide you through troubleshooting before determining the appropriate warranty solution.</p>"
          }
        },
        "item_49wwYK": {
          "type": "item",
          "settings": {
            "question": "Is the return period the same as the warranty period?",
            "answer": "<p>No. The Return & Refund Policy applies to eligible return and refund requests within the applicable return period, while the <a href=\"/pages/warranty-policy\" target=\"_blank\" title=\"Warranty Policy\">Warranty Policy</a> covers eligible manufacturing defects during the applicable manufacturer warranty period.</p>"
          }
        },
        "item_8C8Gnq": {
          "type": "item",
          "settings": {
            "question": "Where can I download the app?",
            "answer": "<p>Search for the official XTU app in the App Store or Google Play.</p>"
          }
        }
      },
