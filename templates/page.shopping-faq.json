    "xtu_faq_XETYNK": {
      "type": "xtu-faq",
      "blocks": {
        "item_g3KXkA": {
          "type": "item",
          "settings": {
            "question": "What Payment Methods Does XTU Accept?",
            "answer": "<p>XTU offers several secure and convenient payment methods. Depending on your country, currency, device, and checkout availability, you may be able to pay using:</p><ul><li>Visa</li><li>Mastercard</li><li>American Express</li><li>Discover</li><li>PayPal</li><li>Google Pay</li></ul><p>The payment methods available for your specific order will be displayed at checkout.</p>"
          }
        },
        "item_aDxrPg": {
          "type": "item",
          "settings": {
            "question": "Does XTU Accept PayPal?",
            "answer": "<p>Yes. XTU accepts <strong>PayPal</strong> for eligible orders and destinations.</p><p>PayPal allows you to complete your purchase using your PayPal balance or a supported payment card linked to your PayPal account.</p><p>When you select PayPal at checkout, you may be redirected to PayPal to securely complete your payment.</p><p>If PayPal is not displayed at checkout, it may not be available for your current country, currency, product, or order.</p>"
          }
        },
        "item_YJaMrV": {
          "type": "item",
          "settings": {
            "question": "Can I Pay with Google Pay?",
            "answer": "<p>Yes. <strong>Google Pay</strong> is available for eligible XTU orders where supported.</p><p>You can use Google Pay with a supported device, browser, Google account, and payment card.</p><p>If Google Pay is available for your order, it will be displayed as a payment option during checkout.</p><p>Payment options may vary depending on your country, device, browser, currency, and other checkout conditions.</p>"
          }
        },
        "item_RNVRnE": {
          "type": "item",
          "settings": {
            "question": "Is My Payment Information Secure?",
            "answer": "<p>Yes. XTU takes payment security seriously. Payments are processed through secure payment systems and payment providers designed to protect your payment information during checkout. XTU does not directly store your complete credit or debit card details on our servers. For additional security, your bank or payment provider may require verification before your payment can be completed. We recommend using only trusted devices and secure internet connections when making a payment.<br/><br/></p>"
          }
        },
        "item_x7PtV3": {
          "type": "item",
          "settings": {
            "question": "Why Was My Payment Declined?",
            "answer": "<p>A payment may be declined for several reasons, including:</p><ul><li>Incorrect card or billing information</li><li>Insufficient funds or available credit</li><li>Expired or blocked payment card</li><li>Bank or card issuer restrictions</li><li>Payment verification failure</li><li>Country or regional payment restrictions</li><li>Security or fraud-prevention checks</li><li>Temporary issues with the payment provider</li></ul><p>If your payment is declined, please check your payment information and try again.</p><p>You can also try another available payment method, such as PayPal, Google Pay, or another supported card.</p><p>If the problem continues, please contact your bank or payment provider first. You can also contact XTU Customer Support for assistance.</p><p><strong>Email:</strong> <a href=\"mailto:support@xtucam.com\">support@xtucam.com</a></p>"
          }
        }
      },
