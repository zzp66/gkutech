    "xtu_faq_cpaDnR": {
      "type": "xtu-faq",
      "blocks": {
        "item_cdRqUi": {
          "type": "item",
          "settings": {
            "question": "What is GKU's return policy?",
            "answer": "<p>GKU accepts eligible returns in accordance with the current GKU Return & Refund Policy. Eligibility may depend on the purchase date, product condition, reason for return, purchase channel, and other applicable conditions.</p>"
          }
        },
        "item_WKRptn": {
          "type": "item",
          "settings": {
            "question": "How do I request a return?",
            "answer": "<p>Contact GKU Support before returning your product. Please provide your order number, product model, reason for return, and supporting photos or videos where applicable. Our team will review your request and provide return instructions if approved.</p>"
          }
        },
        "item_bCeAiD": {
          "type": "item",
          "settings": {
            "question": "Can I return a product without contacting GKU first?",
            "answer": "<p>No. Please contact GKU Support before sending any product back. Unauthorized returns may be delayed or may not be correctly identified and processed.</p>"
          }
        },
        "item_pD7rDt": {
          "type": "item",
          "settings": {
            "question": "How will I receive my refund?",
            "answer": "<p>Approved refunds are generally issued to the original payment method used for the purchase. The time required for the refund to appear in your account may vary depending on your bank, card issuer, or payment provider.</p>"
          }
        },
        "item_8dLfQN": {
          "type": "item",
          "settings": {
            "question": "What should I do if my GKU product arrives damaged?",
            "answer": "<p>Contact GKU Support as soon as reasonably possible. Please provide your order number and clear photos or videos of the shipping package, shipping label, product packaging, and damaged product. Keep the original packaging until your case has been reviewed.</p>"
          }
        },
        "item_bYAtDY": {
          "type": "item",
          "settings": {
            "question": "What should I do if I receive the wrong product?",
            "answer": "<p>Contact GKU Support with your order number and photos of the product and package you received. Our team will review the issue and provide the appropriate next steps.<br/></p>"
          }
        }
      },
