    "xtu_faq_FkpnX6": {
      "type": "xtu-faq",
      "blocks": {
        "item_CELKjj": {
          "type": "item",
          "settings": {
            "question": "Which countries does GKU ship to?",
            "answer": "<p>GKU ships to supported countries and regions worldwide, subject to product availability and available logistics services. Enter your delivery address at checkout to see the shipping options currently available for your order.</p>"
          }
        },
        "item_h4xLqJ": {
          "type": "item",
          "settings": {
            "question": "How long does GKU take to process an order?",
            "answer": "<p>Most GKU orders are processed within <strong>1–2 business days</strong> after payment confirmation. Processing may take longer during holidays, major promotions, new product launches, or periods of unusually high order volume.</p>"
          }
        },
        "item_FnXGw4": {
          "type": "item",
          "settings": {
            "question": "How long does GKU shipping take?",
            "answer": "<p>Estimated delivery times depend on the destination and shipping method. Express shipping typically takes approximately <strong>3–7 business days</strong>, while standard shipping typically takes approximately <strong>5–10 business days</strong> after the order has shipped. Delivery times are estimates and may be affected by customs, weather, carrier delays, or holidays.</p>"
          }
        },
        "item_fXCRr9": {
          "type": "item",
          "settings": {
            "question": "How much does GKU shipping cost?",
            "answer": "<p>Shipping costs depend on the product, order value, destination, and available shipping method. The applicable shipping fee will be displayed at checkout before you complete your purchase.</p>"
          }
        },
        "item_JJUqjD": {
          "type": "item",
          "settings": {
            "question": "Does GKU offer free shipping?",
            "answer": "<p>Free standard shipping may be available for eligible orders that meet the applicable order-value requirement. Availability can vary by product and destination. Please check the shipping options displayed at checkout.</p>"
          }
        },
        "item_VFf48w": {
          "type": "item",
          "settings": {
            "question": "Does GKU ship from local warehouses?",
            "answer": "<p>Whenever possible, GKU may fulfill orders from local or regional warehouses based on your destination and available inventory. This can help provide faster and more efficient delivery.</p>"
          }
        },
        "item_8Gmzhw": {
          "type": "item",
          "settings": {
            "question": "What happens if the nearest GKU warehouse is out of stock?",
            "answer": "<p>If the product is unavailable at the nearest warehouse, GKU may fulfill your order from another available warehouse or shipping origin. This may result in a longer delivery time.</p>"
          }
        },
        "item_zBHpUT": {
          "type": "item",
          "settings": {
            "question": "Does GKU offer international shipping?",
            "answer": "<p>Yes, international shipping is available to supported destinations. Shipping options, fees, delivery times, customs requirements, and product availability may vary by country or region.</p>"
          }
        },
        "item_AQEbcL": {
          "type": "item",
          "settings": {
            "question": "Does GKU offer DDP shipping?",
            "answer": "<p>DDP (Delivered Duty Paid) shipping may be available for selected destinations, products, and shipping methods. Availability can vary depending on current logistics services. Please check the available options at checkout or contact GKU Support for confirmation.</p>"
          }
        },
        "item_q7ygyw": {
          "type": "item",
          "settings": {
            "question": "Will I have to pay customs duties or import taxes?",
            "answer": "<p>International orders may be subject to customs duties, import taxes, or clearance fees depending on the destination. Where DDP shipping is available, applicable duties and taxes may be handled as part of the shipping arrangement. Otherwise, the recipient may be responsible for charges required by local authorities.</p>"
          }
        },
        "item_NBpnw6": {
          "type": "item",
          "settings": {
            "question": "How can I track my GKU order?",
            "answer": "<p>Once your order has shipped, you will receive a shipping confirmation email with available tracking information. Tracking may take some time to become active after the carrier receives your package.</p>"
          }
        },
        "item_k9zJRc": {
          "type": "item",
          "settings": {
            "question": "My tracking says delivered, but I can't find my package. What should I do?",
            "answer": "<p>Check entrances, mailrooms, reception areas, garages, and other possible delivery locations. You may also want to ask household members, neighbors, or building staff. If the package is still missing after 24 hours, contact GKU Support with your order number and tracking number for assistance.</p>"
          }
        }
      },
