          "settings": {
            "question": "Does GKU offer wholesale or bulk pricing?",
            "answer": "<p>Yes. GKU welcomes inquiries from distributors, retailers, fleet operators, corporate buyers, automotive businesses, and other eligible partners. Visit the GKU Wholesale & Business Solutions page to request a business quotation.</p>"
          }
        },
        "item_7WrwCM": {
          "type": "item",
          "settings": {
            "question": "Can I purchase GKU dash cams for a fleet or corporate project?",
            "answer": "<p>Yes. GKU supports selected fleet, corporate, and bulk-purchase projects. Contact our business team with your target products, estimated quantity, destination, and project requirements to discuss available solutions.</p>"
          }
        }
