    "xtu_faq_eYencV": {
      "type": "xtu-faq",
      "blocks": {
        "item_tM79Th": {
          "type": "item",
          "settings": {
            "question": "How do I place an order on the GKU website?",
            "answer": "<p>Choose the GKU dash cam or accessory you want, select the available options, and click <strong>Add to Cart</strong> or <strong>Buy Now</strong>. Enter your shipping and payment information at checkout and complete your purchase. Once your order is successfully placed, you will receive an order confirmation email.</p>"
          }
        },
        "item_8GGkJP": {
          "type": "item",
          "settings": {
            "question": "Do I need an account to place an order?",
            "answer": "<p>No. You can place an order without creating an account where guest checkout is available. Creating a GKU account, however, can make it easier to manage your order information and future purchases.</p>"
          }
        },
        "item_j38jCw": {
          "type": "item",
          "settings": {
            "question": "Can I change my order after placing it?",
            "answer": "<p>Please contact GKU Support as soon as possible if you need to change your order. We will try to accommodate your request before the order enters fulfillment. Once an order has been processed or shipped, changes may no longer be possible.</p>"
          }
        },
        "item_XLPN9M": {
          "type": "item",
          "settings": {
            "question": "Can I change my shipping address after placing an order?",
            "answer": "<p>Please contact GKU Support immediately if you notice an incorrect or incomplete shipping address. We will try to update it before fulfillment begins, but address changes cannot be guaranteed once the order has been processed or shipped.</p>"
          }
        },
        "item_iwzyCt": {
          "type": "item",
          "settings": {
            "question": "Can I cancel my GKU order?",
            "answer": "<p>Orders may generally be cancelled before they have been processed or shipped. Contact GKU Support as soon as possible. Once an order has entered fulfillment or has been handed to the carrier, cancellation may no longer be possible.</p>"
          }
        }
      },
      "block_order": [
        "item_tM79Th",
        "item_8GGkJP",
        "item_j38jCw",
        "item_XLPN9M",
        "item_iwzyCt"
      ],
