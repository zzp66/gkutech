    "xtu_faq_eYencV": {
      "type": "xtu-faq",
      "blocks": {
        "item_tM79Th": {
          "type": "item",
          "settings": {
            "question": "Can I return my order?",
            "answer": "<p>Eligible orders purchased from the official XTU website may be returned according to our<a href=\"https://xtucam.com/pages/return-and-refund\" target=\"_blank\" title=\"https://xtucam.com/pages/return-and-refund\"> <strong>Return & Refund Policy</strong></a>.</p><p>Please contact <a href=\"mailto:support@xtucam.com\"><strong>support@xtucam.com</strong></a> before sending any item back.</p>"
          }
        },
        "item_8GGkJP": {
          "type": "item",
          "settings": {
            "question": "What if my product arrives damaged or incorrect?",
            "answer": "<p>Please contact us with your <strong>order number, photos, or videos</strong> showing the issue.</p><p>Our support team will review the case and provide the appropriate solution.</p>"
          }
        },
        "item_j38jCw": {
          "type": "item",
          "settings": {
            "question": "How long does a refund take?",
            "answer": "<p>Once an eligible return has been received and inspected, we will process the refund to your original payment method.</p><p>The time it takes to appear in your account depends on your bank or payment provider.</p>"
          }
        }
      },
