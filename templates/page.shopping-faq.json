      "blocks": {
        "item_fAPg7H": {
          "type": "item",
          "settings": {
            "question": "How can I contact GKU Customer Support?",
            "answer": "<p>If you need help with an order, payment, shipping, return, warranty, or product issue, contact GKU Support at <a><strong>support@gkutech.com</strong></a> or through the official contact options listed on the GKU website. When contacting us about an existing order, please include your order number and product model whenever possible.</p>"
          }
        },
        "item_GhmeEp": {
          "type": "item",
          "settings": {
            "question": "What information should I provide when contacting GKU Support?",
            "answer": "<p>For order-related questions, provide your order number, purchaser name, and email address. For product-related issues, also include your product model, a description of the problem, and clear photos or videos where applicable.</p>"
          }
        }
      },
