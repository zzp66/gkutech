    "xtu_faq_hQz4T8": {
      "type": "xtu-faq",
      "blocks": {
        "item_VAhEUE": {
          "type": "item",
          "settings": {
            "question": "How do I use a GKU discount code?",
            "answer": "<p>Enter your valid discount code in the promotional code field during checkout and apply it before completing payment. If the code is valid and your order meets the promotion requirements, the discount will be reflected in your order total.</p>"
          }
        },
        "item_fGxxiz": {
          "type": "item",
          "settings": {
            "question": "Why isn't my GKU discount code working?",
            "answer": "<p>The code may have expired, apply only to selected products or customers, require a minimum purchase amount, have already been used, or be incompatible with another promotion. Please review the terms of the applicable offer.</p>"
          }
        },
        "item_7XThTm": {
          "type": "item",
          "settings": {
            "question": "Can I use more than one discount code?",
            "answer": "<p>Discount codes may not always be combined. Whether multiple promotions can be used together depends on the terms and checkout rules of the specific offers.</p>"
          }
        },
        "item_YWga9e": {
          "type": "item",
          "settings": {
            "question": "Does GKU offer student, teacher, military, or key worker discounts?",
            "answer": "<p>GKU may offer verified discounts to eligible groups through selected discount programs. Visit the GKU verified discount page to check current eligibility and available offers.</p>"
          }
        }
      },
