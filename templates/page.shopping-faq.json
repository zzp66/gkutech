    "xtu_faq_TgYaEL": {
      "type": "xtu-faq",
      "blocks": {
        "item_VQiN6n": {
          "type": "item",
          "settings": {
            "question": "How do I create an XTU account?",
            "answer": "<p>Creating an XTU account is quick and easy.</p><p>Click <a href=\"https://shopify.com/authentication/50136547494/login?analytics_trace_id=65e9fe45-0101-49e2-9634-c46a40308c34&client_id=2d1093e8-43e7-4c91-bc17-ce639c21f482&locale=en-US&redirect_uri=%2Fauthentication%2F50136547494%2Foauth%2Fauthorize%3Fanalytics_trace_id%3D65e9fe45-0101-49e2-9634-c46a40308c34%26buyer_flags%3DeyJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJodHRwLXd3dy14dHVjYW0tY29tLm15c2hvcGlmeS5jb20iLCJmbGFncyI6W10sImV4cCI6MTc4ODI1MDYxMywibmJmIjoxNzg3NjQ1ODEzfQ.EnYkNZ0MqBYvkWrMrXDus7sVWJ3qyh1pJn1dntKvPe8%26client_id%3D2d1093e8-43e7-4c91-bc17-ce639c21f482%26locale%3Den-US%26nonce%3D52dd7c3a-a409-43b9-a0aa-a58b3bf32dd3%26redirect_uri%3Dhttps%253A%252F%252Fshopify.com%252F50136547494%252Faccount%252Fcallback%26response_type%3Dcode%26scope%3Dopenid%2Bemail%2Bcustomer-account-api%253Afull%26state%3DhWNG3XOSaXrkrNOODBHiSM2j\" target=\"_blank\" title=\"https://shopify.com/authentication/50136547494/login?analytics_trace_id=65e9fe45-0101-49e2-9634-c46a40308c34&client_id=2d1093e8-43e7-4c91-bc17-ce639c21f482&locale=en-US&redirect_uri=%2Fauthentication%2F50136547494%2Foauth%2Fauthorize%3Fanalytics_trace_id%3D65e9fe45-0101-49e2-9634-c46a40308c34%26buyer_flags%3DeyJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJodHRwLXd3dy14dHVjYW0tY29tLm15c2hvcGlmeS5jb20iLCJmbGFncyI6W10sImV4cCI6MTc4ODI1MDYxMywibmJmIjoxNzg3NjQ1ODEzfQ.EnYkNZ0MqBYvkWrMrXDus7sVWJ3qyh1pJn1dntKvPe8%26client_id%3D2d1093e8-43e7-4c91-bc17-ce639c21f482%26locale%3Den-US%26nonce%3D52dd7c3a-a409-43b9-a0aa-a58b3bf32dd3%26redirect_uri%3Dhttps%253A%252F%252Fshopify.com%252F50136547494%252Faccount%252Fcallback%26response_type%3Dcode%26scope%3Dopenid%2Bemail%2Bcustomer-account-api%253Afull%26state%3DhWNG3XOSaXrkrNOODBHiSM2j\"><strong>Sign</strong></a><strong> In</strong> on the XTU website and follow the instructions to create your account using your email address.</p><p>An XTU account allows you to manage your orders, view order history, track purchases, and access other account-related features.</p><p>You can also check out as a guest if guest checkout is available for your order.</p>"
          }
        },
        "item_HP4M49": {
          "type": "item",
          "settings": {
            "question": "Do I Need an Account to Place an Order?",
            "answer": "<p>No. You may be able to place an order as a guest without creating an XTU account.</p><p>However, creating an XTU account allows you to easily view your order history, track your purchases, manage your account information, and receive important order updates.</p>"
          }
        },
        "item_HByFxp": {
          "type": "item",
          "settings": {
            "question": "How Do I Place an Order on XTU?",
            "answer": "<p>To place an order:</p><ol><li>Select the product you want to purchase.</li><li>Choose the available options, such as product version or accessories.</li><li>Click <strong>Add to Cart</strong> or <strong>Buy It Now</strong>.</li><li>Review your order and shipping information.</li><li>Select an available payment method.</li><li>Complete your payment.</li><li>Wait for your order confirmation email.</li></ol><p>Once your payment has been successfully confirmed, we will begin processing your order.</p>"
          }
        },
        "item_7p6kDc": {
          "type": "item",
          "settings": {
            "question": "Can I Change My Order After Placing It?",
            "answer": "<p>If your order has not yet been processed or shipped, we may be able to help you change certain order details.</p><p>Please contact XTU Customer Support as soon as possible and provide your order number and the changes you would like to make.</p><p>Once an order has been shipped, we may not be able to make changes.</p><p><strong>Email:</strong> <a href=\"mailto:support@xtucam.com\">support@xtucam.com</a></p><p>or click chat to contact website service.</p>"
          }
        },
        "item_yReTq8": {
          "type": "item",
          "settings": {
            "question": "Can I Cancel My XTU Order?",
            "answer": "<p>You may request to cancel your order before it has been shipped.</p><p>Please contact us as soon as possible with your order number.</p><p>If your order has already been shipped, cancellation may no longer be possible. In this case, you may need to follow our return and refund process after receiving the order.</p><p>For more information, please see our <strong>Return & Refund Policy</strong>.</p>"
          }
        },
        "item_6hJcaJ": {
          "type": "item",
          "settings": {
            "question": "How Can I Use a Discount Code?",
            "answer": "<p>If you have an XTU discount or promotional code, enter it in the <strong>Discount Code</strong> or <strong>Promo Code</strong> field during checkout and apply it before completing your payment.</p><p>Please make sure:</p><ul><li>The discount code has not expired.</li><li>The code is entered correctly.</li><li>Your order meets any applicable promotional requirements.</li><li>The code is valid for the products you are purchasing.</li></ul><p>Some promotions may not be combined with other discounts or offers.</p><p>If your discount code does not work, please contact XTU Customer Support before completing your order.</p>"
          }
        },
        "item_rycYdT": {
          "type": "item",
          "settings": {
            "question": "Can I Use More Than One Discount Code on the Same Order?",
            "answer": "<p>Unless otherwise stated in the promotion terms, only one promotional or discount code can generally be applied to an order.</p><p>Some automatic promotions, product discounts, or sitewide offers may be combined where specifically permitted.</p><p>Please check the terms of the promotion before placing your order.</p>"
          }
        },
        "item_raBYXL": {
          "type": "item",
          "settings": {
            "question": "Can I Get a Discount for Bulk or Wholesale Orders?",
            "answer": "<p>Yes. XTU may offer special pricing or purchasing options for eligible bulk, business, or wholesale orders.</p><p>If you are interested in purchasing multiple XTU products, please contact our team with:</p><ul><li>Products you are interested in</li><li>Quantity required</li><li>Destination country</li><li>Intended use</li></ul><p>Our team will review your request and provide available purchasing options.</p><p>For wholesale, click <a href=\"https://xtucam.com/pages/wholesale-business\" target=\"_blank\" title=\"https://xtucam.com/pages/wholesale-business\">here</a></p>"
          }
        },
        "item_wqTnLW": {
          "type": "item",
          "settings": {
            "question": "How Can I Check My Order Status?",
            "answer": "<p>If you have an XTU account, sign in to view your order history and available order information.</p><p>You can also check your order confirmation and shipping emails for updates.</p><p>Once your order has been shipped, we will provide tracking information so you can follow the delivery status.</p><p>If you cannot find your order information, please contact us with your order number and email address.</p>"
          }
        },
        "item_JkTCmj": {
          "type": "item",
          "settings": {
            "question": "I Did Not Receive My Order Confirmation Email. What Should I Do?",
            "answer": "<p>After placing an order, you should normally receive an order confirmation email.</p><p>If you do not receive it, please:</p><ol><li>Check your spam or junk email folder.</li><li>Confirm that the email address entered during checkout is correct.</li><li>Check whether your payment was successfully completed.</li><li>Wait a few minutes and check your inbox again.</li></ol><p>If you still cannot find your confirmation email, contact XTU Customer Support with your name, email address, and order details.</p>"
          }
        },
        "item_Vgk4NH": {
          "type": "item",
          "settings": {
            "question": "Can I Change My Shipping Address After Placing an Order?",
            "answer": "<p>Please contact us as soon as possible if you need to change your shipping address.</p><p>We may be able to update the address if your order has not yet been shipped.</p><p>Once the package has been handed over to the shipping carrier, we may not be able to change the delivery address.</p><p>Any additional costs caused by an incorrect or incomplete address may be the customer's responsibility.</p>"
          }
        },
        "item_kHyPHf": {
          "type": "item",
          "settings": {
            "question": "Can I Add Items to an Existing Order?",
            "answer": "<p>Once an order has been placed, we may not be able to add additional products to the same order.</p><p>If your order has not yet been processed, please contact us as soon as possible. Depending on the order status, we may be able to cancel the original order so you can place a new order with all the products you need.</p>"
          }
        },
        "item_FUy8cQ": {
          "type": "item",
          "settings": {
            "question": "Why Was My Order Automatically Cancelled?",
            "answer": "<p>An order may be cancelled in certain circumstances, including:</p><ul><li>Payment authorization failure</li><li>Incorrect or incomplete order information</li><li>Product availability issues</li><li>Shipping restrictions</li><li>Suspected fraudulent transactions</li><li>Other circumstances that prevent us from safely processing the order</li></ul><p>If your order is cancelled, we will contact you when appropriate and process any eligible refund according to the original payment method.</p>"
          }
        },
        "item_aqWnjx": {
          "type": "item",
          "settings": {
            "question": "Is My Personal Information Secure?",
            "answer": "<p>XTU takes reasonable measures to protect your personal and order information.</p><p>Your information is used to process orders, provide customer support, deliver products, and improve your shopping experience.</p><p>For more information about how we collect and use personal information, please refer to our <strong>Privacy Policy</strong>.</p>"
          }
        },
        "item_eQBdqg": {
          "type": "item",
          "settings": {
            "question": "How Can I Contact XTU Customer Support?",
            "answer": "<p>If you have questions about your order, account, payment, shipping, or products, you can contact XTU Customer Support.</p><p><strong>Email:</strong> <a href=\"mailto:support@xtucam.com\">support@xtucam.com</a></p><p>Website ONLINE Chat is also available.</p><p>When contacting us about an existing order, please include your <strong>order number</strong> so we can assist you more quickly.</p>"
          }
        }
      },
