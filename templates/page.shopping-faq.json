    "xtu_faq_i7KEyP": {
      "type": "xtu-faq",
      "blocks": {
        "item_UMChqL": {
          "type": "item",
          "settings": {
            "question": "What payment methods does GKU accept?",
            "answer": "<p>GKU accepts supported major payment methods, including eligible credit cards and PayPal where available. Available payment methods may vary by country or region, so please refer to the options displayed at checkout.</p>"
          }
        },
        "item_L7kUYQ": {
          "type": "item",
          "settings": {
            "question": "Does GKU accept PayPal?",
            "answer": "<p>Yes. PayPal is available for eligible orders. Select PayPal during checkout and follow the instructions to complete your payment.</p>"
          }
        },
        "item_pGJF9M": {
          "type": "item",
          "settings": {
            "question": "Is my payment information secure?",
            "answer": "<p>GKU uses secure checkout technology and trusted payment service providers to process online payments. For more information about how personal information is handled, please review the GKU Privacy Policy.</p>"
          }
        },
        "item_r86fPc": {
          "type": "item",
          "settings": {
            "question": "Why was my payment declined?",
            "answer": "<p>A payment may be declined because of incorrect card information, insufficient funds, billing-address mismatches, bank security restrictions, international transaction restrictions, or payment-provider risk controls. Check your information and try again, contact your bank, or use another available payment method.</p>"
          }
        },
        "item_bNY3Wk": {
          "type": "item",
          "settings": {
            "question": "What currency will I be charged in?",
            "answer": "<p>The currency shown at checkout will generally be used to process your order. Your bank or payment provider may apply currency conversion or international transaction fees where applicable.</p>"
          }
        }
      },
