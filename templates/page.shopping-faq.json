    "xtu_faq_afjj37": {
      "type": "xtu-faq",
      "blocks": {
        "item_JQbjEE": {
          "type": "item",
          "settings": {
            "question": "Which Countries Does XTU Ship To?",
            "answer": "<p>XTU ships to selected countries and regions across North America, Europe, Asia-Pacific, and Southeast Asia.</p><p>Our shipping coverage may include:</p><ul><li><strong>North America:</strong> United States, Canada</li><li><strong>Europe:</strong> United Kingdom, Germany, France, Italy, Spain, Netherlands, and other eligible European countries</li><li><strong>Asia-Pacific:</strong> Japan, South Korea, Australia, and New Zealand</li><li><strong>Southeast Asia:</strong> Singapore, Malaysia, Thailand, Vietnam, Indonesia, and the Philippines</li></ul><p>Available shipping destinations may vary depending on the product, warehouse availability, carrier, and local import regulations.</p><p>The shipping options available for your specific address will be displayed at checkout.</p>"
          }
        },
        "item_zy6PGN": {
          "type": "item",
          "settings": {
            "question": "Does XTU Offer DDP Shipping?",
            "answer": "<p>Yes. XTU supports <strong>DDP (Delivered Duty Paid) shipping</strong> for eligible destinations.</p><p>With DDP shipping, applicable import duties, taxes, and customs clearance charges are generally handled through the shipping service, providing a more convenient and hassle-free delivery experience.</p><p>DDP availability may vary depending on your destination, product, fulfillment warehouse, shipping carrier, and local customs requirements.</p><p>When DDP is available for your order, the applicable shipping option will be displayed at checkout.</p>"
          }
        },
        "item_ReQ6MR": {
          "type": "item",
          "settings": {
            "question": "Which Countries Support DDP Shipping?",
            "answer": "<p>XTU supports DDP shipping to selected destinations.</p><p>DDP availability may include major markets such as:</p><ul><li>United States</li><li>Canada</li><li>United Kingdom</li><li>Germany</li><li>France</li><li>Italy</li><li>Spain</li><li>Australia</li><li>Japan</li><li>South Korea</li><li>Singapore</li><li>Malaysia</li><li>Thailand</li><li>Vietnam</li><li>Philippines</li></ul><p>However, DDP availability is not guaranteed for every product or address within these countries.</p><p>The available shipping methods are determined based on the destination, product type, fulfillment warehouse, carrier, and current logistics conditions.</p><p><strong>The final DDP availability and shipping cost will be confirmed at checkout.</strong></p>"
          }
        },
        "item_An6MNn": {
          "type": "item",
          "settings": {
            "question": "Does XTU Ship from Local Warehouses?",
            "answer": "<p>Yes. XTU operates multiple fulfillment locations to serve customers in different markets.</p><p>When local inventory is available, <strong>XTU prioritizes fulfillment from a warehouse near your delivery address</strong> whenever possible.</p><p>Local warehouse fulfillment can help reduce international transit time and provide a faster and more convenient delivery experience.</p><p>However, local inventory availability varies by product and may change over time.</p><p>Countries with local warehouse: America, European Countries, Japan, Australia, UK, Canada.</p>"
          }
        },
        "item_paLgen": {
          "type": "item",
          "settings": {
            "question": "What Happens If My Package Is Delayed?",
            "answer": "<p>Delivery delays can occur due to circumstances beyond XTU's control, including:</p><ul><li>Customs clearance</li><li>Severe weather</li><li>Carrier delays</li><li>Public holidays</li><li>High-volume shopping periods</li><li>Transportation restrictions</li><li>Temporary warehouse shortages</li><li>Cross-warehouse fulfillment</li><li>Incorrect or incomplete delivery information</li></ul><p>If your package is significantly delayed, please contact XTU Customer Support with your order number and tracking information.</p><p>We will help you check the latest shipping status with the carrier.</p>"
          }
        },
        "item_bda9Rg": {
          "type": "item",
          "settings": {
            "question": "Will I Have to Pay Customs or Import Taxes?",
            "answer": "<p>No. </p><p>For eligible orders shipped using <strong>DDP (Delivered Duty Paid)</strong>, applicable import duties, taxes, and customs clearance charges are generally handled through the DDP shipping service.</p><p>For orders shipped using a non-DDP service, we will discuss with the customer before shipping.</p>"
          }
        },
        "item_JazymB": {
          "type": "item",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Estimated delivery times are:</p><p><strong>Express Shipping:</strong> 3–5 business days<br/><strong>Standard Shipping:</strong> 5–15 business days</p><p>Delivery times may vary depending on your location, warehouse availability, customs, and carrier conditions.</p>"
          }
        },
        "item_w4WXh4": {
          "type": "item",
          "settings": {
            "question": "Does XTU offers free shipping?",
            "answer": "<p>Yes. <strong>Standard Shipping is free on orders of $49.99 or more</strong> where available.</p><p>Actual shipping options and fees will be shown at checkout.</p>"
          }
        }
      },
