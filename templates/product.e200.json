    "xtu_faq_kT3Ffi": {
      "type": "xtu-faq",
      "blocks": {
        "item_37LRTh": {
          "type": "item",
          "settings": {
            "question": "What is Sony STARVIS 2, and how does it improve night recording?",
            "answer": "<p>The E200 uses the <strong>Sony STARVIS 2 IMX675 image sensor</strong>, designed to improve image quality in challenging low-light conditions. It helps capture cleaner footage with reduced image noise and better detail at night.</p><p>Actual night footage can still vary depending on vehicle speed, surrounding light, headlights, weather, windshield condition, and other environmental factors.</p>"
          }
        },
        "item_f6em3x": {
          "type": "item",
          "settings": {
            "question": "Does the E200 support HDR?",
            "answer": "<p>Yes. The E200 supports <strong>HDR imaging</strong> to help balance bright and dark areas in high-contrast driving situations, such as headlights at night, tunnels, streetlights, and rapidly changing lighting conditions.</p>"
          }
        },
        "item_XHwPXM": {
          "type": "item",
          "settings": {
            "question": "Can I connect the E200 to my smartphone?",
            "answer": "<p>Yes. The E200 features built-in WiFi and works with the <strong>GKU GO App</strong> on compatible iOS and Android devices.</p><p>You can use your phone to preview recordings, manage camera settings, download important footage, and save clips for sharing.</p>"
          }
        },
        "item_77XCPT": {
          "type": "item",
          "settings": {
            "question": "Does the E200's WiFi provide internet or remote monitoring?",
            "answer": "<p>No. The E200's WiFi creates a <strong>local wireless connection between the dash cam and your smartphone</strong>. It is used for video preview, downloads, and camera management through the GKU GO App.</p><p>It does not provide internet access or remote vehicle monitoring when you are away from the car.</p>"
          }
        },
        "item_UaqcKr": {
          "type": "item",
          "settings": {
            "question": "Does the GKU E200 have built-in GPS?",
            "answer": "<p>Yes. The E200 has <strong>built-in GPS</strong> that can record driving information such as vehicle speed, route, and location data, providing additional context when reviewing your footage.</p>"
          }
        },
        "item_TmAAYP": {
          "type": "item",
          "settings": {
            "question": "Does the E200 support parking mode?",
            "answer": "<p>Yes. The E200 supports <strong>24-hour parking surveillance</strong> when connected to a compatible GKU hardwire kit.</p><p>The hardwire kit provides continuous power while the vehicle is parked and includes low-voltage protection to help protect the vehicle battery.</p>"
          }
        },
        "item_NpnXWK": {
          "type": "item",
          "settings": {
            "question": "Is the E200 a good choice for night driving?",
            "answer": "<p>The E200 is designed for drivers who prioritize <strong>front-and-rear image quality and nighttime performance</strong>. Its Dual 4K recording, Sony STARVIS 2 imaging, and HDR work together to capture more useful detail across a range of daytime and nighttime driving conditions.</p><p>For the best results, keep the windshield and camera lenses clean and make sure the cameras are installed at the correct angle.</p>"
          }
        },
        "item_NFjWeY": {
          "type": "item",
          "settings": {
            "question": "Does the E200 come with a memory card?",
            "answer": "<p>No</p>"
          }
        }
      },
