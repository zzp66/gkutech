{% comment %}
This file is auto-generated by PageFly. The content can be overridden when publish page in PageFly. Please do not update this file directly.
If you plan to remove PageFly, please see the guide in our help center first: https://help.pagefly.io/.
{% endcomment %}
<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %}
      Opt into cross-document (MPA) view transitions and hold first paint until #MainContent
      parses, so the transition runs consistently.
      Both are gated on the same settings as the view-transitions.js opt-out switch (see snippets/scripts.liquid).
    {% endcomment %}
{% if settings.transition_to_main_product or settings.page_transition_enabled %}
  {% unless request.design_mode %}
    {% style %}
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    {% endstyle %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >
  {% endunless %}
{% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  {% include 'pagefly-app-header' %}</head>

  <body class="page-width-custom card-hover-effect-{{ settings.card_hover_effect }}"><div class="pagefly-container">
              {{ content_for_layout }}
            </div></body>
</html>
